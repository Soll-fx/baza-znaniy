utton_anchor" data-phrase-anchor="bssPhr5097"></a><a data-anchor="/document/90/18560/dfas4p8n1s/"></a>81 &#8212; 90</p></td><td class="bdBottom bdRight" style="width: 34%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5098/" data-role="phrase-anchor" data-phrase-id="5098" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5098"></a><a data-anchor="/document/90/18560/dfasxcf48z/"></a>14,36</p></td></tr><tr><td class="bdBottom bdRight bdLeft" colspan="2" style="width: 29%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5099/" data-role="phrase-anchor" data-phrase-id="5099" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5099"></a><a data-anchor="/document/90/18560/dfasp3p21u/"></a>X</p></td><td class="bdBottom bdRight" colspan="3" style="width: 35%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5100/" data-role="phrase-anchor" data-phrase-id="5100" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5100"></a><a data-anchor="/document/90/18560/dfasi1g697/"></a>91 &#8212; 100</p></td><td class="bdBottom bdRight" style="width: 34%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5101/" data-role="phrase-anchor" data-phrase-id="5101" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5101"></a><a data-anchor="/document/90/18560/dfashbbrvr/"></a>17,50</p></td></tr><tr><td class="bdBottom bdRight bdLeft" colspan="2" style="width: 29%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr5102/" data-role="phrase-anchor" data-phrase-id="5102" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5102"></a><a data-anchor="/document/90/18560/dfask87lx1/"></a>&#160;</td><td class="bdBottom bdRight" colspan="3" style="width: 35%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5103/" data-role="phrase-anchor" data-phrase-id="5103" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5103"></a><a data-anchor="/document/90/18560/dfasiaa0gv/"></a>Неоцененные земли</p></td><td class="bdBottom bdRight" style="width: 34%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5104/" data-role="phrase-anchor" data-phrase-id="5104" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5104"></a><a data-anchor="/document/90/18560/dfassniu2g/"></a>4,67</p></td></tr></tbody></table></div></div></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr5105/" data-role="phrase-anchor" data-phrase-id="5105" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5105"></a><a data-anchor="/document/90/18560/dfas9wsc5q/"></a>Примечание:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr5106/" data-role="phrase-anchor" data-phrase-id="5106" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5106"></a><a data-anchor="/document/90/18560/dfasg6smuz/"></a>Ставка земельного налога, взимаемого за орошаемые сельскохозяйственные угодья, определяется исходя из базовой ставки земельного налога на орошаемые сельскохозяйственные угодья и поправочного коэффициента, учитывающего качественную характеристику земельного участка (балл-бонитета).</p><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr allowpartbreak="false"><td style="width: 24%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr5107/" data-role="phrase-anchor" data-phrase-id="5107" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5107"></a><a data-anchor="/document/90/18560/dfasfqg5rc/"></a>&#160;</td><td colspan="2" style="width: 22%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr5108/" data-role="phrase-anchor" data-phrase-id="5108" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5108"></a><a data-anchor="/document/90/18560/dfas2xin4q/"></a>&#160;</td><td colspan="2" style="width: 25%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr5109/" data-role="phrase-anchor" data-phrase-id="5109" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5109"></a><a data-anchor="/document/90/18560/dfasl0fxb2/"></a>&#160;</td><td colspan="2" style="width: 27%; word-wrap: break-word"><p style="text-align:right"><a data-anchor="/document/90/18560/bssPhr5110/" data-role="phrase-anchor" data-phrase-id="5110" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5110"></a><a data-anchor="/document/90/18560/dfasar0qg5/"></a>Таблица № 2</p></td></tr><tr allowpartbreak="false"><td class="bdBottom" colspan="7" style="width: 100%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5111/" data-role="phrase-anchor" data-phrase-id="5111" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5111"></a><a data-anchor="/document/90/18560/dfasgcgzrq/"></a><strong>СТАВКИ<br>земельного налога, взимаемого за богарные пашни, залежи и многолетние насаждения</strong></p></td></tr><tr allowpartbreak="false"><td class="bdAll" rowspan="2" style="width: 24%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5112/" data-role="phrase-anchor" data-phrase-id="5112" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5112"></a><a data-anchor="/document/90/18560/dfaspiopr1/"></a><strong>Область</strong></p></td><td class="bdTop bdBottom bdRight" colspan="6" style="width: 75%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5113/" data-role="phrase-anchor" data-phrase-id="5113" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5113"></a><a data-anchor="/document/90/18560/dfasnpz851/"></a><strong>Ставки земельного налога по зонам за 1 га, в сумах</strong></p></td></tr><tr allowpartbreak="false"><td class="bdBottom bdRight" colspan="2" style="width: 22%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5114/" data-role="phrase-anchor" data-phrase-id="5114" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5114"></a><a data-anchor="/document/90/18560/dfasl0tgih/"></a><strong>равнинная<br>(необеспеченная осадками) зона</strong></p></td><td class="bdBottom bdRight" colspan="2" style="width: 25%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5115/" data-role="phrase-anchor" data-phrase-id="5115" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5115"></a><a data-anchor="/document/90/18560/dfasmeo6tg/"></a><strong>адырная<br>(полуобеспеченная осадками) зона</strong></p></td><td class="bdBottom bdRight" colspan="2" style="width: 27%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5116/" data-role="phrase-anchor" data-phrase-id="5116" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5116"></a><a data-anchor="/document/90/18560/dfasdsg2h3/"></a><strong>предгорная и горная<br>(обеспеченная осадками) зона</strong></p></td></tr><tr allowpartbreak="false"><td class="bdBottom bdRight bdLeft" style="width: 24%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr5117/" data-role="phrase-anchor" data-phrase-id="5117" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr5117"></a><a data-anchor="/document/90/18560/dfas18to8o/"></a>Андижанская</p></td><td class="bdBottom bdRight" colspan="2" style="width: 22%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr5118/" data-role="phrase-anchor" data-phrase-id="5118" data-dwh-source-type-favorites="button_anchor" data-phr