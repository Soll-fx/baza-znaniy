3/"></a>18 500</p></td><td class="bdBottom bdRight" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6283/" data-role="phrase-anchor" data-phrase-id="6283" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6283"></a><a data-anchor="/document/90/18560/dfashqtsia/"></a>16 500</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6284/" data-role="phrase-anchor" data-phrase-id="6284" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6284"></a><a data-anchor="/document/90/18560/dfasdgxa3y/"></a>2.2.</p></td><td class="bdBottom bdRight" style="width: 22%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6285/" data-role="phrase-anchor" data-phrase-id="6285" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6285"></a><a data-anchor="/document/90/18560/dfasdxv97u/"></a>9-10,5 часов</p></td><td class="bdBottom bdRight" style="width: 15%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6286/" data-role="phrase-anchor" data-phrase-id="6286" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6286"></a><a data-anchor="/document/90/18560/dfasld3fg2/"></a>81 100</p></td><td class="bdBottom bdRight" style="width: 18%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6287/" data-role="phrase-anchor" data-phrase-id="6287" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6287"></a><a data-anchor="/document/90/18560/dfas2i6v96/"></a>73 400</p></td><td class="bdBottom bdRight" style="width: 17%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6288/" data-role="phrase-anchor" data-phrase-id="6288" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6288"></a><a data-anchor="/document/90/18560/dfassr37ci/"></a>106 900</p></td><td class="bdBottom bdRight" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6289/" data-role="phrase-anchor" data-phrase-id="6289" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6289"></a><a data-anchor="/document/90/18560/dfasg8h7wv/"></a>96 900</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6290/" data-role="phrase-anchor" data-phrase-id="6290" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6290"></a><a data-anchor="/document/90/18560/dfas5dxnes/"></a>2.3.</p></td><td class="bdBottom bdRight" style="width: 22%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6291/" data-role="phrase-anchor" data-phrase-id="6291" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6291"></a><a data-anchor="/document/90/18560/dfasx8dswo/"></a>12 часов</p></td><td class="bdBottom bdRight" style="width: 15%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6292/" data-role="phrase-anchor" data-phrase-id="6292" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6292"></a><a data-anchor="/document/90/18560/dfas2f1u0s/"></a>106 100</p></td><td class="bdBottom bdRight" style="width: 18%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6293/" data-role="phrase-anchor" data-phrase-id="6293" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6293"></a><a data-anchor="/document/90/18560/dfaso9izfh/"></a>95 600</p></td><td class="bdBottom bdRight" style="width: 17%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6294/" data-role="phrase-anchor" data-phrase-id="6294" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6294"></a><a data-anchor="/document/90/18560/dfasnnub8w/"></a>127 400</p></td><td class="bdBottom bdRight" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6295/" data-role="phrase-anchor" data-phrase-id="6295" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6295"></a><a data-anchor="/document/90/18560/dfasiffgag/"></a>114 500</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6296/" data-role="phrase-anchor" data-phrase-id="6296" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6296"></a><a data-anchor="/document/90/18560/dfas468cr6/"></a>2.4.</p></td><td class="bdBottom bdRight" style="width: 22%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6297/" data-role="phrase-anchor" data-phrase-id="6297" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6297"></a><a data-anchor="/document/90/18560/dfase1qkp3/"></a>24 часа</p></td><td class="bdBottom bdRight" style="width: 15%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6298/" data-role="phrase-anchor" data-phrase-id="6298" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6298"></a><a data-anchor="/document/90/18560/dfas9kpwdx/"></a>106 100</p></td><td class="bdBottom bdRight" style="width: 18%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6299/" data-role="phrase-anchor" data-phrase-id="6299" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6299"></a><a data-anchor="/document/90/18560/dfasrgdmsy/"></a>95 600</p></td><td class="bdBottom bdRight" style="width: 17%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6300/" data-role="phrase-anchor" data-phrase-id="6300" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6300"></a><a data-anchor="/document/90/18560/dfasu9xgcw/"></a>140 300</p></td><td class="bdBottom bdRight" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6301/" data-role="phrase-anchor" data-phrase-id="6301" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6301"></a><a data-anchor="/document/90/18560/dfashppgkv/"></a>127 700</p></td></tr></tbody></table></div></div></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6302/" data-role="phrase-anchor" data-phrase-id="6302" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6302"></a><a data-anchor="/document/90/18560/dfaslkauvi/"></a>* Размеры ежемесячной родительской платы за содержание детей в дошкольных образовательных учреждениях, расположенных в Республике Каракалпакстан и Хорезмской области, устанавливаются в два раза ниже.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6303/" data-role="phrase-anchor" data-phrase-id="6303" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6303"></a><a data-anchor="/document/90/18560/dfasctqhgu/"></a>** При посещении дошкольного образовательного учреждения более чем одного ребенка из одной семьи, в том числе находящиеся в разных возрастных группах, размер родительской платы на каждого ребенка устанавливается согласно возрастной группе.</p><p style="text-align:right"><a data-anchor="/document/90/18560/bssPhr6304/" data-role="phrase-anchor" data-phrase-id="6304" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6304"></a><a data-anchor="/document/90/18560/dfasl0hs50/"></a>ПРИЛОЖЕНИЕ № 35<br>к постановлению Президента Республики<br>Узбекистан от 27 декабря 2016 года № ПП-2699</p><div class="doc__untyped" data-type="untyped" data-level="1"><a data-role="toc" data-anchor="/document/90/18560/tit87/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/18560/bssPhr6305/" data-role="phrase-anchor" data-phrase-id="6305" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6305"></a><a data-anchor="/document/90/18560/dfasrf3e8i/"></a>ПЕРЕЧЕНЬ&#160;<br>услуг, на которые до 1 января 2020 года распространяются налоговые льготы, установленные постановлением Президента Республики Узбекистан от 17 апреля 2006 года № ПП-325</span></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6306/" data-role="phrase-anchor" data-phrase-id="6306" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6306"></a><a data-anchor="/document/90/18560/dfasif8bnc/"></a>1) услуги в области ремонта обуви и изделий из кожи в сельской местности;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6307/" data-role="phrase-anchor" data-phrase-id="6307" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6307"></a><a data-anchor="/document/90/18560/dfasazt7d5/"></a>2) услуги по ремонту часов в сельской местности;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6308/" data-role="phrase-anchor" data-phrase-id="6308" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6308"></a><a data-anchor="/document/90/18560/dfasyyb2xa/"></a>3) услуги по ремонту и техническому обслуживанию бытовых электронных и электрических приборов (телевизоров, аудио видео аппаратуры, компьютерной, принтерной техники, холодильников, кондиционеров и др.) в сельской местности;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6309/" data-role="phrase-anchor" data-phrase-id="6309" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6309"></a><a data-anchor="/document/90/18560/dfas77071e/"></a>4) услуги парикмахерских и салонов красоты, оказываемые в сельской местности;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6310/" data-role="phrase-anchor" data-phrase-id="6310" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6310"></a><a data-anchor="/document/90/18560/dfasi89fxl/"></a>5) услуги по пошиву и ремонту одежды, оказываемые в сельской местности;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6311/" data-role="phrase-anchor" data-phrase-id="6311" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6311"></a><a data-anchor="/document/90/18560/dfasa5wi2q/"></a>6) услуги организаций по приему белья в стирку, организуемых в сельских массивах, застраиваемых под индивидуальное жилищное строительство;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6312/" data-role="phrase-anchor" data-phrase-id="6312" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6312"></a><a data-anchor="/document/90/18560/dfas9hcvcn/"></a>7) услуги организаций химической чистки, организуемых в сельских массивах, застраиваемых под индивидуальное жилищное строительство;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6313/" data-role="phrase-anchor" data-phrase-id="6313" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6313"></a><a data-anchor="/document/90/18560/dfastv9cps/"></a>8) услуги в сфере образования, включая обучение работе на компьютере;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6314/" data-role="phrase-anchor" data-phrase-id="6314" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6314"></a><a data-anchor="/document/90/18560/dfas591cxa/"></a>9) услуги санаториев, детских оздоровительных учреждений, детских спортивных учреждений и секций;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6315/" data-role="phrase-anchor" data-phrase-id="6315" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6315"></a><a data-anchor="/document/90/18560/dfaskgcmfx/"></a>10) социальные услуги по уходу за детьми, инвалидами, престарелыми гражданами;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6316/" data-role="phrase-anchor" data-phrase-id="6316" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6316"></a><a data-anchor="/document/90/18560/dfasascg4f/"></a>11) услуги информационно-ресурсных центров, информационно-библиотечных центров, электронного образования;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6317/" data-role="phrase-anchor" data-phrase-id="6317" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6317"></a><a data-anchor="/document/90/18560/dfas4u6ugg/"></a>12) услуги по компьютерному программированию (включая консультационные), оказываемые в сельской местности.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6318/" data-role="phrase-anchor" data-phrase-id="6318" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6318"></a><a data-anchor="/document/90/18560/dfaso836m5/"></a>Примечание. Льготы по уплате налога на прибыль и единого налогового платежа распространяются на все доходы микрофирм и малых предприятий при условии, что их выручка от оказания видов услуг, по которым предусмотрены льготы, составляет 80 и более процентов от общего объема выручки.</p><p style="text-align:right"><a data-anchor="/document/90/18560/bssPhr6319/" data-role="phrase-anchor" data-phrase-id="6319" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6319"></a><a data-anchor="/document/90/18560/dfas5f2che/"></a>ПРИЛОЖЕНИЕ № 36<br>к постановлению Президента Республики<br>Узбекистан от 27 декабря 2016 года № ПП-2699</p><div class="doc__untyped" data-type="untyped" data-level="1"><a data-role="toc" data-anchor="/document/90/18560/tit88/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/18560/bssPhr6320/" data-role="phrase-anchor" data-phrase-id="6320" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6320"></a><a data-anchor="/document/90/18560/dfaszivahd/"></a>ПЕРЕЧЕНЬ&#160;<br>некоторых решений Президента Республики Узбекистан и Правительства Республики Узбекистан, признаваемых утратившими силу с 1 января 2017 года</span></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6321/" data-role="phrase-anchor" data-phrase-id="6321" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6321"></a><a data-anchor="/document/90/18560/dfasf9f3iv/"></a>1. Пункт 8 постановления Президента Республики Узбекистан от 24 декабря 2010 года № ПП-1449 &#171;О прогнозе основных макроэкономических показателей и параметрах Государственного бюджета Республики Узбекистан на 2011 год&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6322/" data-role="phrase-anchor" data-phrase-id="6322" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6322"></a><a data-anchor="/document/90/18560/dfasba9aoo/"></a>2. Постановление Центрального Комитета Компартии Узбекистана и Совета Министров Узбекской ССР от 9 июня 1983 года № 380 &#171;Постановление Центрального Комитета КПСС и Совета Министров СССР от 26 мая 1983 года № 473 &#171;О дополнительных мерах по улучшению изучения русского языка в общеобразовательных школах и других учебных заведениях союзных республик&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6323/" data-role="phrase-anchor" data-phrase-id="6323" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6323"></a><a data-anchor="/document/90/18560/dfasv6c35a/"></a>3. Распоряжение Совета Министров Узбекской ССР от 28 декабря 1989 года № 410-р.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6324/" data-role="phrase-anchor" data-phrase-id="6324" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6324"></a><a data-anchor="/document/90/18560/dfas385oq6/"></a>4. Постановление Кабинета Министров от 26 июля 1995 года № 292 &#171;О вопросах организации и деятельности агентства &#171;Мадад&#187; (СП Республики Узбекистан, 1995 г., № 7, ст. 25).</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6325/" data-role="phrase-anchor" data-phrase-id="6325" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6325"></a><a data-anchor="/document/90/18560/dfasdi522x/"></a>5. Пункт VI приложения № 3 к постановлению Кабинета Министров от 27 ноября 2002 года № 413 &#171;О мерах по дальнейшему развитию рынка страховых услуг&#187; (СП Республики Узбекистан, 2002 г., № 11, ст. 72).</p><p style="text-align:right"><a data-anchor="/document/90/18560/bssPhr6326/" data-role="phrase-anchor" data-phrase-id="6326" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6326"></a><a data-anchor="/document/90/18560/dfasfqi18x/"></a>ПРИЛОЖЕНИЕ № 37<br>к постановлению Президента Республики<br>Узбекистан от 27 декабря 2016 года № ПП-2699</p><div class="doc__untyped" data-type="untyped" data-level="1"><a data-role="toc" data-anchor="/document/90/18560/tit89/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/18560/bssPhr6327/" data-role="phrase-anchor" data-phrase-id="6327" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6327"></a><a data-anchor="/document/90/18560/dfasedq4p5/"></a>Изменения и дополнения, вносимые с 1 января 2017 года в некоторые решения Президента Республики Узбекистан и Правительства Республики Узбекистан</span></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6328/" data-role="phrase-anchor" data-phrase-id="6328" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6328"></a><a data-anchor="/document/90/18560/dfas75hggw/"></a>1. Абзац второй пункта 18 постановления Президента Республики Узбекистан от 12 декабря 2007 года № ПП-744 &#171;О прогнозе основных макроэкономических показателей и параметрах Государственного бюджета Республики Узбекистан на 2008 год&#187; дополнить словами &#171;и материально-технической базы учреждения, прежде всего, на приобретение санитарно-гигиенических средств и мягкого инвентаря&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6329/" data-role="phrase-anchor" data-phrase-id="6329" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6329"></a><a data-anchor="/document/90/18560/dfasql9pga/"></a>3. Пункт 1 постановления Президента Республики Узбекистан от 30 декабря 2009 года № ПП-1252 &#171;О мерах по формированию организационной структуры внебюджетного Пенсионного фонда при Министерстве финансов Республики Узбекистан&#187; дополнить абзацем следующего содержания:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6330/" data-role="phrase-anchor" data-phrase-id="6330" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6330"></a><a data-anchor="/document/90/18560/dfasgl9ni2/"></a>&#171;Разрешить министру финансов Республики Узбекистан вносить, при необходимости, изменения в структуру исполнительного аппарата внебюджетного Пенсионного фонда при Министерстве финансов Республики Узбекистан, структуры его территориальных управлений и районных (городских) отделов в пределах утвержденной общей предельной численности персонала&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6331/" data-role="phrase-anchor" data-phrase-id="6331" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6331"></a><a data-anchor="/document/90/18560/dfaslsbh05/"></a>5. В пункте 9 постановления Президента Республики Узбекистан от 30 мая 2011 года № ПП-1533 &#171;О мерах по укреплению материально-технической базы высших образовательных учреждений и кардинальному улучшению качества подготовки высококвалифицированных специалистов&#187; слова &#171;по 31 декабря 2016 года&#187; заменить словами &#171;по 31 декабря 2017 года&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6332/" data-role="phrase-anchor" data-phrase-id="6332" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6332"></a><a data-anchor="/document/90/18560/dfasndk3g1/"></a>7. В абзаце первом пункта 1 постановления Президента Республики Узбекистан от 30 декабря 2011 года № ПП-1672 &#171;О предоставлении дополнительных налоговых льгот и преференций для дальнейшего развития средств массовой информации&#187; слова &#171;на пять лет&#187; заменить словами &#171;на семь лет&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6333/" data-role="phrase-anchor" data-phrase-id="6333" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6333"></a><a data-anchor="/document/90/18560/dfassnul0u/"></a>8. В абзаце первом пункта 3 постановления Президента Республики Узбекистан от 4 апреля 2012 года № ПП-1736 &#171;О дополнительных мерах по дальнейшему развитию производства автотранспортных средств на Самаркандском автомобильном заводе&#187; слова &#171;на 5 лет&#187; заменить словами &#171;на 8 лет&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6334/" data-role="phrase-anchor" data-phrase-id="6334" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6334"></a><a data-anchor="/document/90/18560/dfas5flwcg/"></a>9. В постановлении Президента Республики Узбекистан от 6 ноября 2012 года № ПП-1849 &#171;О мерах по реализации проекта &#171;Реабилитация магистральных оросительных каналов Ташсакинской системы Хорезмской области&#187; с участием Исламского банка развития&#187;:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6335/" data-role="phrase-anchor" data-phrase-id="6335" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6335"></a><a data-anchor="/document/90/18560/dfase6lpug/"></a>а) в абзаце пятом пункта 1 слова &#171;в течение 2013 &#8212; 2016&#187; заменить словами &#171;в течение 2013 &#8212; 2019&#187;;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6336/" data-role="phrase-anchor" data-phrase-id="6336" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6336"></a><a data-anchor="/document/90/18560/dfas6zlang/"></a>б) в пункте 3:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6337/" data-role="phrase-anchor" data-phrase-id="6337" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6337"></a><a data-anchor="/document/90/18560/dfas1cevkk/"></a>абзац второй исключить;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6338/" data-role="phrase-anchor" data-phrase-id="6338" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6338"></a><a data-anchor="/document/90/18560/dfas7063kv/"></a>абзацы третий и четвертый считать соответственно абзацами вторым и третьим;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6339/" data-role="phrase-anchor" data-phrase-id="6339" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6339"></a><a data-anchor="/document/90/18560/dfasc84d3z/"></a>в) приложение № 1 признать утратившим силу.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6340/" data-role="phrase-anchor" data-phrase-id="6340" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6340"></a><a data-anchor="/document/90/18560/dfas2tmy5b/"></a>10. В пункте 9 постановления Президента Республики Узбекистан от 23 мая 2013 года № ПП-1971 &#171;О мерах по совершенствованию деятельности Узбекского государственного университета мировых языков&#187; слова &#171;до 1 января 2017 года&#187; заменить словами &#171;до 1 января 2018 года&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6341/" data-role="phrase-anchor" data-phrase-id="6341" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6341"></a><a data-anchor="/document/90/18560/dfas321fph/"></a>11. В абзаце первом пункта 4 постановления Президента Республики Узбекистан от 20 сентября 2013 года № ПП-2042 &#171;О мерах по дальнейшему усилению стимулирования отечественных разработчиков программного обеспечения&#187; слова &#171;до 1 января 2017 года&#187; заменить словами &#171;до 1 января 2020 года&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6342/" data-role="phrase-anchor" data-phrase-id="6342" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6342"></a><a data-anchor="/document/90/18560/dfaslar94q/"></a>14. В постановлении Кабинета Министров от 27 мая 1998 года № 232 &#171;О совершенствовании механизма стимулирования развития малого предпринимательства&#187; (СП Республики Узбекистан, 1998 г., № 5, ст. 20):</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6343/" data-role="phrase-anchor" data-phrase-id="6343" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6343"></a><a data-anchor="/document/90/18560/dfaswfxhrg/"></a>а) в пункте 9:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6344/" data-role="phrase-anchor" data-phrase-id="6344" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6344"></a><a data-anchor="/document/90/18560/dfasxdrg47/"></a>абзац второй исключить;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6345/" data-role="phrase-anchor" data-phrase-id="6345" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6345"></a><a data-anchor="/document/90/18560/dfas27y9xf/"></a>абзац третий считать абзацем вторым;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6346/" data-role="phrase-anchor" data-phrase-id="6346" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6346"></a><a data-anchor="/document/90/18560/dfas4ngw0y/"></a>б) пункт 11 и приложение № 4 признать утратившими силу;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6347/" data-role="phrase-anchor" data-phrase-id="6347" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6347"></a><a data-anchor="/document/90/18560/dfasrn28kw/"></a>в) из графы &#171;Наименование органов&#187; позиции шестой приложения № 2 слово &#171;Мадад&#187; исключить;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6348/" data-role="phrase-anchor" data-phrase-id="6348" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6348"></a><a data-anchor="/document/90/18560/dfas75c74s/"></a>г) из абзаца пятого пункта 11 приложения № 3 слово &#171;Мадад&#187; исключить.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6349/" data-role="phrase-anchor" data-phrase-id="6349" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6349"></a><a data-anchor="/document/90/18560/dfas4o66w0/"></a>16. В постановлении Кабинета Министров от 21 декабря 2005 года № 275 &#171;Об утверждении усовершенствованной системы оплаты труда работников народного образования&#187; (СП Республики Узбекистан, 2005 г., № 12, ст. 63):</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6350/" data-role="phrase-anchor" data-phrase-id="6350" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6350"></a><a data-anchor="/document/90/18560/dfaskguzix/"></a>а) в приложении № 1:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6351/" data-role="phrase-anchor" data-phrase-id="6351" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6351"></a><a data-anchor="/document/90/18560/dfasumvz01/"></a>пункт 8 после слова &#171;руководители кружков&#187; дополнить словами &#171;(кроме указанных в пункте 9)&#187;;</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6352/" data-role="phrase-anchor" data-phrase-id="6352" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6352"></a><a data-anchor="/document/90/18560/dfasvdlglu/"></a>дополнить пунктом 9 следующего содержания:</p><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdRight" style="width: 3%; word-wrap: break-word"><p style="text-align:right"><a data-anchor="/document/90/18560/bssPhr6353/" data-role="phrase-anchor" data-phrase-id="6353" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6353"></a><a data-anchor="/document/90/18560/dfasuts6mh/"></a>&#171;</p></td><td class="bdTop bdBottom bdRight" style="width: 41%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6354/" data-role="phrase-anchor" data-phrase-id="6354" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6354"></a><a data-anchor="/document/90/18560/dfaso25w3x/"></a>9. Руководители кружков детских центров &#171;Баркамол авлод&#187;</p></td><td class="bdTop bdBottom bdRight" style="width: 10%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6355/" data-role="phrase-anchor" data-phrase-id="6355" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6355"></a><a data-anchor="/document/90/18560/dfasgl40mx/"></a>40 786</p></td><td class="bdTop bdBottom bdRight" style="width: 9%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6356/" data-role="phrase-anchor" data-phrase-id="6356" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6356"></a><a data-anchor="/document/90/18560/dfasbtrg2f/"></a>37 521</p></td><td class="bdTop bdBottom bdRight" style="width: 10%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6357/" data-role="phrase-anchor" data-phrase-id="6357" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6357"></a><a data-anchor="/document/90/18560/dfasz3ez9z/"></a>34 386</p></td><td class="bdTop bdBottom bdRight" style="width: 11%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6358/" data-role="phrase-anchor" data-phrase-id="6358" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6358"></a><a data-anchor="/document/90/18560/dfasshxacs/"></a>31 393</p></td><td class="bdTop bdBottom bdRight" style="width: 9%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6359/" data-role="phrase-anchor" data-phrase-id="6359" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6359"></a><a data-anchor="/document/90/18560/dfascy3m4l/"></a>28 549</p></td><td class="bdLeft" style="width: 3%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6360/" data-role="phrase-anchor" data-phrase-id="6360" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6360"></a><a data-anchor="/document/90/18560/dfasczzkoo/"></a>&#187;;</p></td></tr></tbody></table></div></div></div><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6361/" data-role="phrase-anchor" data-phrase-id="6361" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6361"></a><a data-anchor="/document/90/18560/dfasakpi2i/"></a>б) пункт 16 приложения № 4 дополнить абзацем следующего содержания:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6362/" data-role="phrase-anchor" data-phrase-id="6362" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6362"></a><a data-anchor="/document/90/18560/dfas123vro/"></a>&#171;При установлении ежемесячных надбавок учителям с одинаковым уровнем профессионализма и конкретного вклада в учебный процесс, высокой результативности и качества обучения преимущество имеют учителя русского языка и литературы в классах с нерусским языком обучения в школах, находящихся в сельской местности и поселках городского типа, а также учителя узбекского языка и литературы в классах с неузбекским языком обучения независимо от месторасположения школы&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6363/" data-role="phrase-anchor" data-phrase-id="6363" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6363"></a><a data-anchor="/document/90/18560/dfasqw1rse/"></a>17. В постановлении Кабинета Министров от 6 февраля 2006 года № 15 &#171;О совершенствовании системы платежей за специальное природопользование&#187;:</p><p style="text-align:left"><a data-anchor="/document/90/18560/bssPhr6364/" data-role="phrase-anchor" data-phrase-id="6364" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6364"></a><a data-anchor="/document/90/18560/dfas8wa2ot/"></a>а) текст приложения № 1 изложить в следующей редакции:</p><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6365/" data-role="phrase-anchor" data-phrase-id="6365" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6365"></a><a data-anchor="/document/90/18560/dfaszmvbcv/"></a><strong>&#171;РАЗМЕРЫ<br>компенсационных выплат за выбросы загрязняющих веществ в атмосферный воздух на территории Республики Узбекистан</strong></p><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdAll" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6366/" data-role="phrase-anchor" data-phrase-id="6366" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6366"></a><a data-anchor="/document/90/18560/dfaswe212v/"></a><strong>№ </strong></p></td><td class="bdTop bdBottom bdRight" style="width: 49%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6367/" data-role="phrase-anchor" data-phrase-id="6367" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6367"></a><a data-anchor="/document/90/18560/dfasaip1y7/"></a><strong>Наименование загрязняющих веществ</strong></p></td><td class="bdTop bdBottom bdRight" style="width: 40%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6368/" data-role="phrase-anchor" data-phrase-id="6368" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6368"></a><a data-anchor="/document/90/18560/dfasa4qqu1/"></a><strong>Размеры компенсационных выплат за выброс одной тонны загрязняющих веществ в атмосферный воздух (тыс. сум)</strong></p></td><td class="bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr6369/" data-role="phrase-anchor" data-phrase-id="6369" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6369"></a><a data-anchor="/document/90/18560/dfasgn06un/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6370/" data-role="phrase-anchor" data-phrase-id="6370" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6370"></a><a data-anchor="/document/90/18560/dfasd20fr6/"></a>1.</p></td><td class="bdBottom bdRight" style="width: 49%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6371/" data-role="phrase-anchor" data-phrase-id="6371" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6371"></a><a data-anchor="/document/90/18560/dfasds2955/"></a>Азота двуокись</p></td><td class="bdBottom bdRight" style="width: 40%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6372/" data-role="phrase-anchor" data-phrase-id="6372" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6372"></a><a data-anchor="/document/90/18560/dfasqh7cck/"></a>0,9828</p></td><td class="bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr6373/" data-role="phrase-anchor" data-phrase-id="6373" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6373"></a><a data-anchor="/document/90/18560/dfas2h78no/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6374/" data-role="phrase-anchor" data-phrase-id="6374" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6374"></a><a data-anchor="/document/90/18560/dfasi62y3m/"></a>2.</p></td><td class="bdBottom bdRight" style="width: 49%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6375/" data-role="phrase-anchor" data-phrase-id="6375" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6375"></a><a data-anchor="/document/90/18560/dfasa41qb0/"></a>Азота окись</p></td><td class="bdBottom bdRight" style="width: 40%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6376/" data-role="phrase-anchor" data-phrase-id="6376" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6376"></a><a data-anchor="/document/90/18560/dfas38y3ne/"></a>0,6552</p></td><td class="bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr6377/" data-role="phrase-anchor" data-phrase-id="6377" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6377"></a><a data-anchor="/document/90/18560/dfaso4l36h/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6378/" data-role="phrase-anchor" data-phrase-id="6378" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6378"></a><a data-anchor="/document/90/18560/dfas82vtbd/"></a>3.</p></td><td class="bdBottom bdRight" style="width: 49%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6379/" data-role="phrase-anchor" data-phrase-id="6379" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6379"></a><a data-anchor="/document/90/18560/dfasabhp20/"></a>Акрилонитрил</p></td><td class="bdBottom bdRight" style="width: 40%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6380/" data-role="phrase-anchor" data-phrase-id="6380" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6380"></a><a data-anchor="/document/90/18560/dfasi4vgc9/"></a>1,3104</p></td><td class="bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/18560/bssPhr6381/" data-role="phrase-anchor" data-phrase-id="6381" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6381"></a><a data-anchor="/document/90/18560/dfasycq2xb/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6382/" data-role="phrase-anchor" data-phrase-id="6382" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6382"></a><a data-anchor="/document/90/18560/dfasctb2qd/"></a>4.</p></td><td class="bdBottom bdRight" style="width: 49%; word-wrap: break-word"><p><a data-anchor="/document/90/18560/bssPhr6383/" data-role="phrase-anchor" data-phrase-id="6383" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr6383"></a><a data-anchor="/document/90/18560/dfasdrlgt5/"></a>Акролеин</p></td><td class="bdBottom bdRight" style="width: 40%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/18560/bssPhr6384/" data-role="phrase-anchor" data-phrase-id="6384" data-dwh-source-type-favorites=