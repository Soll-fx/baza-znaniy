                margin-top: -0.92857143em;
            }
            ul li,
            ol li {
                margin: 0 0 0.42857143em;
            }
            dl dd {
                margin: 0 0 0.42857143em;
            }
            ul,
            ol,
            dl {
                margin: 0 0 0.92857143em 2.85714286em;
            }
            .list__item:before,
            .order__item:before {
                display: -moz-inline-stack;
                display: inline-block;
                vertical-align: baseline;
                font: normal 11px / 1.18181818 "PT Serif", Georgia, "Times New Roman", Times, serif;
                letter-spacing: normal;
                min-width: 1.63636364em;
                margin-left: -1.63636364em;
