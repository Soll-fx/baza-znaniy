m" style="text-align:left; vertical-align:top; word-wrap:break-word"><a data-anchor="/document/90/10613/bssPhr3514/" data-role="phrase-anchor" data-phrase-id="3514" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3514"></a><a data-anchor="/document/90/10613/dfasdkkpgz/"></a>&#160;</td><td style="text-align:left; vertical-align:top; word-wrap:break-word"><a data-anchor="/document/90/10613/bssPhr3515/" data-role="phrase-anchor" data-phrase-id="3515" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3515"></a><a data-anchor="/document/90/10613/dfasxv35gp/"></a>&#160;</td><td class="bdTop bdBottom" style="text-align:left; vertical-align:top; word-wrap:break-word"><a data-anchor="/document/90/10613/bssPhr3516/" data-role="phrase-anchor" data-phrase-id="3516" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3516"></a><a data-anchor="/document/90/10613/dfashq91rf/"></a>&#160;</td><td style="width:1.4%; text-align:left; vertical-align:top; word-wrap:break-word"><a data-anchor="/document/90/10613/bssPhr3517/" data-role="phrase-anchor" data-phrase-id="3517" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3517"></a><a data-anchor="/document/90/10613/dfash62pb7/"></a>&#160;</td></tr><tr><td class="bdAll" rowspan="3" style="text-align:left; vertical-align:top; word-wrap:break-word"><p><a kazakh="yes" data-anchor="/document/90/10613/bssPhr3518/" data-role="phrase-anchor" data-phrase-id="3518" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3518"></a><a data-anchor="/document/90/10613/dfaspwh5n1/"></a>10-босқич</p></td><td class="bdBottom bdRight" style="text-align:left; vertical-align:top; word-wrap:break-word"><a data-anchor="/document/90/10613/bssPhr3519/" data-role="phrase-anchor" data-phrase-id="3519" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr3519"></a><a data-anchor="/document/90/10613/dfaspwnuu0/"></a>&#160;</td><td class="