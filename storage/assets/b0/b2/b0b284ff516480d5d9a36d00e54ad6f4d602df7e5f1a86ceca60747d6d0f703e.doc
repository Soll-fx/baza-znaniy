 stroke-miterlimit="10" stroke-width="3"></path><path d="M 481 21 L 672 21 L 671.57 80.9" fill="none" opacity="0.25" stroke="#000000" stroke-miterlimit="10" stroke-width="3" transform="translate(2,3)"></path><path d="M 481 21 L 672 21 L 671.57 80.9" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><path d="M 671.52 87.65 L 667.09 78.61 L 671.57 80.9 L 676.09 78.68 Z" fill="#ff3333" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><path d="M 424 41 L 424 66 L 518 66 L 518 80.9" fill="none" opacity="0.25" stroke="#000000" stroke-miterlimit="10" stroke-width="3" transform="translate(2,3)"></path><path d="M 424 41 L 424 66 L 518 66 L 518 80.9" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><path d="M 518 87.65 L 513.5 78.65 L 518 80.9 L 522.5 78.65 Z" fill="#ff3333" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><path d="M 309 41 L 309 66 L 215 66 L 215 80.9" fill="none" opacity="0.25" stroke="#000000" stroke-miterlimit="10" stroke-width="3" transform="translate(2,3)"></path><path d="M 309 41 L 309 66 L 215 66 L 215 80.9" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><path d="M 215 87.65 L 210.5 78.65 L 215 80.9 L 219.5 78.65 Z" fill="#ff3333" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="3"></path><rect fill="#000000" opacity="0.25" rx="6" ry="6" stroke="#000000" stroke-width="3" style="width: 230px; height: 40px;" transform="translate(2,3)" x="251" y="1"></rect><rect fill="url(#mx-gradient-ff9999-1-ffcccc-1-s-0)" pointer-events="none" rx="6" ry="6" stroke="#ff3333" stroke-width="3" style="width: 230px; height: 40px;" x="251" y="1"></rect><g transform="translate(268.5,8.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 195px; height: 24px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#000000; display:inline-block; font-family:Helvetica; font-size:12px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:nowrap; width:196px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/221448/bssPhr15/"></a><a xmlns="" data-anchor="/document/16/221448/dfas0v8o7x/" data-dfa="dfas0v8o7x" data-cke-saved-name="dfas0v8o7x"></a><strong>Темы конференции</strong></div></div></foreignobject><text fill="#000000" font-family="Helvetica" font-size="12px" text-anchor="middle" x="98" y="18">[Not supported by viewer]</text></switch></g><rect fill="#000000" opacity="0.25" rx="18" ry="18" stroke="#000000" stroke-width="3" style="width: 133px; height: 120px;" transform="translate(2,3)" x="602" y="91"></rect><rect fill="url(#mx-gradient-ff9999-1-ffcccc-1-s-0)" pointer-events="none" rx="18" ry="18" stroke="#ff3333" stroke-width="3" style="width: 133px; height: 120px;" x="602" y="91"></rect><g transform="translate(604.5,99.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 127px; height: 100px;"><div xmlns="http://www.w3.org/1999/xhtml" style='color:#000000; display:inline-block; font-family:&#34;Times New Roman&#34;; font-size:17px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:127px'><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/221448/bssPhr16/"></a><a xmlns="" data-anchor="/document/16/221448/dfas8f0snx/" data-dfa="dfas8f0snx" data-cke-saved-name="dfas8f0snx"></a><a xmlns="" data-anchor="/document/16/221448/dfasgizlmu/" data-dfa="dfasgizlmu" data-cke-saved-name="dfasgizlmu"></a><a xmlns="" data-anchor="/document/16/221448/bssPhr17/"></a><strong>Учет</strong><br xmlns=""><br xmlns=""><a data-cke-saved-href="https://1gb.uz/#/document/16/221448/dfasmcs0vi" href="https://1gb.uz/#/document/16/221448/dfasmcs0vi">Управленческий учет на предприятии</a></div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="17px" text-anchor="middle" x="64" y="59">[Not supported by viewer]</text></switch></g><path d="M 16 131 L 116 131" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="2"></path><path d="M 467.5 131 L 567.5 131" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="2"></path><path d="M 618.5 131 L 718.5 131" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="2"></path><path d="M 315.5 131 L 415.5 131" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="2"></path><path d="M 165 131 L 265 131" fill="none" pointer-events="none" stroke="#ff3333" stroke-miterlimit="10" stroke-width="2"></path></g></svg><a data-anchor="/document/16/221448/tit1/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit1"><a data-anchor="/document/16/221448/bssPhr18/"></a><a data-anchor="/document/16/221448/dfasa08qby/" data-dfa="dfasa08qby"></a>Налоговые изменения 2026 года</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/221448/bssPhr20/"></a><a data-anchor="/document/16/221448/dfasesilwf/" data-dfa="dfasesilwf"></a><a data-anchor="/document/16/221448/dfasgdoo9p/" data-dfa="dfasgdoo9p"></a>Изменения в налоговом законодательстве появляются быстрее, чем бухгалтеры успевают перестроить работу. Достаточно пропустить одну новую норму,&nbsp;и могут возникнуть ошибки в расчете налогов.&nbsp;Сертифицированный налоговый консультант Гульнара Эргашева разобрала последние изменения законодательства и объяснила, как применять новые правила на практике.</p><p data-end="1406" data-start="997"><a data-anchor="/document/16/221448/bssPhr21/"></a><a data-anchor="/document/16/221448/dfasmnibac/" data-dfa="dfasmnibac"></a>Участники узнали, какие изменения необходимо учесть при подготовке отчетности в 2026 году. Отдельное внимание эксперт уделила <span num="8" target="_blank" lnktype="intlnk" title="" class="doc">Указу Президента&nbsp;от 26.05.2026 № УП-100</span>, который изменил порог дохода для перехода на общеустановленный порядок налогообложения и дал возможность&nbsp;добровольно перейти на&nbsp;упрощенный&nbsp;НДС со&nbsp;ставкой&nbsp;6 процентов для отдельных видов бизнеса.</p><p data-end="1626" data-start="1408"><a data-anchor="/document/16/221448/bssPhr22/"></a><a data-anchor="/document/16/221448/dfasxvsm39/" data-dfa="dfasxvsm39"></a><a data-anchor="/document/16/221448/dfasgr1xv7/" data-dfa="dfasgr1xv7"></a>Во время выступления участники получили не только разъяснения законодательства, но и ответы на вопросы, которые возникают в ежедневной работе бухгалтеров. Разбор практических&nbsp;ситуации вызвал&nbsp;наиболее&nbsp;активное обсуждение.&nbsp;Подробные ответы на вопросы участников,&nbsp;рекомендации и разъяснения –&nbsp;в видеозаписи ниже.</p><p><a data-anchor="/document/16/221448/bssPhr23/"></a><a data-anchor="/document/16/221448/dfasmk9pv5/" data-dfa="dfasmk9pv5"></a><strong>Видео-лекция.&nbsp;Какие налоговые изменения учесть в 2026 году</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/SAHNHzxnyQQ?si=iH3Hhk0whzsP1WzT" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr24/"></a><a data-anchor="/document/16/221448/dfasvdx47d/" data-dfa="dfasvdx47d"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/273c0590-e0bf-4d42-948a-e52100dbaa29/index.html" data-itype="presentation" data-moduleId="237" data-id="376" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr25/"></a><a data-anchor="/document/16/221448/dfas1gwtfn/" data-dfa="dfas1gwtfn"></a>Практическая часть выступления завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе.&nbsp;Ответы привели в таблице.</p><div align="left"><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции о налогообложении</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr27/"></a><a data-anchor="/document/16/221448/dfasgtaf7r/" data-dfa="dfasgtaf7r"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr28/"></a><a data-anchor="/document/16/221448/dfas7eobzt/" data-dfa="dfas7eobzt"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr29/"></a><a data-anchor="/document/16/221448/dfasecfvk7/" data-dfa="dfasecfvk7"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr30/"></a><a data-anchor="/document/16/221448/dfasphpsnx/" data-dfa="dfasphpsnx"></a>&nbsp;1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr31/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr32/"></a><a data-anchor="/document/16/221448/dfasw34tg2/" data-dfa="dfasw34tg2"></a><a data-anchor="/document/16/221448/dfasqn0ty6/" data-dfa="dfasqn0ty6"></a>С какого дохода организация обязана перейти на общеустановленный порядок налогообложения</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr33/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr34/"></a><a data-anchor="/document/16/221448/dfasemgk7v/" data-dfa="dfasemgk7v"></a><a data-anchor="/document/16/221448/dfasy0yaf8/" data-dfa="dfasy0yaf8"></a>С 1 июня 2026 года нужно перейти на общеустановленный режим, если доход превысил 12 000 БРВ&nbsp; –&nbsp;это 4 499 000 000 сумов</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr35/"></a><a data-anchor="/document/16/221448/dfasy070vv/" data-dfa="dfasy070vv"></a>&nbsp;2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr36/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr37/"></a><a data-anchor="/document/16/221448/dfaspdqh3l/" data-dfa="dfaspdqh3l"></a><a data-anchor="/document/16/221448/dfas50cgbo/" data-dfa="dfas50cgbo"></a>Кто может добровольно применять упрощенный порядок уплаты НДС по ставке 6 процентов</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr38/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr39/"></a><a data-anchor="/document/16/221448/dfas6xpxeg/" data-dfa="dfas6xpxeg"></a><a data-anchor="/document/16/221448/dfasw06358/" data-dfa="dfasw06358"></a>Право перейти на упрощенный НДС получили организации, основной деятельностью которых является&nbsp;общественное питание,&nbsp;торговля или оказание услуг. Льготный порядок действует с 1 июня 2026 года по 1 января 2030 года</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr40/"></a><a data-anchor="/document/16/221448/dfask168lx/" data-dfa="dfask168lx"></a>&nbsp;3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr41/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr42/"></a><a data-anchor="/document/16/221448/dfasp9tg7w/" data-dfa="dfasp9tg7w"></a><a data-anchor="/document/16/221448/dfasrngicr/" data-dfa="dfasrngicr"></a>На что бухгалтеру обратить внимание при формировании отчетности</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr43/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr44/"></a><a data-anchor="/document/16/221448/dfasqdmnw1/" data-dfa="dfasqdmnw1"></a><a data-anchor="/document/16/221448/dfasfgc556/" data-dfa="dfasfgc556"></a>Проверьте, не изменился ли налоговый режим организации, правильно ли применяется ставка НДС и все изменения 2026 года учли в работе</p></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div><a data-anchor="/document/16/221448/tit2/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit2"><a data-anchor="/document/16/221448/bssPhr45/"></a><a data-anchor="/document/16/221448/dfas8l0chr/" data-dfa="dfas8l0chr"></a>Цифровая трансформация&nbsp;бухгалтерии&nbsp;</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p data-end="648" data-start="321"><a data-anchor="/document/16/221448/bssPhr47/"></a><a data-anchor="/document/16/221448/dfasza5iuh/" data-dfa="dfasza5iuh"></a><a data-anchor="/document/16/221448/dfas59vwp3/" data-dfa="dfas59vwp3"></a>Бухгалтерам ежедневно приходится&nbsp;выполнять десятки однотипных операций: разносить банковские выписки, готовить документы, переключаться между разными сервисами и вручную вводить данные в программу учета. Такая работа отнимает большую часть рабочего дня и увеличивает риск ошибок.&nbsp;На конференции Фахриддин Ахадов показал, как современные цифровые решения помогают автоматизировать эти процессы и освободить время для действительно важных задач.</p><p data-end="1302" data-start="819"><a data-anchor="/document/16/221448/bssPhr48/"></a><a data-anchor="/document/16/221448/dfas5f7lm1/" data-dfa="dfas5f7lm1"></a>Во время выступления участники познакомились с возможностями облачной системы Keeping и увидели, как вести бухучет&nbsp;из любой точки мира, автоматически формировать документы и проводить банковские операции без повторного ввода данных. Отдельное внимание спикер уделил инструментам, которые помогают сократить количество рутинных операций и упростить ежедневную работу бухгалтера.</p><p data-end="1823" data-start="1304"><a data-anchor="/document/16/221448/bssPhr49/"></a><a data-anchor="/document/16/221448/dfask0rwtl/" data-dfa="dfask0rwtl"></a>Эксперт также рассказал о функциях, которые уже сегодня помогают автоматизировать учет: безбумажный документооборот, единое рабочее пространство, автоматическое восстановление учета, управленческий дашборд для руководителя и Telegram-бот для быстрого доступа к документам и уведомлениям. Главная идея выступления – цифровая трансформация начинается не в будущем, а уже сегодня, и современные инструменты позволяют бухгалтеру уделять больше времени анализу, а не рутинным операциям.</p><p data-end="1662" data-start="1387"><a data-anchor="/document/16/221448/bssPhr50/"></a><a data-anchor="/document/16/221448/dfas9xb6ex/" data-dfa="dfas9xb6ex"></a>Подробные ответы на вопросы участников, практические рекомендации и разъяснения экспертов – в видеозаписи ниже.</p><p><a data-anchor="/document/16/221448/bssPhr51/"></a><a data-anchor="/document/16/221448/dfas043yz3/" data-dfa="dfas043yz3"></a><strong>Видео-лекция.&nbsp;Цифровая трансформация бухгалтерии: новые инструменты и возможности</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/s0rbn65L-44?si=0CaT9Hodri2OddXc" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr52/"></a><a data-anchor="/document/16/221448/dfasodueuh/" data-dfa="dfasodueuh"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/38450755-82fa-4af2-aedb-c6c00ba69f9d/index.html" data-itype="presentation" data-moduleId="237" data-id="368" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr53/"></a><a data-anchor="/document/16/221448/dfasuqszg1/" data-dfa="dfasuqszg1"></a>Практическая часть выступления завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе.&nbsp;Ответы привели в таблице.</p><div><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции о цифровых решениях в бухгалтерии</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr55/"></a><a data-anchor="/document/16/221448/dfasdvb0da/" data-dfa="dfasdvb0da"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr56/"></a><a data-anchor="/document/16/221448/dfas52p1r3/" data-dfa="dfas52p1r3"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr57/"></a><a data-anchor="/document/16/221448/dfas3kpe28/" data-dfa="dfas3kpe28"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr58/"></a><a data-anchor="/document/16/221448/dfasygvatk/" data-dfa="dfasygvatk"></a>1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr59/"></a><a data-anchor="/document/16/221448/dfaskrlkrd/" data-dfa="dfaskrlkrd"></a>Можно ли работать в системе вне офиса</td><td><a data-anchor="/document/16/221448/bssPhr60/"></a><a data-anchor="/document/16/221448/dfase5zbwy/" data-dfa="dfase5zbwy"></a>Keeping – облачная платформа, поэтому для работы нужен только браузер и доступ в интернет. Бухгалтер может работать на любом устройстве без установки программы</td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr61/"></a><a data-anchor="/document/16/221448/dfasufreg2/" data-dfa="dfasufreg2"></a>2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr62/"></a><a data-anchor="/document/16/221448/dfaslucq8q/" data-dfa="dfaslucq8q"></a>Как система помогает сократить ежедневную рутину</td><td><a data-anchor="/document/16/221448/bssPhr63/"></a><a data-anchor="/document/16/221448/dfasgdgz2l/" data-dfa="dfasgdgz2l"></a>Keeping автоматически загружает банковские операции, формирует проводки, создает документы по встроенным шаблонам и объединяет основные процессы в одном окне. Это сокращает количество ручных операций и снижает вероятность ошибок</td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr64/"></a><a data-anchor="/document/16/221448/dfasc8dhia/" data-dfa="dfasc8dhia"></a>3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr65/"></a><a data-anchor="/document/16/221448/dfasszd0im/" data-dfa="dfasszd0im"></a>Какие инструменты особенно полезны бухгалтеру в ежедневной работе</td><td><a data-anchor="/document/16/221448/bssPhr66/"></a><a data-anchor="/document/16/221448/dfasuwpe9l/" data-dfa="dfasuwpe9l"></a>Среди возможностей системы – автоматическое восстановление учета, безбумажный документооборот, единый кабинет для нескольких организаций, управленческий дашборд и Telegram-бот для работы с документами и уведомлениями</td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div><a data-anchor="/document/16/221448/tit3/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit3"><a data-anchor="/document/16/221448/bssPhr67/"></a><a data-anchor="/document/16/221448/dfasazxzh2/" data-dfa="dfasazxzh2"></a>Новые правила выплаты пособий с 1 июля 2026 года</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/221448/bssPhr69/"></a><a data-anchor="/document/16/221448/dfaswvug3c/" data-dfa="dfaswvug3c"></a><a data-anchor="/document/16/221448/dfasm51gvl/" data-dfa="dfasm51gvl"></a>В 2026 году нужно применять новые&nbsp;правила&nbsp;назначения и выплаты пособий. Вместе с изменениями появились вопросы: кто и за какие дни оплачивает больничный, как теперь назначают декретные, что делать работодателю и какие ошибки могут задержать выплаты.&nbsp;На конференции эти изменения подробно разобрала главный специалист Управления социальных выплат Национального агентства социальной защиты Дилшодхон Мухамеджанова.</p><p data-end="914" data-start="625"><a data-anchor="/document/16/221448/bssPhr70/"></a><a data-anchor="/document/16/221448/dfasyv9ptg/" data-dfa="dfasyv9ptg"></a>Эксперт объяснила, как теперь работает проактивный механизм назначения пособий по временной нетрудоспособности, а также&nbsp;по беременности и родам, какие действия больше не требуются от работников и работодателей,&nbsp;какие данные нужно проверять в электронном больничном листе.</p><p data-end="1385" data-start="916"><a data-anchor="/document/16/221448/bssPhr71/"></a><a data-anchor="/document/16/221448/dfasohlzqg/" data-dfa="dfasohlzqg"></a>Отдельный блок посвятили новому порядку оплаты больничных. С 1 июля работодатель оплачивает только первые пять календарных дней нетрудоспособности в пределах установленного лимита, а начиная с шестого дня пособие выплачивает Фонд социального страхования. Спикер подробно рассказала, как теперь назначаются и выплачиваются пособия и&nbsp;разобрала практические ситуации. Подробности о <span num="31" target="_blank" lnktype="intlnk" title="" class="doc">новом порядке выплаты больничных</span> смотрите в рекомендации.</p><p data-end="1662" data-start="1387"><a data-anchor="/document/16/221448/bssPhr72/"></a><a data-anchor="/document/16/221448/dfasqp2ual/" data-dfa="dfasqp2ual"></a><a data-anchor="/document/16/221448/dfas2b3fgg/" data-dfa="dfas2b3fgg"></a>Во время выступления участники активно задавали вопросы по переходному периоду, расчету оплачиваемых дней и взаимодействию с информационными системами.&nbsp;Подробные ответы на вопросы участников, практические рекомендации и разъяснения –&nbsp;в видеозаписи ниже.</p><p><a data-anchor="/document/16/221448/bssPhr73/"></a><a data-anchor="/document/16/221448/dfasqg3thx/" data-dfa="dfasqg3thx"></a><strong>Видео-лекция.&nbsp;Новые правила выплаты пособий в 2026 году</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/5LWb5e3U8xU?si=co4_jPDDhGB3I_3s" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr74/"></a><a data-anchor="/document/16/221448/dfasr273vi/" data-dfa="dfasr273vi"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/1e620551-761a-405e-afbb-5953f61e9510/index.html" data-itype="presentation" data-moduleId="237" data-id="375" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr75/"></a><a data-anchor="/document/16/221448/dfasoq5fly/" data-dfa="dfasoq5fly"></a>Практическая часть выступления&nbsp;завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе.&nbsp;Ответы привели в таблице.</p><div align="left"><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции о новых правилах выплаты пособий</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr77/"></a><a data-anchor="/document/16/221448/dfasdghpix/" data-dfa="dfasdghpix"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr78/"></a><a data-anchor="/document/16/221448/dfasld96n7/" data-dfa="dfasld96n7"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr79/"></a><a data-anchor="/document/16/221448/dfaso9xbw2/" data-dfa="dfaso9xbw2"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr80/"></a><a data-anchor="/document/16/221448/dfasg41cd6/" data-dfa="dfasg41cd6"></a>1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr81/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr82/"></a><a data-anchor="/document/16/221448/dfas2v6il1/" data-dfa="dfas2v6il1"></a><a data-anchor="/document/16/221448/dfasde6c9m/" data-dfa="dfasde6c9m"></a>Работник уже болел в этом году пять календарных дней. Нужно ли работодателю снова оплачивать первые пять дней нового больничного</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr83/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr84/"></a><a data-anchor="/document/16/221448/dfasa8n9o5/" data-dfa="dfasa8n9o5"></a><a data-anchor="/document/16/221448/dfaszoxfen/" data-dfa="dfaszoxfen"></a>Нет. Если лимит в пять календарных дней за счет работодателя уже использован в текущем календарном году, повторно оплачивать эти дни не нужно. Дальнейшая выплата производится по новым правилам</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr85/"></a><a data-anchor="/document/16/221448/dfasx2qly9/" data-dfa="dfasx2qly9"></a>2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr86/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr87/"></a><a data-anchor="/document/16/221448/dfasx52g0y/" data-dfa="dfasx52g0y"></a><a data-anchor="/document/16/221448/dfasy7u5tc/" data-dfa="dfasy7u5tc"></a>По какому порядку работодатель рассчитывает пособие за первые пять календарных дней временной нетрудоспособности, оплачиваемых за свой счет</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr88/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr89/"></a><a data-anchor="/document/16/221448/dfasqx8p5h/" data-dfa="dfasqx8p5h"></a><a data-anchor="/document/16/221448/dfasflkbc7/" data-dfa="dfasflkbc7"></a>Работодатель рассчитывает пособие за первые пять календарных дней временной нетрудоспособности по прежним правилам (<span num="13" target="_blank" lnktype="intlnk" title="" class="doc">Положение</span>, утв. постановлением Кабмина от 31.05.2024 № 314)</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr90/"></a><a data-anchor="/document/16/221448/dfas09ahg0/" data-dfa="dfas09ahg0"></a>3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr91/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr92/"></a><a data-anchor="/document/16/221448/dfas4psuqb/" data-dfa="dfas4psuqb"></a><a data-anchor="/document/16/221448/dfask1heft/" data-dfa="dfask1heft"></a>Что бухгалтеру необходимо проверить, чтобы не возникло задержек с выплатой пособия</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr93/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr94/"></a><a data-anchor="/document/16/221448/dfas5qrq61/" data-dfa="dfas5qrq61"></a><a data-anchor="/document/16/221448/dfasedg7iy/" data-dfa="dfasedg7iy"></a>Убедитесь, что сведения о работнике в информационных системах актуальны, а электронный больничный оформлен без ошибок. Некорректные данные могут повлиять на назначение и выплату пособия</p></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div><a data-anchor="/document/16/221448/tit4/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit4"><a data-anchor="/document/16/221448/bssPhr95/"></a><a data-anchor="/document/16/221448/dfasrbnxv6/" data-dfa="dfasrbnxv6"></a>Расчет отпускных в 2026 году без ошибок</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/221448/bssPhr97/"></a><a data-anchor="/document/16/221448/dfasd2ig53/" data-dfa="dfasd2ig53"></a><a data-anchor="/document/16/221448/dfase2g17r/" data-dfa="dfase2g17r"></a>Новый порядок расчета отпускных заставил бухгалтеров заново проверить привычные алгоритмы. Какие дни включать в отпуск, как учитывать праздничные и дополнительные выходные, по какой формуле рассчитывать средний заработок – эти вопросы сегодня вызывают больше всего споров на практике.&nbsp;На конференции редакционный директор «Актион-МЦФЭР» Альфия Газизова пошагово разобрала новые правила расчета отпускных и объяснила, как применять их в ежедневной работе.</p><p data-end="1034" data-start="686"><a data-anchor="/document/16/221448/bssPhr98/"></a><a data-anchor="/document/16/221448/dfasb7adk2/" data-dfa="dfasb7adk2"></a>Эксперт подробно рассказала, как рассчитывать отпускные по новым требованиям законодательства, какие изменения внесло <span num="16" target="_blank" lnktype="intlnk" title="" class="doc">постановление</span> Кабмина от 14.11.2024 № 758 и как определить среднедневной заработок в соответствии со <span num="17" target="_blank" lnktype="intlnk" title="" class="doc">статьей 257</span> ТК. Особое внимание уделили нюансам, которые чаще всего становятся причиной ошибок при начислении выплат.</p><p data-end="1227" data-start="1036"><a data-anchor="/document/16/221448/bssPhr99/"></a><a data-anchor="/document/16/221448/dfaslwhnnc/" data-dfa="dfaslwhnnc"></a><a data-anchor="/document/16/221448/dfassqnxk6/" data-dfa="dfassqnxk6"></a>Теорию подкрепили практическими примерами. На реальных ситуациях участники увидели, как рассчитывать отпускные в нестандартных случаях и что обязательно проверить перед начислением.&nbsp;Подробные ответы на вопросы участников, практические рекомендации и разъяснения –&nbsp;в видеозаписи ниже.</p><p data-end="1227" data-start="1036"><a data-anchor="/document/16/221448/bssPhr100/"></a><a data-anchor="/document/16/221448/dfas5ckczw/" data-dfa="dfas5ckczw"></a><strong>Видео-лекция.&nbsp;Как рассчитывать отпускные в 2026 году</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/poeQv7k4FOI?si=rP8G64xY0iU09aFB" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr101/"></a><a data-anchor="/document/16/221448/dfasbaf4u2/" data-dfa="dfasbaf4u2"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/bca70df2-55f9-40de-b9e4-4d1a5d54a761/index.html" data-itype="presentation" data-moduleId="237" data-id="371" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr102/"></a><a data-anchor="/document/16/221448/dfas0p98ml/" data-dfa="dfas0p98ml"></a>Практическая часть выступления завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе.&nbsp;Ответы привели в таблице.</p><div align="left"><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции о расчете и выплате отпускных</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr104/"></a><a data-anchor="/document/16/221448/dfassv3r8v/" data-dfa="dfassv3r8v"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr105/"></a><a data-anchor="/document/16/221448/dfasdsx9x9/" data-dfa="dfasdsx9x9"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr106/"></a><a data-anchor="/document/16/221448/dfasm05d9f/" data-dfa="dfasm05d9f"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr107/"></a><a data-anchor="/document/16/221448/dfaspfv5lt/" data-dfa="dfaspfv5lt"></a>1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><p><a data-anchor="/document/16/221448/bssPhr108/"></a><a data-anchor="/document/16/221448/dfaszmgr1y/" data-dfa="dfaszmgr1y"></a>Можно ли отозвать работника из отпуска, если он использовал только семь календарных дней из 21</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><p><a data-anchor="/document/16/221448/bssPhr109/"></a><a data-anchor="/document/16/221448/dfasgl6tgk/" data-dfa="dfasgl6tgk"></a>Отозвать из отпуска работника не получится. Работодатель обязан предоставить работнику не менее 14 календарных дней непрерывного отдыха, чтобы общая продолжительность использованного отпуска составила не менее 21 календарного дня</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr110/"></a><a data-anchor="/document/16/221448/dfasqv1sbb/" data-dfa="dfasqv1sbb"></a>2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr111/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr112/"></a><a data-anchor="/document/16/221448/dfas633ff6/" data-dfa="dfas633ff6"></a><a data-anchor="/document/16/221448/dfasconyhd/" data-dfa="dfasconyhd"></a>Нужно ли оплачивать дополнительные выходные дни, перенесенные к праздникам, если они приходятся на период отпуска</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr113/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr114/"></a><a data-anchor="/document/16/221448/dfas1pq0z9/" data-dfa="dfas1pq0z9"></a><a data-anchor="/document/16/221448/dfasen1e4v/" data-dfa="dfasen1e4v"></a>Дополнительные выходные дни включаются в период отпуска и&nbsp;оплачиваются. При расчете отпускных исключаются только воскресные и праздничные дни</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr115/"></a><a data-anchor="/document/16/221448/dfas58kczm/" data-dfa="dfas58kczm"></a>3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr116/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr117/"></a><a data-anchor="/document/16/221448/dfas255tyw/" data-dfa="dfas255tyw"></a><a data-anchor="/document/16/221448/dfasig595k/" data-dfa="dfasig595k"></a>Что чаще всего приводит к ошибкам при расчете отпускных после изменений</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr118/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr119/"></a><a data-anchor="/document/16/221448/dfaswlcs6i/" data-dfa="dfaswlcs6i"></a><a data-anchor="/document/16/221448/dfasf4sn71/" data-dfa="dfasf4sn71"></a>Ошибки чаще всего возникают в&nbsp;количестве&nbsp;дней отпуска и расчете среднего заработка. Перед начислением отпускных важно проверить оба показателя с учетом последних изменений</p></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div><a data-anchor="/document/16/221448/tit5/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit5"><a data-anchor="/document/16/221448/bssPhr120/"></a><a data-anchor="/document/16/221448/dfasyr3wt5/" data-dfa="dfasyr3wt5"></a>Полезные функции 1С для бухгалтера&nbsp;</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/221448/bssPhr122/"></a><a data-anchor="/document/16/221448/dfas9k8sx4/" data-dfa="dfas9k8sx4"></a>После масштабных изменений в налоговом и трудовом законодательстве бухгалтерам пришлось перестраивать не только порядок работы, но и привычные процессы в 1С. Появились новые операции, изменились формы отчетности, вырос риск допустить&nbsp;ошибку.</p><p data-end="757" data-start="545"><a data-anchor="/document/16/221448/bssPhr123/"></a><a data-anchor="/document/16/221448/dfasqxabnd/" data-dfa="dfasqxabnd"></a>На конференции руководитель методологии Venkon Group Людмила Ветрова показала, как последние изменения поменяли работу в&nbsp;программе 1С и какие инструменты помогут автоматизировать ежедневную работу бухгалтера. Участники увидели, как рассчитывать больничные по новым правилам, что нового в формах по&nbsp;НДФЛ и социальному&nbsp;налогу, как учитывать сверхурочную работу, в чем заключаются новые механизмы учета отсрочки НДС и т. д.</p><p data-end="1364" data-start="1150"><a data-anchor="/document/16/221448/bssPhr124/"></a><a data-anchor="/document/16/221448/dfas9yhglk/" data-dfa="dfas9yhglk"></a><a data-anchor="/document/16/221448/dfasvo1n63/" data-dfa="dfasvo1n63"></a>Особое внимание спикер уделила практическим возможностям программы. Вместо ручной проверки расчетов бухгалтеры получили готовые решения, которые помогают быстрее выполнять повседневные задачи и снизить риск ошибок.&nbsp;Подробные ответы на вопросы участников, практические рекомендации и разъяснения –&nbsp;в видеозаписи ниже.</p><p><a data-anchor="/document/16/221448/bssPhr125/"></a><a data-anchor="/document/16/221448/dfasvw8g20/" data-dfa="dfasvw8g20"></a><strong>Видео-лекция.&nbsp;Новые возможности 1С для бухгалтера в 2026 году</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/Tm4XwVYPPiU?si=4kv6pBIr-8yJPpLi" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr126/"></a><a data-anchor="/document/16/221448/dfas3nelqs/" data-dfa="dfas3nelqs"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/086fe2e2-cb59-4cf4-a747-27eaf514001f/index.html" data-itype="presentation" data-moduleId="237" data-id="369" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr127/"></a><a data-anchor="/document/16/221448/dfas4r4k52/" data-dfa="dfas4r4k52"></a>Практическая часть конференции завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе. Ответы привели в таблице.</p><div align="left"><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции об учете в 1С</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr129/"></a><a data-anchor="/document/16/221448/dfasn28aqg/" data-dfa="dfasn28aqg"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr130/"></a><a data-anchor="/document/16/221448/dfasrlwtmw/" data-dfa="dfasrlwtmw"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr131/"></a><a data-anchor="/document/16/221448/dfas23wnk3/" data-dfa="dfas23wnk3"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr132/"></a><a data-anchor="/document/16/221448/dfasgazzlz/" data-dfa="dfasgazzlz"></a>1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr133/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr134/"></a><a data-anchor="/document/16/221448/dfasd2pe4i/" data-dfa="dfasd2pe4i"></a><a data-anchor="/document/16/221448/dfassd0lo4/" data-dfa="dfassd0lo4"></a>Какие изменения в 1С появились после последних изменений законодательства</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr135/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr136/"></a><a data-anchor="/document/16/221448/dfas9h18ro/" data-dfa="dfas9h18ro"></a><a data-anchor="/document/16/221448/dfas0l8od0/" data-dfa="dfas0l8od0"></a>В программу добавили новые механизмы расчета больничных, обновленные формы расчета НДФЛ и социального налога, учет сверхурочных часов, а также новые инструменты для работы с НДС и налогом с оборота</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr137/"></a><a data-anchor="/document/16/221448/dfas41ycgq/" data-dfa="dfas41ycgq"></a>2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr138/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr139/"></a><a data-anchor="/document/16/221448/dfas2iiz6x/" data-dfa="dfas2iiz6x"></a><a data-anchor="/document/16/221448/dfas5prsqi/" data-dfa="dfas5prsqi"></a>Нужно ли вручную настраивать новые механизмы расчета</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr140/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr141/"></a><a data-anchor="/document/16/221448/dfask6o6e5/" data-dfa="dfask6o6e5"></a><a data-anchor="/document/16/221448/dfasnb477m/" data-dfa="dfasnb477m"></a>Это зависит от используемой версии программы. Перед началом работы рекомендуется установить последние обновления и проверить настройки информационной базы</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr142/"></a><a data-anchor="/document/16/221448/dfasg1r3nn/" data-dfa="dfasg1r3nn"></a>3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><a data-anchor="/document/16/221448/bssPhr143/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr144/"></a><a data-anchor="/document/16/221448/dfashth47p/" data-dfa="dfashth47p"></a><a data-anchor="/document/16/221448/dfaserke7p/" data-dfa="dfaserke7p"></a>Какие возможности 1С помогут бухгалтеру сэкономить больше всего времени</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><a data-anchor="/document/16/221448/bssPhr145/"></a>&nbsp;<p><a data-anchor="/document/16/221448/bssPhr146/"></a><a data-anchor="/document/16/221448/dfasr2ddb5/" data-dfa="dfasr2ddb5"></a><a data-anchor="/document/16/221448/dfasv8zedm/" data-dfa="dfasv8zedm"></a>Автоматический расчет больничных по новым правилам, обновленные налоговые расчеты и новые механизмы учета позволяют сократить количество ручных операций и снизить вероятность ошибок при подготовке отчетности</p></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div><a data-anchor="/document/16/221448/tit6/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit6"><a data-anchor="/document/16/221448/bssPhr147/"></a><a data-anchor="/document/16/221448/dfasmcs0vi/" data-dfa="dfasmcs0vi"></a>Управленческий учет и внутренний контроль</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/221448/bssPhr149/"></a><a data-anchor="/document/16/221448/dfas1sshs3/" data-dfa="dfas1sshs3"></a><a data-anchor="/document/16/221448/dfascm4ygn/" data-dfa="dfascm4ygn"></a>Бухгалтерская отчетность показывает прибыль, но собственник все равно спрашивает, почему денег на счетах не хватает. Ответить на этот вопрос с помощью одного бухгалтерского учета невозможно. Для этого нужны инструменты управленческого учета и внутреннего контроля.&nbsp;Именно этой теме посвятила свое выступление основатель и директор консалтинговой компании BALANS PLUS Ольга Игамратова.</p><p data-end="1112" data-start="701"><a data-anchor="/document/16/221448/bssPhr150/"></a><a data-anchor="/document/16/221448/dfasq8n1v5/" data-dfa="dfasq8n1v5"></a>Эксперт объяснила, чем управленческий учет отличается от бухгалтерского, и почему сегодня бухгалтеру важно не только правильно отражать операции, но и понимать, что происходит с финансами компании. На практических примерах она показала, почему рост выручки не всегда приводит к увеличению средств, из-за чего прибыльная компания может испытывать кассовые разрывы и как вовремя выявлять финансовые риски.</p><p data-end="1397" data-start="1114"><a data-anchor="/document/16/221448/bssPhr151/"></a><a data-anchor="/document/16/221448/dfasgu28t6/" data-dfa="dfasgu28t6"></a><a data-anchor="/document/16/221448/dfas1td6la/" data-dfa="dfas1td6la"></a>Особый интерес у участников вызвали реальные кейсы из практики спикера. На конференции разобрали, как анализ финансовых показателей помогает руководителю принимать обоснованные управленческие решения, а бухгалтеру – стать не просто исполнителем, а надежным финансовым партнером бизнеса.&nbsp;Еще больше полезной информации для финансистов вы найдете в системе&nbsp;<a href="https://1fd.uz/" target="_blank" title="">1fd.uz</a>.&nbsp;Подробные ответы на вопросы участников, практические рекомендации и разъяснения экспертов – в видеозаписи ниже.</p><p><a data-anchor="/document/16/221448/bssPhr152/"></a><a data-anchor="/document/16/221448/dfasre5mi0/" data-dfa="dfasre5mi0"></a><strong>Видео-лекция.&nbsp;Почему прибыли недостаточно для оценки бизнеса</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/Yv4FTpdcSuY?si=1rXU_wXAMz4x2fQ-" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/221448/bssPhr153/"></a><a data-anchor="/document/16/221448/dfasb2dn7s/" data-dfa="dfasb2dn7s"></a><strong>Презентация, которая поможет внедрить изменения в работу</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/4af5589e-e0a3-4853-b937-3eed11da383c/index.html" data-itype="presentation" data-moduleId="237" data-id="374" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/221448/bssPhr154/"></a><a data-anchor="/document/16/221448/dfas320a7f/" data-dfa="dfas320a7f"></a>Практическая часть конференции завершилась разбором вопросов, с которыми бухгалтеры регулярно сталкиваются в своей работе. Ответы привели в таблице.</p><div><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption>Ответы на вопросы участников конференции об управленческом учете</caption><tbody><tr><td style="vertical-align: middle; width: 5.43%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr156/"></a><a data-anchor="/document/16/221448/dfascwa74s/" data-dfa="dfascwa74s"></a><strong>№</strong></td><td style="vertical-align: middle; width: 43.6%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr157/"></a><a data-anchor="/document/16/221448/dfastsgpul/" data-dfa="dfastsgpul"></a><strong>Вопросы</strong></td><td style="vertical-align: middle; width: 50.83%; text-align: left;"><a data-anchor="/document/16/221448/bssPhr158/"></a><a data-anchor="/document/16/221448/dfasytku1t/" data-dfa="dfasytku1t"></a><strong>Ответы</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr159/"></a><a data-anchor="/document/16/221448/dfashh0wch/" data-dfa="dfashh0wch"></a>1</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><p><a data-anchor="/document/16/221448/bssPhr160/"></a><a data-anchor="/document/16/221448/dfaspqzqoe/" data-dfa="dfaspqzqoe"></a>Почему компания показывает прибыль, но при этом испытывает нехватку денежных средств</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><p><a data-anchor="/document/16/221448/bssPhr161/"></a><a data-anchor="/document/16/221448/dfasnerx15/" data-dfa="dfasnerx15"></a>Прибыль и денежный поток – разные показатели. Компания может быть прибыльной по данным учета, но испытывать дефицит денежных средств из-за дебиторской задолженности, инвестиций, кредитной нагрузки или других обязательств</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr162/"></a><a data-anchor="/document/16/221448/dfasmkzs0r/" data-dfa="dfasmkzs0r"></a>2</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><p><a data-anchor="/document/16/221448/bssPhr163/"></a><a data-anchor="/document/16/221448/dfas3491om/" data-dfa="dfas3491om"></a>Чем управленческий учет отличается от бухгалтерского</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><p><a data-anchor="/document/16/221448/bssPhr164/"></a><a data-anchor="/document/16/221448/dfas2ad1k2/" data-dfa="dfas2ad1k2"></a>Бухгалтерский учет отражает хозяйственные операции и помогает выполнять требования законодательства. Управленческий учет помогает анализировать результаты деятельности компании, выявлять риски и принимать управленческие решения</p></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 5.43%;"><a data-anchor="/document/16/221448/bssPhr165/"></a><a data-anchor="/document/16/221448/dfask5h5br/" data-dfa="dfask5h5br"></a>3</td><td style="text-align: left; vertical-align: middle; width: 43.6%;"><p><a data-anchor="/document/16/221448/bssPhr166/"></a><a data-anchor="/document/16/221448/dfassbfx43/" data-dfa="dfassbfx43"></a>Какие вопросы помогает решить управленческий учет</p></td><td style="text-align: left; vertical-align: middle; width: 50.83%;"><p><a data-anchor="/document/16/221448/bssPhr167/"></a><a data-anchor="/document/16/221448/dfashsac1z/" data-dfa="dfashsac1z"></a>Управленческий учет позволяет понять, почему компании не хватает денег, какие направления бизнеса приносят прибыль, где возникают потери и какие решения помогут повысить эффективность работы бизнеса</p></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div></div></div></div><div xmlns="" class="footer">© Материал из ЭС "ACTION: Главбух"<br />https://1gb.uz<br />Дата копирования: 29.09.2026</div></body></html>