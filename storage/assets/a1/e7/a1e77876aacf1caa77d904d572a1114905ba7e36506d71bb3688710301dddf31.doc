rase-anchor" data-phrase-id="11599" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11599"></a><a data-anchor="/document/90/18678/dfashl0ayl/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11600/" data-role="phrase-anchor" data-phrase-id="11600" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11600"></a><a data-anchor="/document/90/18678/dfasg09o6x/"></a>других населенных пунктах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11601/" data-role="phrase-anchor" data-phrase-id="11601" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11601"></a><a data-anchor="/document/90/18678/dfasfx31sa/"></a>6</p></td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11602/" data-role="phrase-anchor" data-phrase-id="11602" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11602"></a><a data-anchor="/document/90/18678/dfassblsmf/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11603/" data-role="phrase-anchor" data-phrase-id="11603" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11603"></a><a data-anchor="/document/90/18678/dfasblcuqd/"></a>труднодоступных и горных районах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11604/" data-role="phrase-anchor" data-phrase-id="11604" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11604"></a><a data-anchor="/document/90/18678/dfass8g8mx/"></a>4</p></td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11605/" data-role="phrase-anchor" data-phrase-id="11605" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11605"></a><a data-anchor="/document/90/18678/dfasagz0dm/"></a>8.</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11606/" data-role="phrase-anchor" data-phrase-id="11606" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11606"></a><a data-anchor="/document/90/18678/dfasnpzb3f/"></a>из них</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11607/" data-role="phrase-anchor" data-phrase-id="11607" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11607"></a><a data-anchor="/document/90/18678/dfaskctt1y/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11608/" data-role="phrase-anchor" data-phrase-id="11608" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11608"></a><a data-anchor="/document/90/18678/dfasyrfb8h/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11609/" data-role="phrase-anchor" data-phrase-id="11609" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11609"></a><a data-anchor="/document/90/18678/dfasivskbd/"></a>специализированные предприятия общественного питания, обслуживающие общеобразовательные школы, школы-интернаты, средние специальные, профессиональные и высшие учебные заведения</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11610/" data-role="phrase-anchor" data-phrase-id="11610" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11610"></a><a data-anchor="/document/90/18678/dfasoq4b6z/"></a>75 % от установленной ставки в зависимости от места расположения</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11611/" data-role="phrase-anchor" data-phrase-id="11611" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11611"></a><a data-anchor="/document/90/18678/dfasgrpszp/"></a>9.</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11612/" data-role="phrase-anchor" data-phrase-id="11612" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11612"></a><a data-anchor="/document/90/18678/dfas7mgo8w/"></a>Налогоплательщики в сфере розничной торговли</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11613/" data-role="phrase-anchor" data-phrase-id="11613" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11613"></a><a data-anchor="/document/90/18678/dfaspkf9p4/"></a>&#160;</td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11614/" data-role="phrase-anchor" data-phrase-id="11614" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11614"></a><a data-anchor="/document/90/18678/dfasg0d594/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11615/" data-role="phrase-anchor" data-phrase-id="11615" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11615"></a><a data-anchor="/document/90/18678/dfasgpkmb0/"></a>в зависимости от места расположения:</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11616/" data-role="phrase-anchor" data-phrase-id="11616" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11616"></a><a data-anchor="/document/90/18678/dfasyngf5i/"></a>&#160;</td></tr><tr><td class="bdRight bdLeft" rowspan="2" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11617/" data-role="phrase-anchor" data-phrase-id="11617" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11617"></a><a data-anchor="/document/90/18678/dfasg29rvu/"></a>9.1</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11618/" data-role="phrase-anchor" data-phrase-id="11618" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11618"></a><a data-anchor="/document/90/18678/dfasi647kt/"></a>городах с численностью населения 100 тысяч и более человек</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11619/" data-role="phrase-anchor" data-phrase-id="11619" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11619"></a><a data-anchor="/document/90/18678/dfasms2alp/"></a>4</p></td></tr><tr allowpartbreak="false"><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11620/" data-role="phrase-anchor" data-phrase-id="11620" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11620"></a><a data-anchor="/document/90/18678/dfas1gqeaf/"></a>других населенных пунктах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11621/" data-role="phrase-anchor" data-phrase-id="11621" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11621"></a><a data-anchor="/document/90/18678/dfasfquum4/"></a>2</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11622/" data-role="phrase-anchor" data-phrase-id="11622" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11622"></a><a data-anchor="/document/90/18678/dfasgc99lg/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11623/" data-role="phrase-anchor" data-phrase-id="11623" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11623"></a><a data-anchor="/document/90/18678/dfass1r3me/"></a>труднодоступных и горных районах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11624/" data-role="phrase-anchor" data-phrase-id="11624" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11624"></a><a data-anchor="/document/90/18678/dfasxuan6w/"></a>1</p></td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11625/" data-role="phrase-anchor" data-phrase-id="11625" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11625"></a><a data-anchor="/document/90/18678/dfas31r9wl/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11626/" data-role="phrase-anchor" data-phrase-id="11626" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11626"></a><a data-anchor="/document/90/18678/dfaslkg7s6/"></a>независимо от места расположения:</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11627/" data-role="phrase-anchor" data-phrase-id="11627" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11627"></a><a data-anchor="/document/90/18678/dfastpsb0h/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11628/" data-role="phrase-anchor" data-phrase-id="11628" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11628"></a><a data-anchor="/document/90/18678/dfashm5nb5/"></a>9.2</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11629/" data-role="phrase-anchor" data-phrase-id="11629" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11629"></a><a data-anchor="/document/90/18678/dfasghbhev/"></a>по товарообороту от реализации алкогольной продукции, табачной продукции, бензина, дизельного топлива, сжиженного и сжатого газа</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11630/" data-role="phrase-anchor" data-phrase-id="11630" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11630"></a><a data-anchor="/document/90/18678/dfas07e13x/"></a>4</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11631/" data-role="phrase-anchor" data-phrase-id="11631" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11631"></a><a data-anchor="/document/90/18678/dfas8dsit1/"></a>10.</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11632/" data-role="phrase-anchor" data-phrase-id="11632" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11632"></a><a data-anchor="/document/90/18678/dfas719z27/"></a>Предприятия торговли, осуществляющие оптовую, а также оптово-розничную торговлю (за исключением указанных в пункте 11)</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11633/" data-role="phrase-anchor" data-phrase-id="11633" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11633"></a><a data-anchor="/document/90/18678/dfasemy9o7/"></a>4</p></td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11634/" data-role="phrase-anchor" data-phrase-id="11634" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11634"></a><a data-anchor="/document/90/18678/dfaseegzku/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11635/" data-role="phrase-anchor" data-phrase-id="11635" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11635"></a><a data-anchor="/document/90/18678/dfasw19dsn/"></a>Оптовые и розничные аптечные организации, расположенные в:</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11636/" data-role="phrase-anchor" data-phrase-id="11636" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11636"></a><a data-anchor="/document/90/18678/dfask6u4py/"></a>&#160;</td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11637/" data-role="phrase-anchor" data-phrase-id="11637" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11637"></a><a data-anchor="/document/90/18678/dfas9rsgw9/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11638/" data-role="phrase-anchor" data-phrase-id="11638" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11638"></a><a data-anchor="/document/90/18678/dfaspdh0hf/"></a>городах с численностью населения 100 тысяч и более человек</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11639/" data-role="phrase-anchor" data-phrase-id="11639" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11639"></a><a data-anchor="/document/90/18678/dfasx59q2p/"></a>3</p></td></tr><tr><td class="bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11640/" data-role="phrase-anchor" data-phrase-id="11640" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11640"></a><a data-anchor="/document/90/18678/dfas6yga2b/"></a>11.</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11641/" data-role="phrase-anchor" data-phrase-id="11641" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11641"></a><a data-anchor="/document/90/18678/dfask9cnc0/"></a>других населенных пунктах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11642/" data-role="phrase-anchor" data-phrase-id="11642" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11642"></a><a data-anchor="/document/90/18678/dfasu1gu29/"></a>2</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11643/" data-role="phrase-anchor" data-phrase-id="11643" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11643"></a><a data-anchor="/document/90/18678/dfasgsh74m/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11644/" data-role="phrase-anchor" data-phrase-id="11644" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11644"></a><a data-anchor="/document/90/18678/dfas9r8nw9/"></a>труднодоступных и горных районах</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11645/" data-role="phrase-anchor" data-phrase-id="11645" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11645"></a><a data-anchor="/document/90/18678/dfassax26r/"></a>1</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11646/" data-role="phrase-anchor" data-phrase-id="11646" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11646"></a><a data-anchor="/document/90/18678/dfasumszdm/"></a>12.</p></td><td class="bdBottom bdRight" style="width: 75%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11647/" data-role="phrase-anchor" data-phrase-id="11647" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11647"></a><a data-anchor="/document/90/18678/dfasgs406x/"></a>Заготовительные организации, осуществляющие закуп, сортировку, хранение и фасовку сельскохозяйственной продукции</p></td><td class="bdBottom bdRight" style="width: 19%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11648/" data-role="phrase-anchor" data-phrase-id="11648" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11648"></a><a data-anchor="/document/90/18678/dfas9glhzv/"></a>4 % от товарооборота или 25 % от валового дохода</p></td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11649/" data-role="phrase-anchor" data-phrase-id="11649" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11649"></a><a data-anchor="/document/90/18678/dfas2wiuhy/"></a>* Для юридических лиц, предоставляющих имущество в финансовую аренду (лизинг), &#8212; сумма процентного дохода по финансовой аренде (лизингу).</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11650/" data-role="phrase-anchor" data-phrase-id="11650" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11650"></a><a data-anchor="/document/90/18678/dfasmfkrsv/"></a>** Сумма вознаграждения (валовый доход).</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11651/" data-role="phrase-anchor" data-phrase-id="11651" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11651"></a><a data-anchor="/document/90/18678/dfas6b21cl/"></a>Примечания:</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11652/" data-role="phrase-anchor" data-phrase-id="11652" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11652"></a><a data-anchor="/document/90/18678/dfasyza87f/"></a>Если налогоплательщик в сфере розничной торговли имеет несколько торговых точек, не являющихся самостоятельными юридическими лицами и расположенных в разных населенных пунктах, по которым установлены различные ставки единого налогового платежа, то они должны вести раздельный учет товарооборота по каждой торговой точке и уплачивать единый налоговый платеж по ставкам, установленным для этих населенных пунктов.</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11653/" data-role="phrase-anchor" data-phrase-id="11653" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11653"></a><a data-anchor="/document/90/18678/dfasurgggd/"></a>Поступления от единого налогового платежа распределяются в следующих размерах:</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11654/" data-role="phrase-anchor" data-phrase-id="11654" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11654"></a><a data-anchor="/document/90/18678/dfaspek6xg/"></a>в Государственный бюджет Республики Узбекистан &#8212; 46%;</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11655/" data-role="phrase-anchor" data-phrase-id="11655" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11655"></a><a data-anchor="/document/90/18678/dfasdkp4t3/"></a>в Пенсионный фонд &#8212; 46%;</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11656/" data-role="phrase-anchor" data-phrase-id="11656" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11656"></a><a data-anchor="/document/90/18678/dfas5u41g4/"></a>в Фонд развития Союза молодежи Узбекистана &#8212; 4%;</p><p style="text-align:left"><a data-anchor="/document/90/18678/bssPhr11657/" data-role="phrase-anchor" data-phrase-id="11657" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11657"></a><a data-anchor="/document/90/18678/dfasak3y9a/"></a>в Совет Федерации профсоюзов Узбекистана &#8212; 4%.</p><p style="text-align:right"><a data-anchor="/document/90/18678/bssPhr11658/" data-role="phrase-anchor" data-phrase-id="11658" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11658"></a><a data-role="toc" data-anchor="/document/90/18678/tit8/"></a><a data-anchor="/document/90/18678/dfasn0bhuq/"></a>ПРИЛОЖЕНИЕ № 8<br>к постановлению Президента Республики<br>Узбекистан от 26 декабря 2018 года № ПП-4086</p><div class="doc__untyped" data-type="untyped" data-level="1"><a data-role="toc" data-anchor="/document/90/18678/tit41/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/18678/bssPhr11659/" data-role="phrase-anchor" data-phrase-id="11659" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11659"></a><a data-anchor="/document/90/18678/dfasygt0d3/"></a>Ставки&#160;<br>единого социального платежа</span></div><div><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdAll" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11660/" data-role="phrase-anchor" data-phrase-id="11660" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11660"></a><a data-anchor="/document/90/18678/dfas49gad8/"></a><strong>№</strong></p></td><td class="bdTop bdBottom bdRight" style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11661/" data-role="phrase-anchor" data-phrase-id="11661" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11661"></a><a data-anchor="/document/90/18678/dfasc0xf03/"></a><strong>Плательщики</strong></p></td><td class="bdTop bdBottom bdRight" style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11662/" data-role="phrase-anchor" data-phrase-id="11662" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11662"></a><a data-anchor="/document/90/18678/dfasrke43w/"></a><strong>Ставки налога в %<br>к налогооблагаемой базе</strong></p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11663/" data-role="phrase-anchor" data-phrase-id="11663" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11663"></a><a data-anchor="/document/90/18678/dfasrxnthp/"></a>1.</p></td><td class="bdBottom bdRight" style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11664/" data-role="phrase-anchor" data-phrase-id="11664" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11664"></a><a data-anchor="/document/90/18678/dfaspmm3m8/"></a>Бюджетные организации и государственные предприятия, юридические лица с долей государства в уставном фонде (капитале) в размере 50 процентов и более, юридические лица, в уставном фонде (капитале) которых 50 процентов и более принадлежит юридическому лицу с долей государства 50 процентов и более, и их структурные подразделения</p></td><td class="bdBottom bdRight" style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11665/" data-role="phrase-anchor" data-phrase-id="11665" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11665"></a><a data-anchor="/document/90/18678/dfasgzp26r/"></a>25</p></td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11666/" data-role="phrase-anchor" data-phrase-id="11666" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11666"></a><a data-anchor="/document/90/18678/dfas3asotz/"></a>2.</p></td><td class="bdBottom bdRight" style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11667/" data-role="phrase-anchor" data-phrase-id="11667" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11667"></a><a data-anchor="/document/90/18678/dfaskg6gfk/"></a>Другие плательщики, не предусмотренные в пункте 1 (за исключением отдельных категорий налогоплательщиков, для которых в соответствии с законодательством установлены пониженные ставки единого социального платежа)</p></td><td class="bdBottom bdRight" style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11668/" data-role="phrase-anchor" data-phrase-id="11668" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11668"></a><a data-anchor="/document/90/18678/dfasx8d1rr/"></a>12</p></td></tr><tr><td class="bdTop" style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11669/" data-role="phrase-anchor" data-phrase-id="11669" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11669"></a><a data-anchor="/document/90/18678/dfas9szrvb/"></a>&#160;</td><td class="bdTop" style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11670/" data-role="phrase-anchor" data-phrase-id="11670" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11670"></a><a data-anchor="/document/90/18678/dfasz508ig/"></a>&#160;</td><td class="bdTop" style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11671/" data-role="phrase-anchor" data-phrase-id="11671" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11671"></a><a data-anchor="/document/90/18678/dfas3y21np/"></a>&#160;</td></tr><tr><td colspan="3" style="width: 100%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11672/" data-role="phrase-anchor" data-phrase-id="11672" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11672"></a><a data-anchor="/document/90/18678/dfasua5qsd/"></a>Сумма единого социального платежа распределяется между государственными целевыми фондами и Советом Федерации профсоюзов Узбекистана в соответствии с установленным порядком в следующих размерах:</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11673/" data-role="phrase-anchor" data-phrase-id="11673" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11673"></a><a data-anchor="/document/90/18678/dfasp3satn/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11674/" data-role="phrase-anchor" data-phrase-id="11674" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11674"></a><a data-anchor="/document/90/18678/dfasqhn17o/"></a>по бюджетным организациям и государственным предприятиям, юридическим лицам с долей государства в уставном фонде (капитале) в размере 50 процентов и более, юридическим лицам, в уставном фонде (капитале) которых 50 процентов и более принадлежит юридическому лицу с долей государства 50 процентов и более, и их структурным подразделениям:</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11675/" data-role="phrase-anchor" data-phrase-id="11675" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11675"></a><a data-anchor="/document/90/18678/dfasvynau4/"></a>100 %</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11676/" data-role="phrase-anchor" data-phrase-id="11676" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11676"></a><a data-anchor="/document/90/18678/dfasau1cr3/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11677/" data-role="phrase-anchor" data-phrase-id="11677" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11677"></a><a data-anchor="/document/90/18678/dfassgtp0e/"></a>во внебюджетный Пенсионный фонд</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11678/" data-role="phrase-anchor" data-phrase-id="11678" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11678"></a><a data-anchor="/document/90/18678/dfasfunu9e/"></a>99,2%</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11679/" data-role="phrase-anchor" data-phrase-id="11679" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11679"></a><a data-anchor="/document/90/18678/dfasgp9gt9/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11680/" data-role="phrase-anchor" data-phrase-id="11680" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11680"></a><a data-anchor="/document/90/18678/dfase2ogwi/"></a>в Государственный фонд содействия занятости</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11681/" data-role="phrase-anchor" data-phrase-id="11681" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11681"></a><a data-anchor="/document/90/18678/dfastih4aw/"></a>0,4%</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11682/" data-role="phrase-anchor" data-phrase-id="11682" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11682"></a><a data-anchor="/document/90/18678/dfaspzw33g/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11683/" data-role="phrase-anchor" data-phrase-id="11683" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11683"></a><a data-anchor="/document/90/18678/dfas3b1zv9/"></a>в Совет Федерации профсоюзов Узбекистана</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11684/" data-role="phrase-anchor" data-phrase-id="11684" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11684"></a><a data-anchor="/document/90/18678/dfas35m90m/"></a>0,4%</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11685/" data-role="phrase-anchor" data-phrase-id="11685" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11685"></a><a data-anchor="/document/90/18678/dfaskorkvv/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11686/" data-role="phrase-anchor" data-phrase-id="11686" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11686"></a><a data-anchor="/document/90/18678/dfasmk3qt4/"></a>по другим плательщикам:</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11687/" data-role="phrase-anchor" data-phrase-id="11687" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11687"></a><a data-anchor="/document/90/18678/dfasyhod10/"></a>100%</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11688/" data-role="phrase-anchor" data-phrase-id="11688" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11688"></a><a data-anchor="/document/90/18678/dfasb43400/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11689/" data-role="phrase-anchor" data-phrase-id="11689" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11689"></a><a data-anchor="/document/90/18678/dfas0gfmlt/"></a>во внебюджетный Пенсионный фонд</p></td><td style="width: 22%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11690/" data-role="phrase-anchor" data-phrase-id="11690" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11690"></a><a data-anchor="/document/90/18678/dfasgw1fqx/"></a>98,4%</p></td></tr><tr><td style="width: 4%; text-align: left; vertical-align: top; word-wrap: break-word"><a data-anchor="/document/90/18678/bssPhr11691/" data-role="phrase-anchor" data-phrase-id="11691" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11691"></a><a data-anchor="/document/90/18678/dfasv1q9bt/"></a>&#160;</td><td style="width: 73%; text-align: left; vertical-align: top; word-wrap: break-word"><p><a data-anchor="/document/90/18678/bssPhr11692/" data-role="phrase-anchor" data-phrase-id="11692" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr11692"></a><a data-anchor="/document/90/18678/dfas06o1r3/"></a>в Государственный фонд содействия занятости</p></td><td style="width