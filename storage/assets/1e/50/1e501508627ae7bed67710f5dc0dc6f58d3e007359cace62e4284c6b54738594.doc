3/dfas3zo6mx/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr220/" data-role="phrase-anchor" data-phrase-id="220" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr220"></a><a data-anchor="/document/90/20923/dfaseemfry/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr221/" data-role="phrase-anchor" data-phrase-id="221" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr221"></a><a data-anchor="/document/90/20923/dfaswduov6/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr222/" data-role="phrase-anchor" data-phrase-id="222" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr222"></a><a data-anchor="/document/90/20923/dfaswgodfv/"></a>&#8206;</p></td></tr><tr><td colspan="20"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr223/" data-role="phrase-anchor" data-phrase-id="223" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr223"></a><a data-anchor="/document/90/20923/dfaskfxgz0/"></a>&#8206;&#8206;савдо шохобчасида фойдаланиш учун, ____________________________________________________ русумли,<br>&#8206; завод рақами (версияси)________________________________________________бўлган онлайн-НКМ (виртуал<br>&#8206; касса) ва __________________________________________________________серия рақамли фискал модулни,<br>&#8206; _____________________________________________________давлат солиқ инспекциясида рўйхатга қўйишда<br>&#8206;амалий ёрдам беришингизни сўрайман.</p></td></tr><tr><td><p><a data-anchor="/document/90/20923/bssPhr224/" data-role="phrase-anchor" data-phrase-id="224" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr224"></a><a data-anchor="/document/90/20923/dfas1f7hek/"></a>&#8206;</p></td><td colspan="10"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr225/" data-role="phrase-anchor" data-phrase-id="225" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr225"></a><a data-anchor="/document/90/20923/dfaswfxds0/"></a>&#8206;&#8206;Қуйидаги ҳужжатлар илова қилинади:&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr226/" data-role="phrase-anchor" data-phrase-id="226" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr226"></a><a data-anchor="/document/90/20923/dfastary8z/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr227/" data-role="phrase-anchor" data-phrase-id="227" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr227"></a><a data-anchor="/document/90/20923/dfas6osgcl/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr228/" data-role="phrase-anchor" data-phrase-id="228" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr228"></a><a data-anchor="/document/90/20923/dfasn1nedc/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr229/" data-role="phrase-anchor" data-phrase-id="229" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr229"></a><a data-anchor="/document/90/20923/dfass5bmi1/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr230/" data-role="phrase-anchor" data-phrase-id="230" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr230"></a><a data-anchor="/document/90/20923/dfas33gszr/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr231/" data-role="phrase-anchor" data-phrase-id="231" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr231"></a><a data-anchor="/document/90/20923/dfasprrg0s/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr232/" data-role="phrase-anchor" data-phrase-id="232" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr232"></a><a data-anchor="/document/90/20923/dfas3560fv/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr233/" data-role="phrase-anchor" data-phrase-id="233" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr233"></a><a data-anchor="/document/90/20923/dfasv948fg/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr234/" data-role="phrase-anchor" data-phrase-id="234" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr234"></a><a data-anchor="/document/90/20923/dfas4ur0ui/"></a>&#8206;</p></td></tr><tr><td><p><a data-anchor="/document/90/20923/bssPhr235/" data-role="phrase-anchor" data-phrase-id="235" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr235"></a><a data-anchor="/document/90/20923/dfas87a19k/"></a>&#8206;</p></td><td colspan="19"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr236/" data-role="phrase-anchor" data-phrase-id="236" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr236"></a><a data-anchor="/document/90/20923/dfasgawtvy/"></a>&#8206;&#8206;&#8206;&#8206;1. Турғун шохобча (кўчма савдо объекти) мавжудлигини тасдиқлайдиган ҳужжатларнинг нусхалари</p></td></tr><tr><td colspan="20"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr237/" data-role="phrase-anchor" data-phrase-id="237" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr237"></a><a data-anchor="/document/90/20923/dfasiav9xt/"></a>(бино, иншоотнинг ёки унинг қисмининг ижара шартномаси ёки кадастр ҳужжатлари). &#8206;&#8206;</p></td></tr><tr><td><p><a data-anchor="/document/90/20923/bssPhr238/" data-role="phrase-anchor" data-phrase-id="238" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr238"></a><a data-anchor="/document/90/20923/dfasqwetnt/"></a>&#8206;</p></td><td colspan="19"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr239/" data-role="phrase-anchor" data-phrase-id="239" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr239"></a><a data-anchor="/document/90/20923/dfasnmgmse/"></a>&#8206;&#8206;2. Турғун савдо (хизмат кўрсатиш) шохобчаси (кўчма савдо объекти) манзилининг харитадаги</p></td></tr><tr><td colspan="20"><p><a data-anchor="/document/90/20923/bssPhr240/" data-role="phrase-anchor" data-phrase-id="240" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr240"></a><a data-anchor="/document/90/20923/dfas36kbgp/"></a>координатаси. &#8206;&#8206;&#8206;&#8206;</p></td></tr><tr><td colspan="9"><p style="text-align:center"><a data-anchor="/document/90/20923/bssPhr241/" data-role="phrase-anchor" data-phrase-id="241" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr241"></a><a data-anchor="/document/90/20923/dfasyg0lub/"></a>__________________________</p></td><td><p><a data-anchor="/document/90/20923/bssPhr242/" data-role="phrase-anchor" data-phrase-id="242" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr242"></a><a data-anchor="/document/90/20923/dfasf39h83/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr243/" data-role="phrase-anchor" data-phrase-id="243" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr243"></a><a data-anchor="/document/90/20923/dfasomuzeg/"></a>&#8206;</p></td><td colspan="4"><p style="text-align:center"><a data-anchor="/document/90/20923/bssPhr244/" data-role="phrase-anchor" data-phrase-id="244" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr244"></a><a data-anchor="/document/90/20923/dfast6wawp/"></a>____________&#8206;&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr245/" data-role="phrase-anchor" data-phrase-id="245" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr245"></a><a data-anchor="/document/90/20923/dfaso80skh/"></a>&#8206;</p></td><td colspan="3"><p style="text-align:center"><a data-anchor="/document/90/20923/bssPhr246/" data-role="phrase-anchor" data-phrase-id="246" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr246"></a><a data-anchor="/document/90/20923/dfas6kt8dm/"></a>_________&#8206;&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr247/" data-role="phrase-anchor" data-phrase-id="247" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr247"></a><a data-anchor="/document/90/20923/dfaspfg0dw/"></a>&#8206;</p></td></tr><tr><td colspan="9"><p style="text-align:center"><a kazakh="yes" data-anchor="/document/90/20923/bssPhr248/" data-role="phrase-anchor" data-phrase-id="248" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr248"></a><a data-anchor="/document/90/20923/dfas2xbyg5/"></a>(Тадбиркорлик субъекти раҳбарининг Ф.И.О.)&#8206;&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr249/" data-role="phrase-anchor" data-phrase-id="249" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr249"></a><a data-anchor="/document/90/20923/dfas6c8h90/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr250/" data-role="phrase-anchor" data-phrase-id="250" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr250"></a><a data-anchor="/document/90/20923/dfasklfyef/"></a>&#8206;</p></td><td colspan="4"><p style="text-align:center"><a data-anchor="/document/90/20923/bssPhr251/" data-role="phrase-anchor" data-phrase-id="251" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr251"></a><a data-anchor="/document/90/20923/dfas7451o7/"></a>(имзо)&#8206;&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr252/" data-role="phrase-anchor" data-phrase-id="252" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr252"></a><a data-anchor="/document/90/20923/dfas8pxk7y/"></a>&#8206;</p></td><td colspan="3"><p style="text-align:center"><a data-anchor="/document/90/20923/bssPhr253/" data-role="phrase-anchor" data-phrase-id="253" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr253"></a><a data-anchor="/document/90/20923/dfask3mwbf/"></a>(сана) &#8206;&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr254/" data-role="phrase-anchor" data-phrase-id="254" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr254"></a><a data-anchor="/document/90/20923/dfasa0vu9d/"></a>&#8206;</p></td></tr></tbody></table></div></div></div></div><p style="text-align:right"><a kazakh="yes" data-anchor="/document/90/20923/bssPhr255/" data-role="phrase-anchor" data-phrase-id="255" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr255"></a><a data-anchor="/document/90/20923/dfas2gcpf3/"></a>Аҳоли билан пулли ҳисоб-китобларни амалга оширишда<br>онлайн-НКМ ва (ёки) виртуал касса тизимини<br>қўллаш тартиби тўғрисидаги низомга<br>2-ИЛОВА</p><div><div class="table-wide"><div><div><table width="100%"><tbody><tr><td colspan="20"><div class="doc__untyped" data-type="untyped" data-level="2"><a data-role="toc" data-anchor="/document/90/20923/tit12/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a kazakh="yes" data-anchor="/document/90/20923/bssPhr256/" data-role="phrase-anchor" data-phrase-id="256" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr256"></a><a data-anchor="/document/90/20923/dfastmu4qg/"></a>&#8206;&#8206;Онлайн-НКМ ёки виртуал касса давлат солиқ хизмати органларида &#8206;рўйхатга олинганлиги тўғрисидаги маълумотлар&#8206;</span></div></td></tr><tr><td colspan="20"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr257/" data-role="phrase-anchor" data-phrase-id="257" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr257"></a><a data-anchor="/document/90/20923/dfas139ot0/"></a>Ушбу рўйхатга олинганлик тўғрисидаги маълумот__________________________________________________<br>&#8206;__________________________________________________________ (СТИР: _________________________)га</p></td></tr><tr><td colspan="8"><p style="text-align:right"><a data-anchor="/document/90/20923/bssPhr258/" data-role="phrase-anchor" data-phrase-id="258" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr258"></a><a data-anchor="/document/90/20923/dfas5b5rb0/"></a>&#8206;&#8206;&#8206;&#8206;(тадбиркорлик субъекти номи)</p></td><td><p><a data-anchor="/document/90/20923/bssPhr259/" data-role="phrase-anchor" data-phrase-id="259" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr259"></a><a data-anchor="/document/90/20923/dfas7tyt11/"></a>&#8206;</p></td><td colspan="8"><a data-anchor="/document/90/20923/bssPhr260/" data-role="phrase-anchor" data-phrase-id="260" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr260"></a><a data-anchor="/document/90/20923/dfasz08wzs/"></a>&#160;</td><td><p><a data-anchor="/document/90/20923/bssPhr261/" data-role="phrase-anchor" data-phrase-id="261" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr261"></a><a data-anchor="/document/90/20923/dfaslfli95/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr262/" data-role="phrase-anchor" data-phrase-id="262" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr262"></a><a data-anchor="/document/90/20923/dfasf0c3kc/"></a>&#8206;</p></td><td><p><a data-anchor="/document/90/20923/bssPhr263/" data-role="phrase-anchor" data-phrase-id="263" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr263"></a><a data-anchor="/document/90/20923/dfaspyg0gr/"></a>&#8206;</p></td></tr><tr><td colspan="20"><p><a kazakh="yes" data-anchor="/document/90/20923/bssPhr264/" data-role="phrase-anchor" data-phrase-id="264" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr264"></a><a data-anchor="/document/90/20923/dfashhfagb/"></a>&#8206;&#8206;тегишли бўлган онлайн-НКМ ёки виртуал касса тизими махсус ахборот тизимида қайд этилганлиги тўғрисида берилди.</p></td></tr><tr><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr265/" data-role="phrase-anchor" data-phrase-id="265" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr265"></a><a data-anchor="/document/90/20923/dfasoul5ze/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr266/" data-role="phrase-anchor" data-phrase-id="266" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr266"></a><a data-anchor="/document/90/20923/dfas0ymb72/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr267/" data-role="phrase-anchor" data-phrase-id="267" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr267"></a><a data-anchor="/document/90/20923/dfas4txxb7/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr268/" data-role="phrase-anchor" data-phrase-id="268" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr268"></a><a data-anchor="/document/90/20923/dfas0no4se/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr269/" data-role="phrase-anchor" data-phrase-id="269" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr269"></a><a data-anchor="/document/90/20923/dfasy520ha/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr270/" data-role="phrase-anchor" data-phrase-id="270" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr270"></a><a data-anchor="/document/90/20923/dfasv3v3vw/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr271/" data-role="phrase-anchor" data-phrase-id="271" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr271"></a><a data-anchor="/document/90/20923/dfas9evw0w/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr272/" data-role="phrase-anchor" data-phrase-id="272" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr272"></a><a data-anchor="/document/90/20923/dfasuz8y6s/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr273/" data-role="phrase-anchor" data-phrase-id="273" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr273"></a><a data-anchor="/document/90/20923/dfasa3d5di/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr274/" data-role="phrase-anchor" data-phrase-id="274" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr274"></a><a data-anchor="/document/90/20923/dfasq4v36w/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr275/" data-role="phrase-anchor" data-phrase-id="275" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr275"></a><a data-anchor="/document/90/20923/dfasrkugxc/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr276/" data-role="phrase-anchor" data-phrase-id="276" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr276"></a><a data-anchor="/document/90/20923/dfash43nam/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr277/" data-role="phrase-anchor" data-phrase-id="277" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr277"></a><a data-anchor="/document/90/20923/dfas0iagdl/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr278/" data-role="phrase-anchor" data-phrase-id="278" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr278"></a><a data-anchor="/document/90/20923/dfasmhgz3c/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr279/" data-role="phrase-anchor" data-phrase-id="279" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr279"></a><a data-anchor="/document/90/20923/dfasz4dfoo/"></a>&#8206;</p></td><td class="bdBottom"><p><a data-anchor="/document/90/20923/bssPhr280/" data-role="ph