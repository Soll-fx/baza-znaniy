ent/16/220944/dfas510sk6/" data-dfa="dfas510sk6" data-cke-saved-name="dfas510sk6"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/220944/dfasvds40d" href="https://1gb.uz/#/document/16/220944/dfasvds40d" style="font-size: 24px">Декретное<br xmlns="">пособие</a></h1></div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="24px" text-anchor="middle" x="57" y="56">[Not supported by viewer]</text></switch></g><rect fill="none" pointer-events="none" rx="16.2" ry="16.2" stroke="#cc0000" stroke-width="3" style="width: 218px; height: 108px;" x="279" y="1"></rect><g transform="translate(281.5,10.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 212px; height: 88px;"><div xmlns="http://www.w3.org/1999/xhtml" style='color:#000000; display:inline-block; font-family:&#34;Times New Roman&#34;; font-size:24px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:212px'><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><h1 style="font-size:24px"><a xmlns="" data-anchor="/document/16/220944/bssPhr6/"></a><a xmlns="" data-anchor="/document/16/220944/dfas9euua4/" data-dfa="dfas9euua4" data-cke-saved-name="dfas9euua4"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/220944/dfasoerq4o" href="https://1gb.uz/#/document/16/220944/dfasoerq4o" style="font-size: 24px">Больничное пособие</a></h1></div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="24px" text-anchor="middle" x="106" y="56">[Not supported by viewer]</text></switch></g><rect fill="none" pointer-events="none" rx="16.2" ry="16.2" stroke="#cc0000" stroke-width="3" style="width: 218px; height: 108px;" x="505" y="187"></rect><g transform="translate(507.5,182.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 212px; height: 117px;"><div xmlns="http://www.w3.org/1999/xhtml" style='color:#000000; display:inline-block; font-family:&#34;Times New Roman&#34;; font-size:24px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:212px'><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><h1 style="font-size:24px"><a xmlns="" data-anchor="/document/16/220944/bssPhr7/"></a><a xmlns="" data-anchor="/document/16/220944/dfasgfwgl0/" data-dfa="dfasgfwgl0" data-cke-saved-name="dfasgfwgl0"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/220944/dfashmyxpg" href="https://1gb.uz/#/document/16/220944/dfashmyxpg" style="font-size: 24px">Пособие по усыновлению ребенка</a></h1></div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="24px" text-anchor="middle" x="106" y="71">[Not supported by viewer]</text></switch></g><rect fill="none" pointer-events="none" rx="16.2" ry="16.2" stroke="#cc0000" stroke-width="3" style="width: 218px; height: 108px;" x="732" y="1"></rect><g transform="translate(734.5,26.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 212px; height: 56px;"><div xmlns="http://www.w3.org/1999/xhtml" style='color:#000000; display:inline-block; font-family:&#34;Times New Roman&#34;; font-size:24px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:212px'><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/220944/bssPhr8/"></a><a xmlns="" data-anchor="/document/16/220944/dfasupt8wt/" data-dfa="dfasupt8wt" data-cke-saved-name="dfasupt8wt"></a><strong><a data-cke-saved-href="https://1gb.uz/#/document/16/220944/dfasinopp3" href="https://1gb.uz/#/document/16/220944/dfasinopp3" style="font-size: 24px">Чек-лист по пособиям</a></strong></div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="24px" text-anchor="middle" x="106" y="40">[Not supported by viewer]</text></switch></g></g></svg><a data-anchor="/document/16/220944/tit1/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit1"><a data-anchor="/document/16/220944/bssPhr9/"></a><a data-anchor="/document/16/220944/dfasf5olar/" data-dfa="dfasf5olar"></a>Новый&nbsp;порядок выплат пособий</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/220944/bssPhr12/"></a><a data-anchor="/document/16/220944/dfash4ie10/" data-dfa="dfash4ie10"></a>С&nbsp;1&nbsp;января 2026 порядок назначения и&nbsp;выплаты социальных пособий полностью автоматизирован. Работодатель в&nbsp;процессе больше не&nbsp;участвует: он&nbsp;не&nbsp;принимает документы, не&nbsp;рассчитывает пособие и&nbsp;не&nbsp;перечисляет выплаты. Система перешла на&nbsp;проактивный формат, который вводится поэтапно до 2030&nbsp;года. Подробные сроки –&nbsp;в <a href="https://1gb.uz/#/document/16/220944/dfasduku2g/">таблице</a>.</p><p><a data-anchor="/document/16/220944/bssPhr13/"></a><a data-anchor="/document/16/220944/dfasduku2g/" data-dfa="dfasduku2g"></a><strong>Таблица. Сроки перехода&nbsp;на новый порядок выплат пособий</strong></p><div><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%" class="bdAll"><caption></caption><tbody><tr><td style="text-align: left; vertical-align: middle; width: 41.9%;"><a data-anchor="/document/16/220944/bssPhr15/"></a><a data-anchor="/document/16/220944/dfasg1u6fw/" data-dfa="dfasg1u6fw"></a><strong>Дата перехода</strong></td><td style="text-align: left; vertical-align: middle; width: 57.95%;"><a data-anchor="/document/16/220944/bssPhr16/"></a><a data-anchor="/document/16/220944/dfas65309e/" data-dfa="dfas65309e"></a><strong>Виды пособий</strong></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 41.9%;"><a data-anchor="/document/16/220944/bssPhr17/"></a><a data-anchor="/document/16/220944/dfascihg90/" data-dfa="dfascihg90"></a>С&nbsp;1&nbsp;января 2026</td><td style="text-align: left; vertical-align: middle; width: 57.95%;"><a data-anchor="/document/16/220944/bssPhr18/"></a><a data-anchor="/document/16/220944/dfash3iifu/" data-dfa="dfash3iifu"></a>Пособие по&nbsp;беременности и&nbsp;родам</td></tr><tr><td style="text-align: left; vertical-align: middle; width: 41.9%;"><a data-anchor="/document/16/220944/bssPhr19/"></a><a data-anchor="/document/16/220944/dfasgzogf6/" data-dfa="dfasgzogf6"></a>С&nbsp;1&nbsp;июля 2026</td><td style="text-align: left; vertical-align: middle; width: 57.95%;"><a data-anchor="/document/16/220944/bssPhr20/"></a><a data-anchor="/document/16/220944/dfasogwdin/" data-dfa="dfasogwdin"></a>Пособие по&nbsp;временной нетрудоспособности</td></tr><tr><td style="text-align: left; vertical-align: middle; width: 41.9%;"><a data-anchor="/document/16/220944/bssPhr21/"></a><a data-anchor="/document/16/220944/dfasm3if3f/" data-dfa="dfasm3if3f"></a>С&nbsp;1&nbsp;января 2030</td><td style="text-align: left; vertical-align: middle; width: 57.95%;"><a data-anchor="/document/16/220944/bssPhr22/"></a><a data-anchor="/document/16/220944/dfasoqyl0d/" data-dfa="dfasoqyl0d"></a>Выходное пособие</td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div><p data-end="448" data-start="222"><a data-anchor="/document/16/220944/bssPhr23/"></a><a data-anchor="/document/16/220944/dfas9uiyq5/" data-dfa="dfas9uiyq5"></a><strong>Мухамеджанова Дилшодхон</strong>, главный специалист Национального агентства социальной защиты при Президенте Республики Узбекистан, на <a href="https://1gb.uz/#/document/16/220944/dfasge95vd/">видеолекции разъяснила</a>, как назначают&nbsp;и&nbsp;выплачивают пособия по новым правилам начиная с 2026 года.&nbsp;</p><p data-end="448" data-start="222"><a data-anchor="/document/16/220944/bssPhr24/"></a><a data-anchor="/document/16/220944/dfasge95vd/" data-dfa="dfasge95vd" hint="" id="dfasge95vd" type=""></a><strong>Видеолекция. Новый&nbsp;порядок страховых выплат</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/gTyCIOFVgM8?si=ukfbVN7lbMqTl22K" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p data-end="448" data-start="222"><a data-anchor="/document/16/220944/bssPhr25/"></a><a data-anchor="/document/16/220944/dfash3l1rq/" data-dfa="dfash3l1rq"></a>Процесс назначения и&nbsp;выплат пособий начинается с&nbsp;медицинской организации. Она оформляет электронный больничный в&nbsp;системе DMED не&nbsp;позднее одного рабочего дня с&nbsp;даты открытия. После этого документ автоматически поступает в&nbsp;систему «Социальное страхование».</p><p data-end="776" data-start="450"><a data-anchor="/document/16/220944/bssPhr26/"></a><a data-anchor="/document/16/220944/dfasv7y3x1/" data-dfa="dfasv7y3x1"></a>После закрытия больничного система сама собирает необходимые данные из&nbsp;государственных баз. Подтягивается информация о&nbsp;доходах и&nbsp;уплате страховых взносов из&nbsp;Налогового комитета, сведения о&nbsp;добровольных взносах и&nbsp;статусе физлица, а&nbsp;также данные о&nbsp;стаже, занятости, отпусках и&nbsp;договорах ГПХ из&nbsp;Единой национальной системы труда. На&nbsp;основе этих данных система автоматически принимает решение&nbsp;— назначить пособие или отказать с&nbsp;указанием причины. Одновременно формируются платежные реестры.</p><p data-end="1178" data-is-last-node="" data-is-only-node="" data-start="939"><a data-anchor="/document/16/220944/bssPhr27/"></a><a data-anchor="/document/16/220944/dfasussa5l/" data-dfa="dfasussa5l"></a>Результат назначения пособия направляется работнику по&nbsp;SMS: указывается сумма, способ и&nbsp;срок выплаты либо причина отказа. После этого Фонд социального страхования (далее ФСС) перечисляет деньги в&nbsp;банк, а&nbsp;банк зачисляет их&nbsp;на&nbsp;карту получателя в&nbsp;течение пяти рабочих дней.&nbsp;По&nbsp;заявлению работника пособия будут выплачивать тремя способами:&nbsp;страховщика,&nbsp;работодателя или госсистемы в&nbsp;электронной форме.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/220944/bssPhr28/"></a><a data-anchor="/document/16/220944/dfas6x7v95/" data-dfa="dfas6x7v95"></a>Учитывайте важные сроки для выплат пособий</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/220944/bssPhr29/"></a><a data-anchor="/document/16/220944/dfasoxwo1a/" data-dfa="dfasoxwo1a"></a>Обратите внимание, что привычный порядок выплат и&nbsp;назначений пособий действует до вступления в силу нового порядка. До&nbsp;1&nbsp;июля 2026 пособия по&nbsp;временной нетрудоспособности исчисляет&nbsp;и&nbsp;уплачивает полностью работодатель. С&nbsp;1&nbsp;июля 2026 работодатель будет оплачивать 5&nbsp;дней в&nbsp;календарном году, пропущенных по&nbsp;болезни, а с&nbsp;6&nbsp;дня&nbsp;— пособие выплачивает ФСС. До&nbsp;1&nbsp;января 2030 выходное пособие&nbsp;полностью лежит на&nbsp;работодателе.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/220944/bssPhr30/"></a><a data-anchor="/document/16/220944/dfasu81vel/" data-dfa="dfasu81vel"></a><a data-anchor="/document/16/220944/dfas01xaz2/" data-dfa="dfas01xaz2"></a><strong>Что делать бухгалтеру.&nbsp;</strong>Ошибки в&nbsp;учете доходов и&nbsp;взносов напрямую отражаются на&nbsp;автоматическом расчете выплат. Некорректные данные могут привести как к&nbsp;занижению, так и&nbsp;к&nbsp;завышению пособий.</p><p><a data-anchor="/document/16/220944/bssPhr31/"></a><a data-anchor="/document/16/220944/dfasdgof61/" data-dfa="dfasdgof61"></a>Особое внимание уделяйте:</p><ul class="c-list"><li><a data-anchor="/document/16/220944/bssPhr32/"></a><a data-anchor="/document/16/220944/dfas6pword/" data-dfa="dfas6pword"></a>корректности персональных данных работников;</li><li>правильному отражению доходов работников;</li><li>своевременной и&nbsp;полной уплате страховых взносов. От&nbsp;них зависит страховой стаж и&nbsp;право на&nbsp;пособие.</li></ul><p><a data-anchor="/document/16/220944/bssPhr33/"></a><a data-anchor="/document/16/220944/dfaszdoy4a/" data-dfa="dfaszdoy4a"></a><strong>Памятка. Какие данные нужно проверить бухгалтеру</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/b5464630-2f14-4746-ab68-8963d879b39f/index.html" data-itype="poster" data-moduleId="238" data-id="147" style="min-height:600px" width="100%"></iframe></div><p data-end="864" data-start="787"><a data-anchor="/document/16/220944/bssPhr34/"></a><a data-anchor="/document/16/220944/dfasgf4dw1/" data-dfa="dfasgf4dw1"></a>Актуализируйте сведения о&nbsp;страховом стаже, поскольку в&nbsp;расчет будут входить все периоды до&nbsp;2026&nbsp;года, в&nbsp;том числе уплаченные взносы ЕСП и&nbsp;начисленный соцналог.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/220944/bssPhr35/"></a><a data-anchor="/document/16/220944/dfastw75tn/" data-dfa="dfastw75tn"></a>С&nbsp;1&nbsp;января 2026 года в&nbsp;ЕНСТ нужно регистрировать и&nbsp;договоры ГПХ</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/220944/bssPhr36/"></a><a data-anchor="/document/16/220944/dfasgfn2gv/" data-dfa="dfasgfn2gv"></a>Основание&nbsp;— <span num="45" target="_blank" lnktype="intlnk" title="" class="doc">пункт&nbsp;3</span> постановления Кабмина от&nbsp;17.12.2025 №&nbsp;796.</p></div><div class="incut-v4__icon"></div></div><p data-end="864" data-start="787"><a data-anchor="/document/16/220944/bssPhr37/"></a><a data-anchor="/document/16/220944/dfasws3u6e/" data-dfa="dfasws3u6e"></a><strong>Видеоурок. Cпециалисты ФСС</strong><strong> о&nbsp;порядке применения новых правил выплат пособий</strong></p><div class="iframe"><iframe width="1349" height="759" src="https://www.youtube.com/embed/0wfPr7BK9ao" title="Новые правила назначения и выплат пособий-2026. Шералиев Алишер" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p style="text-align:left"><a data-anchor="/document/16/220944/bssPhr38/"></a><a data-anchor="/document/16/220944/dfasm1iqqc/" data-dfa="dfasm1iqqc"></a><strong>Презентация. Порядок выплаты пособий</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/7028a7dc-22c1-4794-917f-679c926c62a2/index.html" data-itype="presentation" data-moduleId="237" data-id="354" style="min-height:400px" width="100%"></iframe></div><p style="text-align:left"><a data-anchor="/document/16/220944/bssPhr39/"></a><a data-anchor="/document/16/220944/dfashgqhhe/" data-dfa="dfashgqhhe"></a><span num="46" target="_blank" lnktype="intlnk" title="" class="doc">Закон</span> «О&nbsp;государственном социальном страховании» разделил госстрахование на&nbsp;обязательное и&nbsp;добровольное. Каких&nbsp;работников охватывает социальное страхование, смотрите в <a href="https://1gb.uz/#/document/16/220944/dfasr77b9w/">таблице</a>.</p><p style="text-align:left"><a data-anchor="/document/16/220944/bssPhr40/"></a><a data-anchor="/document/16/220944/dfasr77b9w/" data-dfa="dfasr77b9w"></a><strong>Таблица. Виды&nbsp;социального страхования</strong></p><div align="left"><div class="table-wide scroller-wrapper"><div class="scroller table-scroller"><div class="scroller__container"><table width="100%"><caption></caption><tbody><tr><td class="bdAll" style="text-align: left; vertical-align: middle; width: 49.39%;"><a data-anchor="/document/16/220944/bssPhr42/"></a><a data-anchor="/document/16/220944/dfas216heg/" data-dfa="dfas216heg"></a><strong>Виды соцстрахования</strong></td><td class="bdAll" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr43/"></a><a data-anchor="/document/16/220944/dfaspvqagx/" data-dfa="dfaspvqagx"></a><strong>Категории работников</strong></td></tr><tr><td class="bdAll" rowspan="3" style="text-align: left; vertical-align: middle; width: 49.39%;"><a data-anchor="/document/16/220944/bssPhr44/"></a><a data-anchor="/document/16/220944/dfas2gl72u/" data-dfa="dfas2gl72u"></a>Обязательное соцстрахование</td><td class="bdTopbdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr45/"></a><a data-anchor="/document/16/220944/dfassuezri/" data-dfa="dfassuezri"></a>Работники по&nbsp;трудовым договорам</td></tr><tr><td class="bdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr46/"></a><a data-anchor="/document/16/220944/dfask9ix1z/" data-dfa="dfask9ix1z"></a>Работники по&nbsp;договорам ГПХ</td></tr><tr><td class="bdBottombdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr47/"></a><a data-anchor="/document/16/220944/dfas9my54l/" data-dfa="dfas9my54l"></a>Руководители юридических лиц</td></tr><tr><td class="bdAll" rowspan="4" style="text-align: left; vertical-align: middle; width: 49.39%;"><a data-anchor="/document/16/220944/bssPhr48/"></a><a data-anchor="/document/16/220944/dfasgme67g/" data-dfa="dfasgme67g"></a>Добровольное соцстрахование</td><td class="bdTopbdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr49/"></a><a data-anchor="/document/16/220944/dfasvslsqf/" data-dfa="dfasvslsqf"></a>Самозанятые лица</td></tr><tr><td class="bdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr50/"></a><a data-anchor="/document/16/220944/dfasgv30vx/" data-dfa="dfasgv30vx"></a>Индивидуальные предприниматели</td></tr><tr><td class="bdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr51/"></a><a data-anchor="/document/16/220944/dfasb2fwll/" data-dfa="dfasb2fwll"></a>Члены и&nbsp;главы дехканских хозяйств</td></tr><tr><td class="bdBottombdRightbdLeft" style="text-align: left; vertical-align: middle; width: 50.47%;"><a data-anchor="/document/16/220944/bssPhr52/"></a><a data-anchor="/document/16/220944/dfas3pcdig/" data-dfa="dfas3pcdig"></a>Учредители компаний и&nbsp;другие физлица</td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="70" target="_blank" lnktype="intlnk" title="" class="doc">При каких условиях назначаются пособия в 2026 году</span></li><li class="incut-v4-more-about__item"><span num="71" target="_blank" lnktype="intlnk" title="" class="doc">Как рассчитать и выплатить пособия в 2026 году</span></li></ul></div><div class="incut-v4__icon"></div></div></div></div><div data-role="phrase-incut" class="incut-v4 incut-v4-spoiler incut-v4-situation " data-incut="spoiler"><h3 class="incut-v4__tag" data-incut-toggle="">Ситуация</h3><p class="incut-v4__title" data-incut-toggle=""><name>Как работодателю встать на учет в ФСС для выплат пособий</name></p><div class="incut-v4__content" data-incut-content=""><p style="text-align:left"><a data-anchor="/document/16/220944/bssPhr55/"></a><a data-anchor="/document/16/220944/dfasa1zb0u/" data-dfa="dfasa1zb0u"></a><a data-anchor="/document/16/220944/dfas2krz0o/" data-dfa="dfas2krz0o"></a>Отдельно вставать на учет работодателю не надо.&nbsp;Работодатель автоматически становится участником системы государственного социального страхования при условии своевременной сдачи налоговой отчетности. Необходимо корректно и полно отражать сведения о трудовой деятельности работников в системе <a href="https://my.mehnat.uz/login" target="_blank" title="">my.mehnat</a>.</p></div></div><a data-anchor="/document/16/220944/tit2/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit2"><a data-anchor="/document/16/220944/bssPhr56/"></a><a data-anchor="/document/16/220944/dfas9p2o2e/" data-dfa="dfas9p2o2e"></a>Условия назначения пособий&nbsp;</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/220944/bssPhr58/"></a><a data-anchor="/document/16/220944/dfascclad6/" data-dfa="dfascclad6"></a>Право на пособие зависит от официальной занятости и страхового стажа.&nbsp;Выплаты назначают при соблюдении ряда условий согласно <span num="101" target="_blank" lnktype="intlnk" title="" class="doc">приложению&nbsp;№ 4</span> к Положению, утвержденному постановлением Кабмина от 17.12.2025 № 796. Подробнее смотрите на <a href="https://1gb.uz/#/document/16/220944/dfas7aqo8x/">схеме</a>.</p><p><a data-anchor="/document/16/220944/bssPhr59/"></a><a data-anchor="/document/16/220944/dfas7aqo8x/" data-dfa="dfas7aqo8x"></a><strong>Схема. Кто имеет право на получение пособий</strong></p><img iid="-41920406" lnktype="img" class="inimg" forprint="true" id="-41920406" sourceId="1" width="581" height="481" src="https://1gb.uz/system/content/image/297/1/-41920406/"><svg data-role="idiagram" content='<mxfile modified=&#34;2026-03-17T12:04:16.098Z&#34; host=&#34;web-arm.aservices.tech&#34; agent=&#34;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36&#34; etag=&#34;Wzd3pqs27Ckto3QRF8ne&#34; version=&#34;10.5.9&#34; type=&#34;device&#34;&gt;<diagram id=&#34;gX63IKHU83uzN2n-3GzF&#34; name=&#34;Страница 1&#34;&gt;</diagram&gt;</mxfile&gt;' height="481px" version="1.1" viewbox="-0.5 -0.5 581 481" width="581px"><defs xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"></defs><g xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><path d="M 290 30 L 290 63.63" fill="none" pointer-events="none" stroke="#990000" stroke-miterlimit="10"></path><path d="M 290 68.88 L 286.5 61.88 L 290 63.63 L 293.5 61.88 Z" fill="#990000" pointer-events="none" stroke="#990000" stroke-miterlimit="10"></path><rect fill="#f8cecc" pointer-events="none" stroke="#990000" style="width: 280px; height: 30px;" x="150" y="0"></rect><g transform="translate(188.5,5.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 203px; height: 18px;"><div xmlns="http://www.w3.org/1999/xhtml" style='color:#000000; display:inline-block; font-family:&#34;Times New Roman&#34;; font-size:14px; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:nowrap; width:204px'><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/220944/bssPhr60/"></a><a xmlns="" data-anchor="/document/16/220944/dfasl0vqga/" data-dfa="dfasl0vqga" data-cke-saved-name="dfasl0vqga"></a>Кто имеет право на пособие</div></div></foreignobject><text fill="#000000" font-family="Times New Roman" font-size="14px" text-anchor=