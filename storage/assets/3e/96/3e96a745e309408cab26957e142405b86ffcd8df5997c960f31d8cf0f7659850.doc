0" stroke-miterlimit="10" stroke-width="3"></path><g transform="translate(212.5,116.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 57px; height: 20px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#ffffff; display:inline-block; font-family:Helvetica; font-size:18px; font-weight:bold; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:nowrap; width:58px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/219105/bssPhr17/"></a><a xmlns="" data-anchor="/document/16/219105/dfasqkxzla/" data-dfa="dfasqkxzla" data-cke-saved-name="dfasqkxzla"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/219105/dfas5bggfg" href="https://1gb.uz/#/document/16/219105/dfas5bggfg">МСФО</a></div></div></foreignobject><text fill="#FFFFFF" font-family="Helvetica" font-size="18px" font-weight="bold" text-anchor="middle" x="29" y="19">[Not supported by viewer]</text></switch></g><rect fill="#ff9999" pointer-events="none" rx="10" ry="10" stroke="#000000" stroke-width="3" style="width: 150px; height: 75px;" x="166.5" y="1.5"></rect><path d="M 304 6.5 L 311.5 9.5 L 311.5 21.5 L 304 18.5 L 296.5 21.5 L 296.5 9.5 Z" fill="#ff9999" pointer-events="none" stroke="#000000" stroke-miterlimit="10" stroke-width="3"></path><g transform="translate(221.5,28.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 39px; height: 20px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#ffffff; display:inline-block; font-family:Helvetica; font-size:18px; font-weight:bold; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:nowrap; width:40px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/219105/bssPhr18/"></a><a xmlns="" data-anchor="/document/16/219105/dfastsygsq/" data-dfa="dfastsygsq" data-cke-saved-name="dfastsygsq"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/219105/dfasuh01hp" href="https://1gb.uz/#/document/16/219105/dfasuh01hp">НДС</a></div></div></foreignobject><text fill="#FFFFFF" font-family="Helvetica" font-size="18px" font-weight="bold" text-anchor="middle" x="20" y="19">[Not supported by viewer]</text></switch></g><rect fill="#ff9999" pointer-events="none" rx="10" ry="10" stroke="#000000" stroke-width="3" style="width: 150px; height: 75px;" x="661.5" y="176.5"></rect><path d="M 799 181.5 L 806.5 184.5 L 806.5 196.5 L 799 193.5 L 791.5 196.5 L 791.5 184.5 Z" fill="#ff9999" pointer-events="none" stroke="#000000" stroke-miterlimit="10" stroke-width="3"></path><g transform="translate(704.5,203.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 64px; height: 20px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#ffffff; display:inline-block; font-family:Helvetica; font-size:18px; font-weight:bold; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:nowrap; width:65px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/219105/bssPhr19/"></a><a xmlns="" data-anchor="/document/16/219105/dfashfiu3w/" data-dfa="dfashfiu3w" data-cke-saved-name="dfashfiu3w"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/219105/dfas2soq04" href="https://1gb.uz/#/document/16/219105/dfas2soq04">Туризм</a></div></div></foreignobject><text fill="#FFFFFF" font-family="Helvetica" font-size="18px" font-weight="bold" text-anchor="middle" x="32" y="19">[Not supported by viewer]</text></switch></g><rect fill="#ff9999" pointer-events="none" rx="10" ry="10" stroke="#000000" stroke-width="3" style="width: 150px; height: 75px;" x="661.5" y="89"></rect><path d="M 799 94 L 806.5 97 L 806.5 109 L 799 106 L 791.5 109 L 791.5 97 Z" fill="#ff9999" pointer-events="none" stroke="#000000" stroke-miterlimit="10" stroke-width="3"></path><g transform="translate(664.5,105.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 144px; height: 41px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#ffffff; display:inline-block; font-family:Helvetica; font-size:18px; font-weight:bold; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:144px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/219105/bssPhr20/"></a><a xmlns="" data-anchor="/document/16/219105/dfasabelx8/" data-dfa="dfasabelx8" data-cke-saved-name="dfasabelx8"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/219105/dfas2a9cfv" href="https://1gb.uz/#/document/16/219105/dfas2a9cfv">Статистическая отчетность</a></div></div></foreignobject><text fill="#FFFFFF" font-family="Helvetica" font-size="18px" font-weight="bold" text-anchor="middle" x="72" y="30">[Not supported by viewer]</text></switch></g><rect fill="#ff9999" pointer-events="none" rx="10" ry="10" stroke="#000000" stroke-width="3" style="width: 150px; height: 75px;" x="661.5" y="1.5"></rect><path d="M 799 6.5 L 806.5 9.5 L 806.5 21.5 L 799 18.5 L 791.5 21.5 L 791.5 9.5 Z" fill="#ff9999" pointer-events="none" stroke="#000000" stroke-miterlimit="10" stroke-width="3"></path><g transform="translate(664.5,18.5)"><switch><foreignobject pointer-events="all" requiredfeatures="http://www.w3.org/TR/SVG11/feature#Extensibility" style="overflow: visible; width: 144px; height: 41px;"><div xmlns="http://www.w3.org/1999/xhtml" style="color:#ffffff; display:inline-block; font-family:Helvetica; font-size:18px; font-weight:bold; line-height:1.2; overflow-wrap:normal; text-align:center; vertical-align:top; white-space:normal; width:144px"><div style="display:inline-block; text-align:inherit; text-decoration:inherit"><a xmlns="" data-anchor="/document/16/219105/bssPhr21/"></a><a xmlns="" data-anchor="/document/16/219105/dfasll6nwx/" data-dfa="dfasll6nwx" data-cke-saved-name="dfasll6nwx"></a><a data-cke-saved-href="https://1gb.uz/#/document/16/219105/dfas80mnxw" href="https://1gb.uz/#/document/16/219105/dfas80mnxw">Налоговые проверки</a></div></div></foreignobject><text fill="#FFFFFF" font-family="Helvetica" font-size="18px" font-weight="bold" text-anchor="middle" x="72" y="30">[Not supported by viewer]</text></switch></g></g></svg><p><a data-anchor="/document/16/219105/bssPhr22/"></a><a data-anchor="/document/16/219105/dfashaowlu/" data-dfa="dfashaowlu"></a>Эргашева Гульнара Халдаровна, сертифицированный налоговый консультант&nbsp;и преподаватель,&nbsp;разъяснила, что перенастроить в работе бухгалтеру из-за налоговых изменений в 2026 году.&nbsp;</p><p><a data-anchor="/document/16/219105/bssPhr23/"></a><a data-anchor="/document/16/219105/dfas4is1nq/" data-dfa="dfas4is1nq"></a><strong>Видеолекция. Налоговые изменения – 2026: что срочно перенастроить в работе. Часть 1</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/d_4l_WP1brg?si=DrtFlCdsVRhG-rJP" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><p><a data-anchor="/document/16/219105/bssPhr24/"></a><a data-anchor="/document/16/219105/dfaskf3dsg/" data-dfa="dfaskf3dsg"></a><strong>Видеолекция. Налоговые изменения – 2026: что срочно перенастроить в работе. Часть 2</strong></p><div class="iframe"><iframe width="560" height="315" src="https://www.youtube.com/embed/0ZhNT3XlUF4?si=-EwXWzS7iwkfdAFq" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><a data-anchor="/document/16/219105/tit1/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit1"><a data-anchor="/document/16/219105/bssPhr25/"></a><a data-anchor="/document/16/219105/dfasdo21lg/" data-dfa="dfasdo21lg"></a>Налог на прибыль</h2><a data-anchor="/document/16/219105/tit2/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit2"><a data-anchor="/document/16/219105/bssPhr26/"></a><a data-anchor="/document/16/219105/dfasvp4duy/" data-dfa="dfasvp4duy"></a>Новый порог уплаты авансовых&nbsp;платежей по налогу на прибыль</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr29/"></a><a data-anchor="/document/16/219105/dfaslqbgse/" data-dfa="dfaslqbgse"></a>С&nbsp;1 января 2026 меньше компаний должны платить авансовые платежи по&nbsp;налогу на&nbsp;прибыль. Порог доходов для обязательной уплаты авансовых платежей повысили с&nbsp;10&nbsp;млрд до&nbsp;20&nbsp;млрд сумов годового дохода (Указ Президента от&nbsp;19.08.2025 № <span num="1034" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="2232" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr30/"></a><a data-anchor="/document/16/219105/dfasmyr62s/" data-dfa="dfasmyr62s"></a>Компании с&nbsp;выручкой ниже нового порога могут рассчитывать налог на&nbsp;прибыль по&nbsp;фактическим данным отчетного периода, а&nbsp;не&nbsp;вносить авансы исходя из&nbsp;прогнозных показателей. Повышение доходного порога позволяет снизить нагрузку на&nbsp;бизнес, улучшить управление денежными потоками и&nbsp;уменьшить риск переплат. Для более чем тысячи предприятий малого и&nbsp;среднего бизнеса нововведение стало послаблением: они могут направить высвобожденные средства на&nbsp;развитие и&nbsp;оборотный капитал, а&nbsp;не&nbsp;«замораживать» их&nbsp;в&nbsp;бюджете в&nbsp;виде авансовых платежей.</p><p><a data-anchor="/document/16/219105/bssPhr31/"></a><a data-anchor="/document/16/219105/dfaskrarok/" data-dfa="dfaskrarok"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr32/"></a><a data-anchor="/document/16/219105/dfasld726d/" data-dfa="dfasld726d"></a>Проанализируйте доходы компании. Если годовой доход не&nbsp;превышает 20&nbsp;млрд сумов, вы&nbsp;можете не&nbsp;вносить авансовые платежи по&nbsp;налогу на&nbsp;прибыль. Потребуется обновить учетную политику для целей налогообложения&nbsp;— пропишите там уплату налога на&nbsp;прибыль без авансовых платежей. Что учесть в&nbsp;учетной политике читайте в <span data-warm-notices="45753196" data-warm-notice-type="error" num="2235" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr33/"></a><a data-anchor="/document/16/219105/dfascr8b3c/" data-dfa="dfascr8b3c"></a><strong>Мини-тест. Готовы&nbsp;ли вы&nbsp;к&nbsp;изменениям по&nbsp;налогу на&nbsp;прибыль</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/0f55cc0b-a142-4cd0-ab7b-5c4613a5547a/index.html" data-itype="testcard" data-moduleId="250" data-id="86" style="min-height:400px" width="100%"></iframe></div><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr34/"></a><a data-anchor="/document/16/219105/dfasvhuzhz/" data-dfa="dfasvhuzhz"></a>Подготовьте справку для исчисления авансовых платежей по&nbsp;налогу на&nbsp;прибыль</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr35/"></a><a data-anchor="/document/16/219105/dfasvkas79/" data-dfa="dfasvkas79"></a>Справку надо подать до&nbsp;15&nbsp;января 2026&nbsp;года. О&nbsp;том как составить и&nbsp;подать справку об&nbsp;авансовых платежах читайте в <span num="1204" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr36/"></a><a data-anchor="/document/16/219105/dfascxftuu/" data-dfa="dfascxftuu"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="945" target="_self" lnktype="intlnk" title="" class="doc">Как заполнить форму Справки для исчисления авансовых платежей по&nbsp;налогу на&nbsp;прибыль</span></li><li class="incut-v4-more-about__item"><span num="946" target="_self" lnktype="intlnk" title="" class="doc">Как рассчитать налог на&nbsp;прибыль коммерческой организации</span></li><li class="incut-v4-more-about__item"><span num="947" target="_self" lnktype="intlnk" title="" class="doc">Вычитаемые и&nbsp;невычитаемые расходы по&nbsp;налогу на&nbsp;прибыль</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit3/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit3"><a data-anchor="/document/16/219105/bssPhr38/"></a><a data-anchor="/document/16/219105/dfasrcbucl/" data-dfa="dfasrcbucl"></a>Льготы по налогу на прибыль&nbsp;</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr41/"></a><a data-anchor="/document/16/219105/dfas16i2b5/" data-dfa="dfas16i2b5"></a>С&nbsp;2026 действуют льготы по&nbsp;налогу на&nbsp;прибыль в&nbsp;сферах:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr42/"></a><a data-anchor="/document/16/219105/dfascrv4c2/" data-dfa="dfascrv4c2"></a><a href="https://1gb.uz/#/document/16/219105/dfasosbv79/">бухгалтерских услуг</a>;</li><li><a href="https://1gb.uz/#/document/16/219105/dfasgxkrdg/">строительства</a>.</li></ul><p><a data-anchor="/document/16/219105/bssPhr43/"></a><a data-anchor="/document/16/219105/dfasosbv79/" data-dfa="dfasosbv79"></a><strong>Льготы для бухгалтерских услуг</strong></p><p><a data-anchor="/document/16/219105/bssPhr44/"></a><a data-anchor="/document/16/219105/dfas58rute/" data-dfa="dfas58rute"></a>Предприятия, перешедшие с&nbsp;налога с&nbsp;оборота на&nbsp;налог на&nbsp;прибыль и&nbsp;НДС, могут применить льготу в&nbsp;виде вычета расходов на&nbsp;оплату труда бухгалтерских услуг из&nbsp;налоговых платежей (<span num="2080" target="_blank" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;19.08.2025 № УП-138).</p><p><a data-anchor="/document/16/219105/bssPhr45/"></a><a data-anchor="/document/16/219105/dfasemxcmo/" data-dfa="dfasemxcmo"></a>С&nbsp;1&nbsp;января 2026 года часть заработной платы бухгалтеров до&nbsp;3,5&nbsp;МРОТ в&nbsp;течение 6&nbsp;месяцев вычитается из&nbsp;налогов, уплаченных предприятиями, перешедшими с&nbsp;налога с&nbsp;оборота на&nbsp;НДС.</p><p><a data-anchor="/document/16/219105/bssPhr48/"></a><a data-anchor="/document/16/219105/dfass802wn/" data-dfa="dfass802wn"></a>Важно, что льгота распространяется именно на&nbsp;расходы в&nbsp;виде оплаты труда. То&nbsp;есть, на&nbsp;бухгалтерские услуги предоставленные бухгалтером по&nbsp;трудовому договору или по&nbsp;договору ГПХ (<span num="1037" target="_blank" lnktype="intlnk" title="" class="doc">ст.&nbsp;371</span>&nbsp;НК). Если бухгалтерские услуги оказывает&nbsp;ИП или юрлицо, такие расходы вычесть из&nbsp;налоговых платежей не&nbsp;получится.</p><p><a data-anchor="/document/16/219105/bssPhr49/"></a><a data-anchor="/document/16/219105/dfasb46f02/" data-dfa="dfasb46f02"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr50/"></a><a data-anchor="/document/16/219105/dfashntsgg/" data-dfa="dfashntsgg"></a>Если переходите на&nbsp;НДС, подайте заявление не&nbsp;позднее 7&nbsp;дней, с&nbsp;момента формирования обязательств по&nbsp;оплате налога. О&nbsp;том как перейти с&nbsp;налога с&nbsp;оборота на&nbsp;НДС и&nbsp;налог на&nbsp;прибыль читайте в <span num="2237" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-advice "><h3 class="incut-v4__tag" data-incut-toggle="">Совет</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr51/"></a><a data-anchor="/document/16/219105/dfasszf501/" data-dfa="dfasszf501"></a>Проверьте договор с&nbsp;бухгалтером, если планируете вычитать расходы на&nbsp;бухуслуги из&nbsp;налоговых платежей</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr52/"></a><a data-anchor="/document/16/219105/dfassv2xp1/" data-dfa="dfassv2xp1"></a>О&nbsp;том, как заключить трудовой договор с&nbsp;главным бухгалтером, читайте в <span data-warm-notices="45753202" data-warm-notice-type="error" num="1205" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr53/"></a><a data-anchor="/document/16/219105/dfasgxkrdg/" data-dfa="dfasgxkrdg"></a><strong>Льготы для строительства</strong></p><p><a data-anchor="/document/16/219105/bssPhr54/"></a><a data-anchor="/document/16/219105/dfaskku8xu/" data-dfa="dfaskku8xu"></a>При строительстве и&nbsp;безвозмездной передаче субъектами хозяйствования объектов социальной инфраструктуры за&nbsp;счет собственных средств расходы на&nbsp;эти объекты уменьшают налоговую базу по&nbsp;налогу на&nbsp;прибыль (<span num="2314" target="_blank" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;19.08.2025 № УП-138). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="2315" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr55/"></a><a data-anchor="/document/16/219105/dfasm32f0c/" data-dfa="dfasm32f0c"></a>К&nbsp;объектам социальной&nbsp;инфраструктуры можно отнести:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr56/"></a><a data-anchor="/document/16/219105/dfasxhggng/" data-dfa="dfasxhggng"></a>объекты социальной сферы (школы, детские сады, интернаты, больницы, поликлиники, культурные центры и&nbsp;т.д.);</li><li>объекты коммунального и&nbsp;инженерного обеспечения (водопровод, канализация, теплосети, электросети, газопровод, дороги и&nbsp;внутриквартальные проезды, сети уличного освещения и&nbsp;т.д.);</li><li>строительно-инженерные объекты (сети связи, инфраструктура ЖКХ, пункты утилизации отходов, общественные парковки и&nbsp;т.п.).</li></ul><p><a data-anchor="/document/16/219105/bssPhr57/"></a><a data-anchor="/document/16/219105/dfasg70d7l/" data-dfa="dfasg70d7l"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr58/"></a><a data-anchor="/document/16/219105/dfasedpdb1/" data-dfa="dfasedpdb1"></a>Организуйте учет по&nbsp;таким объектам раздельно. Подготовьте документы для подтверждения расходов. Все расходы на&nbsp;строительство и&nbsp;передачу должны быть детально учтены: материалы, оплата труда, подрядные услуги, прочие затраты и&nbsp;т.д.</p><p><a data-anchor="/document/16/219105/bssPhr59/"></a><a data-anchor="/document/16/219105/dfasi884bv/" data-dfa="dfasi884bv"></a><strong>Воспользуйтесь нашими справочниками и&nbsp;шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753148" data-warm-notice-type="error" num="2308" target="_blank" lnktype="intlnk" title="" class="doc">Как заключить трудовой договор с&nbsp;руководителем и&nbsp;главным бухгалтером</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753147" data-warm-notice-type="error" num="2309" target="_blank" lnktype="intlnk" title="" class="doc">Как учитывать сотрудников по&nbsp;договору ГПХ</span></li><li class="incut-v4-more-about__item"><span num="2310" target="_blank" lnktype="intlnk" title="" class="doc">Кто платит НДС</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753146" data-warm-notice-type="error" num="227" target="_self" lnktype="intlnk" title="" class="doc">Как работать строительным компаниям</span></li><li class="incut-v4-more-about__item"><span num="228" target="_self" lnktype="intlnk" title="" class="doc">Как рассчитать налог на&nbsp;прибыль коммерческой организации</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753145" data-warm-notice-type="error" num="229" target="_self" lnktype="intlnk" title="" class="doc">В&nbsp;каком порядке разработать документацию по&nbsp;организации строительства и&nbsp;производству работ</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753144" data-warm-notice-type="error" num="230" target="_self" lnktype="intlnk" title="" class="doc">Как организовать производство строительно-монтажных работ</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit4/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit4"><a data-anchor="/document/16/219105/bssPhr61/"></a><a data-anchor="/document/16/219105/dfasuh01hp/" data-dfa="dfasuh01hp"></a>НДС</h2><a data-anchor="/document/16/219105/tit5/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit5"><a data-anchor="/document/16/219105/bssPhr62/"></a><a data-anchor="/document/16/219105/dfasl5dv1z/" data-dfa="dfasl5dv1z"></a>Система автоматического&nbsp;анализа ЭСФ</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr64/"></a><a data-anchor="/document/16/219105/dfasnn078g/" data-dfa="dfasnn078g"></a>Заработала новая система контроля счетов-фактур в&nbsp;режиме реального времени. Зачет НДС возможен только при соблюдении ряда условий, в&nbsp;том числе в&nbsp;части уплаты налога и&nbsp;оценки степени риска операций (<span num="1039" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;04.09.2025 № УП-153). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="1107" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span> и&nbsp;соответствующие акты законодательства.</p><p><a data-anchor="/document/16/219105/bssPhr67/"></a><a data-anchor="/document/16/219105/dfasgcqtb4/" data-dfa="dfasgcqtb4"></a>По&nbsp;<span num="2842" target="_self" lnktype="intlnk" title="" class="doc">Указу</span>&nbsp;Президента от 04.09.2025 № УП-153 ввелся пороговый барьер для «высокорисковых» ЭСФ. Доля таких счетов-фактур не&nbsp;должна превышать 10&nbsp;процентов от&nbsp;общего количества ЭСФ, оформленных в&nbsp;отчетный период. Причем этот показатель будут рассчитывать по&nbsp;всей республике, а&nbsp;не&nbsp;только по&nbsp;отдельным предприятиям.</p><p><a data-anchor="/document/16/219105/bssPhr68/"></a><a data-anchor="/document/16/219105/dfas2zr6h6/" data-dfa="dfas2zr6h6"></a>Чтобы получить зачет НДС по&nbsp;«высокорисковому» ЭСФ, покупателю потребуется либо дождаться полной уплаты налога со&nbsp;стороны поставщика, либо самому перечислить налог в&nbsp;бюджет.</p><p><a data-anchor="/document/16/219105/bssPhr69/"></a><a data-anchor="/document/16/219105/dfasvz7o7s/" data-dfa="dfasvz7o7s"></a><a data-anchor="/document/16/219105/dfaszgksuu/" data-dfa="dfaszgksuu"></a>Новая система разработана с&nbsp;участием Международного валютного фонда (МВФ). Считается, что внедрение автоматического анализа позволит ГНК выявлять «сомнительные» или потенциально мошеннические сделки на&nbsp;ранней стадии, что снизит риски уклонения от&nbsp;уплаты налогов. Компаниям потребуется более внимательно относиться к&nbsp;оформлению ЭСФ и&nbsp;своевременной уплате НДС.</p><p><a data-anchor="/document/16/219105/bssPhr70/"></a><a data-anchor="/document/16/219105/dfaswg9r0p/" data-dfa="dfaswg9r0p"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr71/"></a><a data-anchor="/document/16/219105/dfastwpzl4/" data-dfa="dfastwpzl4"></a>Организуйте проверку контрагентов на&nbsp;риски. Убедитесь что компания работает преимущественно с&nbsp;надежными поставщиками. В&nbsp;этом вам помогут <span data-warm-notices="45753215" data-warm-notice-type="error" num="199" target="_self" lnktype="intlnk" title="" class="doc">сервисы для проверки контрагентов</span>.</p><p><a data-anchor="/document/16/219105/bssPhr72/"></a><a data-anchor="/document/16/219105/dfas8lt2fd/" data-dfa="dfas8lt2fd"></a>Проведите инструктаж сотрудников по&nbsp;новым правилам: как проверять ЭСФ, как реагировать на&nbsp;уведомления о&nbsp;«высоком риске», как общаться с&nbsp;поставщиками, если у&nbsp;них проблемы с&nbsp;налогами и&nbsp;т.д.. О&nbsp;том, как правильно оформлять электронные счета-фактуры, читайте в&nbsp;рекомендации <span data-warm-notices="41881648" data-warm-notice-type="error" num="200" target="_self" lnktype="intlnk" title="" class="doc">«Как выставить, оформить и&nbsp;учитывать электронные счета-фактуры»</span>.</p><p><a data-anchor="/document/16/219105/bssPhr73/"></a><a data-anchor="/document/16/219105/dfasoc0ibt/" data-dfa="dfasoc0ibt"></a><strong>Интерактив. Правда-ложь </strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/53397f5f-dbcd-466d-9e5c-d57dbd063296/index.html" data-itype="truefalse" data-moduleId="242" data-id="155" style="min-height:400px" width="100%"></iframe></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753140" data-warm-notice-type="error" num="57" target="_self" lnktype="intlnk" title="" class="doc">Чек-лист для бухгалтера, чтобы проверить контрагента</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753139" data-warm-notice-type="error" num="58" target="_self" lnktype="intlnk" title="" class="doc">Сервисы для проверки контрагента</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753138" data-warm-notice-type="error" num="59" target="_self" lnktype="intlnk" title="" class="doc">Как бесплатно проверить контрагента: ключевые источники</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit6/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit6"><a data-anchor="/document/16/219105/bssPhr75/"></a><a data-anchor="/document/16/219105/dfasmwpcis/" data-dfa="dfasmwpcis"></a>Льготы по НДС&nbsp;</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr78/"></a><a data-anchor="/document/16/219105/dfasd73igp/" data-dfa="dfasd73igp"></a>С&nbsp;2026 действуют льготы по&nbsp;НДС в&nbsp;сферах:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr79/"></a><a data-anchor="/document/16/219105/dfasyu6mw7/" data-dfa="dfasyu6mw7"></a><a href="https://1gb.uz/#/document/16/219105/dfasttbfrg/">ювелирного производства</a>;</li><li><a href="https://1gb.uz/#/document/16/219105/dfasrnfefu/">сельского хозяйства</a>;</li><li><a href="https://1gb.uz/#/document/16/219105/dfas7h86c4/">тепличного хозяйства</a>.</li></ul><p><a data-anchor="/document/16/219105/bssPhr80/"></a><a data-anchor="/document/16/219105/dfasttbfrg/" data-dfa="dfasttbfrg"></a><strong>Льготы для ювелирного производства</strong></p><p><a data-anchor="/document/16/219105/bssPhr81/"></a><a data-anchor="/document/16/219105/dfasia2oec/" data-dfa="dfasia2oec"></a>Ювелирные компании, фабрики и&nbsp;производственные предприятия, работающие с&nbsp;<strong>ювелирными изделиями</strong> и <strong>полуфабрикатами, изготовленными&nbsp;из драгоценных металлов и драгоценных камней</strong>, теперь обязаны уплачивать НДС независимо от&nbsp;объёма получаемого дохода. Отмена льготы по&nbsp;НДС предусмотрена Законом от 25.12.2025 № ЗРУ-1108.</p><p><a data-anchor="/document/16/219105/bssPhr82/"></a><a data-anchor="/document/16/219105/dfasqoqp82/" data-dfa="dfasqoqp82"></a>Одновременно с&nbsp;этим ввели льготу&nbsp;— такие компании освобождены от&nbsp;уплаты сбора на&nbsp;реализацию ювелирных изделий.</p><p><a data-anchor="/document/16/219105/bssPhr83/"></a><a data-anchor="/document/16/219105/dfas8e0mgg/" data-dfa="dfas8e0mgg"></a>Отменили освобождение от&nbsp;НДС оборотов по&nbsp;реализации:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr84/"></a><a data-anchor="/document/16/219105/dfasi42m2g/" data-dfa="dfasi42m2g"></a>ювелирных изделий,</li><li>полуфабрикатов, изготовленных из&nbsp;драгоценных металлов и&nbsp;драгоценных камней (<span num="1041" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;18</span>&nbsp;ч.&nbsp;1&nbsp;ст.&nbsp;243&nbsp;НК).</li></ul><p><a data-anchor="/document/16/219105/bssPhr85/"></a><a data-anchor="/document/16/219105/dfas38mggx/" data-dfa="dfas38mggx"></a>Хотим напомнить, что на&nbsp;период с&nbsp;1&nbsp;января 2024 до&nbsp;1&nbsp;января 2027 освобождается от&nbsp;НДС ввоз на&nbsp;территорию Республики Узбекистан драгоценных камней, используемых для производства ювелирных изделий (<span num="2844" target="_blank" lnktype="intlnk" title="" class="doc">ч.&nbsp;49</span>&nbsp;ст. 483&nbsp;НК).</p><p><a data-anchor="/document/16/219105/bssPhr86/"></a><a data-anchor="/document/16/219105/dfas261vi5/" data-dfa="dfas261vi5"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr87/"></a><a data-anchor="/document/16/219105/dfasgm35e3/" data-dfa="dfasgm35e3"></a>До&nbsp;конца 2025 года, если вы работаете с драгоценными изделиями и полуфабрикатами,&nbsp;надо было перейти на&nbsp;уплату НДС и&nbsp;налога на&nbsp;прибыль. Перенастройте ККМ для работы с&nbsp;НДС, обучите персонал основам учета и&nbsp;отчетности по&nbsp;НДС. В&nbsp;этом вам поможет рекомендация <span data-warm-notices="41881649" data-warm-notice-type="error" num="265" target="_self" lnktype="intlnk" title="" class="doc">«Кто платит НДС»</span>. О&nbsp;том, как перенастроить ККМ, читайте в&nbsp;рекомендации «<span num="266" target="_blank" lnktype="intlnk" title="" class="doc">Как применять онлайн-ККМ и&nbsp;виртуальную кассу</span>».</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr88/"></a><a data-anchor="/document/16/219105/dfasv07xqv/" data-dfa="dfasv07xqv"></a>Пересмотрите ценовую политику с&nbsp;учетом НДС</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr89/"></a><a data-anchor="/document/16/219105/dfashpghim/" data-dfa="dfashpghim"></a>Пересчитайте цены с&nbsp;учетом добавления 12&nbsp;процентов НДС. Внесите соответствующие изменения в&nbsp;налоговую учетную политику.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr90/"></a><a data-anchor="/document/16/219105/dfasrnfefu/" data-dfa="dfasrnfefu"></a><strong>Льготы для сельских хозяйств</strong></p><p><a data-anchor="/document/16/219105/bssPhr91/"></a><a data-anchor="/document/16/219105/dfasut2uxt/" data-dfa="dfasut2uxt"></a>Сельхозпроизводители могут применять нулевую ставку НДС на&nbsp;выращенную ими продукцию. Исключение составляет хлопок и&nbsp;зерно, на&nbsp;которые льгота не&nbsp;распространяется (<span num="2391" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;04.09.2025 № УП-153). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="2392" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span> и&nbsp;ввести соответствующей перечень.</p><p><a data-anchor="/document/16/219105/bssPhr92/"></a><a data-anchor="/document/16/219105/dfasfws7e8/" data-dfa="dfasfws7e8"></a>Перечень продукции, на&nbsp;которую будет распространяться новая льгота,&nbsp;должно утвердить Минсельхоза совместно с&nbsp;Налоговым комитетом Узбекистана. Ожидается, что список будет регулярно обновляться и&nbsp;публиковаться на&nbsp;официальных сайтах ведомств. Это позволит обеспечить прозрачность и&nbsp;доступность информации для всех сельхозпроизводителей.</p><p><a data-anchor="/document/16/219105/bssPhr93/"></a><a data-anchor="/document/16/219105/dfas75s40z/" data-dfa="dfas75s40z"></a>Для сельхозпроизводителей нулевая ставка НДС поможет сократить издержки и&nbsp;улучшить финансовое положение. Для потребителей такой шаг также имеет значение. Ожидается, что снижение налоговой нагрузки на&nbsp;сельхозпроизводителей может привести к&nbsp;уменьшению цен на&nbsp;продукцию, а&nbsp;также к&nbsp;улучшению качества товаров.</p><p><a data-anchor="/document/16/219105/bssPhr94/"></a><a data-anchor="/document/16/219105/dfasx47qhn/" data-dfa="dfasx47qhn"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr95/"></a><a data-anchor="/document/16/219105/dfasrhv8ns/" data-dfa="dfasrhv8ns"></a>Отслеживайте публикацию официального перечня продукции, на&nbsp;которую будет распространяться нулевая ставка НДС. Следите за&nbsp;публикациями на&nbsp;сайтах Минсельхоза и&nbsp;Налогового комитета. Как только список будет утвержден&nbsp;— сопоставьте продукцию предприятия с&nbsp;этим перечнем.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr96/"></a><a data-anchor="/document/16/219105/dfasx0wba2/" data-dfa="dfasx0wba2"></a>Обновите шаблоны договоров с&nbsp;контрагентами</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr97/"></a><a data-anchor="/document/16/219105/dfasggg7wp/" data-dfa="dfasggg7wp"></a>После утверждения перечня&nbsp;— включите указание на&nbsp;нулевую ставку НДС в&nbsp;договоры поставки. Внесите изменения в&nbsp;налоговую учетную политику. В&nbsp;этом вам поможет рекомендация «<span data-warm-notices="45753238" data-warm-notice-type="error" num="1248" target="_blank" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span>».</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr98/"></a><a data-anchor="/document/16/219105/dfas7h86c4/" data-dfa="dfas7h86c4"></a><strong>Льготы для тепличных хозяйств</strong></p><p data-end="607" data-start="293"><a data-anchor="/document/16/219105/bssPhr99/"></a><a data-anchor="/document/16/219105/dfas409gps/" data-dfa="dfas409gps"></a>10&nbsp;октября 2025 вступил в&nbsp;силу <span num="2845" target="_blank" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;08.10.2025 № УП-181, который ввел ряд налоговых и&nbsp;административных преференций для участников тепличного сектора, включая льготу по&nbsp;НДС.</p><p><a data-anchor="/document/16/219105/bssPhr100/"></a><a data-anchor="/document/16/219105/dfasq7ucho/" data-dfa="dfasq7ucho"></a>До&nbsp;1&nbsp;января 2028 года освобождаются от&nbsp;НДС:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr101/"></a><a data-anchor="/document/16/219105/dfast69dq7/" data-dfa="dfast69dq7"></a>сделки по&nbsp;реализации теплиц&nbsp;— как полностью построенных, так и модернизированных;</li><li>сделки по&nbsp;реализации залоговых объектов, переданных банкам и&nbsp;реализуемых в&nbsp;рамках реструктуризации или возврата кредитов, если такие объекты относятся к&nbsp;тепличным хозяйствам.</li></ul><p data-end="1199" data-start="1022"><a data-anchor="/document/16/219105/bssPhr102/"></a><a data-anchor="/document/16/219105/dfas79yard/" data-dfa="dfas79yard"></a>Освобождение от&nbsp;НДС применяется:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr103/"></a><a data-anchor="/document/16/219105/dfasxibsns/" data-dfa="dfasxibsns"></a>тепличными хозяйствами;</li><li>банками и&nbsp;кредитными организациями при реализации залоговых тепличных объектов;</li><li>инвесторами и&nbsp;организациями, приобретающими теплицы для дальнейшей деятельности.</li></ul><p data-end="1557" data-start="1457"><a data-anchor="/document/16/219105/bssPhr104/"></a><a data-anchor="/document/16/219105/dfas5g5q9n/" data-dfa="dfas5g5q9n"></a>Если сделка подпадает под перечень льготируемых операций&nbsp;— НДС не&nbsp;начисляется и&nbsp;не&nbsp;уплачивается.</p><p><a data-anchor="/document/16/219105/bssPhr105/"></a><a data-anchor="/document/16/219105/dfas3o0uop/" data-dfa="dfas3o0uop"></a><strong>Что важно сделать бухгалтеру</strong></p><p data-end="1721" data-start="1603"><a data-anchor="/document/16/219105/bssPhr106/"></a><a data-anchor="/document/16/219105/dfasbqc95b/" data-dfa="dfasbqc95b"></a>Проверьте, подпадает&nbsp;ли объект под льготу. Уточните:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr107/"></a><a data-anchor="/document/16/219105/dfas7waann/" data-dfa="dfas7waann"></a>относится&nbsp;ли имущество к&nbsp;теплицам или объектам, используемым в&nbsp;тепличном хозяйстве;</li><li>является&nbsp;ли объект залоговым и&nbsp;передан&nbsp;ли он&nbsp;банку в&nbsp;рамках кредитных обязательств.</li></ul><p data-end="2118" data-start="2043"><a data-anchor="/document/16/219105/bssPhr108/"></a><a data-anchor="/document/16/219105/dfas0i38sl/" data-dfa="dfas0i38sl"></a>Обновите налоговую учетную политику. Перепроверьте договоры и&nbsp;первичные документы. Учтите влияние льготы на&nbsp;вычеты по&nbsp;входящему НДС. Если компания продает теплицу без НДС, то:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr109/"></a><a data-anchor="/document/16/219105/dfasz8t6zs/" data-dfa="dfasz8t6zs"></a>входной НДС, относящийся к&nbsp;этим операциям, к&nbsp;вычету не&nbsp;принимается;</li><li>требуется раздельный учёт затрат, связанных с&nbsp;облагаемыми и&nbsp;необлагаемыми операциями.</li></ul><p><a data-anchor="/document/16/219105/bssPhr110/"></a><a data-anchor="/document/16/219105/dfasn9b3m4/" data-dfa="dfasn9b3m4"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753150" data-warm-notice-type="error" num="263" target="_self" lnktype="intlnk" title="" class="doc">Справочник по&nbsp;налогу: НДС</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753149" data-warm-notice-type="error" num="264" target="_self" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit7/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit7"><a data-anchor="/document/16/219105/bssPhr112/"></a><a data-anchor="/document/16/219105/dfas5mo5vq/" data-dfa="dfas5mo5vq"></a>Налог с оборота</h2><a data-anchor="/document/16/219105/tit8/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit8"><a data-anchor="/document/16/219105/bssPhr113/"></a><a data-anchor="/document/16/219105/dfasyxd7uz/" data-dfa="dfasyxd7uz"></a>Переход с налога с оборота на НДС</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr116/"></a><a data-anchor="/document/16/219105/dfasutli7f/" data-dfa="dfasutli7f"></a>Компании, которые впервые переходят с&nbsp;уплаты налога с&nbsp;оборота на&nbsp;НДС&nbsp;— в&nbsp;течение года освобождаются от&nbsp;налога на&nbsp;прибыль и&nbsp;от&nbsp;штрафов за&nbsp;нарушения порядка регистрации как плательщика НДС (<span num="1044" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;19.08.2025 № УП-138). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="1110" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr117/"></a><a data-anchor="/document/16/219105/dfas06btgb/" data-dfa="dfas06btgb"></a>С&nbsp;1&nbsp;января 2026 часть заработной платы бухгалтеров до&nbsp;3,5&nbsp;МРОТ в&nbsp;течение 6&nbsp;месяцев сумма будет вычитаться из&nbsp;налогов, уплаченных предприятиями, впервые перешедшими с&nbsp;налога с&nbsp;оборота на&nbsp;НДС.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-advice "><h3 class="incut-v4__tag" data-incut-toggle="">Совет</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr118/"></a><a data-anchor="/document/16/219105/dfasvv8lvv/" data-dfa="dfasvv8lvv"></a>Проверьте, чтобы у&nbsp;бухгалтера был подписанный трудовой договор, а&nbsp;начисления зарплаты отражались в&nbsp;учете.</p><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr120/"></a><a data-anchor="/document/16/219105/dfasdre97g/" data-dfa="dfasdre97g"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr121/"></a><a data-anchor="/document/16/219105/dfashm1bbu/" data-dfa="dfashm1bbu"></a>Подайте заявление о&nbsp;переходе на&nbsp;НДС не&nbsp;позднее 7&nbsp;дней, с&nbsp;момента формирования обязательств по&nbsp;оплате налога. О&nbsp;том, как перейти с&nbsp;налога с&nbsp;оборота на&nbsp;НДС и&nbsp;налог на&nbsp;прибыль, читайте в&nbsp;рекомендации «<span num="369" target="_blank" lnktype="intlnk" title="" class="doc">Кто платит НДС</span>».</p><p><a data-anchor="/document/16/219105/bssPhr122/"></a><a data-anchor="/document/16/219105/dfas502zbq/" data-dfa="dfas502zbq"></a>Оформите бухгалтера по&nbsp;трудовому договору или договору ГПХ, так как льгота применяется только если бухгалтер работает официально. О&nbsp;том, как заключить трудовой договор с&nbsp;главным бухгалтером, читайте в <span data-warm-notices="45753214" data-warm-notice-type="error" num="370" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr123/"></a><a data-anchor="/document/16/219105/dfas9p37mo/" data-dfa="dfas9p37mo"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="85" target="_self" lnktype="intlnk" title="" class="doc">Кто платит НДС</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753142" data-warm-notice-type="error" num="86" target="_self" lnktype="intlnk" title="" class="doc">Как заключить трудовой договор с&nbsp;руководителем и&nbsp;главным бухгалтером</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753141" data-warm-notice-type="error" num="87" target="_self" lnktype="intlnk" title="" class="doc">Как учитывать сотрудников по&nbsp;договору ГПХ</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit9/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit9"><a data-anchor="/document/16/219105/bssPhr125/"></a><a data-anchor="/document/16/219105/dfaswi2r86/" data-dfa="dfaswi2r86"></a>Отмена фиксированных ставок налога с оборота</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr128/"></a><a data-anchor="/document/16/219105/dfastf0l76/" data-dfa="dfastf0l76"></a>С&nbsp;1&nbsp;января 2026 бизнес больше не&nbsp;может применять фиксированные годовые ставки налога с&nbsp;оборота&nbsp;— вместо них все предприниматели обязаны рассчитывать налог по&nbsp;стандартной ставке 4&nbsp;процента от&nbsp;совокупного дохода (<span num="1045" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;32</span>&nbsp;ст.&nbsp;3&nbsp;Закона от&nbsp;24.12.2024 № ЗРУ-1014). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="1111" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr129/"></a><a data-anchor="/document/16/219105/dfaswc5y16/" data-dfa="dfaswc5y16"></a><a data-anchor="/document/16/219105/dfas9mdveg/" data-dfa="dfas9mdveg"></a><a data-anchor="/document/16/219105/dfasstai3e/" data-dfa="dfasstai3e"></a><a data-anchor="/document/16/219105/dfasek7ivq/" data-dfa="dfasek7ivq"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr130/"></a><a data-anchor="/document/16/219105/dfasl86qrg/" data-dfa="dfasl86qrg"></a>Определите, какой была&nbsp;бы сумма налога по&nbsp;новой ставке 4&nbsp;процента за&nbsp;2025 год&nbsp;— чтобы оценить потенциальную налоговую нагрузку с&nbsp;2026&nbsp;года. Сравните прошлые фиксированные платежи (30&nbsp;млн или 40&nbsp;млн сумов в&nbsp;год) и&nbsp;сумму 4&nbsp;процента от&nbsp;совокупного дохода. Это поможет заранее спрогнозировать рост расходов.</p><p><a data-anchor="/document/16/219105/bssPhr131/"></a><a data-anchor="/document/16/219105/dfasgngn5e/" data-dfa="dfasgngn5e"></a>Обновите договоры с&nbsp;контрагентами и&nbsp;ценовую политику. Пересмотрите стоимость товаров и&nbsp;услуг, так как переход на&nbsp;4&nbsp;процента повлечет существенное увеличение налогов. Вы&nbsp;можете воспользоваться нашим <span data-warm-notices="45753232" data-warm-notice-type="error" num="371" target="_self" lnktype="intlnk" title="" class="doc">образцом договора на&nbsp;поставку товаров</span>. Внесите соответствующие изменения в&nbsp;налоговую <span num="2846" target="_blank" lnktype="intlnk" title="" class="doc">учетную политику</span>. Образец ниже.</p><p><a data-anchor="/document/16/219105/bssPhr132/"></a><a data-anchor="/document/16/219105/dfas3loz9z/" data-dfa="dfas3loz9z"></a><strong>Образец учетной политики в целях налогообложения</strong></p><span data-warm-notices="" data-warm-notice-type="" num="1160" target="_blank" lnktype="intlnk" title="" class="doc"><img alt="" hideborder="true" class="inimg" num="26" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></span><p style="text-align:center"><a data-anchor="/document/16/219105/bssPhr133/"></a><a data-anchor="/document/16/219105/dfas1x7c2l/" data-dfa="dfas1x7c2l"></a><span num="1161" target="_blank" lnktype="intlnk" title="" class="doc">Скачать образец</span></p><p><a data-anchor="/document/16/219105/bssPhr134/"></a><a data-anchor="/document/16/219105/dfaszttt7n/" data-dfa="dfaszttt7n"></a><strong>Памятка. Что важно проверить в налоге с оборота</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/8096c68d-de0d-4bb2-a855-6efd9e61eb25/index.html" data-itype="memo" data-moduleId="53" data-id="637" style="min-height:400px" width="100%"></iframe></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753143" data-warm-notice-type="error" num="114" target="_self" lnktype="intlnk" title="" class="doc">Как рассчитать налог с&nbsp;оборота</span></li><li class="incut-v4-more-about__item"><span num="116" target="_self" lnktype="intlnk" title="" class="doc">Как заполнить и&nbsp;сдать расчет по&nbsp;налогу с&nbsp;оборота</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit10/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit10"><a data-anchor="/document/16/219105/bssPhr136/"></a><a data-anchor="/document/16/219105/dfash2myxn/" data-dfa="dfash2myxn"></a>НДФЛ, социальный и&nbsp;ресурсные налоги</h2><a data-anchor="/document/16/219105/tit11/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit11"><a data-anchor="/document/16/219105/bssPhr137/"></a><a data-anchor="/document/16/219105/dfast6c9tr/" data-dfa="dfast6c9tr"></a>Автоматическая отчетность</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr141/"></a><a data-anchor="/document/16/219105/dfas8bp0um/" data-dfa="dfas8bp0um"></a>Отчеты по&nbsp;земельному, имущественному, подоходному и&nbsp;социальному налогам за&nbsp;предпринимателей будут формировать налоговики. Значит, чтобы налоговая база формировалась верно, важно убедиться, что документы оформлены верно, сведения у&nbsp;налоговиков корректные (Указ Президента от&nbsp;19.08.2025 № <span num="1928" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>). Предполагаем, что нужно дождаться заявлений налоговых органов в&nbsp;их <a href="https://t.me/soliq_qonunchiligi_bot" target="_blank" title="">телеграм-канале</a>.</p><p><a data-anchor="/document/16/219105/bssPhr142/"></a><a data-anchor="/document/16/219105/dfas4f2ft3/" data-dfa="dfas4f2ft3"></a>Налогоплательщик имеет право внести необходимые исправления в&nbsp;отчетность, сформированную налоговыми органами, и&nbsp;представить исправленную налоговую отчетность в&nbsp;течение 5&nbsp;рабочих дней.</p><p><a data-anchor="/document/16/219105/bssPhr143/"></a><a data-anchor="/document/16/219105/dfast09wgv/" data-dfa="dfast09wgv"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr144/"></a><a data-anchor="/document/16/219105/dfasazxgme/" data-dfa="dfasazxgme"></a>Проверьте точность всех данных, передаваемых в&nbsp;налоговые органы. Что именно нужно проверить:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr145/"></a><a data-anchor="/document/16/219105/dfasms3pea/" data-dfa="dfasms3pea"></a>кадастровые данные земельных участков и&nbsp;объектов недвижимости: адреса, площади, целевое назначение, наличие правоустанавливающих документов;</li><li>количество работников и&nbsp;сведения о&nbsp;них: корректность данных по&nbsp;зарплатам, соцналогу, НДФЛ и&nbsp;ИНПС, ПИНФЛ и&nbsp;т.д.;</li><li>остаточную стоимость основных средств, наличие/отсутствие на&nbsp;балансе на&nbsp;1&nbsp;января 2026.</li></ul><p data-end="2716" data-start="2680"><a data-anchor="/document/16/219105/bssPhr146/"></a><a data-anchor="/document/16/219105/dfas9b8kz5/" data-dfa="dfas9b8kz5"></a>Установите внутренний регламент:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr147/"></a><a data-anchor="/document/16/219105/dfas4mgi7u/" data-dfa="dfas4mgi7u"></a>кто проверяет автоматические отчеты;</li><li>кто и&nbsp;как вносит исправления (в&nbsp;течение 5&nbsp;рабочих дней);</li><li>как документировать замечания и&nbsp;корректировки.</li></ul><p><a data-anchor="/document/16/219105/bssPhr148/"></a><a data-anchor="/document/16/219105/dfasewky2a/" data-dfa="dfasewky2a"></a>Внесите изменения в&nbsp;налоговую учетную политику. Как составить учетную политику в&nbsp;целях налогообложения, читайте в <span data-warm-notices="45753205" data-warm-notice-type="error" num="406" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr149/"></a><a data-anchor="/document/16/219105/dfasl4zm7a/" data-dfa="dfasl4zm7a"></a><strong>Интерактив. Правда-ложь </strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/5cf6ce15-6cca-45f7-abdb-bc73f0e4b9a3/index.html" data-itype="truefalse" data-moduleId="242" data-id="157" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/219105/bssPhr150/"></a><a data-anchor="/document/16/219105/dfasq6v3nw/" data-dfa="dfasq6v3nw"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753153" data-warm-notice-type="error" num="365" target="_self" lnktype="intlnk" title="" class="doc">Как заполнять формы налоговой отчетности по&nbsp;налогу на&nbsp;имущество юридических лиц</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753152" data-warm-notice-type="error" num="366" target="_self" lnktype="intlnk" title="" class="doc">Как предоставлять отчетность и&nbsp;уплачивать земельный налог</span></li><li class="incut-v4-more-about__item"><span num="367" target="_self" lnktype="intlnk" title="" class="doc">Как составить и&nbsp;сдать расчет по&nbsp;НДФЛ и&nbsp;социальному налогу</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753151" data-warm-notice-type="error" num="368" target="_self" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit12/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit12"><a data-anchor="/document/16/219105/bssPhr152/"></a><a data-anchor="/document/16/219105/dfas5026y2/" data-dfa="dfas5026y2"></a>Льготы по НДФЛ, социальному и&nbsp;ресурсным налогам</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p data-semantic-type="paragraph"><a data-anchor="/document/16/219105/bssPhr155/"></a><a data-anchor="/document/16/219105/dfasq6dacg/" data-dfa="dfasq6dacg"></a>С 2026 действуют льготы по НДФЛ, социальному и ресурсным налогам для:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr156/"></a><a data-anchor="/document/16/219105/dfasmmmtiy/" data-dfa="dfasmmmtiy"></a><a href="https://1gb.uz/#/document/16/219105/dfas6fuas7/">иностранных граждан</a>;</li><li><a href="https://1gb.uz/#/document/16/219105/dfasptomhc/">тепличного хозяйства</a>;</li><li><a href="https://1gb.uz/#/document/16/219105/dfasu7puax/">промышленности</a>.&nbsp;</li></ul><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr157/"></a><a data-anchor="/document/16/219105/dfas6fuas7/" data-dfa="dfas6fuas7"></a><strong>Льготы для иностранных граждан</strong></p><p><a data-anchor="/document/16/219105/bssPhr158/"></a><a data-anchor="/document/16/219105/dfasyme354/" data-dfa="dfasyme354"></a>С&nbsp;1&nbsp;января 2026 иностранные граждане вправе подать заявление и&nbsp;получить освобождение от&nbsp;НДФЛ с&nbsp;доходов, полученных из&nbsp;источников за&nbsp;пределами Республики Узбекистан при одновременном выполнении условий:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr159/"></a><a data-anchor="/document/16/219105/dfas82xbzz/" data-dfa="dfas82xbzz"></a>нахождение на&nbsp;территории Узбекистана более 30&nbsp;календарных дней в&nbsp;течение последовательных 12&nbsp;месяцев;</li><li>наличие недвижимости;</li><li>банковского счета/криптокошелька;</li><li>уплата сбора.</li></ul><p><a data-anchor="/document/16/219105/bssPhr160/"></a><a data-anchor="/document/16/219105/dfasve4tqc/" data-dfa="dfasve4tqc"></a>При этом иностранный гражданин приобретает статус налогового резидента и&nbsp;уже может пользоваться льготами по&nbsp;НДФЛ, предоставленными Налоговым кодексом (Указ Президента от&nbsp;04.10.2025 <span num="2932" target="_blank" lnktype="intlnk" title="" class="doc">№ УП-180</span>).</p><p><a data-anchor="/document/16/219105/bssPhr161/"></a><a data-anchor="/document/16/219105/dfasl1acyp/" data-dfa="dfasl1acyp"></a>Освобождение оформляется через заявление в&nbsp;Комиссию при ГНК, решение будет приниматься в&nbsp;течение пяти рабочих дней. Льгота также распространяется на&nbsp;совершеннолетних родственников при уплате сбора. Для бизнеса и&nbsp;бухгалтерии это означает необходимость корректно определять налоговый статус иностранных сотрудников, чтобы не&nbsp;допустить переплату НДФЛ или ошибок в&nbsp;удержаниях.</p><p><a data-anchor="/document/16/219105/bssPhr162/"></a><a data-anchor="/document/16/219105/dfasmv1kgm/" data-dfa="dfasmv1kgm"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr163/"></a><a data-anchor="/document/16/219105/dfasq9i11h/" data-dfa="dfasq9i11h"></a>Проверьте всех иностранных сотрудников и&nbsp;их&nbsp;налоговый статус. Обновите правила определения статуса резидента (30&nbsp;дней + дополнительные условия). Запросите у&nbsp;иностранных работников подтверждающие документы:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr164/"></a><a data-anchor="/document/16/219105/dfasw42xxi/" data-dfa="dfasw42xxi"></a>подтверждение нахождения в&nbsp;Узбекистане более 30&nbsp;дней;</li><li>документы на&nbsp;недвижимость (собственность или договор аренды);</li><li>подтверждение открытия банковского счёта или криптокошелька;</li><li>подтверждение уплаты сбора (50&nbsp;000&nbsp;USD&nbsp;/ 10&nbsp;000&nbsp;USD для родственников).</li></ul><p><a data-anchor="/document/16/219105/bssPhr165/"></a><a data-anchor="/document/16/219105/dfasi4cgu2/" data-dfa="dfasi4cgu2"></a>При необходимости внесите изменения в&nbsp;налоговую учетную политику. О&nbsp;том как составить учетную политику в&nbsp;целях налогообложения, читайте в <span data-warm-notices="45753253" data-warm-notice-type="error" num="2759" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr166/"></a><a data-anchor="/document/16/219105/dfasptomhc/" data-dfa="dfasptomhc"></a><strong>Льготы для тепличных хозяйств</strong></p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr167/"></a><a data-anchor="/document/16/219105/dfash9l3k5/" data-dfa="dfash9l3k5"></a>Тепличные хозяйства получили налоговые, финансовые и&nbsp;административные послабления, снижены налоговые ставки и&nbsp;продлены сроки погашения задолженности по&nbsp;налогам на&nbsp;3&nbsp;года. Эти и&nbsp;другие преференции предусматривает Указ Президента от&nbsp;08.10.2025 <span num="2933" target="_blank" lnktype="intlnk" title="" class="doc">№ УП-181</span>.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr168/"></a><a data-anchor="/document/16/219105/dfasw167d7/" data-dfa="dfasw167d7"></a>С&nbsp;1&nbsp;января 2026 по&nbsp;31&nbsp;декабря 2028 для предприятий, у&nbsp;которых не&nbsp;менее 60&nbsp;процентов совокупного дохода приходится на&nbsp;тепличное производство, ставка социального налога установлена на&nbsp;уровне 1&nbsp;процента.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr169/"></a><a data-anchor="/document/16/219105/dfas89zb3h/" data-dfa="dfas89zb3h"></a>Земельный налог для тепличных хозяйств рассчитывается по&nbsp;ставкам для сельхозземель вне зависимости от&nbsp;категории земельного фонда. При этом с&nbsp;января 2025 производится перерасчет ранее начисленных сумм, если налог исчислялся по&nbsp;ставкам земель несельскохозяйственного назначения.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr170/"></a><a data-anchor="/document/16/219105/dfas473ln8/" data-dfa="dfas473ln8"></a>Списание задолженности:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr171/"></a><a data-anchor="/document/16/219105/dfasuhoi3f/" data-dfa="dfasuhoi3f"></a>срок уплаты налоговой задолженности по&nbsp;состоянию на&nbsp;1&nbsp;октября 2025 продлевается до&nbsp;конца 2028 года без начисления процентов;</li><li>уплата производится равными долями ежеквартально до&nbsp;2029&nbsp;года;</li><li>все штрафы, пени и&nbsp;инкассовые поручения по&nbsp;долгам тепличных хозяйств отменяются и&nbsp;отзываются.</li></ul><p><a data-anchor="/document/16/219105/bssPhr172/"></a><a data-anchor="/document/16/219105/dfasnd4eyt/" data-dfa="dfasnd4eyt"></a><strong>Что важно сделать бухгалтеру</strong></p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr173/"></a><a data-anchor="/document/16/219105/dfas7r86uh/" data-dfa="dfas7r86uh"></a>обновите систему расчета соцналога. В&nbsp;программе 1С измените ставку соцналога на&nbsp;1&nbsp;процент для «теплиц»;</li><li>проверьте налоги и&nbsp;задолженности за&nbsp;прошлые периоды. Если есть налоговая задолженность (соцналог, штрафы и&nbsp;т.п.)&nbsp;— оцените ее&nbsp;с&nbsp;учетом нового срока уплаты до&nbsp;конца 2028&nbsp;года, спланируйте поэтапное погашение;</li><li>пересчитайте земельный налог, если земля раньше учитывалась как «не&nbsp;сельхоз». Проведите ревизию земельных актов и&nbsp;договоров аренды/собственности. При необходимости оформите перевод земли в&nbsp;категорию сельскохозяйственной&nbsp;— чтобы льгота на&nbsp;земельный налог начала действовать;</li><li>внесите изменения в&nbsp;налоговую учетную политику.</li></ul><p><a data-anchor="/document/16/219105/bssPhr174/"></a><a data-anchor="/document/16/219105/dfasu7puax/" data-dfa="dfasu7puax"></a><strong>Льготы для промышленных предприятий</strong></p><p><a data-anchor="/document/16/219105/bssPhr175/"></a><a data-anchor="/document/16/219105/dfasipepra/" data-dfa="dfasipepra"></a>С&nbsp;1&nbsp;января 2026 вступили в&nbsp;силу новые льготы для промышленных предприятий, предусмотренные Постановлением Президента от&nbsp;04.10.2025 <span num="3019" target="_blank" lnktype="intlnk" title="" class="doc">№ ПП-295</span>. Они будут действовать до&nbsp;1&nbsp;января 2028 и&nbsp;направлены на&nbsp;поддержку бизнеса и&nbsp;снижение налоговой нагрузки.</p><p><a data-anchor="/document/16/219105/bssPhr176/"></a><a data-anchor="/document/16/219105/dfasch5v4y/" data-dfa="dfasch5v4y"></a>Промышленные предприятия могут из&nbsp;налогооблагаемой базы социального налога вычитать расходы на&nbsp;транспортировку и&nbsp;питание работников&nbsp;— до&nbsp;1&nbsp;БРВ в&nbsp;месяц на&nbsp;каждого сотрудника. Но&nbsp;льгота действует только при выполнении двух условий:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr177/"></a><a data-anchor="/document/16/219105/dfas2h9d0r/" data-dfa="dfas2h9d0r"></a>средняя заработная плата на&nbsp;предприятии должна быть не&nbsp;ниже 2&nbsp;минимальных размеров оплаты труда. На&nbsp;2026 год это&nbsp;— 2,542 млн сумов в&nbsp;месяц;</li><li>не&nbsp;менее 60&nbsp;процентов объема реализации должно приходиться на&nbsp;определённые виды продукции (приложение №&nbsp;4, утв. Постановлением&nbsp;Президента от&nbsp;04.10.2025 № ПП-295). Если оба условия соблюдаются, предприятия смогут экономить на&nbsp;соцналоге в&nbsp;течение двух лет.</li></ul><p><a data-anchor="/document/16/219105/bssPhr178/"></a><a data-anchor="/document/16/219105/dfastu6186/" data-dfa="dfastu6186"></a>Также с&nbsp;1&nbsp;января 2026 до&nbsp;1&nbsp;января 2028 предприятия, добывающие гипсовое сырьё для собственных нужд и&nbsp;производящие стройматериалы, платят на&nbsp;50&nbsp;процентов меньше налога за&nbsp;пользование недрами. Это позволит снизить себестоимость продукции и&nbsp;поддержать строительную отрасль.</p><p><a data-anchor="/document/16/219105/bssPhr179/"></a><a data-anchor="/document/16/219105/dfaslxvbog/" data-dfa="dfaslxvbog"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr180/"></a><a data-anchor="/document/16/219105/dfasigyv19/" data-dfa="dfasigyv19"></a>Чтобы льготы можно было применять с&nbsp;первого дня, бухгалтерии важно подготовиться заранее:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr181/"></a><a data-anchor="/document/16/219105/dfasfg89fp/" data-dfa="dfasfg89fp"></a>проверьте выполнение условий по&nbsp;зарплате. Проанализируйте фонд оплаты труда за&nbsp;последние месяцы. Убедитесь, что средняя заработная плата сотрудников не&nbsp;менее 2&nbsp;МРОТ. При необходимости согласуйте с&nbsp;руководством корректировку зарплат.</li><li>проверьте, относится&nbsp;ли предприятие к&nbsp;тем видам деятельности, которые подпадают под льготу. Посчитайте долю реализации по&nbsp;перечню&nbsp;— должна быть не&nbsp;менее 60&nbsp;процентов.</li><li>внесите настройки в&nbsp;1С. Исключите расходы на&nbsp;транспорт и&nbsp;питание работников (до&nbsp;1&nbsp;БРВ) из&nbsp;базы соцналога.</li><li>скорректируйте налоговую учетную политику при необходимости. О&nbsp;том, как составить учетную политику в&nbsp;целях налогообложения, читайте в <span data-warm-notices="45753252" data-warm-notice-type="error" num="2538" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</li></ul><p><a data-anchor="/document/16/219105/bssPhr182/"></a><a data-anchor="/document/16/219105/dfaset2hso/" data-dfa="dfaset2hso"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="1724" target="_blank" lnktype="intlnk" title="" class="doc">Как рассчитать среднюю заработную плату в&nbsp;2025 году</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753194" data-warm-notice-type="error" num="2751" target="_blank" lnktype="intlnk" title="" class="doc">Как налоговому агенту рассчитать НДФЛ</span></li><li class="incut-v4-more-about__item"><span num="2604" target="_blank" lnktype="intlnk" title="" class="doc">Как составить и&nbsp;сдать расчет по&nbsp;НДФЛ и&nbsp;социальному налогу</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753193" data-warm-notice-type="error" num="1725" target="_blank" lnktype="intlnk" title="" class="doc">Как оформить питание для работников</span></li><li class="incut-v4-more-about__item"><span num="1726" target="_blank" lnktype="intlnk" title="" class="doc">Кто платит налог за&nbsp;пользование недрами</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753192" data-warm-notice-type="error" num="1727" target="_blank" lnktype="intlnk" title="" class="doc">Как рассчитать, перечислить в&nbsp;бюджет и&nbsp;сдать отчетность по&nbsp;налогу за&nbsp;пользование недрами</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753191" data-warm-notice-type="error" num="2605" target="_blank" lnktype="intlnk" title="" class="doc">Как рассчитать земельный налог с&nbsp;юридических лиц</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753190" data-warm-notice-type="error" num="2606" target="_blank" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit13/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit13"><a data-anchor="/document/16/219105/bssPhr184/"></a><a data-anchor="/document/16/219105/dfasqsihid/" data-dfa="dfasqsihid"></a>Обязательный переход на МСФО</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr186/"></a><a data-anchor="/document/16/219105/dfas08iag6/" data-dfa="dfas08iag6"></a>C&nbsp;1&nbsp;января 2026 особо значимые компании для общества переходят на&nbsp;МСФО (Постановление Президента от&nbsp;15.09.2025 № <span num="1048" target="_self" lnktype="intlnk" title="" class="doc">ПП-282</span>). Министерство экономики и&nbsp;финансов будет вести новый электронный Реестр общественно значимых организаций на&nbsp;платформах <a href="https://gov.uz/ru" target="_blank" title="">gov.uz</a> и <a href="https://data.egov.uz/rus" target="_blank" title="">data.egov.uz</a>. В&nbsp;нем будут отражены субъекты предпринимательства с&nbsp;высоким социальным или экономическим влиянием, широким кругом заинтересованных сторон. Критерии включения будут определяться по&nbsp;видам деятельности и&nbsp;размеру активов компаний.</p><p><a data-anchor="/document/16/219105/bssPhr188/"></a><a data-anchor="/document/16/219105/dfast4alt3/" data-dfa="dfast4alt3"></a>C&nbsp;1&nbsp;января 2026 особо значимые компании для общества переходят на&nbsp;МСФО. Министерство экономики и&nbsp;финансов будет вести новый электронный Реестр общественно значимых организаций на&nbsp;платформах <a href="https://gov.uz/ru" target="_blank" title="">gov.uz</a> и <a href="https://data.egov.uz/rus" target="_blank" title="">data.egov.uz</a>. Если вашу компанию включат в&nbsp;новый реестр, потребуется вести учет по&nbsp;МСФО&nbsp;— но&nbsp;только с&nbsp;1&nbsp;января года, следующего за&nbsp;годом включения в&nbsp;реестр.</p><p><a data-anchor="/document/16/219105/bssPhr189/"></a><a data-anchor="/document/16/219105/dfasys0x6k/" data-dfa="dfasys0x6k"></a>Если вашу компанию включат в&nbsp;новый реестр, потребуется вести учет по&nbsp;МСФО&nbsp;— но&nbsp;только с&nbsp;1&nbsp;января года, следующего за&nbsp;годом включения в&nbsp;реестр. А&nbsp;по&nbsp;итогам второго года надо будет составлять финансовую отчетность по&nbsp;МСФО и&nbsp;публиковать ее&nbsp;вместе с&nbsp;аудиторским заключением (если иное не&nbsp;установлено ранее принятыми нормами).</p><p><a data-anchor="/document/16/219105/bssPhr190/"></a><a data-anchor="/document/16/219105/dfas3cng0a/" data-dfa="dfas3cng0a"></a>В&nbsp;связи с&nbsp;введением новых требований, с&nbsp;декабря 2025 утратили силу отдельные положения Постановления Президента от&nbsp;24.02.2020 № <span num="1049" target="_self" lnktype="intlnk" title="" class="doc">ПП-4611</span>, включая:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr191/"></a><a data-anchor="/document/16/219105/dfasq9hg97/" data-dfa="dfasq9hg97"></a>обязательство вести учет по&nbsp;МСФО для&nbsp;АО, банков, страховых компаний и&nbsp;крупных налогоплательщиков;</li><li>требование иметь в&nbsp;штате минимум 3&nbsp;специалистов с&nbsp;международными сертификатами (ACCA, CIPA, CPA, DipIFR).</li></ul><p><a data-anchor="/document/16/219105/bssPhr192/"></a><a data-anchor="/document/16/219105/dfasalsz3t/" data-dfa="dfasalsz3t"></a>Организации вправе добровольно перейти на&nbsp;МСФО. Если ваша компания решила вести учет и&nbsp;отчитываться по&nbsp;МСФО уже в&nbsp;отчетном году&nbsp;— до&nbsp;1&nbsp;марта следующего отчетного года направьте уведомление через личный кабинет налогоплательщика.</p><p><a data-anchor="/document/16/219105/bssPhr193/"></a><a data-anchor="/document/16/219105/dfasextidr/" data-dfa="dfasextidr"></a>При первом применении МСФО в&nbsp;первоначальном отчете о&nbsp;финансовом положении отразите сравнительную информацию на&nbsp;дату предыдущего сопоставимого периода. Это упростит переход на&nbsp;новые стандарты.</p><p><a data-anchor="/document/16/219105/bssPhr194/"></a><a data-anchor="/document/16/219105/dfas7v9zfz/" data-dfa="dfas7v9zfz"></a>Планируется автоматизировать сдачу отчетов по&nbsp;МСФО в&nbsp;системах ERP (планирования ресурсов предприятия) и&nbsp;на&nbsp;профессиональном бухгалтерском ПО. Первые этапы Минэкономфин начал внедрять уже в&nbsp;ноябре 2025&nbsp;года.</p><p><a data-anchor="/document/16/219105/bssPhr195/"></a><a data-anchor="/document/16/219105/dfas8wct6l/" data-dfa="dfas8wct6l"></a>В&nbsp;декабре 2025 года ведомство подготовило новую редакцию Закона «О&nbsp;бухгалтерском учете и&nbsp;финансовой отчетности<strong>»</strong>. Она стала законодательной базой для внедрения МСФО в&nbsp;Узбекистане.</p><p><a data-anchor="/document/16/219105/bssPhr196/"></a><a data-anchor="/document/16/219105/dfasqnrpbv/" data-dfa="dfasqnrpbv"></a>Реформа учета по&nbsp;правилам международных стандартов распланирована на&nbsp;несколько лет. В&nbsp;январе 2026 года ожидается разработка:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr197/"></a><a data-anchor="/document/16/219105/dfas388nnm/" data-dfa="dfas388nnm"></a>стандартизированных форм финансовой отчетности, включая консолидированную;</li><li>типового плана счетов, адаптированного под МСФО;</li><li>инструкции по&nbsp;применению плана счетов по&nbsp;МСФО.</li></ul><p><a data-anchor="/document/16/219105/bssPhr198/"></a><a data-anchor="/document/16/219105/dfasaegqzl/" data-dfa="dfasaegqzl"></a>В&nbsp;2026-2028 годах государство будет компенсировать расходы граждан (на&nbsp;первичную регистрацию и&nbsp;сдачу экзаменов), успешно сдавших экзамены в&nbsp;рамках международной сертификации бухгалтеров. Речь идет о&nbsp;следующих квалификациях:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr199/"></a><a data-anchor="/document/16/219105/dfasucrwzl/" data-dfa="dfasucrwzl"></a>ACCA DipIFR (диплом по&nbsp;международной финансовой отчетности);</li><li>Сертификаты по&nbsp;дисциплинам «Финансовая отчетность по&nbsp;МСФО», «Аудит» и&nbsp;другим.</li></ul><p><a data-anchor="/document/16/219105/bssPhr200/"></a><a data-anchor="/document/16/219105/dfas2xbheu/" data-dfa="dfas2xbheu"></a>В&nbsp;страховых организациях ожидается приведение учета в&nbsp;соответствие с&nbsp;МСФО и&nbsp;европейской нормативной системой Solvency II. В&nbsp;частности, будет обновлена методика формирования страховых резервов и&nbsp;оценки платежеспособности страховщиков. Но&nbsp;проект нормативного акта ожидается только к&nbsp;декабрю 2026&nbsp;года.</p><p><a data-anchor="/document/16/219105/bssPhr201/"></a><a data-anchor="/document/16/219105/dfastyk9rk/" data-dfa="dfastyk9rk"></a><a data-anchor="/document/16/219105/dfasx430y4/" data-dfa="dfasx430y4"></a>Все ключевые этапы реформы и&nbsp;контрольные сроки зафиксированы в&nbsp;Дорожной карте, приложение №&nbsp;2&nbsp;к Постановлению Президента от&nbsp;15.09.2025 № <span num="1050" target="_self" lnktype="intlnk" title="" class="doc">ПП-282</span>.</p><p><a data-anchor="/document/16/219105/bssPhr202/"></a><a data-anchor="/document/16/219105/dfascwo368/" data-dfa="dfascwo368"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr203/"></a><a data-anchor="/document/16/219105/dfas94v8gf/" data-dfa="dfas94v8gf"></a>Определите статус компании. Проверьте, входит&nbsp;ли компания в&nbsp;новый Реестр общественно значимых организаций. Если вас включили в&nbsp;Реестр, готовьтесь к&nbsp;переходу на&nbsp;МСФО с&nbsp;1&nbsp;января 2027. Если компания решила перейти на&nbsp;МСФО добровольно, отправьте уведомление в&nbsp;налоговую до&nbsp;1&nbsp;марта 2026.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-advice "><h3 class="incut-v4__tag" data-incut-toggle="">Совет</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr204/"></a><a data-anchor="/document/16/219105/dfast9b5iu/" data-dfa="dfast9b5iu"></a>Начните подготовку внутренних регламентов, учетной политики и&nbsp;программного обеспечения к&nbsp;работе по&nbsp;МСФО</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr205/"></a><a data-anchor="/document/16/219105/dfasv9em56/" data-dfa="dfasv9em56"></a>Организуйте обучение и&nbsp;повышение квалификации своих бухгалтеров по&nbsp;МСФО. В&nbsp;этом вам поможет рекомендация <span data-warm-notices="41960422" data-warm-notice-type="error" num="1252" target="_self" lnktype="intlnk" title="" class="doc">«Как начать работать по&nbsp;МСФО»</span></p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr206/"></a><a data-anchor="/document/16/219105/dfas1zonng/" data-dfa="dfas1zonng"></a>Ознакомьтесь с&nbsp;проектом новой редакции Закона «О&nbsp;бухгалтерском учете и&nbsp;финансовой отчетности», который будет готов к&nbsp;декабрю 2025&nbsp;года.</p><p><a data-anchor="/document/16/219105/bssPhr207/"></a><a data-anchor="/document/16/219105/dfasoum8gx/" data-dfa="dfasoum8gx"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="437" target="_self" lnktype="intlnk" title="" class="doc">Как перейти на&nbsp;МСФО</span></li><li class="incut-v4-more-about__item"><span num="438" target="_self" lnktype="intlnk" title="" class="doc">Как формировать финансовую отчетность по&nbsp;МСФО</span></li><li class="incut-v4-more-about__item"><span num="439" target="_self" lnktype="intlnk" title="" class="doc">Как составить баланс по&nbsp;МСФО</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit14/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit14"><a data-anchor="/document/16/219105/bssPhr209/"></a><a data-anchor="/document/16/219105/dfasauiczg/" data-dfa="dfasauiczg"></a>Внешнеторговые операций</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr212/"></a><a data-anchor="/document/16/219105/dfas52thyf/" data-dfa="dfas52thyf"></a>Ввели моратории на&nbsp;наложение и&nbsp;взыскание штрафов с&nbsp;хозяйствующих субъектов, не&nbsp;имеющих государственной доли в&nbsp;уставном фонде, за&nbsp;просроченную дебиторскую задолженность по&nbsp;внешнеторговым операциям сроком до&nbsp;1&nbsp;января 2027 (<span num="1051" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;19.08.2025 № УП-138). При этом наложенные в&nbsp;период действия моратория штрафы аннулируются в&nbsp;случае погашения просроченной дебиторской задолженности.</p><p><a data-anchor="/document/16/219105/bssPhr213/"></a><a data-anchor="/document/16/219105/dfasb2igvk/" data-dfa="dfasb2igvk"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr214/"></a><a data-anchor="/document/16/219105/dfastwwkyw/" data-dfa="dfastwwkyw"></a>Проведите инвентаризацию всех ВЭД-договоров (экспорт и&nbsp;импорт). Составьте список всех контрагентов-должников с&nbsp;разбивкой: сумма, дата возникновения задолженности, причина задержки, наличие документов. О&nbsp;том как проводить инвентаризацию читайте в&nbsp;рекомендации «<span data-warm-notices="45753242" data-warm-notice-type="error" num="479" target="_blank" lnktype="intlnk" title="" class="doc">Как провести инвентаризацию</span>». Если в&nbsp;2025 году были начислены штрафы за&nbsp;ВЭД-дебиторку&nbsp;— при ее&nbsp;погашении в&nbsp;период до&nbsp;1&nbsp;января 2027&nbsp;— требуйте аннулирования штрафов.</p><p><a data-anchor="/document/16/219105/bssPhr215/"></a><a data-anchor="/document/16/219105/dfas94iwl4/" data-dfa="dfas94iwl4"></a>Используйте время моратория для урегулирования задолженности. Активно работайте с&nbsp;должниками: отправьте официальные письма, предложите реструктуризацию долга, заключите допсоглашения с&nbsp;новыми графиками, оформите мировые соглашения. Зафиксируйте все попытки возврата долга.</p><p data-end="2494" data-start="2420"><a data-anchor="/document/16/219105/bssPhr216/"></a><a data-anchor="/document/16/219105/dfasfal9xw/" data-dfa="dfasfal9xw"></a>Составьте график действий так, чтобы к&nbsp;1&nbsp;января 2027:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr217/"></a><a data-anchor="/document/16/219105/dfaslshiv6/" data-dfa="dfaslshiv6"></a>либо задолженность была погашена;</li><li>либо были подготовлены документы, подтверждающие усилия по&nbsp;взысканию.</li></ul><p><a data-anchor="/document/16/219105/bssPhr218/"></a><a data-anchor="/document/16/219105/dfaswg03kx/" data-dfa="dfaswg03kx"></a><strong>Вам могут понадобиться образцы:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753157" data-warm-notice-type="error" num="475" target="_self" lnktype="intlnk" title="" class="doc">Как отразить в&nbsp;бухучете дебиторскую задолженность к&nbsp;получению от&nbsp;покупателей и&nbsp;заказчиков</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753156" data-warm-notice-type="error" num="476" target="_self" lnktype="intlnk" title="" class="doc">Когда в&nbsp;бухучете можно списать дебиторскую задолженность</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753155" data-warm-notice-type="error" num="477" target="_self" lnktype="intlnk" title="" class="doc">Как выставляют штраф за&nbsp;просроченную дебиторскую задолженность по&nbsp;экспортно-импортным операциям</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753154" data-warm-notice-type="error" num="478" target="_self" lnktype="intlnk" title="" class="doc">Как регулировать форс-мажор во&nbsp;внешнеторговых операциях</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit15/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit15"><a data-anchor="/document/16/219105/bssPhr220/"></a><a data-anchor="/document/16/219105/dfasts74te/" data-dfa="dfasts74te"></a>ИП и самозанятые</h2><a data-anchor="/document/16/219105/tit16/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit16"><a data-anchor="/document/16/219105/bssPhr221/"></a><a data-anchor="/document/16/219105/dfas3zfns2/" data-dfa="dfas3zfns2"></a>Новый налоговый режим</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr224/"></a><a data-anchor="/document/16/219105/dfaswdza1s/" data-dfa="dfaswdza1s"></a>Индивидуальные предприниматели и&nbsp;самозанятые переходят на&nbsp;новый налоговый режим&nbsp;— 1&nbsp;процент от&nbsp;годового оборота до&nbsp;1&nbsp;млрд сумов вместо нынешних 4&nbsp;процента (Постановление Президента от&nbsp;12.08.2025 № <span num="1052" target="_self" lnktype="intlnk" title="" class="doc">ПП-247</span>). Для вступления новых норм в&nbsp;силу потребуется внести поправки в <span num="1115" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr225/"></a><a data-anchor="/document/16/219105/dfassthh1g/" data-dfa="dfassthh1g"></a>С 2026 года:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr226/"></a><a data-anchor="/document/16/219105/dfas7dit8m/" data-dfa="dfas7dit8m"></a>отменили фиксированная сумма НДФЛ для&nbsp;ИП;</li><li>отменили&nbsp;порядок освобождения от уплаты налога с оборота самозанятых лиц, доход которых от реализации товаров (услуг) за налоговый период не превышает 100 млн сумов;</li><li>ввели&nbsp;единая ставка налога с&nbsp;оборота&nbsp;— 1&nbsp;процент при обороте до&nbsp;1&nbsp;млрд сумов;</li><li>все госуслуги для&nbsp;ИП и&nbsp;самозанятых (регистрация, отчетность, доступ к&nbsp;финансовым сервисам) будут доступны онлайн.</li></ul><p><a data-anchor="/document/16/219105/bssPhr227/"></a><a data-anchor="/document/16/219105/dfasm9k8i8/" data-dfa="dfasm9k8i8"></a><a data-anchor="/document/16/219105/dfas78hqph/" data-dfa="dfas78hqph"></a>Чтобы перейти на новый режим нужно будет подать заявление в налоговую в установленный срок и обеспечить ведение учета и подачу отчетности в электронном виде.</p><p><a data-anchor="/document/16/219105/bssPhr230/"></a><a data-anchor="/document/16/219105/dfasbto14w/" data-dfa="dfasbto14w"></a>Постановление также предусматривает создание цифровых платформ для бизнеса, сокращение бюрократии и&nbsp;развитие безналичных расчетов. Через эту платформу можно будет оформить деятельность, открывать и&nbsp;управлять банковскими счетами, рассчитывать и&nbsp;уплачивать налоги, осуществлять расчеты и&nbsp;формировать фискальные чеки.</p><p><a data-anchor="/document/16/219105/bssPhr231/"></a><a data-anchor="/document/16/219105/dfas2o58a2/" data-dfa="dfas2o58a2"></a>В&nbsp;рамках этой системы предприниматели смогут открывать электронный кошелек, который позволит принимать доходы, осуществлять расчеты с&nbsp;сотрудниками, контрагентами и&nbsp;организациями, а&nbsp;также уплачивать налоги и&nbsp;другие обязательные платежи. Для индивидуальных предпринимателей и&nbsp;самозанятых, имеющих электронный кошелек, открытие банковских счетов станет необязательным.</p><p><a data-anchor="/document/16/219105/bssPhr232/"></a><a data-anchor="/document/16/219105/dfasikzgxf/" data-dfa="dfasikzgxf"></a>Документы можно будет подписывать без электронного ключа&nbsp;— с&nbsp;использованием дистанционной биометрии и&nbsp;SMS-уведомления. Эти данные будут приравнены к&nbsp;документам на&nbsp;бумажном носителе. В&nbsp;пилотном режиме внедряется порядок ежедневных выплат, что позволит производить расчеты с&nbsp;работниками через электронный кошелек.</p><p><a data-anchor="/document/16/219105/bssPhr233/"></a><a data-anchor="/document/16/219105/dfasoe04nk/" data-dfa="dfasoe04nk"></a><a data-anchor="/document/16/219105/dfas0qp5yx/" data-dfa="dfas0qp5yx"></a>С&nbsp;1&nbsp;ноября 2025 начали применяться QR-коды и&nbsp;бесконтактная технология «tap to&nbsp;pay».</p><p><a data-anchor="/document/16/219105/bssPhr234/"></a><a data-anchor="/document/16/219105/dfasyi5zxz/" data-dfa="dfasyi5zxz"></a><strong>Интерактив. Найди пару&nbsp;</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/14f16fdb-0252-45e5-ba1f-1f838bc555af/index.html" data-itype="connectcards" data-moduleId="245" data-id="19" style="min-height:400px" width="100%"></iframe></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="856" target="_self" lnktype="intlnk" title="" class="doc">Кто такие индивидуальные предприниматели</span></li><li class="incut-v4-more-about__item"><span num="857" target="_self" lnktype="intlnk" title="" class="doc">Как зарегистрироваться в&nbsp;качестве индивидуального предпринимателя и&nbsp;какие налоги платить</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753176" data-warm-notice-type="error" num="858" target="_self" lnktype="intlnk" title="" class="doc">Как приостановить деятельность индивидуальному предпринимателю</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753175" data-warm-notice-type="error" num="859" target="_self" lnktype="intlnk" title="" class="doc">Кто такие самозанятые лица, как зарегистрироваться и какие налоги платить</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit17/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit17"><a data-anchor="/document/16/219105/bssPhr236/"></a><a data-anchor="/document/16/219105/dfasw7se21/" data-dfa="dfasw7se21"></a>Новый перечень видов деятельности для самозанятых</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr239/"></a><a data-anchor="/document/16/219105/dfas4i060n/" data-dfa="dfas4i060n"></a>С&nbsp;1&nbsp;января 2026 перечень видов деятельности, которыми могут заниматься самозанятые лица, сокращен со&nbsp;104 до&nbsp;72. Из&nbsp;списка исключены такие виды, как репетиторство, уборка, мелкий ремонт мебели, покраска, установка автосигнализаций и&nbsp;др. При этом добавлен новый вид деятельности&nbsp;— торговля на&nbsp;онлайн-маркетплейсах (Указ Президента от&nbsp;19.03.2025 № <span num="1053" target="_self" lnktype="intlnk" title="" class="doc">УП-50</span>).</p><p><a data-anchor="/document/16/219105/bssPhr240/"></a><a data-anchor="/document/16/219105/dfasx2mx4i/" data-dfa="dfasx2mx4i"></a><strong>Что успеть самозанятому</strong></p><p><a data-anchor="/document/16/219105/bssPhr241/"></a><a data-anchor="/document/16/219105/dfaszw4u0o/" data-dfa="dfaszw4u0o"></a>Проверьте, входит&nbsp;ли ваш вид деятельности в&nbsp;новый список из&nbsp;72&nbsp;разрешенных. Если ваша деятельность исключена (например: репетиторство, мелкий ремонт, уборка и&nbsp;др.) подготовьте переход на&nbsp;другую форму регистрации. Вы&nbsp;можете зарегистрироваться как индивидуальный предприниматель или как юридическое лицо (если обороты или вид деятельности это требуют). В&nbsp;этом вам помогут наши рекомендации:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr242/"></a><a data-anchor="/document/16/219105/dfasza579p/" data-dfa="dfasza579p"></a><span data-warm-notices="41892878" data-warm-notice-type="error" num="520" target="_self" lnktype="intlnk" title="" class="doc">«Как зарегистрироваться в&nbsp;качестве индивидуального предпринимателя и&nbsp;какие налоги платить»</span></li><li><a data-anchor="/document/16/219105/dfasahd8f6/" data-dfa="dfasahd8f6"></a><span data-warm-notices="41892879,45753229" data-warm-notice-type="error" num="521" target="_self" lnktype="intlnk" title="" class="doc">«Как зарегистрировать юридическое лицо»</span>.</li></ul><p><a data-anchor="/document/16/219105/bssPhr243/"></a><a data-anchor="/document/16/219105/dfash7trau/" data-dfa="dfash7trau"></a>Завершите деятельность как самозанятый:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr244/"></a><a data-anchor="/document/16/219105/dfascxpdas/" data-dfa="dfascxpdas"></a>закройте электронный кошелек (если есть);</li><li>сдайте итоговую отчетность (если требовалась);</li><li>уплатите налоги за&nbsp;2025&nbsp;год.</li></ul><p><a data-anchor="/document/16/219105/bssPhr245/"></a><a data-anchor="/document/16/219105/dfaspaqel2/" data-dfa="dfaspaqel2"></a>Как завершить деятельность самозанятого лица, читайте в&nbsp;рекомендации «<span data-warm-notices="45753228" data-warm-notice-type="error" num="522" target="_blank" lnktype="intlnk" title="" class="doc">Как прекратить или приостановить деятельность самозанятого лица</span>».</p><p><a data-anchor="/document/16/219105/bssPhr246/"></a><a data-anchor="/document/16/219105/dfasmy35p8/" data-dfa="dfasmy35p8"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/">Договор гражданско-правового характера</a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753160" data-warm-notice-type="error" num="515" target="_self" lnktype="intlnk" title="" class="doc">Кто такие самозанятые лица, как зарегистрироваться и&nbsp;какие налоги платить</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753159" data-warm-notice-type="error" num="516" target="_self" lnktype="intlnk" title="" class="doc">Как прекратить или приостановить деятельность самозанятого лица</span></li><li class="incut-v4-more-about__item"><span num="517" target="_self" lnktype="intlnk" title="" class="doc">Как перейти на&nbsp;налог с&nbsp;оборота</span></li><li class="incut-v4-more-about__item"><span num="518" target="_self" lnktype="intlnk" title="" class="doc">Как зарегистрироваться в&nbsp;качестве индивидуального предпринимателя и&nbsp;какие налоги платить</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753158" data-warm-notice-type="error" num="519" target="_self" lnktype="intlnk" title="" class="doc">Как зарегистрировать юридическое лицо</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit18/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit18"><a data-anchor="/document/16/219105/bssPhr249/"></a><a data-anchor="/document/16/219105/dfas3bu5n5/" data-dfa="dfas3bu5n5"></a>Трудовое законодательство</h2><a data-anchor="/document/16/219105/tit19/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit19"><a data-anchor="/document/16/219105/bssPhr250/"></a><a data-anchor="/document/16/219105/dfasc6a2sh/" data-dfa="dfasc6a2sh"></a>Документооборот и ответственность работодателя</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr253/"></a><a data-anchor="/document/16/219105/dfas6nfpx2/" data-dfa="dfas6nfpx2"></a>С&nbsp;1&nbsp;января 2026 вступили в&nbsp;силу нововведения, принятые Указом Президента от&nbsp;04.08.2025 <span num="3100" target="_blank" lnktype="intlnk" title="" class="doc">№ УП-126</span>, которые значительно меняют порядок проверок, документооборот и&nbsp;ответственность работодателей. Разобрали основные изменения.</p><p><a data-anchor="/document/16/219105/bssPhr254/"></a><a data-anchor="/document/16/219105/dfaszpegk7/" data-dfa="dfaszpegk7"></a><strong>Проверки через ЕНСТ без участия работодателя</strong></p><p><a data-anchor="/document/16/219105/bssPhr255/"></a><a data-anchor="/document/16/219105/dfas6sfrr5/" data-dfa="dfas6sfrr5"></a>С&nbsp;нового года нарушения, зафиксированные в&nbsp;системе ЕНСТ, рассматриваются в&nbsp;автоматическом режиме&nbsp;— без вызова работодателя и&nbsp;без очного участия.<br>Административное решение (предупреждение или штраф) будет формироваться в&nbsp;электронном виде. Также трудовая инспекция уже получила право проводить проверки без предварительного уведомления. Любые ошибки в&nbsp;отчетах, несоответствия по&nbsp;численности, графикам работы, оформлению трудовых договоров будут видны системе сразу.</p><p><a data-anchor="/document/16/219105/bssPhr256/"></a><a data-anchor="/document/16/219105/dfas5z7ud0/" data-dfa="dfas5z7ud0"></a><strong>Трудоустройство социально уязвимых групп работников</strong></p><p><a data-anchor="/document/16/219105/bssPhr257/"></a><a data-anchor="/document/16/219105/dfaso3hf55/" data-dfa="dfaso3hf55"></a>Для компаний, у&nbsp;которых более 100&nbsp;сотрудников, с&nbsp;2026 года появилась обязанность резервировать до&nbsp;3&nbsp;процентов рабочих мест для социально уязвимых групп:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr258/"></a><a data-anchor="/document/16/219105/dfast8thxs/" data-dfa="dfast8thxs"></a>лиц с&nbsp;инвалидностью;</li><li>сирот;</li><li>жертв насилия;</li><li>граждан из&nbsp;малообеспеченных семей. Органы занятости при выдаче направлений будут учитывать, работает&nbsp;ли в&nbsp;организации кто-то из&nbsp;этих категорий уже сейчас.</li></ul><p><a data-anchor="/document/16/219105/bssPhr259/"></a><a data-anchor="/document/16/219105/dfas3tzyb0/" data-dfa="dfas3tzyb0"></a><strong>Изменения в&nbsp;Трудовом кодексе:</strong></p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr260/"></a><a data-anchor="/document/16/219105/dfasu2mbwz/" data-dfa="dfasu2mbwz"></a>электронные подписи вместо бумаги. Документы, подписанные через ЭЦП или Face-ID, будут считаться равными бумажным;</li><li>отмена приказов о&nbsp;приеме и&nbsp;переводе. Основанием становится только трудовой договор&nbsp;— приказы больше не&nbsp;обязательны.</li><li>упрощенные правила для компаний, имеющих до&nbsp;50&nbsp;работников. Преференции, которые сейчас есть у&nbsp;микрофирм, распространятся еще и&nbsp;на&nbsp;малые организации.</li><li>только электронные трудовые книжки. Переход завершится&nbsp;— бумажные книжки отменяются полностью;</li><li>новые основания для увольнения. Работодатель сможет включить в&nbsp;трудовой договор конкретный перечень грубых нарушений, которые позволят увольнять сотрудников законно и&nbsp;без дополнительных согласований.</li><li>смягчение процедуры увольнения через профсоюз. Отменяется требование расторгнуть договор строго в&nbsp;течение месяца после согласия профсоюза.</li><li>жесткие штрафы за&nbsp;неоформленных работников. Изменения в&nbsp;КоАО ужесточают ответственность за&nbsp;труд без договора&nbsp;— 30&nbsp;БРВ&nbsp;— при первом нарушении и&nbsp;100&nbsp;БРВ при повторном.</li></ul><p><a data-anchor="/document/16/219105/bssPhr261/"></a><a data-anchor="/document/16/219105/dfas62f1x2/" data-dfa="dfas62f1x2"></a>Требования установлены в&nbsp;<span num="3110" target="_blank" lnktype="intlnk" title="" class="doc">приложении №&nbsp;1</span>, утвержденном&nbsp;Указом Президента от&nbsp;04.08.2025 года УП-126.</p><p><a data-anchor="/document/16/219105/bssPhr262/"></a><a data-anchor="/document/16/219105/dfas3t7tnk/" data-dfa="dfas3t7tnk"></a><strong>Что важно сделать бухгалтеру:</strong></p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr263/"></a><a data-anchor="/document/16/219105/dfaskpyoxq/" data-dfa="dfaskpyoxq"></a>проверьте корректность всех трудовых договоров. Убедитесь, что каждый сотрудник оформлен. Проверьте сроки, должности, графики, тарифные ставки, чтобы не&nbsp;возникло несоответствий в&nbsp;ЕНСТ;</li><li>перейдите на&nbsp;электронные трудовые книжки. Завершите оформление сведений по&nbsp;всем работникам&nbsp;— проверьте корректность данных, чтобы не&nbsp;возникло ошибок при проверках;</li><li>пересмотрите кадровый документооборот. Подготовьтесь к&nbsp;отмене приказов о&nbsp;приёме/переводе. Настройте внутренний процесс подписания документов через ЭЦП/Face-ID;</li><li>проверьте численность для расчёта квоты 3&nbsp;процентов для социально уязвимых групп работников. Если работников больше 100, определите размер резервируемых мест,</li><li>проверьте, есть&nbsp;ли среди сотрудников лица из&nbsp;социально уязвимых категорий.</li></ul><p><a data-anchor="/document/16/219105/bssPhr264/"></a><a data-anchor="/document/16/219105/dfaslby7os/" data-dfa="dfaslby7os"></a><strong>Вам в&nbsp;помощь шаблоны:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753188" data-warm-notice-type="error" num="1464" target="_blank" lnktype="intlnk" title="" class="doc">Как заключить трудовой договор с&nbsp;работником</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753187" data-warm-notice-type="error" num="1465" target="_blank" lnktype="intlnk" title="" class="doc">Как войти в&nbsp;МАПК «ЕНСТ»</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753186" data-warm-notice-type="error" num="1466" target="_blank" lnktype="intlnk" title="" class="doc">Как оформить прием на&nbsp;работу в&nbsp;ЕНСТ</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753185" data-warm-notice-type="error" num="1467" target="_blank" lnktype="intlnk" title="" class="doc">Как внести сведения о&nbsp;прошлых местах работы в&nbsp;ЕНСТ</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit20/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit20"><a data-anchor="/document/16/219105/bssPhr266/"></a><a data-anchor="/document/16/219105/dfas1yt0n1/" data-dfa="dfas1yt0n1"></a>Пособие по временной нетрудоспособности</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr270/"></a><a data-anchor="/document/16/219105/dfasbou1ug/" data-dfa="dfasbou1ug"></a>С 2026 года в Узбекистане заработала новая система государственного социального страхования, которая изменила порядок назначения и выплаты пособий – как по беременности и родам, так и по временной нетрудоспособности и будет внедряться поэтапно (Указ Президента от 03.11.2025 <span num="3111" target="_blank" lnktype="intlnk" title="" class="doc">№ УП-206</span>).&nbsp;Помимо этого приняли новый <span num="1797" target="_blank" lnktype="intlnk" title="" class="doc">Закон</span> «О государственном социальном страховании» и <span num="3112" target="_blank" lnktype="intlnk" title="" class="doc">Положение</span> о порядке назначения и выплаты пособий по временной нетрудоспособности, беременности и родам, утвержденное Кабмином от 17.12.2025 <span num="3113" target="_blank" lnktype="intlnk" title="" class="doc">№ 796</span>. Более подробно о нововведениях&nbsp;читайте в&nbsp;<span num="1533" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr271/"></a><a data-anchor="/document/16/219105/dfassfi6h9/" data-dfa="dfassfi6h9"></a><strong>С 1 января 2026&nbsp;</strong></p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr272/"></a><a data-anchor="/document/16/219105/dfashzudo0/" data-dfa="dfashzudo0"></a>Фонд государственного социального страхования начинает&nbsp;самостоятельно назначать и выплачивать пособия по беременности и родам. Эти выплаты будут перечислять получательницам напрямую, без участия работодателя.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr273/"></a><a data-anchor="/document/16/219105/dfas1hl0ps/" data-dfa="dfas1hl0ps"></a><strong>С 1 июля 2026&nbsp;</strong></p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr274/"></a><a data-anchor="/document/16/219105/dfaswayszd/" data-dfa="dfaswayszd"></a>Фонд также возьмет на себя назначение и выплату пособий по временной нетрудоспособности – так называемых «больничных». Это означает, что именно Фонд будет рассчитывать и перечислять выплаты сотруднику на основании данных страхования.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr275/"></a><a data-anchor="/document/16/219105/dfas30zgu7/" data-dfa="dfas30zgu7"></a><strong>С 1 января 2030&nbsp;</strong></p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr276/"></a><a data-anchor="/document/16/219105/dfasbni3xp/" data-dfa="dfasbni3xp"></a>Планируется введение нового вида социальной гарантии – выходного пособия, которое будут предоставлять работникам по обращению. Оно также войдет в систему социального страхования.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr277/"></a><a data-anchor="/document/16/219105/dfasf6gyhp/" data-dfa="dfasf6gyhp"></a>Финансирование соцстрахования строится на двух составляющих: обязательной и добровольной. Обязательная часть формируется за счет части удерживаемого НДФЛ, который будет перераспределяться в пользу системы социального страхования. Добровольная часть – работники смогут дополнительно участвовать в системе, перечисляя ежемесячный взнос в размере 5&nbsp;процентов от МРОТ. Это увеличивает их страховой стаж и потенциально <strong>–</strong> размер пособий.</p><p data-semantic-type="paragraph" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr278/"></a><a data-anchor="/document/16/219105/dfas5rgo7y/" data-dfa="dfas5rgo7y"></a><a data-anchor="/document/16/219105/dfasz9m7ss/" data-dfa="dfasz9m7ss"></a>При определении права на выплаты и их размеров учитывают весь страховой стаж, включая периоды до запуска новой системы.&nbsp;В стаж засчитывают:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr279/"></a><a data-anchor="/document/16/219105/dfas45fu2e/" data-dfa="dfas45fu2e"></a>взносы, уплаченные до 1 января 2026 ;</li><li>выплаты по ЕСП;</li><li>начисленный соцналог.</li></ul><p data-end="1255" data-start="741" style="text-align:left"><a data-anchor="/document/16/219105/bssPhr280/"></a><a data-anchor="/document/16/219105/dfas3bh6vy/" data-dfa="dfas3bh6vy"></a>Выплаты назначаются при соблюдении ряда условий. Право на получение возникает в период, когда застрахованное лицо:</p><ul class="c-list"><li style="text-align:left"><a data-anchor="/document/16/219105/bssPhr281/"></a><a data-anchor="/document/16/219105/dfas1c4dkg/" data-dfa="dfas1c4dkg"></a>состоит в трудовых отношениях с работодателем;</li><li style="text-align:left">оказывает услуги на основании договоров ГПД с юридическими или физическими лицами;</li><li style="text-align:left">занято иной официальной деятельностью в установленном порядке.</li></ul><p><a data-anchor="/document/16/219105/bssPhr282/"></a><a data-anchor="/document/16/219105/dfaslobvd0/" data-dfa="dfaslobvd0"></a>Условия для получения пособий:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr283/"></a><a data-anchor="/document/16/219105/dfascug7gr/" data-dfa="dfascug7gr"></a>страховой стаж для пособия по беременности и родам — не менее 10 месяцев;</li><li>страховой стаж для пособия по временной нетрудоспособности — не менее 6 месяцев.</li></ul><p><a data-anchor="/document/16/219105/bssPhr284/"></a><a data-anchor="/document/16/219105/dfass8rvgn/" data-dfa="dfass8rvgn"></a>Пособие по беременности и родам рассчитывается в зависимости от стажа:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr285/"></a><a data-anchor="/document/16/219105/dfasatnuln/" data-dfa="dfasatnuln"></a>75&nbsp;процентов от среднего заработка при стаже от 10 до 24 месяцев;</li><li>85&nbsp;процентов при стаже от 25 до 60 месяцев;</li><li>100&nbsp;процентов при стаже 61 месяц и более.</li></ul><p><a data-anchor="/document/16/219105/bssPhr286/"></a><a data-anchor="/document/16/219105/dfas8bq2ao/" data-dfa="dfas8bq2ao"></a>Пособие по временной нетрудоспособности будет выплачиваться на основании листка нетрудоспособности, но не более 182 дней в год.</p><p><a data-anchor="/document/16/219105/bssPhr287/"></a><a data-anchor="/document/16/219105/dfas0g2h6v/" data-dfa="dfas0g2h6v"></a><strong>Что успеть бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr288/"></a><a data-anchor="/document/16/219105/dfasz5a3fq/" data-dfa="dfasz5a3fq"></a>Проверьте корректность персональных данных сотрудников.&nbsp;Фонд будет назначать пособия автоматически на основе данных идентификации и страхового стажа.&nbsp;Ошибки в данных могут привести к тому, что Фонд не сможет рассчитать пособие. Проверьте:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr289/"></a><a data-anchor="/document/16/219105/dfasr8yw43/" data-dfa="dfasr8yw43"></a>правильность Ф.И.О., паспортных данных;</li><li>ПИНФЛ;</li><li>корректность даты приема, перевода, увольнения;</li><li>отсутствие дубликатов в системах.</li></ul><p data-end="864" data-start="787"><a data-anchor="/document/16/219105/bssPhr290/"></a><a data-anchor="/document/16/219105/dfask6xiig/" data-dfa="dfask6xiig"></a>Актуализируйте сведения о страховом стаже, поскольку в расчет будут входить все периоды до 2026 года, в том числе&nbsp;уплаченные взносы&nbsp;ЕСП и&nbsp;начисленный соцналог. Бухгалтеру важно:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr291/"></a><a data-anchor="/document/16/219105/dfas2xiatv/" data-dfa="dfas2xiatv"></a>сверить стаж сотрудников в ЕНСТ;</li><li>проверить корректность отчетов за прошлые годы;</li><li>при необходимости – внести исправления в отчетность прошлых лет.</li></ul><p><a data-anchor="/document/16/219105/bssPhr292/"></a><a data-anchor="/document/16/219105/dfasyggphh/" data-dfa="dfasyggphh"></a><strong>Вам в помощь шаблоны:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="1527" target="_blank" lnktype="intlnk" title="" class="doc">Как рассчитывать и&nbsp;оплачивать пособие по&nbsp;временной нетрудоспособности</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753189" data-warm-notice-type="error" num="1528" target="_blank" lnktype="intlnk" title="" class="doc">Как выплатить и&nbsp;назначить пособие по&nbsp;беременности и&nbsp;родам</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit21/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit21"><a data-anchor="/document/16/219105/bssPhr294/"></a><a data-anchor="/document/16/219105/dfas80mnxw/" data-dfa="dfas80mnxw"></a>Выездные налоговые проверки</h2><a data-anchor="/document/16/219105/tit22/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit22"><a data-anchor="/document/16/219105/bssPhr295/"></a><a data-anchor="/document/16/219105/dfasrvgkqb/" data-dfa="dfasrvgkqb"></a>Рассрочка по уплате доначислений&nbsp;</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr298/"></a><a data-anchor="/document/16/219105/dfasgied32/" data-dfa="dfasgied32"></a>Налогоплательщики могут уплачивать финансовые санкции по результатам выездной налоговой проверки равными долями в течение 6 месяцев с даты принятия решения налоговым органом. Рассрочка предусмотрена <span num="1054" target="_self" lnktype="intlnk" title="" class="doc">Указом</span> Президента от 19.08.2025 № УП-138.&nbsp;Для вступления новых норм в силу потребуется внести поправки в <span num="1116" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span>.</p><p><a data-anchor="/document/16/219105/bssPhr299/"></a><a data-anchor="/document/16/219105/dfas3gwrzx/" data-dfa="dfas3gwrzx"></a>Ранее уплатить доначисленные налоги и&nbsp;финансовые санкции в&nbsp;рассрочку&nbsp;— равными долями в&nbsp;течение 6&nbsp;месяцев можно только по&nbsp;результатам налогового аудита и&nbsp;камеральной налоговой проверки (<span num="3114" target="_blank" lnktype="intlnk" title="" class="doc">ч.&nbsp;4</span>&nbsp;ст. 100&nbsp;НК).</p><p><a data-anchor="/document/16/219105/bssPhr300/"></a><a data-anchor="/document/16/219105/dfasdsic36/" data-dfa="dfasdsic36"></a>Для получения рассрочки направьте в&nbsp;налоговый орган по&nbsp;месту налогового учета уведомление. При этом на&nbsp;сумму задолженности по&nbsp;доначисленным суммам налогов и&nbsp;финансовых санкций начисляются проценты исходя из&nbsp;ставки рефинансирования&nbsp;ЦБ, действующей в&nbsp;период рассрочки.</p><p style="text-align:left"><a data-anchor="/document/16/219105/bssPhr301/"></a><a data-anchor="/document/16/219105/dfas6k1o3e/" data-dfa="dfas6k1o3e"></a><strong>Памятка. Что важно проверить</strong></p><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/4ef22621-2f34-4257-b6a0-a2039707d099/index.html" data-itype="poster" data-moduleId="238" data-id="136" style="min-height:400px" width="100%"></iframe></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753178" data-warm-notice-type="error" num="900" target="_self" lnktype="intlnk" title="" class="doc">Как проводят выездные налоговые проверки</span></li><li class="incut-v4-more-about__item"><span num="901" target="_self" lnktype="intlnk" title="" class="doc">Как проводят камеральную и выездную налоговую проверку</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753177" data-warm-notice-type="error" num="902" target="_self" lnktype="intlnk" title="" class="doc">Какие документы оформляют по результатам выездной налоговой проверки</span></li><li class="incut-v4-more-about__item"><span num="903" target="_self" lnktype="intlnk" title="" class="doc">Как рассматривают дела о налоговых правонарушениях</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit23/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit23"><a data-anchor="/document/16/219105/bssPhr303/"></a><a data-anchor="/document/16/219105/dfasbluffi/" data-dfa="dfasbluffi"></a>Мобильные видеокамеры при проверках</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr306/"></a><a data-anchor="/document/16/219105/dfas20u50q/" data-dfa="dfas20u50q"></a>Теперь при выездных налоговых проверках обязательно использование мобильных видеокамер (Указ Президента от 19.08.2025 № <span num="1056" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>). Проверки без видеозаписи признаются незаконными. Это нововведение направлено на&nbsp;повышение прозрачности, снижение субъективного фактора и&nbsp;защиту прав предпринимателей при взаимодействии с&nbsp;налоговыми органами.</p><p><a data-anchor="/document/16/219105/bssPhr307/"></a><a data-anchor="/document/16/219105/dfasttpnze/" data-dfa="dfasttpnze"></a>Для вступления в&nbsp;силу новых норм нужно внести изменения в <span num="1117" target="_blank" lnktype="intlnk" title="" class="doc">Налоговый кодекс</span> и&nbsp;Положение о&nbsp;порядке организации и&nbsp;проведения налоговых проверок (<span num="1057" target="_self" lnktype="intlnk" title="" class="doc">приложение №&nbsp;2</span>, утв.&nbsp;постановлением Кабмина от&nbsp;07.01.2021 №&nbsp;1).</p><p><a data-anchor="/document/16/219105/bssPhr308/"></a><a data-anchor="/document/16/219105/dfasnpx3ew/" data-dfa="dfasnpx3ew"></a>Для компаний это означает, что спорные ситуации можно оперативно разрешать на&nbsp;основании видеозаписи, а&nbsp;риск необоснованных претензий со&nbsp;стороны проверяющих существенно сократится.</p><p><a data-anchor="/document/16/219105/bssPhr309/"></a><a data-anchor="/document/16/219105/dfasmlz542/" data-dfa="dfasmlz542"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr310/"></a><a data-anchor="/document/16/219105/dfaskghyia/" data-dfa="dfaskghyia"></a>Проведите инструктаж работников:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr311/"></a><a data-anchor="/document/16/219105/dfasgr9gxw/" data-dfa="dfasgr9gxw"></a>кто имеет право общаться с&nbsp;налоговыми проверяющими;</li><li>как себя вести при выездной проверке;</li><li>что делать, если видеозапись не&nbsp;ведется или скрывается;</li><li>куда жаловаться, если проверка проводится с&nbsp;нарушением.</li></ul><p><a data-anchor="/document/16/219105/bssPhr312/"></a><a data-anchor="/document/16/219105/dfasmtc7c6/" data-dfa="dfasmtc7c6"></a><a data-anchor="/document/16/219105/dfasuqdy84/" data-dfa="dfasuqdy84"></a>Назначьте ответственного, который будет присутствовать на&nbsp;всех этапах проверки (бухгалтер или юрист). Внесите изменения в&nbsp;учетную политику в&nbsp;целях налогообложения. В&nbsp;этом вам поможет рекомендация «<span data-warm-notices="45753207" data-warm-notice-type="error" num="560" target="_blank" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span>».</p><p><a data-anchor="/document/16/219105/bssPhr313/"></a><a data-anchor="/document/16/219105/dfas9r8hp0/" data-dfa="dfas9r8hp0"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753163" data-warm-notice-type="error" num="556" target="_self" lnktype="intlnk" title="" class="doc">Как проводят выездные налоговые проверки</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753162" data-warm-notice-type="error" num="557" target="_self" lnktype="intlnk" title="" class="doc">Какие документы оформляют по&nbsp;результатам выездной налоговой проверки</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753161" data-warm-notice-type="error" num="558" target="_self" lnktype="intlnk" title="" class="doc">Какие права имеет налогоплательщик при проведении выездных налоговых проверок</span></li><li class="incut-v4-more-about__item"><span num="559" target="_self" lnktype="intlnk" title="" class="doc">Как проводят камеральную и&nbsp;выездную налоговую проверку</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit24/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit24"><a data-anchor="/document/16/219105/bssPhr315/"></a><a data-anchor="/document/16/219105/dfasaduad6/" data-dfa="dfasaduad6"></a>Цифровая маркировка</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p data-end="320" data-start="81"><a data-anchor="/document/16/219105/bssPhr318/"></a><a data-anchor="/document/16/219105/dfasmdrq3f/" data-dfa="dfasmdrq3f"></a>С&nbsp;1&nbsp;января 2026 действует новый порядок контроля за&nbsp;соблюдением правил обязательной цифровой маркировки. Он&nbsp;утвержден&nbsp;<span num="3101" target="_blank" lnktype="intlnk" title="" class="doc">пунктом&nbsp;8</span>&nbsp;Постановления Президента от&nbsp;23.05.2025&nbsp;ПП-190 и&nbsp;полностью меняет механизм проверок.</p><p><a data-anchor="/document/16/219105/bssPhr319/"></a><a data-anchor="/document/16/219105/dfas505ivs/" data-dfa="dfas505ivs"></a>Налоговые органы перешли на&nbsp;дистанционный формат контроля. Это означает:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr320/"></a><a data-anchor="/document/16/219105/dfasat2lgp/" data-dfa="dfasat2lgp"></a>никаких визитов, вызовов или выездных проверок;</li><li>весь анализ проводится через информационную систему;</li><li>основой проверки становятся данные онлайн-ККТ и&nbsp;электронных счет-фактур (ЭСФ).</li></ul><p data-end="787" data-start="634"><a data-anchor="/document/16/219105/bssPhr321/"></a><a data-anchor="/document/16/219105/dfas540146/" data-dfa="dfas540146"></a><a data-anchor="/document/16/219105/dfasnwog3p/" data-dfa="dfasnwog3p"></a>Фактически налоговая будет автоматически сравнивать, насколько корректно предприниматель применяет цифровую маркировку при продаже маркируемой продукции. Если система обнаружит ошибки или несоответствия, организация сначала получит предупреждение.&nbsp;Затем штрафы начинают расти&nbsp;— и&nbsp;зависят от&nbsp;количества нарушений за&nbsp;год. Размер штрафа считается от&nbsp;чистой выручки последнего отчетного квартала, в&nbsp;котором была реализация товара:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr322/"></a><a data-anchor="/document/16/219105/dfas8ad908/" data-dfa="dfas8ad908"></a>0,2&nbsp;процентов&nbsp;— первое нарушение после второго предупреждения (если оно произошло в&nbsp;течение месяца);</li><li>0,4&nbsp;процентов&nbsp;— второе нарушение за&nbsp;год;</li><li>1&nbsp;процентов&nbsp;— третье нарушение за&nbsp;год;</li><li>2&nbsp;процентов&nbsp;— четвёртое и&nbsp;последующие нарушения. Самое серьёзное последствие: при повторных нарушениях, достигающих уровня «четвёртого и&nbsp;более», компания теряет право на&nbsp;возмещение НДС на&nbsp;один год.</li></ul><p><a data-anchor="/document/16/219105/bssPhr323/"></a><a data-anchor="/document/16/219105/dfasz8923f/" data-dfa="dfasz8923f"></a><strong>Что важно сделать бухгалтеру</strong></p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr324/"></a><a data-anchor="/document/16/219105/dfas8964os/" data-dfa="dfas8964os"></a>проверить, вся&nbsp;ли продукция, подлежащая обязательной цифровой маркировке, действительно маркирована;</li><li>убедиться, что данные маркировки корректно передаются в&nbsp;онлайн-ККТ и&nbsp;ЭСФ;</li><li>настроить контрольные процедуры: сверку остатков, кодов маркировки, движение товара;</li><li>провести обучение кассиров, складских сотрудников и&nbsp;ответственных за&nbsp;ЭСФ;</li><li>актуализировать внутренние регламенты и&nbsp;инструкции по&nbsp;работе с&nbsp;маркируемой продукцией;</li><li>проверить техническую готовность: работа оператора маркировки, наличие сканеров, корректность интеграции с&nbsp;учётной системой.</li></ul><p><a data-anchor="/document/16/219105/bssPhr325/"></a><a data-anchor="/document/16/219105/dfast544zu/" data-dfa="dfast544zu"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753180" data-warm-notice-type="error" num="1351" target="_blank" lnktype="intlnk" title="" class="doc">Как производить цифровую маркировку товаров в&nbsp;Республике Узбекистан</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="42396648" data-warm-notice-type="error" num="1352" target="_blank" lnktype="intlnk" title="" class="doc">Перечень товаров с&nbsp;обязательной цифровой маркировкой&nbsp;</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="42396649,45753179" data-warm-notice-type="error" num="1353" target="_blank" lnktype="intlnk" title="" class="doc">1С. Настройка маркировки, контроль маркировки в поступлении и реализации товаров.</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit25/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit25"><a data-anchor="/document/16/219105/bssPhr327/"></a><a data-anchor="/document/16/219105/dfas7ydcqe/" data-dfa="dfas7ydcqe"></a>Штрафы&nbsp;за непредставленную отчетность</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr329/"></a><a data-anchor="/document/16/219105/dfasgg34er/" data-dfa="dfasgg34er"></a>Вступил в&nbsp;силу законопроект согласно Указу Президента от&nbsp;19.08.2025 № <span num="1058" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>, который предусматривает:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr330/"></a><a data-anchor="/document/16/219105/dfasddb2yt/" data-dfa="dfasddb2yt"></a>снижение размера административного штрафа за&nbsp;непредставление в&nbsp;установленный срок налоговой отчетности (декларации) с&nbsp;10&nbsp;до&nbsp;3&nbsp;БРВ для должностных лиц субъектов малого предпринимательства и&nbsp;с&nbsp;3&nbsp;до&nbsp;1&nbsp;БРВ для граждан;</li><li>в&nbsp;случае непредставления в&nbsp;течение отчетного периода налоговой отчетности по&nbsp;нескольким видам налогов штраф налагается в&nbsp;едином общем размере за&nbsp;все непредставленные отчеты;</li><li>не&nbsp;будут налагаться административные штрафы за&nbsp;несвоевременное представление налоговой отчетности на&nbsp;срок до&nbsp;5&nbsp;дней на&nbsp;субъектов хозяйствования, своевременно представивших налоговые отчеты за&nbsp;последние 3&nbsp;месяца.</li></ul><p><a data-anchor="/document/16/219105/bssPhr331/"></a><a data-anchor="/document/16/219105/dfas2xax20/" data-dfa="dfas2xax20"></a>Для вступления новых норм в&nbsp;силу потребуется внести поправки в&nbsp;КоАО.</p><p><a data-anchor="/document/16/219105/bssPhr332/"></a><a data-anchor="/document/16/219105/dfasnin9u0/" data-dfa="dfasnin9u0"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr333/"></a><a data-anchor="/document/16/219105/dfass7bgvn/" data-dfa="dfass7bgvn"></a>Убедитесь, что организация зарегистрирована как малое предпринимательство. Проверьте соответствует&nbsp;ли среднегодовая численность персонала и&nbsp;другие критерии для малого предпринимательства. Вам в&nbsp;помощь&nbsp;— рекомендация «<span data-warm-notices="45753224" data-warm-notice-type="error" num="772" target="_blank" lnktype="intlnk" title="" class="doc">Каким критериям должны соответствовать малые предприятия</span>».</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/219105/bssPhr334/"></a><a data-anchor="/document/16/219105/dfasroi1xa/" data-dfa="dfasroi1xa"></a>Проверьте своевременность сдачи всех видов налоговой отчетности за&nbsp;последние 3&nbsp;месяца</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/219105/bssPhr335/"></a><a data-anchor="/document/16/219105/dfasxlhruh/" data-dfa="dfasxlhruh"></a>С&nbsp;2026 года штраф за&nbsp;просрочку до&nbsp;5&nbsp;дней не&nbsp;налагается, если за&nbsp;предыдущие 3&nbsp;месяца отчеты сдавались в&nbsp;срок. Убедитесь, что все отчеты были приняты налоговыми органами.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/219105/bssPhr336/"></a><a data-anchor="/document/16/219105/dfas0uxgwh/" data-dfa="dfas0uxgwh"></a>При необходимости внесите изменения в&nbsp;учетную политику. Введите пункт о&nbsp;том, что в&nbsp;случае непредставления в&nbsp;течение отчетного периода налоговой отчетности по&nbsp;нескольким видам налогов штраф налагается в&nbsp;едином общем размере за&nbsp;все непредставленные отчеты.</p><p><a data-anchor="/document/16/219105/bssPhr337/"></a><a data-anchor="/document/16/219105/dfasnm6tdb/" data-dfa="dfasnm6tdb"></a><strong>Воспользуйтесь нашими шаблонами:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753174" data-warm-notice-type="error" num="766" target="_self" lnktype="intlnk" title="" class="doc">Каким критериям должны соответствовать малые предприятия</span></li><li class="incut-v4-more-about__item"><span num="767" target="_self" lnktype="intlnk" title="" class="doc">Какая ответственность предусмотрена за&nbsp;нарушение налогового законодательства</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753173" data-warm-notice-type="error" num="768" target="_self" lnktype="intlnk" title="" class="doc">Какой размер пени могут применить, если несвоевременно предоставить налоговую отчетность</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit26/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit26"><a data-anchor="/document/16/219105/bssPhr339/"></a><a data-anchor="/document/16/219105/dfas2a9cfv/" data-dfa="dfas2a9cfv"></a>Статистическая отчетность</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p data-end="469" data-start="127"><a data-anchor="/document/16/219105/bssPhr342/"></a><a data-anchor="/document/16/219105/dfasthc1gf/" data-dfa="dfasthc1gf"></a>С&nbsp;2026 года Нацкомстат внедряет новые сервисы&nbsp;— «Консультант», «Аналитик», а&nbsp;также call-центр для прохождения статобследований по&nbsp;телефону. Количество статформ сокращено до&nbsp;50. Микрофирмы и&nbsp;малые предприятия могут сдавать годовую статистическую отчетность 1&nbsp;раз в&nbsp;3&nbsp;года, если:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr343/"></a><a data-anchor="/document/16/219105/dfas8fazdi/" data-dfa="dfas8fazdi"></a>среднегодовая численность &lt; 5&nbsp;человек,</li><li>или годовая выручка ≤ 2&nbsp;000&nbsp;БРВ. Льгота не&nbsp;распространяется на&nbsp;организации с&nbsp;госдолей ≥ 50&nbsp;процентов и&nbsp;плательщиков акциза.</li></ul><p><a data-anchor="/document/16/219105/bssPhr344/"></a><a data-anchor="/document/16/219105/dfasg3bv8u/" data-dfa="dfasg3bv8u"></a>Требования установлены в&nbsp;Указе Президента от&nbsp;24.02.2025 <span num="3116" target="_blank" lnktype="intlnk" title="" class="doc">№ УП-27</span> и Постановлении Президента от&nbsp;24.02.2025 <span num="3117" target="_blank" lnktype="intlnk" title="" class="doc">№ ПП-75</span>.</p><p><a data-anchor="/document/16/219105/bssPhr345/"></a><a data-anchor="/document/16/219105/dfas0rceam/" data-dfa="dfas0rceam"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr346/"></a><a data-anchor="/document/16/219105/dfasxi156l/" data-dfa="dfasxi156l"></a>Определите статус предприятия на&nbsp;2026&nbsp;год:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr347/"></a><a data-anchor="/document/16/219105/dfas3vwb1s/" data-dfa="dfas3vwb1s"></a>рассчитайте среднегодовую численность работников за&nbsp;2025&nbsp;год;</li><li><a data-anchor="/document/16/219105/dfas5u956e/" data-dfa="dfas5u956e"></a>проверьте выручку за&nbsp;2025&nbsp;год;</li><li>проверьте наличие ограничений: есть&nbsp;ли государственная доля равная или более 50&nbsp;процентов;</li><li>состоите&nbsp;ли плательщиком акцизного налога.</li></ul><p><a data-anchor="/document/16/219105/bssPhr348/"></a><a data-anchor="/document/16/219105/dfashad4y7/" data-dfa="dfashad4y7"></a>Обновите внутренний календарь отчетности:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr349/"></a><a data-anchor="/document/16/219105/dfas2szhv0/" data-dfa="dfas2szhv0"></a>отметьте новые сроки сдачи;</li><li>настройте рабочие процессы под новые инструменты Нацкомстата:</li><li>получите доступ к&nbsp;интерактивным сервисам «Консультант» и&nbsp;«Аналитик»,</li><li>уточните порядок прохождения обзвонов по&nbsp;call-центру.</li></ul><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753184" data-warm-notice-type="error" num="1409" target="_blank" lnktype="intlnk" title="" class="doc">Каким критериям должны соответствовать малые предприятия</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753183" data-warm-notice-type="error" num="1410" target="_blank" lnktype="intlnk" title="" class="doc">Как предоставлять статистическую отчетность</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753182" data-warm-notice-type="error" num="1411" target="_blank" lnktype="intlnk" title="" class="doc">Бланки статотчетности на&nbsp;2025 год</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753181" data-warm-notice-type="error" num="1412" target="_blank" lnktype="intlnk" title="" class="doc">Как получить справку из органа статистики</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit27/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit27"><a data-anchor="/document/16/219105/bssPhr351/"></a><a data-anchor="/document/16/219105/dfasyo5ytg/" data-dfa="dfasyo5ytg"></a>Поддержка гостиничного бизнеса</h2><a data-anchor="/document/16/219105/tit28/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit28"><a data-anchor="/document/16/219105/bssPhr352/"></a><a data-anchor="/document/16/219105/dfasldydx3/" data-dfa="dfasldydx3"></a>Льготные кредиты&nbsp;для гостиничного бизнеса</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr354/"></a><a data-anchor="/document/16/219105/dfasieux2r/" data-dfa="dfasieux2r"></a>Предприниматели всех отраслей могут получить кредиты в&nbsp;коммерческих банках на&nbsp;строительство гостиниц. Кредиты выдаются на&nbsp;срок до&nbsp;7&nbsp;лет (Указ Президента от&nbsp;19.08.2025 № <span num="1059" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>).</p><p><a data-anchor="/document/16/219105/bssPhr355/"></a><a data-anchor="/document/16/219105/dfas25i8tu/" data-dfa="dfas25i8tu"></a>Размер кредита зависит от&nbsp;места расположения строящейся гостиницы:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr356/"></a><a data-anchor="/document/16/219105/dfasxcheiw/" data-dfa="dfasxcheiw"></a>до&nbsp;30&nbsp;млрд сумов&nbsp;— в&nbsp;Ташкенте, Нукусе, областных центрах и&nbsp;туристических зонах,</li><li>до&nbsp;10&nbsp;млрд сумов&nbsp;— в&nbsp;других регионах.</li></ul><p><a data-anchor="/document/16/219105/bssPhr357/"></a><a data-anchor="/document/16/219105/dfasulngkn/" data-dfa="dfasulngkn"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr358/"></a><a data-anchor="/document/16/219105/dfas98rbpk/" data-dfa="dfas98rbpk"></a>Убедитесь, что в&nbsp;уставе или свидетельстве указаны виды деятельности, позволяющие заниматься гостиничным бизнесом (ОКЭД, например, 55.10&nbsp;— деятельность гостиниц и&nbsp;прочих мест для краткосрочного проживания). Если планируется создание новой юридической структуры под гостиницу&nbsp;— вам придется поучаствовать в&nbsp;её&nbsp;регистрации и&nbsp;постановке на&nbsp;учет. В&nbsp;этом вам поможет рекомендация «<span data-warm-notices="45753210" data-warm-notice-type="error" num="773" target="_blank" lnktype="intlnk" title="" class="doc">Как зарегистрировать юридическое лицо</span>».</p><p><a data-anchor="/document/16/219105/bssPhr359/"></a><a data-anchor="/document/16/219105/dfasis2nsu/" data-dfa="dfasis2nsu"></a>Для подачи заявки на&nbsp;кредит банк потребует подготовить финансовую отчётность за&nbsp;последние год&nbsp;— три года:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr360/"></a><a data-anchor="/document/16/219105/dfasugma6x/" data-dfa="dfasugma6x"></a>бухгалтерский баланс (форма&nbsp;1);</li><li>отчет о&nbsp;финансовых результатах (форма 2). О&nbsp;том, как составить финансовую отчетность по&nbsp;всем правилам&nbsp;— читайте в <span data-warm-notices="45753209" data-warm-notice-type="error" num="774" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>;</li><li>документы об&nbsp;отсутствии задолженностей по&nbsp;налогам. В&nbsp;этом вам поможет <span data-warm-notices="45753208" data-warm-notice-type="error" num="775" target="_self" lnktype="intlnk" title="" class="doc">рекомендация</span>;</li><li>кредитную историю организации;</li><li>аудиторское заключение, при необходимости.</li></ul><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="769" target="_self" lnktype="intlnk" title="" class="doc">Льготы и&nbsp;преференции для гостиниц</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753172" data-warm-notice-type="error" num="770" target="_self" lnktype="intlnk" title="" class="doc">Как сдать финансовую отчетность</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753171" data-warm-notice-type="error" num="771" target="_self" lnktype="intlnk" title="" class="doc">Как зарегистрировать юридическое лицо</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit29/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit29"><a data-anchor="/document/16/219105/bssPhr362/"></a><a data-anchor="/document/16/219105/dfasam9yqx/" data-dfa="dfasam9yqx"></a>Конкурс с призовым фондом&nbsp;</h3><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr364/"></a><a data-anchor="/document/16/219105/dfasn4dham/" data-dfa="dfasn4dham"></a>Запускается ежегодный конкурс среди гостиниц с&nbsp;призовым фондом до&nbsp;1&nbsp;млн долларов для выявления и награждения объектов размещения, получивших наибольшее внимание туристов и положительное признание на престижных международных площадках (<span num="1060" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от 19.08.2025 № УП-138).</p><p><a data-anchor="/document/16/219105/bssPhr365/"></a><a data-anchor="/document/16/219105/dfas9gbf1y/" data-dfa="dfas9gbf1y"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr366/"></a><a data-anchor="/document/16/219105/dfasm6p1v6/" data-dfa="dfasm6p1v6"></a>Подготовьте&nbsp;пакет документов для участия в конкурсе.&nbsp;От участников могут потребовать:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr367/"></a><a data-anchor="/document/16/219105/dfasr0d91n/" data-dfa="dfasr0d91n"></a>финансовую отчетность (за последние год –&nbsp;три года). О том, как составить финансовую отчетность по всем правилам, читайте в <span data-warm-notices="45753231" data-warm-notice-type="error" num="727" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>;</li><li>информацию об отсутствии налоговой&nbsp;задолженности. В этом вам поможет <span data-warm-notices="45753230" data-warm-notice-type="error" num="688" target="_self" lnktype="intlnk" title="" class="doc">рекомендация</span>;</li><li>документы по праву собственности/аренды на гостиницу.</li></ul><p><a data-anchor="/document/16/219105/bssPhr368/"></a><a data-anchor="/document/16/219105/dfas9mf09v/" data-dfa="dfas9mf09v"></a>Если гостиница решит участвовать в конкурсе, то возможны дополнительные расходы:&nbsp;улучшение сервиса, ремонт, реклама, продвижение на международных площадках, покупка программ лояльности и т.д.&nbsp;Это означает необходимость инвестиций, которые бухгалтер должен&nbsp;учесть и правильно отразить. Напоминаем, что плательщики налога на прибыль вправе применить инвестиционный вычет по затратам на&nbsp;строительство и реконструкцию гостиниц. О том, как правильно применить и рассчитать инвестиционный вычет, читайте в <span num="689" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span num="686" target="_self" lnktype="intlnk" title="" class="doc">Льготы и&nbsp;преференции для гостиниц</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753170" data-warm-notice-type="error" num="687" target="_self" lnktype="intlnk" title="" class="doc">Как вести учет в&nbsp;туризме</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753169" data-warm-notice-type="error" num="726" target="_self" lnktype="intlnk" title="" class="doc">Как сдать финансовую отчетность</span></li><li class="incut-v4-more-about__item"><span num="685" target="_self" lnktype="intlnk" title="" class="doc">Что подразумевает инвестиционный вычет</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit30/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit30"><a data-anchor="/document/16/219105/bssPhr370/"></a><a data-anchor="/document/16/219105/dfas2soq04/" data-dfa="dfas2soq04"></a>Поддержка сферы туризма</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr372/"></a><a data-anchor="/document/16/219105/dfaszthzpl/" data-dfa="dfaszthzpl"></a>Ввели новые правила, направленные на&nbsp;развитие туризма согласно Указу Президента от&nbsp;19.08.2025 № <span num="1061" target="_self" lnktype="intlnk" title="" class="doc">УП-138</span>:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr373/"></a><a data-anchor="/document/16/219105/dfasyl5epi/" data-dfa="dfasyl5epi"></a>выставление на&nbsp;электронные онлайн-аукционы не&nbsp;менее 5&nbsp;тыс.&nbsp;га&nbsp;земельных участков для организации средств размещения в&nbsp;2026–2028&nbsp;годах;</li><li>механизм заключения партнерских соглашений с&nbsp;государством в&nbsp;размере не&nbsp;более 50&nbsp;процентов уставного фонда строящейся гостиницы, исходя из&nbsp;цены земельных участков, сформированной на&nbsp;аукционе;</li><li>возможность продажи госдоли по&nbsp;рыночной стоимости владельцу недвижимости или иным потенциальным инвесторам в&nbsp;течение 10&nbsp;лет;</li><li>отменился порядок исчисления и&nbsp;уплаты туристского (гостиничного) сбора в&nbsp;средствах размещения, расположенных на&nbsp;территории районов и&nbsp;городов республики (за&nbsp;исключением областных центров, Ташкента и&nbsp;Нукуса, районов (городов) с&nbsp;высоким туристским потенциалом и&nbsp;туристских зон, включенных в&nbsp;перечень, утверждаемый Кабинетом Министров;</li><li>увеличен в&nbsp;2&nbsp;раза установленный предельный размер количества посетителей (туристов), которым одновременно могут быть предоставлены услуги по&nbsp;временному размещению&nbsp;и (или) организации питания для признания объекта размещения семейным гостевым домом (сейчас это количество составляет&nbsp;— 10&nbsp;человек).</li></ul><p><a data-anchor="/document/16/219105/bssPhr374/"></a><a data-anchor="/document/16/219105/dfasqsrowz/" data-dfa="dfasqsrowz"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr375/"></a><a data-anchor="/document/16/219105/dfascxgf7z/" data-dfa="dfascxgf7z"></a>Сообщите руководству об&nbsp;открывающейся возможности получить участки под гостиницы и&nbsp;гостевые дома.</p><p><a data-anchor="/document/16/219105/bssPhr376/"></a><a data-anchor="/document/16/219105/dfas85ds9t/" data-dfa="dfas85ds9t"></a>Проверьте:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr377/"></a><a data-anchor="/document/16/219105/dfaswfszgl/" data-dfa="dfaswfszgl"></a>готов&nbsp;ли устав и&nbsp;регистрационные документы для участия в&nbsp;аукционе;</li><li>есть&nbsp;ли ресурсы на&nbsp;подачу заявки;</li><li>уточните порядок участия в&nbsp;электронных онлайн-аукционах (E-auksion).</li></ul><p><a data-anchor="/document/16/219105/bssPhr378/"></a><a data-anchor="/document/16/219105/dfasig3keg/" data-dfa="dfasig3keg"></a>Подготовьте:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr379/"></a><a data-anchor="/document/16/219105/dfas1ka93h/" data-dfa="dfas1ka93h"></a>финансовую отчетность;</li><li>кредитную историю (если потребуется);</li><li>инвестиционное обоснование/бизнес-план (по&nbsp;желанию инвестора/госоргана).</li></ul><p data-end="859" data-start="773"><a data-anchor="/document/16/219105/bssPhr380/"></a><a data-anchor="/document/16/219105/dfaslvmvfo/" data-dfa="dfaslvmvfo"></a>Если ваша организация попадает под освобождение от&nbsp;туристского сбора, внесите изменения в&nbsp;налоговую учетную политику. Что учесть в&nbsp;учетной политике в&nbsp;рекомендации «<span data-warm-notices="45753203" data-warm-notice-type="error" num="648" target="_self" lnktype="intlnk" title="" class="doc">Как составить учетную политику в&nbsp;целях налогообложения</span>». Проинформируйте администраторов отелей, кассиров, что туристский сбор отменили.</p><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753168" data-warm-notice-type="error" num="644" target="_self" lnktype="intlnk" title="" class="doc">Как вести учет в&nbsp;туризме</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753167" data-warm-notice-type="error" num="645" target="_self" lnktype="intlnk" title="" class="doc">НДС при оказании туристических услуг</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753166" data-warm-notice-type="error" num="646" target="_self" lnktype="intlnk" title="" class="doc">Лицензирование и&nbsp;сертификация туристских услуг</span></li><li class="incut-v4-more-about__item"><span num="647" target="_self" lnktype="intlnk" title="" class="doc">Льготы и&nbsp;преференции для гостиниц</span></li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/219105/tit31/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit31"><a data-anchor="/document/16/219105/bssPhr382/"></a><a data-anchor="/document/16/219105/dfask06rsc/" data-dfa="dfask06rsc"></a>Аренда госактивов</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/219105/bssPhr385/"></a><a data-anchor="/document/16/219105/dfasaxc5oh/" data-dfa="dfasaxc5oh"></a>С&nbsp;2026 года минимальный размер арендной платы за&nbsp;пользование государственной недвижимостью теперь определяется на&nbsp;основе минимальной рыночной стоимости, сформированной в&nbsp;конкретном регионе (<span num="1062" target="_self" lnktype="intlnk" title="" class="doc">Указ</span> Президента от&nbsp;19.08.2025 № УП-138).</p><p><a data-anchor="/document/16/219105/bssPhr386/"></a><a data-anchor="/document/16/219105/dfassytrcp/" data-dfa="dfassytrcp"></a>Напоминаем, что с&nbsp;2025 года Жокаргы Кенес Республики Каракалпакстан, Кенгаши народных депутатов областей вправе вводить повышающий коэффициент до&nbsp;2,0&nbsp;к минимальным ставкам арендной платы по&nbsp;жилым и&nbsp;нежилым помещениям в&nbsp;разрезе районов и&nbsp;городов в&nbsp;зависимости от&nbsp;их&nbsp;уровня экономического развития (<span num="1063" target="_self" lnktype="intlnk" title="" class="doc">ст.&nbsp;12</span>&nbsp;Закона от 24.12.2024 № ЗРУ-1011).</p><p><a data-anchor="/document/16/219105/bssPhr387/"></a><a data-anchor="/document/16/219105/dfasrsnvtk/" data-dfa="dfasrsnvtk"></a>В&nbsp;Ташкенте данный коэффициент определяет Кенгаш народных депутатов в&nbsp;разрезе зон, установленных для целей расчета земельного налога. При этом повышающие коэффициенты к&nbsp;минимальным ставкам арендной платы за&nbsp;нежилые объекты зависят еще и&nbsp;от&nbsp;вида деятельности юрлица. Срок предоставления госнедвижимости в&nbsp;аренду увеличивается&nbsp;— с&nbsp;3&nbsp;лет до&nbsp;5&nbsp;лет.</p><p><a data-anchor="/document/16/219105/bssPhr388/"></a><a data-anchor="/document/16/219105/dfasg5hg0n/" data-dfa="dfasg5hg0n"></a><strong>Что важно сделать бухгалтеру</strong></p><p><a data-anchor="/document/16/219105/bssPhr389/"></a><a data-anchor="/document/16/219105/dfasq83tlg/" data-dfa="dfasq83tlg"></a>Подготовьте шаблоны новых договоров или допсоглашений для аренды с&nbsp;учетом нового срока (5&nbsp;лет). Как составить договор аренды, читайте в <span data-warm-notices="45753220" data-warm-notice-type="error" num="601" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr390/"></a><a data-anchor="/document/16/219105/dfasgwvgrn/" data-dfa="dfasgwvgrn"></a>Если срок аренды закончился в&nbsp;2025&nbsp;году, подайте заявление на&nbsp;продление, указав, что:</p><ul class="c-list"><li><a data-anchor="/document/16/219105/bssPhr391/"></a><a data-anchor="/document/16/219105/dfasdbvyro/" data-dfa="dfasdbvyro"></a>готовы заключить договор на&nbsp;5&nbsp;лет;</li><li>ознакомлены с&nbsp;новыми условиями (ставки, коэффициенты). Минимальные ставки аренды с&nbsp;учетом повышающих коэффициентов в&nbsp;разрезе города Ташкента и&nbsp;областей узнайте из <span data-warm-notices="41892876" data-warm-notice-type="error" num="602" target="_self" lnktype="intlnk" title="" class="doc">рекомендации.</span></li></ul><p><a data-anchor="/document/16/219105/bssPhr392/"></a><a data-anchor="/document/16/219105/dfasutd8gc/" data-dfa="dfasutd8gc"></a>Как учитывать аренду в&nbsp;бухгалтерском и&nbsp;налоговом учете читайте в <span data-warm-notices="45753219" data-warm-notice-type="error" num="603" target="_blank" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr393/"></a><a data-anchor="/document/16/219105/dfash02nny/" data-dfa="dfash02nny"></a>При изменении условий аренды и&nbsp;сроков внесите изменения в&nbsp;учетную политику. О&nbsp;том, как составить учетную политику для целей бухгалтерского учета читайте в <span data-warm-notices="45753218" data-warm-notice-type="error" num="604" target="_self" lnktype="intlnk" title="" class="doc">рекомендации</span>.</p><p><a data-anchor="/document/16/219105/bssPhr394/"></a><a data-anchor="/document/16/219105/dfasemd9ll/" data-dfa="dfasemd9ll"></a><strong>Вам в&nbsp;помощь наши шаблоны:</strong></p><div class="doc-columns doc-columns_type_forms"><table class="" style="width:92%"><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr><tr><td style="vertical-align:top; padding: 0 30px 20px 0;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td><td style="vertical-align:top;"><div class="doc-columns__item"><span class="media"><img class="media__imgage" src="https://1gb.uz/system/content/image/297///" style="width:"></span><div class="doc-columns__item-title"></div><a class="doc-columns__item-text link npd" href="https://1gb.uz//#/document/"></a></div></td></tr></table></div><div data-role="phrase-incut" class="incut-v4  incut-v4-more-about "><h3 class="incut-v4__tag" data-incut-toggle="">Ещё по теме</h3><p class="incut-v4__title" data-incut-toggle=""><name></name></p><div class="incut-v4__content" data-incut-content=""><ul class="incut-v4-more-about__list"><li class="incut-v4-more-about__item"><span data-warm-notices="45753165" data-warm-notice-type="error" num="598" target="_self" lnktype="intlnk" title="" class="doc">Как отразить в&nbsp;бухучете и&nbsp;при налогообложении оперативную аренду</span></li><li class="incut-v4-more-about__item"><span num="599" target="_self" lnktype="intlnk" title="" class="doc">Минимальные ставки арендной платы с&nbsp;учетом повышающих коэффициентов</span></li><li class="incut-v4-more-about__item"><span data-warm-notices="45753164" data-warm-notice-type="error" num="600" target="_self" lnktype="intlnk" title="" class="doc">Как составить учетную политику для целей бухгалтерского учета на&nbsp;2025 год</span></li></ul></div><div class="incut-v4__icon"></div></div></div></div></div><div xmlns="" class="footer">© Материал из ЭС "ACTION: Главбух"<br />https://1gb.uz<br />Дата копирования: 28.09.2026</div></body></html>