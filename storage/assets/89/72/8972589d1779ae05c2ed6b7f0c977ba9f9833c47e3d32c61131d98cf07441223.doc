c/" data-dfa="dfasuh9p8c"></a><a href="https://1gb.uz/#/document/16/218501/dfas3zokb2/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885361" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885361/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr24/"></a><a data-anchor="/document/16/218501/dfas87l2do/" data-dfa="dfas87l2do"></a><a href="https://1gb.uz/#/document/16/218501/dfass26lma/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885369" sourceId="1" width="364" height="92" src="https://1gb.uz/system/content/image/297/1/-41885369/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr25/"></a><a data-anchor="/document/16/218501/dfas142mvn/" data-dfa="dfas142mvn"></a><a href="https://1gb.uz/#/document/16/218501/dfasv2ltcw/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885370" sourceId="1" width="364" height="92" src="https://1gb.uz/system/content/image/297/1/-41885370/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr26/"></a><a data-anchor="/document/16/218501/dfas5lm9gi/" data-dfa="dfas5lm9gi"></a><a href="https://1gb.uz/#/document/16/218501/dfasdtquxc/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885371" sourceId="1" width="364" height="92" src="https://1gb.uz/system/content/image/297/1/-41885371/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr27/"></a><a data-anchor="/document/16/218501/dfasldsmab/" data-dfa="dfasldsmab"></a><a href="https://1gb.uz/#/document/16/218501/dfas2u7xwm/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885372" sourceId="1" width="364" height="92" src="https://1gb.uz/system/content/image/297/1/-41885372/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr28/"></a><a data-anchor="/document/16/218501/dfasaf67u2/" data-dfa="dfasaf67u2"></a><a href="https://1gb.uz/#/document/16/218501/dfas8wpie2/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885373" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885373/"></a></td></tr><tr><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr29/"></a><a data-anchor="/document/16/218501/dfashepi98/" data-dfa="dfashepi98"></a><a href="https://1gb.uz/#/document/16/218501/dfasdw5xr7/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885362" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885362/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr30/"></a><a data-anchor="/document/16/218501/dfascg7tcz/" data-dfa="dfascg7tcz"></a><a href="https://1gb.uz/#/document/16/218501/dfash03sgc/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885382" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885382/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr31/"></a><a data-anchor="/document/16/218501/dfaszsuuwg/" data-dfa="dfaszsuuwg"></a><a href="https://1gb.uz/#/document/16/218501/dfaszigpx6/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885383" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885383/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr32/"></a><a data-anchor="/document/16/218501/dfas6wd9av/" data-dfa="dfas6wd9av"></a><a href="https://1gb.uz/#/document/16/218501/dfasr8s0cv/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885384" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885384/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr33/"></a><a data-anchor="/document/16/218501/dfas15d4on/" data-dfa="dfas15d4on"></a><a href="https://1gb.uz/#/document/16/218501/dfasc1bnil/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885385" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885385/"></a></td><td style="text-align: left; vertical-align: middle; width: 16.6%;"><a data-anchor="/document/16/218501/bssPhr34/"></a><a data-anchor="/document/16/218501/dfaswkuei5/" data-dfa="dfaswkuei5"></a><a href="https://1gb.uz/#/document/16/218501/dfasws1en7/"><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885386" sourceId="1" width="362" height="92" src="https://1gb.uz/system/content/image/297/1/-41885386/"></a></td></tr></tbody></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div></div><p><a data-anchor="/document/16/218501/bssPhr35/"></a><a data-anchor="/document/16/218501/dfas3svmtq/" data-dfa="dfas3svmtq"></a><strong>В&nbsp;системе больше:</strong></p><a href="/#/recommendations/found/isUseHints=false&amp;phrase=%D0%9A%D0%B0%D0%BA%20%D0%B7%D0%B0%D0%BF%D0%BE%D0%BB%D0%BD%D0%B8%D1%82%D1%8C%20%D0%93%D0%BE%D0%B4%D0%BE%D0%B2%D0%BE%D0%B9%20%D0%A0%D0%B0%D1%81%D1%87%D0%B5%D1%82%20%D0%BF%D0%BE%20%D0%BD%D0%B0%D0%BB%D0%BE%D0%B3%D1%83%20%D0%BD%D0%B0%20%D0%BF%D1%80%D0%B8%D0%B1%D1%8B%D0%BB%D1%8C&amp;sort=Relevance&amp;status=actual/" data-warm-notices="" data-warm-notice-type="" target="_self" class="insite" title=""><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885962" sourceId="1" width="610" height="40.945205479452056" src="https://1gb.uz/system/content/image/297/1/-41885962/"></a><a data-anchor="/document/16/218501/backlinkanchor287/" type="backlink-anchor"></a><a href="#/document/118/205634" data-warm-notices="" data-warm-notice-type="" target="_self" title="" moduleId="118" documentId="205634" class="link "><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885572" sourceId="1" fullSizeImageId="-41885571" width="610" height="40.72207084468665" src="https://1gb.uz/system/content/image/297/1/-41885572/"></a><a data-anchor="/document/16/218501/backlinkanchor288/" type="backlink-anchor"></a><a href="#/document/118/205633" data-warm-notices="" data-warm-notice-type="" target="_self" title="" moduleId="118" documentId="205633" class="link "><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41885570" sourceId="1" fullSizeImageId="-41885569" width="610" height="40.72207084468665" src="https://1gb.uz/system/content/image/297/1/-41885570/"></a><a data-anchor="/document/16/218501/tit1/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit1"><a data-anchor="/document/16/218501/bssPhr36/"></a><a data-anchor="/document/16/218501/dfaskysd3p/" data-dfa="dfaskysd3p"></a>Что такое финансовая отчетность</h2></div></div><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr42/"></a><a data-anchor="/document/16/218501/dfasvvg10r/" data-dfa="dfasvvg10r"></a>Финансовая отчетность представляет собой способ представления финансовой информации, характеризующей деятельность организации за&nbsp;определенный период. Причем, независимо от&nbsp;того, является&nbsp;ли организация отдельной независимой организацией или входит в&nbsp;группу организаций (<span num="88" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;9</span>&nbsp;НСБУ №&nbsp;1). Ее&nbsp;цель&nbsp;— предоставить пользователям информацию о&nbsp;финансовом положении организации, результатах ее&nbsp;работы и&nbsp;движении денежных средств (<span num="89" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;10</span>&nbsp;НСБУ №&nbsp;1).&nbsp;</p><p><a data-anchor="/document/16/218501/bssPhr43/"></a><a data-anchor="/document/16/218501/dfasmhhm7g/" data-dfa="dfasmhhm7g"></a>Формирование финансовой отчетности для большинства субъектов бухгалтерского учета, за&nbsp;исключением бюджетных, страховых организаций, банков и&nbsp;небанковских кредитных учреждений, регламентируется:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr44/"></a><a data-anchor="/document/16/218501/dfash9szt3/" data-dfa="dfash9szt3"></a><span num="14" target="_self" lnktype="intlnk" title="" class="doc">Национальным стандартом бухгалтерского учета №&nbsp;1</span>;</li><li><span num="15" target="_self" lnktype="intlnk" title="" class="doc">Положением о&nbsp;сроках предоставления финансовых отчетов, а&nbsp;также их&nbsp;структуре и&nbsp;содержании</span>.</li></ul></div><a data-anchor="/document/16/218501/tit2/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit2"><a data-anchor="/document/16/218501/bssPhr45/"></a><a data-anchor="/document/16/218501/dfas69gza7/" data-dfa="dfas69gza7"></a>Когда сдавать финансовую отчетность</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr48/"></a><a data-anchor="/document/16/218501/dfasllbpnf/" data-dfa="dfasllbpnf"></a>Организации обязаны предоставить годовую финансовую отчетность в&nbsp;государственные органы, в&nbsp;установленные сроки:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr49/"></a><a data-anchor="/document/16/218501/dfasi935za/" data-dfa="dfasi935za"></a>Отчетность по&nbsp;НСБУ: не&nbsp;позднее 1&nbsp;марта года, следующего за&nbsp;отчетным.</li><li>Отчетность по&nbsp;МСФО: не&nbsp;позднее 1&nbsp;мая года, следующего за&nbsp;отчетным.</li></ul><p><a data-anchor="/document/16/218501/bssPhr50/"></a><a data-anchor="/document/16/218501/dfasvk76oz/" data-dfa="dfasvk76oz"></a>Отчетный период для годовой финансовой отчетности составляет с&nbsp;1&nbsp;января по&nbsp;31&nbsp;декабря календарного года. Отчетной датой является последний календарный день отчетного периода.</p><p><a data-anchor="/document/16/218501/bssPhr51/"></a><a data-anchor="/document/16/218501/dfas4xms6z/" data-dfa="dfas4xms6z"></a>Организации, которые ведут бухучет по&nbsp;НСБУ обязаны предоставить годовую финансовую отчетность не&nbsp;позднее 1&nbsp;марта года, следующего за&nbsp;отчетным (<span num="90" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;7</span>&nbsp;Положения о&nbsp;сроках предоставления финансовых отчетов, а&nbsp;также их&nbsp;структуре и&nbsp;содержании). В&nbsp;2026 году 1&nbsp;марта выпадает на&nbsp;воскресенье, поэтому безопаснее подать отчеты заранее&nbsp;— 28&nbsp;февраля.</p><p><a data-anchor="/document/16/218501/bssPhr52/"></a><a data-anchor="/document/16/218501/dfaskd5bna/" data-dfa="dfaskd5bna"></a>Для организаций, созданных в&nbsp;отчетном году, отчетные периоды определяются в&nbsp;зависимости от&nbsp;даты регистрации. Если организация зарегистрирована:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr53/"></a><a data-anchor="/document/16/218501/dfasxeb4lt/" data-dfa="dfasxeb4lt"></a>до&nbsp;1&nbsp;октября&nbsp;— отчетный период начинается с&nbsp;1-ого числа месяца регистрации и&nbsp;заканчивается 31&nbsp;декабря того&nbsp;же года.</li><li>после 1&nbsp;октября&nbsp;— отчетный период начинается с&nbsp;даты регистрации и&nbsp;длится до&nbsp;31&nbsp;декабря следующего года.</li></ul><p><a data-anchor="/document/16/218501/bssPhr54/"></a><a data-anchor="/document/16/218501/dfasy0im17/" data-dfa="dfasy0im17"></a>Это определено в <span num="91" target="_self" lnktype="intlnk" title="" class="doc">пункте&nbsp;6</span>&nbsp;Положения о&nbsp;сроках предоставления финансовых отчетов, а&nbsp;также их&nbsp;структуре и&nbsp;содержании. Эта норма не&nbsp;применяется к&nbsp;организациям, созданным на&nbsp;базе ликвидированных (реорганизованных) организаций или их&nbsp;обособленных подразделений.</p><p><a data-anchor="/document/16/218501/bssPhr55/"></a><a data-anchor="/document/16/218501/dfasrt7wxi/" data-dfa="dfasrt7wxi"></a>Если организация была ликвидирована, реорганизована или присоединена в&nbsp;отчетном году, она представляет отчетность за&nbsp;период с&nbsp;начала года до&nbsp;момента ликвидации, реорганизации или присоединения (<span num="92" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;5</span>&nbsp;Положения о&nbsp;сроках предоставления финансовых отчетов, а&nbsp;также их&nbsp;структуре и&nbsp;содержании).</p><div data-role="phrase-incut" class="incut-v4 incut-v4-spoiler incut-v4-situation " data-incut="spoiler"><h3 class="incut-v4__tag" data-incut-toggle="">Ситуация</h3><p class="incut-v4__title" data-incut-toggle=""><name>Можно&#160;ли в&#160;текущем году списать расходы прошлого года и&#160;как это отразить в&#160;бухучете</name></p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/218501/bssPhr57/"></a><a data-anchor="/document/16/218501/dfas6pby2c/" data-dfa="dfas6pby2c"></a>Да, можно.</p><p><a data-anchor="/document/16/218501/bssPhr58/"></a><a data-anchor="/document/16/218501/dfas1lavq5/" data-dfa="dfas1lavq5"></a>Если финансовая отчетность уже сдана, то&nbsp;отражение в&nbsp;учете и&nbsp;отчетности расходов прошлого года, выявленных в&nbsp;отчетном году, зависит от&nbsp;их&nbsp;существенности.</p><p><a data-anchor="/document/16/218501/bssPhr59/"></a><a data-anchor="/document/16/218501/dfass39g3i/" data-dfa="dfass39g3i"></a>Существенные, значительные ошибки&nbsp;— это ошибки, выявленные в&nbsp;текущем отчетном периоде, которые являются причиной того, что финансовая отчетность за&nbsp;предыдущие периоды не&nbsp;может считаться достоверной (<span num="315" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;114</span>&nbsp;НСБУ №&nbsp;1).</p><p><a data-anchor="/document/16/218501/bssPhr60/"></a><a data-anchor="/document/16/218501/dfas070y2f/" data-dfa="dfas070y2f"></a>Сумму (стоимость) корректировки ошибок, допущенных при подготовке финансовой отчетности за&nbsp;предыдущие периоды, включайте в&nbsp;чистую прибыль или убыток отчетного периода (<span num="316" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;115</span>&nbsp;НСБУ №&nbsp;1).</p><p style="text-align:left"><a data-anchor="/document/16/218501/bssPhr61/"></a><a data-anchor="/document/16/218501/dfasanlhah/" data-dfa="dfasanlhah"></a>В&nbsp;бухучете отразите эту операцию проводкой:</p><p style="text-align:left"><a data-anchor="/document/16/218501/bssPhr62/"></a><a data-anchor="/document/16/218501/dfaswb7o5l/" data-dfa="dfaswb7o5l"></a><strong>Дебет 8710 Кредит 6010</strong></p><ul class="c-list"><li style="text-align:left"><a data-anchor="/document/16/218501/bssPhr63/"></a><a data-anchor="/document/16/218501/dfasup5sfi/" data-dfa="dfasup5sfi"></a>отражены субподрядные работы за&nbsp;прошлый период.</li></ul><p><a data-anchor="/document/16/218501/bssPhr64/"></a><a data-anchor="/document/16/218501/dfasqpufke/" data-dfa="dfasqpufke"></a>Основанием для корректировочных проводок служит бухгалтерская справка. В&nbsp;ней укажите причину исправлений, все последствия ошибок, счета, подлежащие исправлениям. Если корректировка отражается путем изменения сальдо по&nbsp;счету 8700, отразите это в&nbsp;пояснительной записке к&nbsp;бухгалтерскому отчету и&nbsp;финансовым результатам по&nbsp;итогу текущего года.</p><p><a data-anchor="/document/16/218501/bssPhr65/"></a><a data-anchor="/document/16/218501/dfas8i336n/" data-dfa="dfas8i336n"></a>Бухгалтерский баланс и&nbsp;отчет о&nbsp;финансовых результатах за&nbsp;прошлый год пересдавать не&nbsp;нужно.</p></div></div><div data-role="phrase-incut" class="incut-v4 incut-v4-spoiler incut-v4-situation " data-incut="spoiler"><h3 class="incut-v4__tag" data-incut-toggle="">Ситуация</h3><p class="incut-v4__title" data-incut-toggle=""><name>Когда ООО должно сдавать&#160;баланс и отчет о финансовых результатах, если оно зарегистрировано 15&#160;октября 2025 года</name></p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/218501/bssPhr67/"></a><a data-anchor="/document/16/218501/dfas0q5m5t/" data-dfa="dfas0q5m5t"></a>Если юридическое лицо, кроме бюджетных организаций, прошло регистрацию после 1 октября, то его первый отчетный год завершается 31 декабря следующего года (<span num="344" target="_blank" lnktype="intlnk" title="" class="doc">ст. 18</span> Закона о бухучете). Соответственно, первую финансовую отчетность нужно представить&nbsp;за период со дня государственной регистрации по 31 декабря следующего года. В данном случае – с&nbsp;15.10.2025 г. по 31.12.2026 г. Период с октября по декабрь 2025 года включается в этот отчетный период.</p></div></div><p><a data-anchor="/document/16/218501/bssPhr68/"></a><a data-anchor="/document/16/218501/dfasmuokn5/" data-dfa="dfasmuokn5"></a>Ошибки в&nbsp;финансовой отчетности в&nbsp;Узбекистане влекут за&nbsp;собой административные штрафы, доначисление налогов, пени, а&nbsp;также проведение налоговых проверок. Искажение данных приводит к&nbsp;необходимости сдачи уточненной отчетности, а&nbsp;умышленное занижение&nbsp;— финансовым потерям и&nbsp;репутационным рискам.</p><p style="text-align:left"><a data-anchor="/document/16/218501/bssPhr69/"></a><a data-anchor="/document/16/218501/dfasxso5zo/" data-dfa="dfasxso5zo"></a>С&nbsp;1&nbsp;августа размеры штрафа за&nbsp;несвоевременную сдачу отчетности составляют:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr70/"></a><a data-anchor="/document/16/218501/dfas8gc3dh/" data-dfa="dfas8gc3dh"></a>с&nbsp;должностного лица организации&nbsp;— 4&nbsp;120&nbsp;000&nbsp;сум. (10&nbsp;БРВ);</li><li>с&nbsp;индивидуального предпринимателя&nbsp;— 1&nbsp;236&nbsp;000&nbsp;сум. (3&nbsp;БРВ).</li></ul><p><a data-anchor="/document/16/218501/bssPhr71/"></a><a data-anchor="/document/16/218501/dfashcmglc/" data-dfa="dfashcmglc"></a>Основание&nbsp;— часть&nbsp;2&nbsp;статьи&nbsp;175&nbsp;КоАО, статья&nbsp;17.3&nbsp;КоАО.</p></div><a data-anchor="/document/16/218501/tit3/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit3"><a data-anchor="/document/16/218501/bssPhr72/"></a><a data-anchor="/document/16/218501/dfasrrd911/" data-dfa="dfasrrd911"></a>Что включает финансовая отчетность</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><div class="iframe"><iframe allowfullscreen="" frameborder="0" src="/interactive/doc/a8440623-4ab3-4d94-bcf1-daeac02e06e4/index.html" data-itype="presentation" data-moduleId="237" data-id="102" style="min-height:400px" width="100%"></iframe></div><p><a data-anchor="/document/16/218501/bssPhr77/"></a><a data-anchor="/document/16/218501/dfas3zuhgg/" data-dfa="dfas3zuhgg"></a>Это определено в <span num="93" target="_self" lnktype="intlnk" title="" class="doc">пункте&nbsp;9</span>&nbsp;Положение о&nbsp;сроках предоставления финансовых отчетов, а&nbsp;также их&nbsp;структуре и&nbsp;содержании.</p><p><a data-anchor="/document/16/218501/bssPhr79/"></a><a data-anchor="/document/16/218501/dfasvlp3vp/" data-dfa="dfasvlp3vp"></a>Микрофирмы и&nbsp;малые предприятия должны сдать бухгалтерский баланс и отчет о&nbsp;финансовых результатах (<span num="94" target="_self" lnktype="intlnk" title="" class="doc">п.&nbsp;10</span>&nbsp;Положения о сроках предоставления финансовых отчетов, а также их структуре и содержании).</p><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/218501/bssPhr80/"></a><a data-anchor="/document/16/218501/dfasbl6p2t/" data-dfa="dfasbl6p2t"></a>Требования к&nbsp;заполнению форм финансовой отчетности:</p><div class="incut-v4__content" data-incut-content=""><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr81/"></a><a data-anchor="/document/16/218501/dfasgq5hty/" data-dfa="dfasgq5hty"></a>в&nbsp;формах финансовой отчетности должны быть заполнены все реквизиты, строки и&nbsp;графы;</li><li>заполнение форм должно обеспечивать полноту предоставляемой информации и&nbsp;достоверность внесенных данных;</li><li>если у&nbsp;организации отсутствуют данные для заполнения определенной строки или графы, такая строка (графа) не&nbsp;заполняется.</li></ul></div><div class="incut-v4__icon"></div></div></div><a data-anchor="/document/16/218501/tit4/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit4"><a data-anchor="/document/16/218501/bssPhr82/"></a><a data-anchor="/document/16/218501/dfas3p8ls7/" data-dfa="dfas3p8ls7"></a>Как заполнить бухгалтерский баланс</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr88/"></a><a data-anchor="/document/16/218501/dfasfv6wie/" data-dfa="dfasfv6wie"></a>Бухгалтерский баланс отражает имущественное и&nbsp;финансовое состояние организации на&nbsp;конкретную дату (<span num="80" target="_self" lnktype="intlnk" title="" class="doc">гл.&nbsp;6</span>&nbsp;НСБУ №&nbsp;1).</p><img alt="" hideborder="true" class="inimg" num="3" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr89/"></a><a data-anchor="/document/16/218501/dfas6ec8om/" data-dfa="dfas6ec8om"></a>Стандартная форма бухгалтерского баланса представлена в <span data-warm-notices="41176864" data-warm-notice-type="error" num="115" target="_self" lnktype="intlnk" title="" class="doc">приложении №&nbsp;1&nbsp;</span>к Положению о&nbsp;сроках представления финансовой отчетности, а&nbsp;также ее&nbsp;структуре и&nbsp;содержании.</p><p><a data-anchor="/document/16/218501/bssPhr90/"></a><a data-anchor="/document/16/218501/dfasropxrn/" data-dfa="dfasropxrn"></a>Все показатели в&nbsp;бухгалтерском балансе необходимо указывать в&nbsp;тысячах сумов.</p><p><a data-anchor="/document/16/218501/bssPhr91/"></a><a data-anchor="/document/16/218501/dfasob8a54/" data-dfa="dfasob8a54"></a>В <strong>графе 3</strong>&nbsp;баланса надо отразить данные на&nbsp;начало отчетного периода. Эти показатели должны полностью соответствовать данным графы 4&nbsp;баланса за&nbsp;конец предыдущего отчетного периода.</p><p><a data-anchor="/document/16/218501/bssPhr92/"></a><a data-anchor="/document/16/218501/dfaswmi3ym/" data-dfa="dfaswmi3ym"></a>В <strong>графе 4</strong>&nbsp;баланса надо отразить данные на&nbsp;конец отчетного периода.</p><p><a data-anchor="/document/16/218501/bssPhr93/"></a><a data-anchor="/document/16/218501/dfasgk06xg/" data-dfa="dfasgk06xg"></a>Бухгалтерский баланс финансовой отчетности состоит из&nbsp;2&nbsp;частей:</p><ol class="c-list"><li><a data-anchor="/document/16/218501/bssPhr94/"></a><a data-anchor="/document/16/218501/dfas25r5gp/" data-dfa="dfas25r5gp"></a><a href="https://1gb.uz/#/document/16/218501/dfas7bz4ip/">Актив баланса: «Долгосрочные активы» и&nbsp;«Текущие активы»</a>.</li><li><a data-anchor="/document/16/218501/bssPhr95/"></a><a data-anchor="/document/16/218501/dfas5boyre/" data-dfa="dfas5boyre"></a><a href="https://1gb.uz/#/document/16/218501/dfasgpguh6/">Пассив баланса: «Источники собственных средств» и&nbsp;«Обязательства»</a>.</li></ol><div data-role="phrase-incut" class="incut-v4 incut-v4-spoiler incut-v4-example " data-incut="spoiler"><h3 class="incut-v4__tag" data-incut-toggle="">Пример</h3><p class="incut-v4__title" data-incut-toggle=""><name><a data-anchor="/document/16/218501/bssPhr96/"></a><a data-anchor="/document/16/218501/dfas31ebqs/" data-dfa="dfas31ebqs"></a>Как заполнить Баланс финансовой отчетности</name></p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/218501/bssPhr97/"></a><a data-anchor="/document/16/218501/dfas9s9wof/" data-dfa="dfas9s9wof"></a>По&nbsp;данным за&nbsp;2025 год организация имеет следующие показатели:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr98/"></a><a data-anchor="/document/16/218501/dfas1hkiga/" data-dfa="dfas1hkiga"></a>уставный капитал&nbsp;— 50&nbsp;000&nbsp;000&nbsp;сумов;</li><li>первоначальная стоимость ОС&nbsp;— 135&nbsp;000&nbsp;000&nbsp;сумов;</li><li>износ ОС&nbsp;— 81&nbsp;000&nbsp;000&nbsp;сумов;</li><li>остаточная стоимость ОС&nbsp;— 54&nbsp;000&nbsp;000&nbsp;сумов;</li><li>нераспределенная прибыль&nbsp;— 4&nbsp;200&nbsp;000&nbsp;сумов;</li><li>товарно-материальные запасы&nbsp;— 45&nbsp;000&nbsp;000&nbsp;сумов;</li><li>остаток денежных средств на&nbsp;расчетном счете&nbsp;— 5&nbsp;000&nbsp;000&nbsp;сумов;</li><li>полученные авансы&nbsp;— 35&nbsp;000&nbsp;000&nbsp;сумов;</li><li>задолженность по&nbsp;платежам в&nbsp;бюджет 2&nbsp;400&nbsp;000&nbsp;сумов;</li><li>задолженность по&nbsp;платежам в&nbsp;государственные целевые фонды&nbsp;— 2&nbsp;400&nbsp;000&nbsp;сумов;</li><li>задолженность по&nbsp;оплате труда&nbsp;— 10&nbsp;000&nbsp;000&nbsp;сумов.</li></ul><p><a data-anchor="/document/16/218501/bssPhr99/"></a><a data-anchor="/document/16/218501/dfaspuoggv/" data-dfa="dfaspuoggv"></a>Из&nbsp;товарно-материальных запасов:</p><ol class="c-list"><li><a data-anchor="/document/16/218501/bssPhr100/"></a><a data-anchor="/document/16/218501/dfaskngego/" data-dfa="dfaskngego"></a>сырье и&nbsp;материалы&nbsp;— 15&nbsp;000&nbsp;000&nbsp;сумов;</li><li><a data-anchor="/document/16/218501/bssPhr101/"></a><a data-anchor="/document/16/218501/dfaslu14t6/" data-dfa="dfaslu14t6"></a>незавершенное производство&nbsp;— 25&nbsp;000&nbsp;000&nbsp;сумов;</li><li><a data-anchor="/document/16/218501/bssPhr102/"></a><a data-anchor="/document/16/218501/dfasgqoz72/" data-dfa="dfasgqoz72"></a>готовая продукция&nbsp;— 5&nbsp;000&nbsp;000&nbsp;сумов;</li></ol><p><a data-anchor="/document/16/218501/bssPhr103/"></a><a data-anchor="/document/16/218501/dfas9bhg74/" data-dfa="dfas9bhg74"></a>По <strong>строке 010</strong> Баланса организация укажет первоначальную стоимость ОС&nbsp;— 135&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr104/"></a><a data-anchor="/document/16/218501/dfas8yhud2/" data-dfa="dfas8yhud2"></a>По <strong>строке 011</strong>&nbsp;— сумму износа&nbsp;— 81&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr105/"></a><a data-anchor="/document/16/218501/dfas9kbily/" data-dfa="dfas9kbily"></a>По<strong> строке 012 </strong>рассчитается остаточная стоимость ОС&nbsp;— 54&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr106/"></a><a data-anchor="/document/16/218501/dfasy2yofr/" data-dfa="dfasy2yofr"></a><strong>Строка 130 </strong>Баланса рассчитается автоматически&nbsp;— 54&nbsp;000&nbsp;тыс. сумов.</p><img alt="" hideborder="false" class="inimg" num="4" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr107/"></a><a data-anchor="/document/16/218501/dfasm3udf8/" data-dfa="dfasm3udf8"></a>В <strong>строке 150</strong> Баланса организация укажет остаток сырья и&nbsp;материалов&nbsp;— 15&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr108/"></a><a data-anchor="/document/16/218501/dfast50i33/" data-dfa="dfast50i33"></a>В <strong>строке 160</strong> организация укажет незавершенное производство&nbsp;— 25&nbsp;000&nbsp;тыс. сумов, а&nbsp;в&nbsp;строке 170&nbsp;— остаток готовой продукции&nbsp;— 5&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr109/"></a><a data-anchor="/document/16/218501/dfasnhfo0r/" data-dfa="dfasnhfo0r"></a>В<strong> строке 140</strong> рассчитается остаток ТМЗ&nbsp;— 45&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr110/"></a><a data-anchor="/document/16/218501/dfas474600/" data-dfa="dfas474600"></a>В <strong>строке 340</strong> нужно указать остаток денежных средств на&nbsp;расчетном счете&nbsp;— 5&nbsp;000&nbsp;тыс. сумов., строка 320 рассчитается автоматически&nbsp;— 5&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr111/"></a><a data-anchor="/document/16/218501/dfass96lvr/" data-dfa="dfass96lvr"></a><strong>Строка 390 </strong>рассчитается автоматически и&nbsp;ее&nbsp;значение будет равно 50&nbsp;000&nbsp;тыс. сумов, строка 400 также рассчитается автоматически как сумма строк 130 и&nbsp;390 и&nbsp;будет равна 104&nbsp;000&nbsp;тыс. сумов.&nbsp;</p><img alt="" hideborder="false" class="inimg" num="5" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr112/"></a><a data-anchor="/document/16/218501/dfasdmtatt/" data-dfa="dfasdmtatt"></a>В <strong>строке 410</strong> организация укажет размер уставного фонда&nbsp;— 50&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr113/"></a><a data-anchor="/document/16/218501/dfasper1qb/" data-dfa="dfasper1qb"></a>В<strong> строке 450</strong> надо указать нераспределенную прибыль&nbsp;— 4&nbsp;200&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr114/"></a><a data-anchor="/document/16/218501/dfas7c17bw/" data-dfa="dfas7c17bw"></a>Строка 480 рассчитается автоматически и&nbsp;будет равна 54&nbsp;200&nbsp;тыс. сумов.</p><img alt="" hideborder="false" class="inimg" num="6" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr115/"></a><a data-anchor="/document/16/218501/dfasnwvg8t/" data-dfa="dfasnwvg8t"></a>В<strong> строке 670 </strong>организация укажет полученные авансы&nbsp;— 35&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr116/"></a><a data-anchor="/document/16/218501/dfasd4uoso/" data-dfa="dfasd4uoso"></a>В <strong>строке 680</strong>&nbsp;— задолженность по&nbsp;платежам в&nbsp;бюджет&nbsp;— 2&nbsp;400&nbsp;тыс. сумов, в&nbsp;строке 700&nbsp;— задолженность по&nbsp;платежам в&nbsp;государственные целевые фонды&nbsp;— 2&nbsp;400&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr117/"></a><a data-anchor="/document/16/218501/dfasiu8imk/" data-dfa="dfasiu8imk"></a>В <strong>строке 720</strong> организация укажет задолженность по&nbsp;оплате труда&nbsp;— 10&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr118/"></a><a data-anchor="/document/16/218501/dfas4mnb6n/" data-dfa="dfas4mnb6n"></a><strong>Строки 600, 601 </strong>рассчитаются автоматически и&nbsp;будут равны 49&nbsp;800&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr119/"></a><a data-anchor="/document/16/218501/dfasc69ynv/" data-dfa="dfasc69ynv"></a><strong>Строка 770 </strong>рассчитается автоматически и&nbsp;будет равна 49&nbsp;800&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr120/"></a><a data-anchor="/document/16/218501/dfaskimb6g/" data-dfa="dfaskimb6g"></a><strong>Строка 780</strong> рассчитается автоматически и&nbsp;будет равна 104&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr121/"></a><a data-anchor="/document/16/218501/dfasv0g2ga/" data-dfa="dfasv0g2ga"></a><strong>Строка 400</strong> = <strong>строке 780</strong> = 104&nbsp;000&nbsp;тыс. сумов.</p><img alt="" hideborder="false" class="inimg" num="7" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div></div></div><a data-anchor="/document/16/218501/tit5/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit5"><a data-anchor="/document/16/218501/bssPhr122/"></a><a data-anchor="/document/16/218501/dfas4dhx1i/" data-dfa="dfas4dhx1i"></a>Как заполнить Актив баланса</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><a data-anchor="/document/16/218501/tit6/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit6"><a data-anchor="/document/16/218501/bssPhr124/"></a><a data-anchor="/document/16/218501/dfas2t756b/" data-dfa="dfas2t756b"></a>Раздел «Долгосрочные активы»</h3><p><a data-anchor="/document/16/218501/bssPhr125/"></a><a data-anchor="/document/16/218501/dfas85yuf5/" data-dfa="dfas85yuf5"></a><strong>Показатели по&nbsp;ОС отразите по&nbsp;строкам</strong><strong>:</strong></p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr126/"></a><a data-anchor="/document/16/218501/dfasvy866r/" data-dfa="dfasvy866r"></a><strong>010 «Первоначальная (восстановительная) стоимость»</strong>&nbsp;— стоимость собственных&nbsp;ОС, действующих и&nbsp;находящихся на&nbsp;консервации и&nbsp;ОС, полученных по&nbsp;договору финансовой аренды (счета 0100 и&nbsp;0300);</li><li><a data-anchor="/document/16/218501/dfas7hqhxa/" data-dfa="dfas7hqhxa"></a><strong>011 «Сумма износа»</strong>&nbsp;— накопленный на&nbsp;счетах 0200 износ по&nbsp;ОС, которые учтены на&nbsp;счетах 0100 и&nbsp;0300;</li><li><a data-anchor="/document/16/218501/dfasxrg0h2/" data-dfa="dfasxrg0h2"></a><strong>012 «Остаточная (балансовая) стоимость»</strong>&nbsp;— разница строк 010 и&nbsp;011.</li></ul><p><a data-anchor="/document/16/218501/bssPhr129/"></a><a data-anchor="/document/16/218501/dfas9574i1/" data-dfa="dfas9574i1"></a><strong>Показатели по&nbsp;НМА отразите по&nbsp;строкам</strong><strong>:</strong></p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr130/"></a><a data-anchor="/document/16/218501/dfasnbkr8g/" data-dfa="dfasnbkr8g"></a><strong>020 «Первоначальная стоимость»</strong>&nbsp;— по&nbsp;активам, которые учтены на&nbsp;счетах 0400. При этом гудвилл отражается за&nbsp;вычетом списаний, произведенных в&nbsp;отчетном периоде, без отражения амортизации на&nbsp;отдельном счете;</li><li><a data-anchor="/document/16/218501/dfasyaxip3/" data-dfa="dfasyaxip3"></a><strong>021 «Сумма амортизации»</strong>&nbsp;— накопленные на&nbsp;счетах 0500 суммы амортизации по&nbsp;НМА, которые учтены на&nbsp;счетах 0400;</li><li><a data-anchor="/document/16/218501/dfassx6w30/" data-dfa="dfassx6w30"></a><strong>022 «Остаточная (балансовая) стоимость»&nbsp;</strong>— разница строк 020 и&nbsp;021.</li></ul><p><a data-anchor="/document/16/218501/bssPhr131/"></a><a data-anchor="/document/16/218501/dfas2db2gy/" data-dfa="dfas2db2gy"></a>В <strong>строке 030 «Долгосрочные инвестиции» </strong> рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr132/"></a><a data-anchor="/document/16/218501/dfasu0i76g/" data-dfa="dfasu0i76g"></a><strong>040</strong>&nbsp;— средства, вложенные в&nbsp;ценные бумаги: облигации, акции и&nbsp;другие (счет 0610). В&nbsp;эту строку не&nbsp;включайте ценные бумаги дочерних и&nbsp;зависимых предприятий, а&nbsp;также предприятий с&nbsp;иностранным капиталом;</li><li><a data-anchor="/document/16/218501/dfasgux750/" data-dfa="dfasgux750"></a><strong>050</strong>&nbsp;— инвестиции в&nbsp;дочерние предприятия, т.е. средства, вложенные в&nbsp;акции, облигации и&nbsp;другие инвестиции таких предприятий (счет 0620);</li><li><a data-anchor="/document/16/218501/dfascqq4da/" data-dfa="dfascqq4da"></a><strong>060</strong>&nbsp;— инвестиции в&nbsp;зависимые предприятия, т.е. средства, вложенные в&nbsp;акции, облигации и&nbsp;другие инвестиции таких предприятий (счет 0630);</li><li><a data-anchor="/document/16/218501/dfasyu0hi0/" data-dfa="dfasyu0hi0"></a><strong>070</strong>&nbsp;— инвестиции в&nbsp;предприятия с&nbsp;иностранным капиталом, т.е. средства, вложенные в&nbsp;акции, облигации и&nbsp;другие инвестиции таких предприятий (счет 0640);</li><li><a data-anchor="/document/16/218501/dfasy342yh/" data-dfa="dfasy342yh"></a><strong>080&nbsp;</strong>— прочие долгосрочные инвестиции, не&nbsp;учтенные на&nbsp;других счетах (счет 0690).</li></ul><p><a data-anchor="/document/16/218501/bssPhr133/"></a><a data-anchor="/document/16/218501/dfasu467hv/" data-dfa="dfasu467hv"></a>В <strong>строке 090 «Оборудование к&nbsp;установке»</strong> отразите фактическую стоимость такого оборудования (счет 0700).</p><p><a data-anchor="/document/16/218501/bssPhr134/"></a><a data-anchor="/document/16/218501/dfasv0b4hh/" data-dfa="dfasv0b4hh"></a>В <strong>строке 100 «Капитальные вложения»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr135/"></a><a data-anchor="/document/16/218501/dfas1zcn28/" data-dfa="dfas1zcn28"></a>стоимость незавершенного строительства, осуществляемого как хозяйственным, так и&nbsp;подрядным способами (счет 0810);</li><li>стоимость приобретенных&nbsp;ОС (счет 0820) и&nbsp;НМА (счет 0830), не&nbsp;переданных в&nbsp;эксплуатацию;</li><li>затраты по&nbsp;формированию основного стада (счет 0840);</li><li>вложения в&nbsp;благоустройство земли (счет 0850);</li><li>вложения в&nbsp;ОС, полученные по&nbsp;договору финансовой аренды (счет 0860);</li><li>другие капитальные вложения (счет 0890).</li></ul><p><a data-anchor="/document/16/218501/bssPhr136/"></a><a data-anchor="/document/16/218501/dfas7amo2m/" data-dfa="dfas7amo2m"></a>В<strong> строке 110 «Долгосрочная дебиторская задолженность»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr137/"></a><a data-anchor="/document/16/218501/dfascpfib9/" data-dfa="dfascpfib9"></a>долгосрочную часть полученных векселей (счет 0910);</li><li>остаток платежей к&nbsp;получению за&nbsp;ОС, переданные по&nbsp;договору финансовой аренды (счет 0920);</li><li>долгосрочную задолженность персонала (счет 0930);</li><li>прочую долгосрочную дебиторскую задолженность (счет 0940).</li></ul><p><a data-anchor="/document/16/218501/bssPhr138/"></a><a data-anchor="/document/16/218501/dfas2n5c0r/" data-dfa="dfas2n5c0r"></a>В <strong>строке 120 «Долгосрочные отсроченные расходы» </strong>отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr139/"></a><a data-anchor="/document/16/218501/dfasnd2c8t/" data-dfa="dfasnd2c8t"></a>отсроченный налог на&nbsp;прибыль по&nbsp;временным разницам (счет 0950);</li><li>долгосрочные отсроченные расходы по&nbsp;дисконтам, скидкам (счет 0960);</li><li>прочие долгосрочные отсроченные расходы (счет 0990).</li></ul><p><a data-anchor="/document/16/218501/bssPhr140/"></a><a data-anchor="/document/16/218501/dfasx2ruar/" data-dfa="dfasx2ruar"></a>В <strong>строке 130 «Итого по&nbsp;разделу&nbsp;I актива баланса»</strong> рассчитается сумма по&nbsp;строкам 012, 022, 030, 090, 100, 110 и&nbsp;120.</p><img alt="" hideborder="false" class="inimg" num="8" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><a data-anchor="/document/16/218501/tit7/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit7"><a data-anchor="/document/16/218501/bssPhr141/"></a><a data-anchor="/document/16/218501/dfas86u2qt/" data-dfa="dfas86u2qt"></a>Раздел «Текущие активы»</h3><p><a data-anchor="/document/16/218501/bssPhr142/"></a><a data-anchor="/document/16/218501/dfase71gf8/" data-dfa="dfase71gf8"></a>В <strong>строке 140 «Товарно-материальные запасы, всего»</strong> рассчитайте сумму остатков ТМЗ, которые отражены в&nbsp;строках 150, 160, 170 и&nbsp;180.</p><p><a data-anchor="/document/16/218501/bssPhr143/"></a><a data-anchor="/document/16/218501/dfasw3gtfb/" data-dfa="dfasw3gtfb"></a>В <strong>строке 150 «Производственные запасы»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr144/"></a><a data-anchor="/document/16/218501/dfasugbauw/" data-dfa="dfasugbauw"></a>фактическую себестоимость запасов сырья, покупных полуфабрикатов и&nbsp;комплектующих изделий, топлива, запасных частей, стройматериалов, тары, материалов в&nbsp;переработке, инвентаря, хозпринадлежностей и&nbsp;прочих материалов (счет 1000);</li><li>фактическую себестоимость молодняка животных, взрослых животных, находящихся на&nbsp;откорме, в&nbsp;нагуле, птиц, зверей, кроликов, семей пчел, взрослого скота, выбракованного из&nbsp;основного стада для реализации, без постановки на&nbsp;откорм, скота, принятого от&nbsp;населения для реализации (счет 1100);</li><li>сальдо счетов учета заготовления и&nbsp;приобретения материалов 1500 и&nbsp;отклонений в&nbsp;стоимости материалов 1600, если они используются.</li></ul><p><a data-anchor="/document/16/218501/bssPhr145/"></a><a data-anchor="/document/16/218501/dfasnv6f30/" data-dfa="dfasnv6f30"></a>В <strong>строке 160 «Незавершенное производство»</strong> отразите стоимость затрат:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr146/"></a><a data-anchor="/document/16/218501/dfas4b3aps/" data-dfa="dfas4b3aps"></a>незавершенного производства продукции или по&nbsp;незавершенным работам (услугам) (счет 2000);</li><li>на&nbsp;полуфабрикаты собственного производства (счет 2100);</li><li>вспомогательных производств (счет 2300);</li><li>обслуживающих хозяйств (счет 2700).</li></ul><p><a data-anchor="/document/16/218501/bssPhr147/"></a><a data-anchor="/document/16/218501/dfasggfieb/" data-dfa="dfasggfieb"></a>В <strong>строке 170 «Готовая продукция» </strong>(счет 2800) отразите фактическую производственную себестоимость остатка:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr148/"></a><a data-anchor="/document/16/218501/dfasspeqhr/" data-dfa="dfasspeqhr"></a>законченных производством изделий, прошедших испытания и&nbsp;приемку, укомплектованных всеми частями согласно условиям договора с&nbsp;заказчиками, соответствующих техническим условиям и&nbsp;стандартам;</li><li>готовой продукции, находящейся на&nbsp;выставке и&nbsp;переданной на&nbsp;комиссию (консигнацию) другим предприятиям.</li></ul><p><a data-anchor="/document/16/218501/bssPhr149/"></a><a data-anchor="/document/16/218501/dfasqugwe9/" data-dfa="dfasqugwe9"></a>Продукция, не&nbsp;отвечающая этим требованиям, либо не&nbsp;сданные работы, не&nbsp;оказанные услуги, считаются незаконченными. Отразите их&nbsp;в&nbsp;составе незавершенного производства.</p><p><a data-anchor="/document/16/218501/bssPhr150/"></a><a data-anchor="/document/16/218501/dfaswokfic/" data-dfa="dfaswokfic"></a>В <strong>строке 180 «Товары»</strong> (счет 2900 за&nbsp;вычетом счета 2980) отразите стоимость остатков товаров, за&nbsp;вычетом торговой наценки:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr151/"></a><a data-anchor="/document/16/218501/dfas5rtht5/" data-dfa="dfas5rtht5"></a>на&nbsp;складах;</li><li>в&nbsp;розничной торговле;</li><li>на&nbsp;выставке;</li><li>переданных на&nbsp;комиссию (консигнацию) другим предприятиям;</li><li>предметов проката;</li><li>тары под товаром и&nbsp;порожней;</li><li>в&nbsp;пути;</li><li>других.</li></ul><p><a data-anchor="/document/16/218501/bssPhr152/"></a><a data-anchor="/document/16/218501/dfasknirmv/" data-dfa="dfasknirmv"></a>В <strong>строке 190 «Расходы будущих периодов»</strong> отразите сумму расходов, отраженных на&nbsp;счетах 3100, произведенных в&nbsp;отчетном периоде, но&nbsp;относимых на&nbsp;затраты в&nbsp;следующих периодах в&nbsp;течение срока, к&nbsp;которому они относятся.</p><p><a data-anchor="/document/16/218501/bssPhr153/"></a><a data-anchor="/document/16/218501/dfasuk2miy/" data-dfa="dfasuk2miy"></a>В <strong>строке 200 «Отсроченные расходы»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr154/"></a><a data-anchor="/document/16/218501/dfas01xgcr/" data-dfa="dfas01xgcr"></a>текущую часть отсроченного налога на&nbsp;прибыль по&nbsp;временным разницам (счет 3210);</li><li>отсроченные расходы по&nbsp;дисконтам (скидкам) (счет 3220);</li><li>другие расходы (счет 3290).</li></ul><p><a data-anchor="/document/16/218501/bssPhr155/"></a><a data-anchor="/document/16/218501/dfasykxtsw/" data-dfa="dfasykxtsw"></a><a data-anchor="/document/16/218501/dfasmgf7y3/" data-dfa="dfasmgf7y3"></a>В <strong>строке 210 «Дебиторы, всего»</strong> рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr156/"></a><a data-anchor="/document/16/218501/dfasmbbwxy/" data-dfa="dfasmbbwxy"></a><strong>220</strong>&nbsp;— задолженность покупателей и&nbsp;заказчиков за&nbsp;реализованные продукцию, товары, выполненные работы и&nbsp;оказанные услуги за&nbsp;вычетом резерва по&nbsp;сомнительным долгам (счета 4000 за&nbsp;вычетом счетов 4900);</li><li><a data-anchor="/document/16/218501/dfasz0gdsg/" data-dfa="dfasz0gdsg"></a><strong>240</strong>&nbsp;— задолженность дочерних и&nbsp;зависимых предприятий (счет 4120);</li><li><a data-anchor="/document/16/218501/dfastmkbtb/" data-dfa="dfastmkbtb"></a><strong>250&nbsp;</strong>— авансы, выданные персоналу по&nbsp;оплате труда, на&nbsp;служебные командировки, на&nbsp;общехозяйственные расходы и&nbsp;другие авансы по&nbsp;предстоящим расчетам (счет 4200);</li><li><a data-anchor="/document/16/218501/dfas93aflo/" data-dfa="dfas93aflo"></a><strong>260</strong>&nbsp;— авансы, выданные поставщикам и&nbsp;подрядчикам по&nbsp;предстоящим расчетам со&nbsp;сроком меньше 1&nbsp;года (счет 4300);</li><li><a data-anchor="/document/16/218501/dfasy7z8lo/" data-dfa="dfasy7z8lo"></a><strong>270&nbsp;</strong>— авансовые платежи и&nbsp;переплата по&nbsp;налогам и&nbsp;другим обязательным платежам в&nbsp;бюджет (счет 4400);</li><li><a data-anchor="/document/16/218501/dfas09gffp/" data-dfa="dfas09gffp"></a><strong>280</strong>&nbsp;— авансовые платежи в&nbsp;государственные целевые фонды и&nbsp;по&nbsp;страхованию (счет 4500);</li><li><a data-anchor="/document/16/218501/dfas8nsdbv/" data-dfa="dfas8nsdbv"></a><strong>290</strong>&nbsp;— задолженность учредителей по&nbsp;вкладам в&nbsp;уставный капитал (счет 4600);</li><li><a data-anchor="/document/16/218501/dfasbr34fr/" data-dfa="dfasbr34fr"></a><strong>300</strong>&nbsp;— задолженность персонала по&nbsp;прочим операциям, в&nbsp;т.ч.&nbsp;по&nbsp;товарам, реализованным в&nbsp;кредит, предоставленным персоналу займам, по&nbsp;возмещению материального ущерба предприятию (счет 4700);</li><li><a data-anchor="/document/16/218501/dfas8ypl1g/" data-dfa="dfas8ypl1g"></a><strong>310&nbsp;</strong>— прочая дебиторская задолженность&nbsp;— проценты и&nbsp;дивиденды к&nbsp;получению; текущие платежи по&nbsp;финансовой аренде, платежи по&nbsp;оперативной аренде, счета к&nbsp;получению по&nbsp;роялти, штрафы, пени и&nbsp;неустойки к&nbsp;получению (счет 4800).</li></ul><p><a data-anchor="/document/16/218501/bssPhr157/"></a><a data-anchor="/document/16/218501/dfas30ow2g/" data-dfa="dfas30ow2g"></a>В&nbsp;строке <strong>211</strong> справочно покажите просроченную часть дебиторской задолженности. Расшифровку отразите в&nbsp;приложении к&nbsp;Балансу.</p><p><a data-anchor="/document/16/218501/bssPhr158/"></a><a data-anchor="/document/16/218501/dfasnlcnl3/" data-dfa="dfasnlcnl3"></a>В&nbsp;строке <strong>230</strong> справочно укажите задолженность обособленных подразделений на&nbsp;счете 4110.</p><p><a data-anchor="/document/16/218501/bssPhr159/"></a><a data-anchor="/document/16/218501/dfashr046g/" data-dfa="dfashr046g"></a>В <strong>строке 320 «Денежные средства, всего» </strong>рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr160/"></a><a data-anchor="/document/16/218501/dfasnq9v97/" data-dfa="dfasnq9v97"></a><strong>330</strong>&nbsp;— остаток денежных средств в&nbsp;национальной и&nbsp;иностранной валюте в&nbsp;кассах предприятия (счет 5000);</li><li><a data-anchor="/document/16/218501/dfascfn19g/" data-dfa="dfascfn19g"></a><strong>340&nbsp;</strong>— остаток денежных средств в&nbsp;национальной валюте на&nbsp;расчетных счетах в&nbsp;банках (счет 5110);</li><li><a data-anchor="/document/16/218501/dfas2grnad/" data-dfa="dfas2grnad"></a><strong>350&nbsp;</strong>— остаток валютных средств на&nbsp;валютных счетах в&nbsp;банках внутри страны и&nbsp;за&nbsp;рубежом, в&nbsp;пересчете на&nbsp;национальную валюту по&nbsp;курсу&nbsp;ЦБ на&nbsp;последнюю дату отчетного периода (счет 5200);</li><li><a data-anchor="/document/16/218501/dfaseghr0r/" data-dfa="dfaseghr0r"></a><strong>360</strong>&nbsp;— остаток денежных средств предприятия на&nbsp;специальных счетах в&nbsp;банке (счета 5500), денежных эквивалентов (счет 5600), денежных средств (переводов) в&nbsp;пути (счета 5700).</li></ul><p><a data-anchor="/document/16/218501/bssPhr161/"></a><a data-anchor="/document/16/218501/dfasgar8gc/" data-dfa="dfasgar8gc"></a>В <strong>строке 370 «Краткосрочные инвестиции» </strong>отразите инвестиции предприятия (сроком не&nbsp;более 12&nbsp;месяцев) в&nbsp;ценные бумаги других предприятий, облигации государственных и&nbsp;местных займов и&nbsp;т.п., а&nbsp;также выданные займы и&nbsp;прочие текущие инвестиции (счет 5800).</p><p><a data-anchor="/document/16/218501/bssPhr162/"></a><a data-anchor="/document/16/218501/dfasq9gwrm/" data-dfa="dfasq9gwrm"></a>В <strong>строке 380 «Прочие текущие активы» </strong>отразите сальдо по&nbsp;счету учета недостач, хищений и&nbsp;потерь от&nbsp;порчи ценностей, выявленных при инвентаризации, по&nbsp;которым не&nbsp;определены виновные лица, а&nbsp;также прочие активы, которые не&nbsp;предусмотрены в&nbsp;других статьях, но&nbsp;являются собственностью предприятия (счет 5900).</p><p><a data-anchor="/document/16/218501/bssPhr163/"></a><a data-anchor="/document/16/218501/dfas0k5na5/" data-dfa="dfas0k5na5"></a>В <strong>строке 390</strong> рассчитается показатель «Итого по&nbsp;разделу&nbsp;II актива баланса» как сумма строк 140, 190, 200, 210, 320, 370 и&nbsp;380.</p><p><a data-anchor="/document/16/218501/bssPhr164/"></a><a data-anchor="/document/16/218501/dfashy3hy3/" data-dfa="dfashy3hy3"></a><a data-anchor="/document/16/218501/dfasuiesdx/" data-dfa="dfasuiesdx"></a>В <strong>строке 400 «Всего по&nbsp;активу баланса»</strong> рассчитается сумма по&nbsp;строкам 130 (долгосрочные активы, всего) и&nbsp;390 (текущие активы, всего).</p><img alt="" hideborder="false" class="inimg" num="9" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div><a data-anchor="/document/16/218501/tit8/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit8"><a data-anchor="/document/16/218501/bssPhr165/"></a><a data-anchor="/document/16/218501/dfasgpguh6/" data-dfa="dfasgpguh6"></a><a data-anchor="/document/16/218501/dfastq2re1/" data-dfa="dfastq2re1"></a>Как заполнить Пассив баланса</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><a data-anchor="/document/16/218501/tit9/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit9"><a data-anchor="/document/16/218501/bssPhr167/"></a><a data-anchor="/document/16/218501/dfasniceqg/" data-dfa="dfasniceqg"></a>Раздел «Источники собственных средств»</h3><p><a data-anchor="/document/16/218501/bssPhr168/"></a><a data-anchor="/document/16/218501/dfaswg6i5x/" data-dfa="dfaswg6i5x"></a>В <strong>строке 410 «Уставный капитал»</strong> отразите величину уставного капитала, зарегистрированную в&nbsp;учредительных документах как совокупность вкладов (долей, акций по&nbsp;номинальной стоимости, паевых взносов) учредителей предприятия (счета 8300).</p><p><a data-anchor="/document/16/218501/bssPhr171/"></a><a data-anchor="/document/16/218501/dfasgld4mb/" data-dfa="dfasgld4mb"></a>В <strong>строке 420 «Добавленный капитал»</strong> отразите сумму (счета 8400):</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr172/"></a><a data-anchor="/document/16/218501/dfast067fs/" data-dfa="dfast067fs"></a>эмиссионного дохода, полученного при первичной продаже акций по&nbsp;ценам выше номинальной стоимости;</li><li>курсовой разницы, возникающей при формировании уставного капитала.</li></ul><p><a data-anchor="/document/16/218501/bssPhr173/"></a><a data-anchor="/document/16/218501/dfascigxd4/" data-dfa="dfascigxd4"></a>В <strong>строке 430 «Резервный капитал»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr174/"></a><a data-anchor="/document/16/218501/dfas7vuip3/" data-dfa="dfas7vuip3"></a>сумму корректировок по&nbsp;переоценке долгосрочных активов (счет 8510);</li><li>сумму резервного фонда, создаваемого за&nbsp;счет отчислений от&nbsp;чистой прибыли в&nbsp;размерах, предусмотренных законодательством и&nbsp;учредительными документами (счет 8520);</li><li>стоимость безвозмездно полученного имущества (счет 8530).</li></ul><p><a data-anchor="/document/16/218501/bssPhr175/"></a><a data-anchor="/document/16/218501/dfasgo0ukz/" data-dfa="dfasgo0ukz"></a>В <strong>строке 440 «Выкупленные собственные акции»</strong> отразите стоимость собственных выкупленных акций, долей и&nbsp;паев, находящихся у&nbsp;предприятия, для их&nbsp;последующего распространения или аннулирования (счета 8600).</p><p><a data-anchor="/document/16/218501/bssPhr176/"></a><a data-anchor="/document/16/218501/dfas2s6c3h/" data-dfa="dfas2s6c3h"></a>В <strong>строке 450 «Нераспределенная прибыль (непокрытый убыток)»</strong> отразите чистую прибыль (убыток) отчетного года (счет 8710) и&nbsp;накопленную прибыль (убыток) прошлых лет (счет 8720). Если предприятие имеет убыток, показывайте его со&nbsp;знаком «минус».</p><p><a data-anchor="/document/16/218501/bssPhr177/"></a><a data-anchor="/document/16/218501/dfasvmdi6t/" data-dfa="dfasvmdi6t"></a>В<strong> строке 460 «Целевые поступления»</strong> отразите полученные гранты, субсидии, членские взносы, суммы налоговых льгот с&nbsp;целевым использованием и&nbsp;другие поступления для проведения мероприятий целевого назначения (счета 8800).</p><p><a data-anchor="/document/16/218501/bssPhr178/"></a><a data-anchor="/document/16/218501/dfas5i9iy5/" data-dfa="dfas5i9iy5"></a>В <strong>строке 470 «Резервы предстоящих расходов и&nbsp;платежей»</strong> отразите средства, зарезервированные предприятием для предстоящих расходов и&nbsp;платежей в&nbsp;целях равномерного распределения затрат (счет 8910).</p><p><a data-anchor="/document/16/218501/bssPhr179/"></a><a data-anchor="/document/16/218501/dfassvnxfz/" data-dfa="dfassvnxfz"></a><strong>Строка 480 «Итого по&nbsp;разделу&nbsp;I пассива баланса»</strong> рассчитается по&nbsp;формуле: стр.&nbsp;410 + стр.&nbsp;420 + стр.&nbsp;430&nbsp;— стр.&nbsp;440 + стр.&nbsp;450 + стр.&nbsp;460 + стр.&nbsp;470.</p><img alt="" hideborder="false" class="inimg" num="10" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><a data-anchor="/document/16/218501/tit10/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit10"><a data-anchor="/document/16/218501/bssPhr180/"></a><a data-anchor="/document/16/218501/dfaspt4f12/" data-dfa="dfaspt4f12"></a>Раздел «Обязательства»</h3><p><a data-anchor="/document/16/218501/bssPhr181/"></a><a data-anchor="/document/16/218501/dfasme5tsb/" data-dfa="dfasme5tsb"></a><strong>В&nbsp;строке 490 «Долгосрочные обязательства, всего»</strong> рассчитывается сумма обязательств со&nbsp;сроком погашения более 1&nbsp;года по&nbsp;строкам 500, 520, 530, 540, 550, 560, 570, 580 и&nbsp;590.</p><p><a data-anchor="/document/16/218501/bssPhr182/"></a><a data-anchor="/document/16/218501/dfas5mfgio/" data-dfa="dfas5mfgio"></a>В<strong> строке 491</strong> рассчитается сумма долгосрочной кредиторской задолженности, отраженной в&nbsp;строках 500, 520, 540, 560 и&nbsp;590.</p><p><a data-anchor="/document/16/218501/bssPhr183/"></a><a data-anchor="/document/16/218501/dfasqo8kfc/" data-dfa="dfasqo8kfc"></a>В<strong> строке 500 «Долгосрочная задолженность поставщикам и&nbsp;подрядчикам»</strong> отразите сумму долгосрочных обязательств поставщикам и&nbsp;подрядчикам за&nbsp;приобретенное имущество, выполненные работы и&nbsp;оказанные услуги (счета 7000).</p><p><a data-anchor="/document/16/218501/bssPhr184/"></a><a data-anchor="/document/16/218501/dfasazv0xg/" data-dfa="dfasazv0xg"></a>В <strong>строке 510 «Долгосрочная задолженность обособленным подразделениям»</strong> отразите долгосрочные обязательства филиалам и&nbsp;представительствам (счет 7110).</p><p><a data-anchor="/document/16/218501/bssPhr185/"></a><a data-anchor="/document/16/218501/dfasdugsfz/" data-dfa="dfasdugsfz"></a>В <strong>строке 520 «Долгосрочная задолженность дочерним и&nbsp;зависимым хозяйственным обществам» </strong>отразите суммы, учитываемые на&nbsp;счете 7120.</p><p><a data-anchor="/document/16/218501/bssPhr186/"></a><a data-anchor="/document/16/218501/dfasxti3rr/" data-dfa="dfasxti3rr"></a>В<strong> строке 530 «Долгосрочные отсроченные доходы»</strong> отразите:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr187/"></a><a data-anchor="/document/16/218501/dfasug0cvf/" data-dfa="dfasug0cvf"></a>долгосрочные отсроченные доходы в&nbsp;виде дисконта (скидки) (счет 7210);</li><li><a data-anchor="/document/16/218501/dfaspfvkkx/" data-dfa="dfaspfvkkx"></a>долгосрочные отсроченные доходы в&nbsp;виде премии (надбавки) (счет 7220);</li><li><a data-anchor="/document/16/218501/dfasgwrnr9/" data-dfa="dfasgwrnr9"></a>прочие доходы (счет 7230).</li></ul><p><a data-anchor="/document/16/218501/bssPhr188/"></a><a data-anchor="/document/16/218501/dfaseuhcz1/" data-dfa="dfaseuhcz1"></a>В <strong>строке 540 «Долгосрочные отсроченные обязательства по&nbsp;налогам и&nbsp;другим обязательным платежам»</strong> отразите сальдо счета 7240.</p><p><a data-anchor="/document/16/218501/bssPhr189/"></a><a data-anchor="/document/16/218501/dfasbgoln6/" data-dfa="dfasbgoln6"></a>В <strong>строке 550 «Прочие долгосрочные отсроченные обязательства» </strong>отразите обязательства по&nbsp;налогу на&nbsp;прибыль по&nbsp;временным разницам (счет 7250) и&nbsp;прочие обязательства (счет 7290).</p><p><a data-anchor="/document/16/218501/bssPhr190/"></a><a data-anchor="/document/16/218501/dfas10n0dv/" data-dfa="dfas10n0dv"></a>В <strong>строке 560 «Авансы, полученные от&nbsp;покупателей и&nbsp;заказчиков» </strong>отразите долгосрочную задолженность в&nbsp;виде полученных авансов по&nbsp;предстоящим расчетам (счет 7310).</p><p><a data-anchor="/document/16/218501/bssPhr191/"></a><a data-anchor="/document/16/218501/dfasq3zek1/" data-dfa="dfasq3zek1"></a>В <strong>строке 570 «Долгосрочные банковские кредиты» </strong>отразите задолженность перед банками по&nbsp;полученным долгосрочным кредитам (счет 7810).</p><p><a data-anchor="/document/16/218501/bssPhr192/"></a><a data-anchor="/document/16/218501/dfasqr3al0/" data-dfa="dfasqr3al0"></a>В<strong> строке 580 «Долгосрочные займы» </strong>отразите задолженность по&nbsp;долгосрочным займам, полученным от&nbsp;других организаций (счета 7820, 7830 и&nbsp;7840).</p><p><a data-anchor="/document/16/218501/bssPhr193/"></a><a data-anchor="/document/16/218501/dfascmerm1/" data-dfa="dfascmerm1"></a>В <strong>строке 590 «Прочие долгосрочные кредиторские задолженности»</strong> отразите суммы (счета 7900):</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr194/"></a><a data-anchor="/document/16/218501/dfas32x3xn/" data-dfa="dfas32x3xn"></a>долгосрочных обязательств предприятия перед арендодателем (лизингодателем), персоналом, физлицами и&nbsp;организациями по&nbsp;разного рода некоммерческим операциям;</li><li><a data-anchor="/document/16/218501/dfasla2iym/" data-dfa="dfasla2iym"></a>удержанные из&nbsp;зарплаты работников в&nbsp;пользу разных организаций и&nbsp;физлиц на&nbsp;основании исполнительных документов или постановлений судебных органов и&nbsp;др.</li></ul><p><a data-anchor="/document/16/218501/bssPhr195/"></a><a data-anchor="/document/16/218501/dfas8shrr8/" data-dfa="dfas8shrr8"></a>В <strong>строке 600 «Текущие обязательства, всего» </strong>рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr196/"></a><a data-anchor="/document/16/218501/dfasarcyw0/" data-dfa="dfasarcyw0"></a><strong>610 «Задолженность поставщикам и&nbsp;подрядчикам»&nbsp;</strong>— сумму текущих обязательств поставщикам и&nbsp;подрядчикам за&nbsp;приобретенное имущество, выполненные работы и&nbsp;оказанные услуги (счета 6000);</li><li><a data-anchor="/document/16/218501/dfasgoh2xy/" data-dfa="dfasgoh2xy"></a><strong>630 «Задолженность дочерним и&nbsp;зависимым хозяйственным обществам»&nbsp;</strong>— сумму текущих обязательств таким предприятиям (счет 6120);</li><li><a data-anchor="/document/16/218501/dfask2wvam/" data-dfa="dfask2wvam"></a><strong>640 «Отсроченные доходы»</strong>&nbsp;— сальдо счетов 6210 «Отсроченные доходы в&nbsp;виде дисконта (скидки)», 6220 «Отсроченные доходы в&nbsp;виде премии (надбавки)» и&nbsp;6230 «Прочие отсроченные доходы»;</li><li><a data-anchor="/document/16/218501/dfasxgkvd7/" data-dfa="dfasxgkvd7"></a><strong>650 «Отсроченные обязательства по&nbsp;налогам и&nbsp;другим обязательным платежам»&nbsp;</strong>— текущую часть долгосрочных обязательств (счет 6240);</li><li><a data-anchor="/document/16/218501/dfasds3zv7/" data-dfa="dfasds3zv7"></a><strong>660 «Прочие отсроченные обязательства»</strong>&nbsp;— сумму отсроченных обязательств по&nbsp;налогу на&nbsp;прибыль по&nbsp;временным разницам (счет 6250) и&nbsp;прочих обязательств (счет 6290);</li><li><a data-anchor="/document/16/218501/dfasrcgr21/" data-dfa="dfasrcgr21"></a><strong>670 «Полученные авансы»</strong>&nbsp;— задолженность перед контрагентами в&nbsp;виде авансов по&nbsp;предстоящим расчетам (счета 6300);</li><li><a data-anchor="/document/16/218501/dfasedp0st/" data-dfa="dfasedp0st"></a><strong>680 «Задолженность по&nbsp;платежам в&nbsp;бюджет»</strong>&nbsp;— сальдо счета 6410 «Задолженность по&nbsp;платежам в&nbsp;бюджет (по&nbsp;видам)»;</li><li><a data-anchor="/document/16/218501/dfas2bqgse/" data-dfa="dfas2bqgse"></a><strong>690 «Задолженность по&nbsp;страхованию»</strong>&nbsp;— сальдо счета 6510;</li><li><a data-anchor="/document/16/218501/dfasfb9ocx/" data-dfa="dfasfb9ocx"></a><strong>700 «Задолженность по&nbsp;платежам в&nbsp;государственные целевые фонды»</strong>&nbsp;— сальдо счета 6520;</li><li><a data-anchor="/document/16/218501/dfasze7rph/" data-dfa="dfasze7rph"></a><strong>710 «Задолженность учредителям»</strong>&nbsp;— обязательства перед учредителями по&nbsp;дивидендам, выбывающими учредителями по&nbsp;их&nbsp;доле, а&nbsp;также вклады учредителей по&nbsp;увеличению уставного капитала до&nbsp;его регистрации (счета 6600);</li><li><a data-anchor="/document/16/218501/dfaseb3fxn/" data-dfa="dfaseb3fxn"></a><strong>720 «Задолженность по&nbsp;оплате труда»&nbsp;</strong>— начисленные, но&nbsp;еще не&nbsp;выплаченные суммы по&nbsp;оплате труда, премии, пособия и&nbsp;другие начисления по&nbsp;расчетам с&nbsp;персоналом, а&nbsp;также депонированная зарплата (счета 6700);</li><li><a data-anchor="/document/16/218501/dfaskwau5f/" data-dfa="dfaskwau5f"></a><strong>730 «Краткосрочные банковские кредиты»&nbsp;</strong>— задолженность перед банками по&nbsp;полученным краткосрочным кредитам (счет 6810);</li><li><a data-anchor="/document/16/218501/dfastqlsqn/" data-dfa="dfastqlsqn"></a><strong>740 «Краткосрочные займы»</strong>&nbsp;— задолженность по&nbsp;займам, полученным от&nbsp;других лиц (счета 6820, 6830 и&nbsp;6840);</li><li><a data-anchor="/document/16/218501/dfasp2sgqt/" data-dfa="dfasp2sgqt"></a><strong>750 «Текущая часть долгосрочных обязательств»</strong>&nbsp;— сальдо счета 6950;</li><li><a data-anchor="/document/16/218501/dfasecgh8x/" data-dfa="dfasecgh8x"></a><strong>760 «Прочие кредиторские задолженности»</strong>&nbsp;— задолженность по&nbsp;операциям с&nbsp;разными кредиторами предприятия, в&nbsp;т.ч.&nbsp;по&nbsp;оперативной аренде (счет 6910), начисленным процентам (счет 6920), роялти (счет 6930), гарантиям (счет 6940), претензиям (счет 6960), подотчетным лицам (счет 6970) и&nbsp;прочим обязательствам (счет 6990).</li></ul><p><a data-anchor="/document/16/218501/bssPhr197/"></a><a data-anchor="/document/16/218501/dfaswyc7c0/" data-dfa="dfaswyc7c0"></a>В&nbsp;строке <strong>602</strong> справочно отразите просроченную кредиторскую задолженность. Расшифровку покажите в&nbsp;приложении к&nbsp;Бухгалтерскому балансу.</p><p><a data-anchor="/document/16/218501/bssPhr198/"></a><a data-anchor="/document/16/218501/dfasuwdbfh/" data-dfa="dfasuwdbfh"></a>В&nbsp;строке <strong>620</strong> справочно отразите задолженность обособленным подразделениям (счет 6110).</p><p><a data-anchor="/document/16/218501/bssPhr199/"></a><a data-anchor="/document/16/218501/dfasqh66ec/" data-dfa="dfasqh66ec"></a><strong>В&nbsp;строке 601 </strong>рассчитается текущая кредиторская задолженность предприятия как сумма по&nbsp;строкам 610, 630, 650, 670, 680, 690, 700, 710, 720 и&nbsp;760.</p><p><a data-anchor="/document/16/218501/bssPhr200/"></a><a data-anchor="/document/16/218501/dfas8cuhcm/" data-dfa="dfas8cuhcm"></a><strong>В&nbsp;строке 770 «Итого по&nbsp;разделу&nbsp;II пассива баланса» </strong>рассчитается сумма по&nbsp;строкам 490 (долгосрочные обязательства, всего) и&nbsp;600 (текущие обязательства, всего).</p><p><a data-anchor="/document/16/218501/bssPhr201/"></a><a data-anchor="/document/16/218501/dfasw4samz/" data-dfa="dfasw4samz"></a><strong>В&nbsp;строке 780 «Всего по&nbsp;пассиву баланса»</strong> рассчитается сумма по&nbsp;строкам 480 (источники собственных средств) и&nbsp;770 (долгосрочные и&nbsp;текущие обязательства).</p><p><a data-anchor="/document/16/218501/bssPhr202/"></a><a data-anchor="/document/16/218501/dfasgvs8i5/" data-dfa="dfasgvs8i5"></a>Сумма в <strong>строке 400 «Всего по&nbsp;активу баланса»</strong> должна быть равна сумме в&nbsp;строке 780 «Всего по&nbsp;пассиву баланса».</p><img alt="" hideborder="false" class="inimg" num="11" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div><a data-anchor="/document/16/218501/tit11/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit11"><a data-anchor="/document/16/218501/bssPhr203/"></a><a data-anchor="/document/16/218501/dfas9pq0w8/" data-dfa="dfas9pq0w8"></a><a data-anchor="/document/16/218501/dfasxm4lrl/" data-dfa="dfasxm4lrl"></a>Как заполнить расшифровку просроченной кредиторской и&nbsp;дебиторской задолженностей</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr208/"></a><a data-anchor="/document/16/218501/dfasltrf2m/" data-dfa="dfasltrf2m"></a>Расшифровку заполняйте только, если на&nbsp;дату составления бухгалтерского баланса у&nbsp;предприятия есть просроченная дебиторская и&nbsp;кредиторская задолженность.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr209/"></a><a data-anchor="/document/16/218501/dfasn5kcsz/" data-dfa="dfasn5kcsz"></a>В <strong>графе 2&nbsp;«Перечень дебиторов и&nbsp;кредиторов, по&nbsp;которым имеется просроченная задолженность» </strong>расшифруйте строки 2, 2.2, 3, 5, 5.2 и&nbsp;6, указав полное наименование дебиторов (кредиторов).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr210/"></a><a data-anchor="/document/16/218501/dfas17pg5z/" data-dfa="dfas17pg5z"></a>По&nbsp;просроченной задолженности за&nbsp;пределами РУз, кроме наименования дебитора (кредитора), отразите также в&nbsp;скобках название страны.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr211/"></a><a data-anchor="/document/16/218501/dfas4f7gt0/" data-dfa="dfas4f7gt0"></a>В <strong>графе 3&nbsp;«Общая просроченная задолженность» </strong>расшифруйте общую сумму просроченной дебиторской задолженности, указанной в&nbsp;строке 1. Отразите по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr212/"></a><a data-anchor="/document/16/218501/dfaspea6zg/" data-dfa="dfaspea6zg"></a><strong>2&nbsp;</strong>— общую сумму просроченной дебиторской задолженности внутри республики;</li><li><strong>2.1</strong>&nbsp;— просроченную задолженность внутри республики по&nbsp;наименованиям дебиторов;</li><li><strong>2.2</strong>&nbsp;— общую сумму внутриведомственной просроченной дебиторской задолженности;</li><li><strong>2.2.1</strong>&nbsp;— внутриведомственную просроченную задолженность по&nbsp;наименованиям дебиторов;</li><li><strong>3</strong>&nbsp;— общую сумму просроченную дебиторскую задолженности за&nbsp;пределами республики;</li><li><strong>3.1</strong>&nbsp;— просроченную задолженность за&nbsp;пределами республики по&nbsp;наименованиям дебиторов.</li></ul><img alt="" hideborder="false" class="inimg" num="12" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><img alt="" hideborder="false" class="inimg" num="13" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr213/"></a><a data-anchor="/document/16/218501/dfasft1xx2/" data-dfa="dfasft1xx2"></a><strong>Строки&nbsp;5, 5.1, 5.2, 5.2.1, 6&nbsp;и&nbsp;6.1</strong> по&nbsp;просроченной кредиторской задолженности заполните аналогично соответствующим строкам по&nbsp;просроченной дебиторской задолженности.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr214/"></a><a data-anchor="/document/16/218501/dfas1fc03r/" data-dfa="dfas1fc03r"></a><strong>В&nbsp;графе 3&nbsp;«Общая просроченная задолженность»</strong> автоматически рассчитаются показатели по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr215/"></a><a data-anchor="/document/16/218501/dfas2txz3g/" data-dfa="dfas2txz3g"></a><strong>1&nbsp;</strong>— общая сумма просроченной дебиторской задолженности (сумма по&nbsp;строкам 2&nbsp;и&nbsp;3&nbsp;графы 3);</li><li><strong>4</strong>&nbsp;— общая сумма просроченной кредиторской задолженности (сумма по&nbsp;строкам 5&nbsp;и&nbsp;6&nbsp;графы 3).</li></ul><img alt="" hideborder="false" class="inimg" num="14" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/218501/bssPhr216/"></a><a data-anchor="/document/16/218501/dfascgqtgn/" data-dfa="dfascgqtgn"></a>Учет просроченной задолженности</p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/218501/bssPhr217/"></a><a data-anchor="/document/16/218501/dfasvczcuz/" data-dfa="dfasvczcuz"></a>Общая сумма просроченной дебиторской задолженности должна соответствовать показателю строки 211 бухгалтерского баланса.</p><p><a data-anchor="/document/16/218501/bssPhr218/"></a><a data-anchor="/document/16/218501/dfas44fts9/" data-dfa="dfas44fts9"></a>Общая сумма просроченной кредиторской задолженности должна соответствовать показателю строки 602 бухгалтерского баланса.</p></div><div class="incut-v4__icon"></div></div><p><a data-anchor="/document/16/218501/bssPhr219/"></a><a data-anchor="/document/16/218501/dfasfs84av/" data-dfa="dfasfs84av"></a>Просроченную задолженность, которая образовалась по&nbsp;причинам, не&nbsp;зависящим от&nbsp;организации, отразите:</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr220/"></a><a data-anchor="/document/16/218501/dfas3ddbwo/" data-dfa="dfas3ddbwo"></a><strong>в&nbsp;графе 4&nbsp;</strong>— общую просроченную задолженность по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr221/"></a><a data-anchor="/document/16/218501/dfas3qtobm/" data-dfa="dfas3qtobm"></a><strong>1&nbsp;</strong>— общая сумма просроченной дебиторской задолженности, которая должна быть равна сумме, указанной в&nbsp;графах 5, 6, 7&nbsp;и&nbsp;8;</li><li><strong>4</strong>&nbsp;— общая сумма просроченной кредиторской задолженности, которая должна быть равна сумме, указанной в&nbsp;графах 5, 6, 7&nbsp;и&nbsp;8;</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr222/"></a><a data-anchor="/document/16/218501/dfasrv7q8z/" data-dfa="dfasrv7q8z"></a><strong>в&nbsp;графе 5</strong>&nbsp;— просроченную задолженность по&nbsp;продукции, товарам, работам, услугам, отгруженной, полученной без предоплаты по&nbsp;решениям Кабмина;</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr223/"></a><a data-anchor="/document/16/218501/dfaspak7z7/" data-dfa="dfaspak7z7"></a><strong>в&nbsp;графе 6</strong>&nbsp;— просроченную сумму перечисленных авансов, по&nbsp;которым предусмотрена отгрузка сырья и&nbsp;материалов из&nbsp;государственных ресурсов и&nbsp;фондов;</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr224/"></a><a data-anchor="/document/16/218501/dfasxg9qqu/" data-dfa="dfasxg9qqu"></a><strong>в&nbsp;графе 7</strong>&nbsp;— просроченную задолженность, по&nbsp;которой предоставлена отсрочка погашения по&nbsp;решениям Кабмина;</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr225/"></a><a data-anchor="/document/16/218501/dfasingcf6/" data-dfa="dfasingcf6"></a><strong>в&nbsp;графе 8</strong>&nbsp;— просроченную задолженность, по&nbsp;которой идет судебное разбирательство по&nbsp;предъявленным искам, а&nbsp;также по&nbsp;которой вынесено решение суда о&nbsp;ее&nbsp;взыскании с&nbsp;кредитора.</p><img alt="" hideborder="false" class="inimg" num="15" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div><a data-anchor="/document/16/218501/tit12/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit12"><a data-anchor="/document/16/218501/bssPhr226/"></a><a data-anchor="/document/16/218501/dfasggnaz0/" data-dfa="dfasggnaz0"></a>Как заполнить отчет о&nbsp;финансовых результатах</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr230/"></a><a data-anchor="/document/16/218501/dfasfb52zx/" data-dfa="dfasfb52zx"></a>Отчет о&nbsp;финансовых результатах отражает данные о&nbsp;доходах, расходах и&nbsp;чистой прибыли (убытке) организации (<span data-warm-notices="41176863" data-warm-notice-type="error" num="118" target="_self" lnktype="intlnk" title="" class="doc">гл.&nbsp;7&nbsp;</span>НСБУ №&nbsp;1).</p><img alt="" hideborder="true" class="inimg" num="16" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr231/"></a><a data-anchor="/document/16/218501/dfasf50ag6/" data-dfa="dfasf50ag6"></a>Стандартная форма отчета представлена в&nbsp;приложении №&nbsp;2&nbsp;к Положению о&nbsp;сроках представления финансовой отчетности, а&nbsp;также ее&nbsp;структуре и&nbsp;содержании.</p><p><a data-anchor="/document/16/218501/bssPhr232/"></a><a data-anchor="/document/16/218501/dfaslgxe4h/" data-dfa="dfaslgxe4h"></a>Все показатели в&nbsp;отчете необходимо указывать в&nbsp;тысячах сумов.</p><p><a data-anchor="/document/16/218501/bssPhr233/"></a><a data-anchor="/document/16/218501/dfasz4melm/" data-dfa="dfasz4melm"></a>В <strong>графах 3&nbsp;и&nbsp;4</strong>&nbsp;отчета отразите данные за&nbsp;предыдущий год, а&nbsp;в&nbsp;графах 5&nbsp;и&nbsp;6&nbsp;— показатели за&nbsp;отчетный год.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr234/"></a><a data-anchor="/document/16/218501/dfas4fkzk3/" data-dfa="dfas4fkzk3"></a>В <strong>строке 010 «Чистая выручка от&nbsp;реализации продукции (товаров, работ и&nbsp;услуг)»</strong> отразите выручку за&nbsp;вычетом НДС и&nbsp;акцизного налога с&nbsp;учетом стоимости возвращенных товаров и&nbsp;готовой продукции, а&nbsp;также предоставленных скидок. Эту строку заполняйте по&nbsp;данным счетов учета доходов от&nbsp;основной, операционной деятельности 9000.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr235/"></a><a data-anchor="/document/16/218501/dfassqnifn/" data-dfa="dfassqnifn"></a>В <strong>строке 010</strong> отразите доход, признанный в&nbsp;отчетном периоде по&nbsp;методу начисления,&nbsp;— без учета сумм, предоплаченных за&nbsp;будущие периоды.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr236/"></a><a data-anchor="/document/16/218501/dfasqhy69w/" data-dfa="dfasqhy69w"></a>Организации, основной деятельностью которых является предоставление имущества в&nbsp;аренду, лизинг, отражают доход от&nbsp;аренды в&nbsp;строке 010.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr237/"></a><a data-anchor="/document/16/218501/dfaso3dvm3/" data-dfa="dfaso3dvm3"></a>Посреднические предприятия в&nbsp;строке 010 отражают сумму комиссионных вознаграждений за&nbsp;вычетом НДС.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr238/"></a><a data-anchor="/document/16/218501/dfaswzvma8/" data-dfa="dfaswzvma8"></a>В <strong>строке 020 «Себестоимость реализованной продукции (товаров, работ и&nbsp;услуг)»</strong> отразите себестоимость, учтенную на&nbsp;счетах 9100.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr239/"></a><a data-anchor="/document/16/218501/dfas78f04a/" data-dfa="dfas78f04a"></a>Торговые предприятия в&nbsp;этой строке указывают покупную стоимость реализованных товаров.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr240/"></a><a data-anchor="/document/16/218501/dfasnpkkq9/" data-dfa="dfasnpkkq9"></a>В <strong>строке 030 «Валовая прибыль (убыток) от&nbsp;реализации продукции (товаров, работ и&nbsp;услуг)» </strong>рассчитается разница показателей по&nbsp;строкам 010 и&nbsp;020.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr241/"></a><a data-anchor="/document/16/218501/dfasg7ngu6/" data-dfa="dfasg7ngu6"></a>В<strong> строке 040 «Расходы периода, всего» </strong>рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li style="text-align:start"><a data-anchor="/document/16/218501/bssPhr242/"></a><a data-anchor="/document/16/218501/dfasod7whv/" data-dfa="dfasod7whv"></a><strong>050 «Расходы по&nbsp;реализации»</strong>&nbsp;— расходы, связанные с&nbsp;доставкой продукции до&nbsp;потребителя, погрузкой в&nbsp;транспортные средства, затраты отделов и&nbsp;работников, занятых маркетингом, и&nbsp;другие (счет 9410).</li><li><a data-anchor="/document/16/218501/dfasfelei0/" data-dfa="dfasfelei0"></a><strong>060 «Административные расходы»</strong>&nbsp;— расходы по&nbsp;управлению предприятием, на&nbsp;оплату труда управленческого персонала, на&nbsp;ремонт основных средств общеадминистративного назначения, арендную плату помещений общехозяйственного назначения и&nbsp;другие (счет 9420).</li><li><a data-anchor="/document/16/218501/dfashzdnwf/" data-dfa="dfashzdnwf"></a><strong>070 «Прочие операционные расходы»&nbsp;</strong>— расходы, возникающие в&nbsp;операционной деятельности, не&nbsp;связанной с&nbsp;производственным процессом, финансовой деятельностью, и&nbsp;не&nbsp;обладающие качествами чрезвычайных расходов (счет 9430).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr243/"></a><a data-anchor="/document/16/218501/dfashuvola/" data-dfa="dfashuvola"></a>В <strong>строке 080</strong> укажите расходы отчетного периода, вычитаемые из&nbsp;налогооблагаемой прибыли в&nbsp;будущем.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr244/"></a><a data-anchor="/document/16/218501/dfasuylbg0/" data-dfa="dfasuylbg0"></a>В <strong>строке 090 «Прочие доходы от&nbsp;основной деятельности» </strong>отразите (счета 9300):</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr245/"></a><a data-anchor="/document/16/218501/dfasftgku7/" data-dfa="dfasftgku7"></a>прибыль от&nbsp;выбытия основных средств и&nbsp;прочих активов;</li><li>взысканные пени, штрафы и&nbsp;неустойки;</li><li>доходы прошлых лет;</li><li>доходы от&nbsp;оперативной аренды;</li><li>доходы от&nbsp;списания кредиторской и&nbsp;депонентской задолженностей;</li><li>доходы обслуживающих хозяйств;</li><li>суммы безвозмездной финансовой помощи;</li><li>другие операционные доходы.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr246/"></a><a data-anchor="/document/16/218501/dfasmtxn1k/" data-dfa="dfasmtxn1k"></a>В <strong>строке 100 «Прибыль (убыток) от&nbsp;основной деятельности» </strong>рассчитается финансовый результат от&nbsp;основной деятельности предприятия, определяемый по&nbsp;формуле: строка 030&nbsp;— строка 040 + строка 090.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr247/"></a><a data-anchor="/document/16/218501/dfasb9ri3l/" data-dfa="dfasb9ri3l"></a>В <strong>строке 110 «Доходы от&nbsp;финансовой деятельности, всего»</strong> рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr248/"></a><a data-anchor="/document/16/218501/dfas16cpyp/" data-dfa="dfas16cpyp"></a><strong>120 «Доходы в&nbsp;виде дивидендов»</strong>&nbsp;— доходы, полученные в&nbsp;Узбекистане и&nbsp;за&nbsp;его пределами от&nbsp;долевого участия в&nbsp;деятельности других предприятий; дивиденды по&nbsp;акциям и&nbsp;другим ценным бумагам, принадлежащим предприятию (счет 9520);</li><li><a data-anchor="/document/16/218501/dfasde73wb/" data-dfa="dfasde73wb"></a><strong>130 «Доходы в&nbsp;виде процентов»&nbsp;</strong>— доходы по&nbsp;долгосрочным и&nbsp;текущим инвестициям (счет 9530);</li><li><a data-anchor="/document/16/218501/dfas3usvn2/" data-dfa="dfas3usvn2"></a><strong>140 «Доходы от&nbsp;финансовой аренды»</strong>&nbsp;— заполняют предприятия, основной деятельностью которых не&nbsp;является предоставление имущества в&nbsp;финансовую аренду (счет 9550);</li><li><a data-anchor="/document/16/218501/dfasvs9d9f/" data-dfa="dfasvs9d9f"></a><strong>150 «Доходы от&nbsp;валютных курсовых разниц»&nbsp;</strong>— доходы от&nbsp;положительных курсовых разниц по&nbsp;валютным операциям, в&nbsp;том числе от&nbsp;переоценки валютных статей баланса (счет 9540);</li><li><a data-anchor="/document/16/218501/dfasexnx23/" data-dfa="dfasexnx23"></a><strong>160 «Прочие доходы от&nbsp;финансовой деятельности»</strong>&nbsp;— доходы от&nbsp;роялти, переоценки ценных бумаг и&nbsp;другие (счета 9510, 9560 и&nbsp;9590).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr249/"></a><a data-anchor="/document/16/218501/dfasgg6ngi/" data-dfa="dfasgg6ngi"></a>В <strong>строке 170 «Расходы по&nbsp;финансовой деятельности, всего» </strong>рассчитается сумма показателей по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr250/"></a><a data-anchor="/document/16/218501/dfas1km7ny/" data-dfa="dfas1km7ny"></a><strong>180 «Расходы в&nbsp;виде процентов»</strong>&nbsp;— расходы на&nbsp;оплату процентов по&nbsp;кредитам банков и&nbsp;займам (счет 9610);</li><li><a data-anchor="/document/16/218501/dfaspspba7/" data-dfa="dfaspspba7"></a><strong>190 «Расходы в&nbsp;виде процентов по&nbsp;финансовой аренде»&nbsp;</strong>— расходы на&nbsp;оплату процентов по&nbsp;финаренде (лизингу) (счет 9610);</li><li><a data-anchor="/document/16/218501/dfasea7ik4/" data-dfa="dfasea7ik4"></a><strong>200 «Убытки от&nbsp;валютных курсовых разниц»&nbsp;</strong>— отрицательные курсовые разницы по&nbsp;валютным операциям и&nbsp;от&nbsp;переоценки валютных статей баланса (счет 9620);</li><li><a data-anchor="/document/16/218501/dfasudghix/" data-dfa="dfasudghix"></a><strong>210 «Прочие расходы по&nbsp;финансовой деятельности»</strong>&nbsp;— расходы, связанные с&nbsp;выпуском и&nbsp;распространением ценных бумаг и&nbsp;другие (счета 9630 и&nbsp;9690).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr251/"></a><a data-anchor="/document/16/218501/dfasfregad/" data-dfa="dfasfregad"></a>В <strong>строке 220 «Прибыль (убыток) от&nbsp;общехозяйственной деятельности» </strong>рассчитается финансовый результат от&nbsp;общехозяйственной деятельности предприятия, который определяется по&nbsp;формуле: строка 100 + строка 110&nbsp;— строка 170.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr252/"></a><a data-anchor="/document/16/218501/dfasopfolt/" data-dfa="dfasopfolt"></a>В <strong>строке 230 «Чрезвычайные прибыли и&nbsp;убытки» </strong>отразите результаты чрезвычайных событий. К&nbsp;ним относятся события или сделки, которые определенно отличаются от&nbsp;обычной деятельности предприятия, то&nbsp;есть не&nbsp;происходят часто или регулярно.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr253/"></a><a data-anchor="/document/16/218501/dfas62e8r9/" data-dfa="dfas62e8r9"></a>В <strong>графах 3&nbsp;и&nbsp;5&nbsp;</strong>отразите данные по&nbsp;счету 9710, а&nbsp;в&nbsp;графах 4&nbsp;и&nbsp;6&nbsp;— данные по&nbsp;счету 9720.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr254/"></a><a data-anchor="/document/16/218501/dfas065bhg/" data-dfa="dfas065bhg"></a>В <strong>строке 240 «Прибыль (убыток) до&nbsp;уплаты налога на&nbsp;прибыль» </strong>рассчитается показатель по&nbsp;формуле: строка 220 +/- строка 230</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr255/"></a><a data-anchor="/document/16/218501/dfasvblrcl/" data-dfa="dfasvblrcl"></a>В<strong> строке 250 «Налог на&nbsp;прибыль» </strong>отразите сумму налога на&nbsp;прибыль, начисленного за&nbsp;отчетный период (счет 9810).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr256/"></a><a data-anchor="/document/16/218501/dfas89uu9z/" data-dfa="dfas89uu9z"></a>В <strong>строке 260 «Прочие налоги и&nbsp;другие обязательные платежи от&nbsp;прибыли» </strong>отразите сумму начисленных за&nbsp;отчетный период налогов и&nbsp;других обязательных платежей, уплачиваемых за&nbsp;счет прибыли (в&nbsp;том числе налог с&nbsp;оборота) (счет 9820).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr257/"></a><a data-anchor="/document/16/218501/dfascxgk7e/" data-dfa="dfascxgk7e"></a>В <strong>строке 270 «Чистая прибыль (убыток) отчетного периода»</strong> рассчитается конечный финансовый результат, определяемый по&nbsp;формуле: строка 240&nbsp;— строка 250&nbsp;— строка 260.</p><img alt="" hideborder="false" class="inimg" num="17" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><div data-role="phrase-incut" class="incut-v4 incut-v4-spoiler incut-v4-example " data-incut="spoiler"><h3 class="incut-v4__tag" data-incut-toggle="">Пример</h3><p class="incut-v4__title" data-incut-toggle=""><name><a data-anchor="/document/16/218501/bssPhr258/"></a><a data-anchor="/document/16/218501/dfasg8mfuv/" data-dfa="dfasg8mfuv"></a>Как заполнить Отчета о&nbsp;финансовых результатах</name></p><div class="incut-v4__content" data-incut-content=""><p><a data-anchor="/document/16/218501/bssPhr259/"></a><a data-anchor="/document/16/218501/dfas3hv6no/" data-dfa="dfas3hv6no"></a>По&nbsp;данным за&nbsp;2025 год организация имеет следующие показатели:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr260/"></a><a data-anchor="/document/16/218501/dfasdzkwxp/" data-dfa="dfasdzkwxp"></a>чистая выручка по&nbsp;счету 9000&nbsp;— 50&nbsp;000&nbsp;000&nbsp;сумов;</li><li>себестоимость продукции по&nbsp;счету 9100&nbsp;— 15&nbsp;000&nbsp;000&nbsp;сумов;</li><li>расходы по&nbsp;реализации&nbsp;— 5&nbsp;000&nbsp;000&nbsp;сумов;</li><li>административные расходы&nbsp;— 3&nbsp;000&nbsp;000&nbsp;сумов;</li><li>прочие расходы&nbsp;— 2&nbsp;500&nbsp;000&nbsp;сумов;</li><li>получена безвозмездная финансовая помощь на&nbsp;сумму&nbsp;— 7&nbsp;000&nbsp;000&nbsp;сумов;</li><li>налог на&nbsp;прибыль&nbsp;— 5&nbsp;000&nbsp;000&nbsp;сумов.</li></ul><p><a data-anchor="/document/16/218501/bssPhr261/"></a><a data-anchor="/document/16/218501/dfasi1g9lq/" data-dfa="dfasi1g9lq"></a>В<strong> строке 010</strong> организация укажет чистую выручку&nbsp;— 50&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr262/"></a><a data-anchor="/document/16/218501/dfasg3esgc/" data-dfa="dfasg3esgc"></a>В <strong>строке 020</strong> надо указать себестоимость продукции 15&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr263/"></a><a data-anchor="/document/16/218501/dfasdkn4g9/" data-dfa="dfasdkn4g9"></a><strong>Строка 030 </strong>рассчитается автоматически и&nbsp;будет равна 35&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr264/"></a><a data-anchor="/document/16/218501/dfask5uis0/" data-dfa="dfask5uis0"></a>В <strong>строке 050</strong> Организация укажет расходы по&nbsp;реализации на&nbsp;сумму 5&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr265/"></a><a data-anchor="/document/16/218501/dfasmwr7aa/" data-dfa="dfasmwr7aa"></a>В <strong>строке 060 </strong>нужно указать административные расходы на&nbsp;сумму 3&nbsp;000&nbsp;тыс. сумов, а&nbsp;в&nbsp;строке 070 прочие расходы на&nbsp;сумму&nbsp;— 2&nbsp;500&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr266/"></a><a data-anchor="/document/16/218501/dfast1k7c6/" data-dfa="dfast1k7c6"></a><strong>Строка 040</strong> рассчитается автоматически и&nbsp;будет равна 10&nbsp;500&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr267/"></a><a data-anchor="/document/16/218501/dfasr4xptu/" data-dfa="dfasr4xptu"></a>В <strong>строке 090</strong> организация укажет безвозмездную финансовую помощь&nbsp;— 7&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr268/"></a><a data-anchor="/document/16/218501/dfasrrleqn/" data-dfa="dfasrrleqn"></a><strong>Строка 100</strong> рассчитается автоматически и&nbsp;будет равна 31&nbsp;500&nbsp;тыс. сумов, строка 220 также будет равна 31&nbsp;500&nbsp;тыс. сумов.</p><img alt="" hideborder="false" class="inimg" num="18" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr269/"></a><a data-anchor="/document/16/218501/dfas5ghsz6/" data-dfa="dfas5ghsz6"></a>Прибыль до&nbsp;уплаты налога автоматически отразится в&nbsp;строке 240 и&nbsp;будет равна 31&nbsp;500&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr270/"></a><a data-anchor="/document/16/218501/dfas4z1zu7/" data-dfa="dfas4z1zu7"></a>В <strong>строке 250</strong> Организация укажет налог на&nbsp;прибыль на&nbsp;сумму&nbsp;— 5&nbsp;000&nbsp;тыс. сумов.</p><p><a data-anchor="/document/16/218501/bssPhr271/"></a><a data-anchor="/document/16/218501/dfas12t48o/" data-dfa="dfas12t48o"></a>Чистая прибыль рассчитается автоматически и&nbsp;будет равна 26&nbsp;500&nbsp;тыс. сумов.</p><img alt="" hideborder="false" class="inimg" num="19" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div></div><a data-anchor="/document/16/218501/tit13/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit13"><a data-anchor="/document/16/218501/bssPhr272/"></a><a data-anchor="/document/16/218501/dfasx9w524/" data-dfa="dfasx9w524"></a>Приложение «Примечания к&nbsp;финансовой отчетности»</h3><p style="text-align:left"><a data-anchor="/document/16/218501/bssPhr273/"></a><a data-anchor="/document/16/218501/dfasr0yu0d/" data-dfa="dfasr0yu0d"></a>Цель приложения «Примечания к&nbsp;финансовой отчетности»&nbsp;— раскрыть данные, которые предприятие указало в&nbsp;финансовой отчетности&nbsp;— в&nbsp;бухгалтерском балансе и&nbsp;отчете о&nbsp;финансовых результатах.</p><p><a data-anchor="/document/16/218501/bssPhr274/"></a><a data-anchor="/document/16/218501/dfas3u36ev/" data-dfa="dfas3u36ev"></a>Приложение представляет собой произвольную расшифровку всей финансовой ситуации в&nbsp;организации. В&nbsp;ней могут быть как общие сведения, так и&nbsp;подробные разъяснения по&nbsp;финансовой отчетности в&nbsp;целом.</p><p><a data-anchor="/document/16/218501/bssPhr275/"></a><a data-anchor="/document/16/218501/dfastlnxf4/" data-dfa="dfastlnxf4"></a>Например, если предприятие на&nbsp;1&nbsp;число отчетного года проводит переоценку основных средств, ее&nbsp;результаты следует принимать при формировании финансовой отчетности на&nbsp;начало отчетного года. При этом несоответствия данных на&nbsp;конец предыдущего и&nbsp;на&nbsp;начало отчетного периода следует объяснять как результаты переоценки и&nbsp;излагать в&nbsp;пояснительной записке.</p><p><a data-anchor="/document/16/218501/bssPhr276/"></a><a data-anchor="/document/16/218501/dfaspof5l9/" data-dfa="dfaspof5l9"></a>В&nbsp;Приложении можно указать информацию:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr277/"></a><a data-anchor="/document/16/218501/dfasb42hc9/" data-dfa="dfasb42hc9"></a>адрес предприятия;</li><li>среднегодовую численность работников;</li><li>виды деятельности;</li><li>краткие данные о&nbsp;применяемой учетной политике;</li><li>общую сумму чистой выручки;</li><li>общую сумму себестоимости реализованной продукции, товаров, услуг;</li><li>общую сумму расходов периода;</li><li>общую сумму прочих доходов;</li><li>общую сумму доходов и&nbsp;расходов от&nbsp;финансовой деятельности;</li><li>методы оценки готовой продукции, незавершенного производства, товаров и&nbsp;других производственных запасов;</li><li>методы начисления амортизации долгосрочных активов;</li><li>о&nbsp;внесенных изменениях в&nbsp;учетную политику, если они вносились в&nbsp;течение отчетного периода;</li><li>об&nbsp;изменениях в&nbsp;уставном, резервном, добавочном капитале предприятия;</li><li>об&nbsp;арендованном имуществе, если оно имеется у&nbsp;предприятия;</li><li>другие данные.</li></ul></div><a data-anchor="/document/16/218501/tit14/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit14"><a data-anchor="/document/16/218501/bssPhr278/"></a><a data-anchor="/document/16/218501/dfas3zokb2/" data-dfa="dfas3zokb2"></a>Как заполнить отчет о&nbsp;собственном капитале</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr282/"></a><a data-anchor="/document/16/218501/dfasega9nv/" data-dfa="dfasega9nv"></a>Отчет о&nbsp;собственном капитале отражает текущее состояние и&nbsp;изменения в&nbsp;собственном капитале организации, а&nbsp;также источники его формирования (<span num="141" target="_self" lnktype="intlnk" title="" class="doc">гл.&nbsp;8</span>&nbsp;НСБУ №&nbsp;1).</p><img alt="" hideborder="true" class="inimg" num="20" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr283/"></a><a data-anchor="/document/16/218501/dfash29sa1/" data-dfa="dfash29sa1"></a>Стандартная форма отчета представлена в&nbsp;приложении №&nbsp;3&nbsp;к Положению о&nbsp;сроках представления финансовой отчетности, а&nbsp;также ее&nbsp;структуре и&nbsp;содержании.</p><p><a data-anchor="/document/16/218501/bssPhr284/"></a><a data-anchor="/document/16/218501/dfas5o0ls3/" data-dfa="dfas5o0ls3"></a>Все показатели в&nbsp;отчете необходимо указывать в&nbsp;тысячах сумов.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr285/"></a><a data-anchor="/document/16/218501/dfass26lma/" data-dfa="dfass26lma"></a>В <strong>строке 010 «Остаток на&nbsp;начало года»</strong> отразите информацию по&nbsp;состоянию на&nbsp;начало года по&nbsp;графам:</p><ul class="c-list"><li style="text-align:start"><a data-anchor="/document/16/218501/bssPhr286/"></a><a data-anchor="/document/16/218501/dfasguv5zt/" data-dfa="dfasguv5zt"></a><strong>3&nbsp;«Уставный капитал»</strong>&nbsp;— сумму уставного капитала, указанная в&nbsp;учредительных документах (счета 8300);</li><li><a data-anchor="/document/16/218501/dfasu7a9nr/" data-dfa="dfasu7a9nr"></a><strong>4&nbsp;«Добавленный капитал»</strong>&nbsp;— сумму добавленного капитала (счета 8400);</li><li><a data-anchor="/document/16/218501/dfas9ceepg/" data-dfa="dfas9ceepg"></a><strong>5&nbsp;«Резервный капитал»</strong>&nbsp;— сумму резервного капитала (счета 8500);</li><li><a data-anchor="/document/16/218501/dfasxfuevn/" data-dfa="dfasxfuevn"></a><strong>6&nbsp;«Нераспределенная прибыль (непокрытый убыток)»</strong>&nbsp;— сумму нераспределенной прибыли или непокрытого убытка (счета 8700);</li><li><a data-anchor="/document/16/218501/dfast7g0qq/" data-dfa="dfast7g0qq"></a><strong>7&nbsp;«Выкупленные собственные акции»&nbsp;</strong>— сумму собственных выкупленных акций, предназначенных для перепродажи или аннулирования (счета 8600);</li><li><a data-anchor="/document/16/218501/dfasw7fbbg/" data-dfa="dfasw7fbbg"></a><strong>8&nbsp;«Целевые поступления и&nbsp;прочее»</strong>&nbsp;— сумму безвозмездно полученных активов, включая гранты, субсидии, членские взносы и&nbsp;другие поступления из&nbsp;бюджета, фондов специального назначения, от&nbsp;юридических и&nbsp;физических лиц для целевых мероприятий, а&nbsp;также другие источники формирования собственного капитала (счета 8800).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr287/"></a><a data-anchor="/document/16/218501/dfassafn5n/" data-dfa="dfassafn5n"></a>В <strong>строке 020 «Эмиссия ценных бумаг» </strong>отразите данные по&nbsp;выпуску и&nbsp;реализации ценных бумаг по&nbsp;графам:</p><ul class="c-list"><li style="text-align:start"><a data-anchor="/document/16/218501/bssPhr288/"></a><a data-anchor="/document/16/218501/dfasq8p6xx/" data-dfa="dfasq8p6xx"></a><strong>3</strong>&nbsp;— номинальную стоимость (счета 8310 и&nbsp;8320);</li><li><strong>4</strong>&nbsp;— эмиссионный доход (счет 8410).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr289/"></a><a data-anchor="/document/16/218501/dfasv2ltcw/" data-dfa="dfasv2ltcw"></a>В <strong>строке 030 «Переоценка долгосрочных активов»</strong>&nbsp;— в&nbsp;графе 5&nbsp;отразите сумму переоценки основных средств, нематериальных активов и&nbsp;других долгосрочных активов (счет 8510).</p><p><a data-anchor="/document/16/218501/bssPhr290/"></a><a data-anchor="/document/16/218501/dfas4rk2kg/" data-dfa="dfas4rk2kg"></a>В <strong>строке 040 «Валютная курсовая разница при формировании уставного капитала»&nbsp;</strong>— в&nbsp;графе 4&nbsp;отразите курсовая разница, возникшая при формировании уставного капитала предприятия (счет 8420).</p><p><a data-anchor="/document/16/218501/bssPhr291/"></a><a data-anchor="/document/16/218501/dfascgnv55/" data-dfa="dfascgnv55"></a>В <strong>строке 050 «Отчисления в&nbsp;резервный капитал»&nbsp;</strong>— в&nbsp;графах 5&nbsp;и&nbsp;6&nbsp;отразите сумму отчислений в&nbsp;резервный капитал (фонд), произведенных согласно учредительным документам (счет 8520).</p><p><a data-anchor="/document/16/218501/bssPhr292/"></a><a data-anchor="/document/16/218501/dfas25658r/" data-dfa="dfas25658r"></a>В <strong>строке 060 «Нераспределенная прибыль (убыток) текущего года»&nbsp;</strong>— в&nbsp;графе 6&nbsp;отразите сумму чистой прибыли (убытка) за&nbsp;отчетный год. В&nbsp;случае убытка он&nbsp;указывается со&nbsp;знаком «минус».</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr293/"></a><a data-anchor="/document/16/218501/dfascrrvnv/" data-dfa="dfascrrvnv"></a>В <strong>строке 070 «Безвозмездно полученное имущество»</strong>&nbsp;— в&nbsp;графе 5&nbsp;отразите стоимость безвозмездно полученного имущества (счет 8530).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr294/"></a><a data-anchor="/document/16/218501/dfasltoiti/" data-dfa="dfasltoiti"></a>В <strong>строке 080 «Средства, полученные по&nbsp;целевому назначению»</strong>&nbsp;— в&nbsp;графе 8&nbsp;отразите гранты, субсидии, членские взносы и&nbsp;другие поступления, полученные для использования по&nbsp;целевому назначению (счета 8800).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr295/"></a><a data-anchor="/document/16/218501/dfasdtquxc/" data-dfa="dfasdtquxc"></a>В <strong>строке 090 «Дивиденды начисленные»</strong>&nbsp;— в&nbsp;графе 6&nbsp;отразите сумму начисленных дивидендов за&nbsp;отчетный год, как из&nbsp;нераспределенной прибыли отчетного периода, так и&nbsp;из&nbsp;накопленной прибыли прошлых лет (оборот по&nbsp;дебету счета 8700 и&nbsp;кредиту счета 6610). Поскольку начисление дивидендов уменьшает нераспределенную прибыль, сумма дивидендов указывается со&nbsp;знаком «минус».</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr296/"></a><a data-anchor="/document/16/218501/dfasoohx4p/" data-dfa="dfasoohx4p"></a>В <strong>строке 100 «Прочие источники формирования собственного капитала»</strong>&nbsp;— в&nbsp;графах 3-8 отразите суммы, которые не&nbsp;указаны в&nbsp;предыдущих строках (в&nbsp;т.ч. счета 8900).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr297/"></a><a data-anchor="/document/16/218501/dfas2u7xwm/" data-dfa="dfas2u7xwm"></a>В <strong>строке 110 «Остаток на&nbsp;конец года»</strong>&nbsp;— в&nbsp;графах 3-8 отразите сальдо собственного капитала на&nbsp;конец отчетного года.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr298/"></a><a data-anchor="/document/16/218501/dfash4gywd/" data-dfa="dfash4gywd"></a>В <strong>строке 120 «Увеличение (+) или уменьшение (—) собственного капитала»</strong>&nbsp;— в&nbsp;графах 3-8 отразите сумму такого увеличения или уменьшения на&nbsp;конец отчетного года по&nbsp;сравнению с&nbsp;суммой на&nbsp;начало года.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr299/"></a><a data-anchor="/document/16/218501/dfases4tyg/" data-dfa="dfases4tyg"></a><strong>В&nbsp;графе 9&nbsp;</strong>«Итого» рассчитаются итоговые суммы по&nbsp;соответствующим строкам.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr300/"></a><a data-anchor="/document/16/218501/dfas8wpie2/" data-dfa="dfas8wpie2"></a>Акционерные общества заполняют справочно в&nbsp;графе 9&nbsp;по&nbsp;строкам:</p><ul class="c-list"><li style="text-align:start"><a data-anchor="/document/16/218501/bssPhr301/"></a><a data-anchor="/document/16/218501/dfasbi5fxe/" data-dfa="dfasbi5fxe"></a><strong>130&nbsp;</strong>— количество выпущенных акций (в&nbsp;штуках);</li><li><strong>131&nbsp;</strong>— в&nbsp;т.ч. количество выпущенных привилегированных акций;</li><li><strong>132&nbsp;</strong>— в&nbsp;т.ч. количество выпущенных простых акций;</li><li><strong>140&nbsp;</strong>— номинальную стоимость акций;</li><li><strong>150</strong>&nbsp;— количество акций в&nbsp;обращении (в&nbsp;штуках);</li><li><strong>151</strong>&nbsp;— в&nbsp;т.ч. количество привилегированных акций в&nbsp;обращении;</li><li><strong>152</strong>&nbsp;— в&nbsp;т.ч. количество простых акций в&nbsp;обращении.</li></ul><img alt="" hideborder="false" class="inimg" num="21" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"></div><a data-anchor="/document/16/218501/tit15/" data-role="toc-anchor" class="toc-anchor"></a><h2 class="main__title-section title toc" toc-anchor="tit15"><a data-anchor="/document/16/218501/bssPhr302/"></a><a data-anchor="/document/16/218501/dfasdw5xr7/" data-dfa="dfasdw5xr7"></a>Как заполнить отчет о&nbsp;денежных потоках</h2><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><p><a data-anchor="/document/16/218501/bssPhr308/"></a><a data-anchor="/document/16/218501/dfas1os80s/" data-dfa="dfas1os80s"></a>Отчет о&nbsp;денежных потоках отражает изменения в&nbsp;финансовых ресурсах организации через движение денежных средств по&nbsp;трем основным видам деятельности: операционной, инвестиционной и&nbsp;финансовой. Он&nbsp;помогает отследить изменения в&nbsp;остатках денежных средств на&nbsp;начало и&nbsp;конец отчетного периода (<span data-warm-notices="42037386" data-warm-notice-type="error" num="142" target="_self" lnktype="intlnk" title="" class="doc">НСБУ №&nbsp;9</span>).</p><p><a data-anchor="/document/16/218501/bssPhr309/"></a><a data-anchor="/document/16/218501/dfasp2lamb/" data-dfa="dfasp2lamb"></a>Стандартная форма отчета представлена в&nbsp;приложении №&nbsp;4&nbsp;к Положению о&nbsp;сроках представления финансовой отчетности, а&nbsp;также ее&nbsp;структуре и&nbsp;содержании.</p><p><a data-anchor="/document/16/218501/bssPhr310/"></a><a data-anchor="/document/16/218501/dfasl8wmbk/" data-dfa="dfasl8wmbk"></a>Все показатели в&nbsp;отчете необходимо указывать в&nbsp;тысячах сумов.</p><p><a data-anchor="/document/16/218501/bssPhr311/"></a><a data-anchor="/document/16/218501/dfasbd3h9h/" data-dfa="dfasbd3h9h"></a>Отчет о&nbsp;денежных потоках финансовой отчетности состоит из&nbsp;разделов:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr312/"></a><a data-anchor="/document/16/218501/dfas1ytrii/" data-dfa="dfas1ytrii"></a><a href="https://1gb.uz/#/document/16/218501/dfash03sgc/">«Операционная деятельность»</a>;</li><li><a href="https://1gb.uz/#/document/16/218501/dfaszigpx6/">«Инвестиционная деятельность»</a>;</li><li><a href="https://1gb.uz/#/document/16/218501/dfasr8s0cv/">«Финансовая деятельность»</a>;</li><li>«<a href="https://1gb.uz/#/document/16/218501/dfasc1bnil/">Налогообложение и&nbsp;итоговые показатели</a>»;</li><li><a href="https://1gb.uz/#/document/16/218501/dfasws1en7/">Справка о&nbsp;движении денежных средств в&nbsp;иностранной валюте</a>.</li></ul></div><div data-role="phrase-incut" class="incut-v4  incut-v4-universal " data-incut-cant-open=""><a data-anchor="/document/16/218501/tit16/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit16"><a data-anchor="/document/16/218501/bssPhr314/"></a><a data-anchor="/document/16/218501/dfash03sgc/" data-dfa="dfash03sgc"></a>Раздел «Операционная деятельность»</h3><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr315/"></a><a data-anchor="/document/16/218501/dfaszhplfg/" data-dfa="dfaszhplfg"></a>В <strong>строке 010 «Денежные средства, поступившие от&nbsp;реализации продукции (товаров, работ и&nbsp;услуг)»</strong>&nbsp;— в&nbsp;графе «Приход» отразите сумму денежных средств, поступивших за&nbsp;отчетный период на&nbsp;банковские счета и&nbsp;в&nbsp;кассу предприятия за&nbsp;реализованную продукцию, товары, работы и&nbsp;услуги.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr316/"></a><a data-anchor="/document/16/218501/dfasqsu9ay/" data-dfa="dfasqsu9ay"></a>В <strong>строке 020 «Денежные средства, выплаченные поставщикам за&nbsp;материалы, товары, работы и&nbsp;услуги»</strong>&nbsp;— в&nbsp;графе «Расход» отразите сумму денежных средств, уплаченную поставщикам за&nbsp;материалы, товары, работы и&nbsp;услуги, кроме выплат за&nbsp;покупку долгосрочных активов.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr317/"></a><a data-anchor="/document/16/218501/dfas1ag6qy/" data-dfa="dfas1ag6qy"></a>В<strong> строке 030 «Денежные средства, выплаченные работникам и&nbsp;от&nbsp;их&nbsp;имени»</strong>&nbsp;— в&nbsp;графе «Расход» отразите сумму денежных средств, выплаченных из&nbsp;кассы и&nbsp;с&nbsp;банковских счетов, по&nbsp;операциям с&nbsp;работниками и&nbsp;от&nbsp;их&nbsp;имени, в&nbsp;т.ч.&nbsp;на:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr318/"></a><a data-anchor="/document/16/218501/dfasa0p4vs/" data-dfa="dfasa0p4vs"></a>оплату труда;</li><li>уплату в&nbsp;бюджет НДФЛ и&nbsp;отчислений на&nbsp;ИНПС;</li><li>отчисления в&nbsp;профсоюзы;</li><li>уплату алиментов;</li><li>оплату коммунальных услуг;</li><li>погашение кредитов и&nbsp;займов, предоставленных работникам;</li><li>оплату предприятием услуг, оказываемых работникам;</li><li>другие цели.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr319/"></a><a data-anchor="/document/16/218501/dfasvqkwch/" data-dfa="dfasvqkwch"></a>В <strong>строке 040 «Другие денежные поступления и&nbsp;выплаты от&nbsp;операционной деятельности»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li style="text-align:start"><a data-anchor="/document/16/218501/bssPhr320/"></a><a data-anchor="/document/16/218501/dfaswf7ghi/" data-dfa="dfaswf7ghi"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, полученных от&nbsp;роялти, вознаграждений различного характера, комиссионных сборов и&nbsp;другой операционной деятельности;</li><li><strong>«Расход»</strong>&nbsp;— сумму денежных средств, уплаченных на&nbsp;роялти, вознаграждения различного характера, комиссионные сборы и&nbsp;другую операционную деятельность.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr321/"></a><a data-anchor="/document/16/218501/dfasxlivmg/" data-dfa="dfasxlivmg"></a>В <strong>строке 050 «Итого: чистый денежный приток/отток от&nbsp;операционной деятельности» </strong>рассчитается показатель по&nbsp;формуле: строка 010&nbsp;— строка 020&nbsp;— строка 030 +/— строка 040. Если этот показатель получился со&nbsp;знаком «+», он&nbsp;отражается в&nbsp;графе «Приход», со&nbsp;знаком «—» — в&nbsp;графе «Расход».</p><a data-anchor="/document/16/218501/tit17/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit17"><a data-anchor="/document/16/218501/bssPhr322/"></a><a data-anchor="/document/16/218501/dfaszigpx6/" data-dfa="dfaszigpx6"></a>Раздел «Инвестиционная деятельность»</h3><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr323/"></a><a data-anchor="/document/16/218501/dfas1tx1to/" data-dfa="dfas1tx1to"></a>В <strong>строке 060 «Приобретение и&nbsp;продажа основных средств»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr324/"></a><a data-anchor="/document/16/218501/dfas9pzvo6/" data-dfa="dfas9pzvo6"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, поступивших от&nbsp;реализации основных средств;</li><li><strong>«Расход»</strong>&nbsp;— сумму денежных средств, уплаченных за&nbsp;приобретение основных средств.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr325/"></a><a data-anchor="/document/16/218501/dfasw2g1ib/" data-dfa="dfasw2g1ib"></a>В <strong>строке 070 «Приобретение и&nbsp;продажа нематериальных активов» </strong>отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr326/"></a><a data-anchor="/document/16/218501/dfas1b670y/" data-dfa="dfas1b670y"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, поступивших от&nbsp;реализации нематериальных активов;</li><li><strong>«Расход»&nbsp;</strong>— сумму денежных средств, уплаченных за&nbsp;приобретение нематериальных активов.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr327/"></a><a data-anchor="/document/16/218501/dfaswflpvy/" data-dfa="dfaswflpvy"></a>В <strong>строке 080 «Приобретение и&nbsp;продажа долгосрочных и&nbsp;краткосрочных инвестиций»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr328/"></a><a data-anchor="/document/16/218501/dfastyuwig/" data-dfa="dfastyuwig"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, поступивших от&nbsp;реализации ценных бумаг и&nbsp;других инструментов инвестиций;</li><li><strong>«Расход»&nbsp;</strong>— сумму денежных средств, уплаченных за&nbsp;приобретение ценных бумаг и&nbsp;других инструментов инвестиций, включая комиссионные вознаграждения посредникам и&nbsp;проценты бирже.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr329/"></a><a data-anchor="/document/16/218501/dfas4uyswm/" data-dfa="dfas4uyswm"></a>В <strong>строке 090 «Другие денежные поступления и&nbsp;выплаты от&nbsp;инвестиционной деятельности»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr330/"></a><a data-anchor="/document/16/218501/dfas392wc0/" data-dfa="dfas392wc0"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, полученных от&nbsp;прочей инвестиционной деятельности;</li><li><strong>«Расход»</strong>&nbsp;— сумму денежных средств, уплаченных в&nbsp;рамках прочей инвестиционной деятельности.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr331/"></a><a data-anchor="/document/16/218501/dfaskmvk94/" data-dfa="dfaskmvk94"></a>В <strong>строке</strong><strong>100 «Итого: чистый денежный приток/отток от&nbsp;инвестиционной деятельности»</strong>&nbsp;— рассчитается показатель по&nbsp;формуле: строка 060 +/— строка 070 +/— строка 080 +/— строка 090. Если этот показатель получился со&nbsp;знаком «+», его отразите в&nbsp;графе «Приход», со&nbsp;знаком «—» — в&nbsp;графе «Расход».</p><a data-anchor="/document/16/218501/tit18/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit18"><a data-anchor="/document/16/218501/bssPhr332/"></a><a data-anchor="/document/16/218501/dfasr8s0cv/" data-dfa="dfasr8s0cv"></a>Раздел «Финансовая деятельность»</h3><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr333/"></a><a data-anchor="/document/16/218501/dfas68xb1m/" data-dfa="dfas68xb1m"></a>В <strong>строке 110 «Полученные и&nbsp;выплаченные проценты»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr334/"></a><a data-anchor="/document/16/218501/dfasvudocq/" data-dfa="dfasvudocq"></a><strong>«Приход»</strong>&nbsp;— сумму полученных процентов;</li><li><strong>«Расход»</strong>&nbsp;— сумму уплаченных процентов.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr335/"></a><a data-anchor="/document/16/218501/dfasto80ex/" data-dfa="dfasto80ex"></a>В <strong>строке 120 «Полученные и&nbsp;выплаченные дивиденды»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr336/"></a><a data-anchor="/document/16/218501/dfas7v410g/" data-dfa="dfas7v410g"></a><strong>«Приход»</strong>&nbsp;— сумму полученных дивидендов;</li><li><strong>«Расход»</strong>&nbsp;— сумму выплаченных дивидендов.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr337/"></a><a data-anchor="/document/16/218501/dfasqsk1ku/" data-dfa="dfasqsk1ku"></a>В <strong>строке 130</strong> «Денежные поступления от&nbsp;выпуска акций или других инструментов, связанных с&nbsp;собственным капиталом»&nbsp;— в&nbsp;графе «Приход» отразите сумму денежных средств, поступивших от&nbsp;акционеров за&nbsp;выпущенные (реализованные) акции или другие инструменты собственного капитала.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr338/"></a><a data-anchor="/document/16/218501/dfasqi5bf0/" data-dfa="dfasqi5bf0"></a>В <strong>строке 140 «Денежные выплаты и&nbsp;поступления при выкупе и&nbsp;реализации собственных акций» </strong>отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr339/"></a><a data-anchor="/document/16/218501/dfas0eguaw/" data-dfa="dfas0eguaw"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, поступивших от&nbsp;реализации собственных выкупленных акций;</li><li><strong>«Расход»&nbsp;</strong>— сумму денежных средств, уплаченных владельцам за&nbsp;собственные акции (доли, паи), для их&nbsp;последующей перепродажи или аннулирования.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr340/"></a><a data-anchor="/document/16/218501/dfaskbdutx/" data-dfa="dfaskbdutx"></a>В <strong>строке 150 «Денежные поступления и&nbsp;выплаты по&nbsp;долгосрочным и&nbsp;краткосрочным кредитам и&nbsp;займам» </strong>отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr341/"></a><a data-anchor="/document/16/218501/dfasw2twuv/" data-dfa="dfasw2twuv"></a><strong>«Приход»</strong>&nbsp;— сумму полученных кредитов и&nbsp;займов;</li><li><strong>«Расход»&nbsp;</strong>— сумму погашения кредитов и&nbsp;займов.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr342/"></a><a data-anchor="/document/16/218501/dfasw16gsf/" data-dfa="dfasw16gsf"></a>В <strong>строке 160 «Денежные поступления и&nbsp;платежи по&nbsp;финансовой аренде» </strong>отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr343/"></a><a data-anchor="/document/16/218501/dfass3a7te/" data-dfa="dfass3a7te"></a><strong>«Приход»</strong>&nbsp;— сумму денежных средств, поступивших от&nbsp;арендатора (лизингополучателя);</li><li><strong>«Расход»&nbsp;</strong>— сумму денежных средств, уплаченных арендодателю (лизингодателю).</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr344/"></a><a data-anchor="/document/16/218501/dfasbqgb9g/" data-dfa="dfasbqgb9g"></a>В <strong>строке 170 «Другие денежные поступления и&nbsp;выплаты от&nbsp;финансовой деятельности»</strong> отразите в&nbsp;графах:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr345/"></a><a data-anchor="/document/16/218501/dfasl4s78d/" data-dfa="dfasl4s78d"></a><strong>«Приход»&nbsp;</strong>— сумму денежных средств, полученных от&nbsp;прочей финансовой деятельности;</li><li><strong>«Расход»</strong>&nbsp;— сумму средств, уплаченных в&nbsp;рамках прочей финансовой деятельности.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr346/"></a><a data-anchor="/document/16/218501/dfas291em8/" data-dfa="dfas291em8"></a>В <strong>строке 180 «Итого: чистый приток/отток от&nbsp;финансовой деятельности»</strong> рассчитается показатель по&nbsp;формуле: строка 110 +/— строка 120 + строка 130 +/—строка 140 +/— строка 150 +/— строка 160 +/— строка 170. Если этот показатель получился со&nbsp;знаком «+», он&nbsp;отражается в&nbsp;графе «Приход», со&nbsp;знаком «—» — в&nbsp;графе «Расход».</p><a data-anchor="/document/16/218501/tit19/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit19"><a data-anchor="/document/16/218501/bssPhr347/"></a><a data-anchor="/document/16/218501/dfasc1bnil/" data-dfa="dfasc1bnil"></a>Раздел «Налогообложение и&nbsp;итоговые показатели»</h3><p><a data-anchor="/document/16/218501/bssPhr348/"></a><a data-anchor="/document/16/218501/dfasqwqfq0/" data-dfa="dfasqwqfq0"></a>В <strong>строке 190 «Уплаченный налог на&nbsp;прибыль»</strong> в&nbsp;графе «Расход» отразите сумму уплаченного налога на&nbsp;прибыль.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr349/"></a><a data-anchor="/document/16/218501/dfas0f04g2/" data-dfa="dfas0f04g2"></a>В <strong>строке 200 «Уплаченные прочие налоги» </strong>отражайте сумму уплаченных налогов, сборов и&nbsp;других обязательных платежей в&nbsp;бюджет (кроме налога на&nbsp;прибыль).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr350/"></a><a data-anchor="/document/16/218501/dfas4cvm75/" data-dfa="dfas4cvm75"></a>Не&nbsp;включайте в&nbsp;строку 200&nbsp;налоги, удержанные из&nbsp;доходов физлиц. Их&nbsp;отразите в&nbsp;строке 030&nbsp;отчета.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr351/"></a><a data-anchor="/document/16/218501/dfas1ubgp0/" data-dfa="dfas1ubgp0"></a>В <strong>строке 210 «Итого: уплаченные налоги» </strong>рассчитается сумму строк 190 и&nbsp;200.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr352/"></a><a data-anchor="/document/16/218501/dfasx9cd81/" data-dfa="dfasx9cd81"></a>В <strong>строке 220 «Итого: чистый приток/отток от&nbsp;финансово-хозяйственной деятельности»</strong> рассчитается показатель по&nbsp;формуле: строка 050 +/— строка 100 +/— строка 180&nbsp;— строка 210. Если этот показатель получился со&nbsp;знаком «+», он&nbsp;отражается в&nbsp;графе «Приход», со&nbsp;знаком «—» — в&nbsp;графе «Расход».</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr353/"></a><a data-anchor="/document/16/218501/dfasq48w0r/" data-dfa="dfasq48w0r"></a>В <strong>строке 221 «Сальдо курсовых разниц, образовавшихся от&nbsp;переоценки денежных средств в&nbsp;иностранной валюте» </strong>отразите сальдо, образовавшееся по&nbsp;счетам 5020 и&nbsp;5200, а&nbsp;также по&nbsp;счетам 5500, 5600 и&nbsp;5700 (в&nbsp;части иностранной валюты).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr354/"></a><a data-anchor="/document/16/218501/dfas94d5sg/" data-dfa="dfas94d5sg"></a>В <strong>строке 230 «Денежные средства на&nbsp;начало года»</strong> в&nbsp;графе «Приход» отразите сумму остатков денежных средств на&nbsp;счетах учета 5000, 5100, 5200, 5500, 5600 и&nbsp;5700&nbsp;на начало года. Она должна соответствовать показателю в&nbsp;графе 3&nbsp;строки 320 бухгалтерского баланса.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr355/"></a><a data-anchor="/document/16/218501/dfaskembv0/" data-dfa="dfaskembv0"></a>В <strong>строке 240 «Денежные средства на&nbsp;конец года» </strong>в&nbsp;графе «Приход» отразите сумму остатков денежных средств на&nbsp;счетах учета денежных средств 5000, 5100, 5200, 5500, 5600 и&nbsp;5700&nbsp;на конец года. Она должна соответствовать показателю в&nbsp;графе 4&nbsp;строки 320 бухгалтерского баланса.</p><img alt="" hideborder="false" class="inimg" num="1" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><a data-anchor="/document/16/218501/tit20/" data-role="toc-anchor" class="toc-anchor"></a><h3 class="main__title-section title toc" toc-anchor="tit20"><a data-anchor="/document/16/218501/bssPhr356/"></a><a data-anchor="/document/16/218501/dfasws1en7/" data-dfa="dfasws1en7"></a>Справка о&nbsp;движении денежных средств в&nbsp;иностранной валюте</h3><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr357/"></a><a data-anchor="/document/16/218501/dfaskokgx3/" data-dfa="dfaskokgx3"></a>В&nbsp;справке отразите валютные средства в&nbsp;пересчете в&nbsp;национальную валюту по&nbsp;курсу&nbsp;ЦБ на&nbsp;момент совершения операций, а&nbsp;остаток валютных средств&nbsp;— на&nbsp;дату отражения остатка (начало или конец года).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr358/"></a><a data-anchor="/document/16/218501/dfasn8z3rg/" data-dfa="dfasn8z3rg"></a>В <strong>строке 250 «Остаток на&nbsp;начало года» </strong>отразите сумму средств на&nbsp;валютных счетах и&nbsp;в&nbsp;кассе предприятия на&nbsp;начало года.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr359/"></a><a data-anchor="/document/16/218501/dfasuzvw4i/" data-dfa="dfasuzvw4i"></a>В <strong>строке 260 «Поступило валютных средств, всего» </strong>рассчитается сумма валютных средств по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr360/"></a><a data-anchor="/document/16/218501/dfas50croc/" data-dfa="dfas50croc"></a><strong>261 «Выручка от&nbsp;реализации»&nbsp;</strong>— полученная валютная выручка;</li><li><strong>262 «Проконвертировано»</strong>&nbsp;— приобретенная иностранная валюта;</li><li><strong>263 «По&nbsp;финансовой деятельности»</strong>&nbsp;— валютные средства, полученные от&nbsp;финансовой деятельности;</li><li><a data-anchor="/document/16/218501/dfaszfmxky/" data-dfa="dfaszfmxky"></a><strong>264 «Другие источники»&nbsp;</strong>— прочие поступления на&nbsp;валютные счета и&nbsp;в&nbsp;кассу предприятия за&nbsp;счет источников, не&nbsp;перечисленных в&nbsp;строках 261, 262 и&nbsp;263.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr361/"></a><a data-anchor="/document/16/218501/dfaswshfmg/" data-dfa="dfaswshfmg"></a>В <strong>строке 270 «Израсходовано валютных средств, всего»</strong> рассчитается сумма валютных средств по&nbsp;строкам:</p><ul class="c-list"><li><a data-anchor="/document/16/218501/bssPhr362/"></a><a data-anchor="/document/16/218501/dfaswtg4to/" data-dfa="dfaswtg4to"></a><strong>271 «Выплаты поставщикам и&nbsp;подрядчикам»</strong>&nbsp;— валютные средства, израсходованные на&nbsp;приобретение имущества, выполненные работы и&nbsp;оказанные услуги;</li><li><strong>272 «Выплаты по&nbsp;финансовой деятельности»</strong>&nbsp;— валютные средства, израсходованные в&nbsp;рамках финансовой деятельности;</li><li><strong>273 «На&nbsp;другие цели»</strong>&nbsp;— валютные средства, израсходованные на&nbsp;прочие цели, не&nbsp;перечисленные в&nbsp;строках 271 и&nbsp;272.</li></ul><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr363/"></a><a data-anchor="/document/16/218501/dfasnumkrg/" data-dfa="dfasnumkrg"></a>В <strong>строке 280 «Сальдо курсовых разниц, образовавшихся от&nbsp;переоценки денежных средств в&nbsp;иностранной валюте»</strong> отразите сальдо, образовавшееся по&nbsp;счетам 5020 и&nbsp;5200, а&nbsp;также по&nbsp;счетам 5500, 5600 и&nbsp;5700 (в&nbsp;части иностранной валюты).</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr364/"></a><a data-anchor="/document/16/218501/dfasfqghsz/" data-dfa="dfasfqghsz"></a>Значения строк 221 и&nbsp;280 должны совпадать.</p><p style="text-align:start"><a data-anchor="/document/16/218501/bssPhr365/"></a><a data-anchor="/document/16/218501/dfas558vho/" data-dfa="dfas558vho"></a>В <strong>строке 290 «Остаток на&nbsp;конец года» </strong>рассчитается сумма средств на&nbsp;валютных счетах и&nbsp;в&nbsp;кассе предприятия на&nbsp;конец отчетного года по&nbsp;формуле: строка 250 + строка 260&nbsp;— строка 270 +/— строка 280.</p><img alt="" hideborder="false" class="inimg" num="2" lnktype="img" src="https://1gb.uz/system/content/image/297///" width="610" height="NaN"><p><a data-anchor="/document/16/218501/bssPhr366/"></a><a data-anchor="/document/16/218501/dfasui16mh/" data-dfa="dfasui16mh"></a><strong>Конвертер валют.</strong> Воспользуйтесь инструментом от&nbsp;Системы, который поможет Вам быстро и&nbsp;точно конвертировать валюту по&nbsp;курсу ЦБ&nbsp;РУз.</p><div class="iframe"><iframe class="doc-iframe" frameborder="0" height="1000" width="100%" data-src="https://konvertkurs.action-mcfr.uz/"></iframe></div></div><p><a data-anchor="/document/16/218501/dfas2rpmd9/" data-dfa="dfas2rpmd9"></a><a data-anchor="/document/16/218501/bssPhr367/"></a><img alt="" hideborder="true" class="inimg" lnktype="img" id="-41882124" sourceId="1" fullSizeImageId="-41882123" width="610" height="246.82561307901906" src="https://1gb.uz/system/content/image/297/1/-41882124/"></p></div></div><div xmlns="" class="footer">© Материал из ЭС "ACTION: Главбух"<br />https://1gb.uz<br />Дата копирования: 28.09.2026</div></body></html>