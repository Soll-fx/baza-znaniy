r" data-phrase-anchor="bssPhr63789"></a><a data-anchor="/document/90/20882/dfasidrwn9/"></a>&#160;</td><td class="bdTop bdBottom" style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63790/" data-role="phrase-anchor" data-phrase-id="63790" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63790"></a><a data-anchor="/document/90/20882/dfasp5sts4/"></a>&#160;</td></tr><tr><td class="bdAll" rowspan="2" style="width: 11%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr63791/" data-role="phrase-anchor" data-phrase-id="63791" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63791"></a><a data-anchor="/document/90/20882/dfaskwur1b/"></a><strong>8-й этап</strong></p></td><td class="bdBottom bdRight bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63792/" data-role="phrase-anchor" data-phrase-id="63792" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63792"></a><a data-anchor="/document/90/20882/dfasgv71z0/"></a>&#160;</td><td class="bdAll" rowspan="2" style="width: 23%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr63793/" data-role="phrase-anchor" data-phrase-id="63793" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63793"></a><a data-anchor="/document/90/20882/dfas03w52t/"></a><strong>Комитет казначейства при Министерстве экономики и финансов</strong></p></td><td class="bdBottom bdRight bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63794/" data-role="phrase-anchor" data-phrase-id="63794" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63794"></a><a data-anchor="/document/90/20882/dfasiwypx6/"></a>&#160;</td><td class="bdAll" rowspan="2" style="width: 37%; word-wrap: break-word"><p><a data-anchor="/document/90/20882/bssPhr63795/" data-role="phrase-anchor" data-phrase-id="63795" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63795"></a><a data-anchor="/document/90/20882/dfasvtsze7/"></a>В пределах средств Государственного бюджета (при наличии достаточных средств) автоматически перечисляет сумму налога на банковский счёт налогоплательщика.</p></td><td class="bdBottom bdRight bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63796/" data-role="phrase-anchor" data-phrase-id="63796" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63796"></a><a data-anchor="/document/90/20882/dfasbr5ag2/"></a>&#160;</td><td class="bdAll" rowspan="2" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr63797/" data-role="phrase-anchor" data-phrase-id="63797" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63797"></a><a data-anchor="/document/90/20882/dfas1m1r30/"></a>В однодневный срок</p></td></tr><tr allowpartbreak="false"><td class="bdTop bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63798/" data-role="phrase-anchor" data-phrase-id="63798" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63798"></a><a data-anchor="/document/90/20882/dfas9orbmf/"></a>&#160;</td><td class="bdTop bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63799/" data-role="phrase-anchor" data-phrase-id="63799" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63799"></a><a data-anchor="/document/90/20882/dfaszndiak/"></a>&#160;</td><td class="bdTop bdLeft" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63800/" data-role="phrase-anchor" data-phrase-id="63800" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63800"></a><a data-anchor="/document/90/20882/dfaspzhhr2/"></a>&#160;</td></tr><tr><td class="bdTop" style="width: 11%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63801/" data-role="phrase-anchor" data-phrase-id="63801" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63801"></a><a data-anchor="/document/90/20882/dfasoz4p98/"></a>&#160;</td><td style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63802/" data-role="phrase-anchor" data-phrase-id="63802" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63802"></a><a data-anchor="/document/90/20882/dfas8lefp3/"></a>&#160;</td><td class="bdTop" style="width: 23%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63803/" data-role="phrase-anchor" data-phrase-id="63803" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63803"></a><a data-anchor="/document/90/20882/dfasybegq1/"></a>&#160;</td><td style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63804/" data-role="phrase-anchor" data-phrase-id="63804" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63804"></a><a data-anchor="/document/90/20882/dfas49gtw6/"></a>&#160;</td><td class="bdTop" style="width: 37%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63805/" data-role="phrase-anchor" data-phrase-id="63805" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63805"></a><a data-anchor="/document/90/20882/dfas26dgfk/"></a>&#160;</td><td style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63806/" data-role="phrase-anchor" data-phrase-id="63806" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63806"></a><a data-anchor="/document/90/20882/dfass4nemt/"></a>&#160;</td><td class="bdTop" style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63807/" data-role="phrase-anchor" data-phrase-id="63807" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63807"></a><a data-anchor="/document/90/20882/dfased0c2y/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:right"><a data-anchor="/document/90/20882/bssPhr63808/" data-role="phrase-anchor" data-phrase-id="63808" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63808"></a><a data-anchor="/document/90/20882/dfasaqp5de/"></a>ПРИЛОЖЕНИЕ № 1-1<br>к Положению<br>&#171;О порядке возмещения суммы налога на добавленную стоимость&#187;</p><div class="doc__untyped" data-type="untyped" data-level="2"><a data-role="toc" data-anchor="/document/90/20882/tit1326/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/20882/bssPhr63809/" data-role="phrase-anchor" data-phrase-id="63809" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63809"></a><a data-anchor="/document/90/20882/dfasvv65kp/"></a>СХЕМА<br><a data-anchor="/document/90/20882/dfas1k58m9/"></a>РАССМОТРЕНИЯ ЗАЯВЛЕНИЯ О ВОЗВРАТЕ НА БАНКОВСКИЙ СЧЕТ НАЛОГОПЛАТЕЛЬЩИКА СУММЫ НАЛОГА НА ДОБАВЛЕННУЮ СТОИМОСТЬ, ПОДЛЕЖАЩЕЙ ВОЗМЕЩЕНИЮ СУБЪЕКТАМ ПРЕДПРИНИМАТЕЛЬСТВА, ОТНОСЯЩИМСЯ К КАТЕГОРИИ &#171;ААА&#187; ПО РЕЙТИНГУ УСТОЙЧИВОСТИ СУБЪЕКТОВ ПРЕДПРИНИМАТЕЛЬСТВА</span></div><div><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdAll" style="width: 12%; overflow-wrap: break-word; text-align: center; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63810/" data-role="phrase-anchor" data-phrase-id="63810" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63810"></a><a data-anchor="/document/90/20882/dfasvny67l/"></a><strong>Этапы</strong></td><td class="bdRight bdLeft" style="width: 2%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63811/" data-role="phrase-anchor" data-phrase-id="63811" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63811"></a><a data-anchor="/document/90/20882/dfasuvz0qu/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 17%; overflow-wrap: break-word; text-align: center; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63812/" data-role="phrase-anchor" data-phrase-id="63812" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63812"></a><a data-anchor="/document/90/20882/dfas22l6ap/"></a><strong>Субъекты </strong></td><td class="bdRight bdLeft" style="width: 2%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63813/" data-role="phrase-anchor" data-phrase-id="63813" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63813"></a><a data-anchor="/document/90/20882/dfasworg3p/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 47%; overflow-wrap: break-word; text-align: center; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63814/" data-role="phrase-anchor" data-phrase-id="63814" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63814"></a><a data-anchor="/document/90/20882/dfas5qr5q4/"></a><strong>Мероприятия</strong></td><td class="bdRight bdLeft" style="width: 2%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63815/" data-role="phrase-anchor" data-phrase-id="63815" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63815"></a><a data-anchor="/document/90/20882/dfas7puchx/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 15%; overflow-wrap: break-word; text-align: center; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63816/" data-role="phrase-anchor" data-phrase-id="63816" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr63816"></a><a data-anchor="/document/90/20882/dfas614kln/"></a><strong>Срок выполнения</strong></td></tr><tr><td class="bdTop bdBottom" style="width: 12%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr63817/" data-role="phrase-anchor" data-phrase-id=