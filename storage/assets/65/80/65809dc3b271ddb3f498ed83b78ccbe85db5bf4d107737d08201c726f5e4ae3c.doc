nchor" data-phrase-id="48024" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48024"></a><a data-anchor="/document/90/20882/dfas0thdc5/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48025/" data-role="phrase-anchor" data-phrase-id="48025" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48025"></a><a data-anchor="/document/90/20882/dfastyygvs/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48026/" data-role="phrase-anchor" data-phrase-id="48026" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48026"></a><a data-anchor="/document/90/20882/dfasv9k1xw/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48027/" data-role="phrase-anchor" data-phrase-id="48027" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48027"></a><a data-anchor="/document/90/20882/dfaswg42st/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48028/" data-role="phrase-anchor" data-phrase-id="48028" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48028"></a><a data-anchor="/document/90/20882/dfasdn10ri/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48029/" data-role="phrase-anchor" data-phrase-id="48029" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48029"></a><a data-anchor="/document/90/20882/dfaskam6zh/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48030/" data-role="phrase-anchor" data-phrase-id="48030" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48030"></a><a data-anchor="/document/90/20882/dfas63ik42/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48031/" data-role="phrase-anchor" data-phrase-id="48031" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48031"></a><a data-anchor="/document/90/20882/dfastw2cr9/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48032/" data-role="phrase-anchor" data-phrase-id="48032" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48032"></a><a data-anchor="/document/90/20882/dfasxyuuyc/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48033/" data-role="phrase-anchor" data-phrase-id="48033" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48033"></a><a data-anchor="/document/90/20882/dfas2ozb7l/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48034/" data-role="phrase-anchor" data-phrase-id="48034" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48034"></a><a data-anchor="/document/90/20882/dfascz251p/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48035/" data-role="phrase-anchor" data-phrase-id="48035" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48035"></a><a data-anchor="/document/90/20882/dfaslbch15/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48036/" data-role="phrase-anchor" data-phrase-id="48036" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48036"></a><a data-anchor="/document/90/20882/dfasza7ipt/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48037/" data-role="phrase-anchor" data-phrase-id="48037" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48037"></a><a data-anchor="/document/90/20882/dfasxn9z8k/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 3%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48038/" data-role="phrase-anchor" data-phrase-id="48038" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48038"></a><a data-anchor="/document/90/20882/dfas5lryfe/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48039/" data-role="phrase-anchor" data-phrase-id="48039" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48039"></a><a data-anchor="/document/90/20882/dfastgzzvu/"></a><strong>Достоверность и полноту сведений, указанных на данной странице, подтверждаю:</strong></p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td style="width: 19%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48040/" data-role="phrase-anchor" data-phrase-id="48040" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48040"></a><a data-anchor="/document/90/20882/dfasmdcxb5/"></a>&#160;</td><td class="bdBottom" style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48041/" data-role="phrase-anchor" data-phrase-id="48041" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48041"></a><a data-anchor="/document/90/20882/dfashb1f4m/"></a>&#160;</td><td style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48042/" data-role="phrase-anchor" data-phrase-id="48042" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48042"></a><a data-anchor="/document/90/20882/dfasiae0e7/"></a>&#160;</td><td class="bdBottom" style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48043/" data-role="phrase-anchor" data-phrase-id="48043" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48043"></a><a data-anchor="/document/90/20882/dfasdb6ggl/"></a>&#160;</td><td style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48044/" data-role="phrase-anchor" data-phrase-id="48044" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48044"></a><a data-anchor="/document/90/20882/dfasu8lul4/"></a>&#160;</td></tr><tr><td style="width: 19%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48045/" data-role="phrase-anchor" data-phrase-id="48045" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48045"></a><a data-anchor="/document/90/20882/dfaslbtu8m/"></a>&#160;</td><td class="bdTop" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48046/" data-role="phrase-anchor" data-phrase-id="48046" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48046"></a><a data-anchor="/document/90/20882/dfasted886/"></a>(подпись)</p></td><td style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48047/" data-role="phrase-anchor" data-phrase-id="48047" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48047"></a><a data-anchor="/document/90/20882/dfasw2ppq8/"></a>&#160;</td><td class="bdTop" style="width: 20%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48048/" data-role="phrase-anchor" data-phrase-id="48048" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48048"></a><a data-anchor="/document/90/20882/dfas0dqf4u/"></a>(дата)</p></td><td style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48049/" data-role="phrase-anchor" data-phrase-id="48049" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48049"></a><a data-anchor="/document/90/20882/dfasshm5rz/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:right"><a data-anchor="/document/90/20882/bssPhr48050/" data-role="phrase-anchor" data-phrase-id="48050" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48050"></a><a data-role="toc" data-anchor="/document/90/20882/tit67/"></a><a data-anchor="/document/90/20882/dfass6g26u/"></a>ПРИЛОЖЕНИЕ № 6<br>&#160;к постановлению Кабинета Министров<br>от 14.08.2020 г. № 489</p><div class="doc__untyped" data-type="untyped" data-level="1"><a data-role="toc" data-anchor="/document/90/20882/tit905/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/20882/bssPhr48051/" data-role="phrase-anchor" data-phrase-id="48051" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48051"></a><a data-anchor="/document/90/20882/dfasu0alga/"></a>Положение&#160;<br>о формах уведомлений о контролируемых иностранных компаниях, порядке их заполнения и представления</span></div><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit906/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48052/" data-role="phrase-anchor" data-phrase-id="48052" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48052"></a><a data-anchor="/document/90/20882/dfas8u71vv/"></a>ГЛАВА 1. </span><span class="doc__chapter-name">ОБЩИЕ ПОЛОЖЕНИЯ</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48053/" data-role="phrase-anchor" data-phrase-id="48053" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48053"></a><a data-anchor="/document/90/20882/dfaskq0br1/"></a>1. Настоящее Положение определяет формы уведомлений о контролируемых налогоплательщиками - налоговыми резидентами Республики Узбекистан иностранных компаниях (далее - уведомление), порядок их заполнения и представления в налоговые органы.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48054/" data-role="phrase-anchor" data-phrase-id="48054" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48054"></a><a data-anchor="/document/90/20882/dfas0wdqir/"></a>2. Налоговый резидент Республики Узбекистан в порядке и сроки, установленные статьей 209 Налогового кодекса Республики Узбекистан (далее - Налоговый кодекс), уведомляет налоговый орган по месту своего учета в случае признания контролирующим лицом:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48055/" data-role="phrase-anchor" data-phrase-id="48055" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48055"></a><a data-anchor="/document/90/20882/dfasgz1l7r/"></a>иностранной компании по основаниям, предусмотренным в частях первой или пятой статьи 40 Налогового кодекса;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasscby35/"></a>иностранной структуры без образования юридического лица по основаниям, предусмотренным в частях девятой или двенадцатой статьи 40 Налогового кодекса.</li></ul><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit907/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48056/" data-role="phrase-anchor" data-phrase-id="48056" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48056"></a><a data-anchor="/document/90/20882/dfasvp1wti/"></a>ГЛАВА 2. </span><span class="doc__chapter-name">ФОРМЫ И СОСТАВ УВЕДОМЛЕНИЙ</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48057/" data-role="phrase-anchor" data-phrase-id="48057" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48057"></a><a data-anchor="/document/90/20882/dfaskig8d3/"></a>3. В соответствии с приложением № 1 к настоящему Положению форма Уведомления о контролируемых иностранных компаниях состоит из 10 листов и включает:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48058/" data-role="phrase-anchor" data-phrase-id="48058" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48058"></a><a data-anchor="/document/90/20882/dfasg5dy1p/"></a>1 лист (титульный лист);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasn2rsv1/"></a>2 лист (сведения о физическом лице);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfassb3qte/"></a>3 лист (сведения о контролируемых иностранных компаниях);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfaslgdshf/"></a>4 лист (основания признания налогоплательщика контролирующим лицом контролируемой иностранной компании);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasaef5ek/"></a>5 лист (сведения о контролируемых иностранных компаниях, являющихся иностранной структурой без образования юридического лица);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasgp6cax/"></a>6 лист (основания признания налогоплательщика контролирующим лицом контролируемой иностранной компании, являющейся иностранной структурой без образования юридического лица);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasdu5w0w/"></a>7 лист (сведения о финансовой отчетности контролируемой иностранной компании);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfascpfr1c/"></a>8 лист (порядок косвенного участия налогоплательщика в контролируемой иностранной компании);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasedhoui/"></a>9 лист (сведения о предприятии Узбекистана, косвенно участвующем в контролируемой иностранной компании);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasvu536b/"></a>10 лист (сведения об иностранном предприятии, посредством которого налогоплательщик косвенно участвует в контролируемой иностранной компании).</li></ul><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit908/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48059/" data-role="phrase-anchor" data-phrase-id="48059" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48059"></a><a data-anchor="/document/90/20882/dfas9o8uf0/"></a>ГЛАВА 3. </span><span class="doc__chapter-name">ОБЩИЕ ТРЕБОВАНИЯ&#160;К ЗАПОЛНЕНИЮ ФОРМ УВЕДОМЛЕНИЙ</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48060/" data-role="phrase-anchor" data-phrase-id="48060" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48060"></a><a data-anchor="/document/90/20882/dfasdhb3kb/"></a>4. Листы уведомления заполняются черными или синими чернилами либо посредством соответствующего программного обеспечения в одном экземпляре.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48061/" data-role="phrase-anchor" data-phrase-id="48061" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48061"></a><a data-anchor="/document/90/20882/dfastzy2yh/"></a>Заполняются только те листы, для заполнения которых есть основания.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48062/" data-role="phrase-anchor" data-phrase-id="48062" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48062"></a><a data-anchor="/document/90/20882/dfasgrlrgo/"></a>При заполнении уведомления не допускается исправление ошибок или изменение с использованием аналогичных средств, а при представлении в бумажной форме - двусторонняя печать и прошивка.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48063/" data-role="phrase-anchor" data-phrase-id="48063" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48063"></a><a data-anchor="/document/90/20882/dfaswgsg45/"></a>Листы уведомления нумеруются независимо от наличия или отсутствия заполненных разделов, а также количества, титульный лист не нумеруется, нумерация начинается со второго листа с цифры &#171;2&#187; и проставляется в указанном поле.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48064/" data-role="phrase-anchor" data-phrase-id="48064" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48064"></a><a data-anchor="/document/90/20882/dfasxsgh0n/"></a>5. В уведомлении каждому показателю, состоящему из определенных знаков, соответствует одно поле. В каждое поле проставляется только один показатель и в каждую клетку проставляется один знак.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48065/" data-role="phrase-anchor" data-phrase-id="48065" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48065"></a><a data-anchor="/document/90/20882/dfasw5g6ql/"></a>В порядке исключения для обозначения даты указаны три поля: день, месяц и год отделяются &#171;.&#187; (точкой). Например, 15.01.2023.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48066/" data-role="phrase-anchor" data-phrase-id="48066" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48066"></a><a data-anchor="/document/90/20882/dfas4y0poh/"></a>6. При заполнении полей уведомления текстовыми, цифровыми и кодовыми показателями используется заполнение слева направо, с использованием прописных или печатных букв.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48067/" data-role="phrase-anchor" data-phrase-id="48067" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48067"></a><a data-anchor="/document/90/20882/dfaste62m1/"></a>7. Все стоимостные показатели в уведомлении заполняются в сумах.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48068/" data-role="phrase-anchor" data-phrase-id="48068" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48068"></a><a data-anchor="/document/90/20882/dfaseutc2z/"></a>8. За исключением титульного листа уведомления, поле в нижней части листа &#171;Достоверность и полноту сведений, указанных на данной странице, подтверждаю&#187; заверяется подписью налогоплательщика или его представителя.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48069/" data-role="phrase-anchor" data-phrase-id="48069" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48069"></a><a data-anchor="/document/90/20882/dfasv255ew/"></a>9. При распечатывании формы уведомления на принтере посредством программного обеспечения используется шрифт &#171;Times New Roman&#187; кеглем 12-14.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48070/" data-role="phrase-anchor" data-phrase-id="48070" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48070"></a><a data-anchor="/document/90/20882/dfasviq3t8/"></a>10. При отсутствии показателя соответствующего поля уведомления по всей длине поля по центру проставляется знак &#171;-&#187; (черта).</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48071/" data-role="phrase-anchor" data-phrase-id="48071" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48071"></a><a data-anchor="/document/90/20882/dfas02tkzp/"></a>Если количество цифр дробной части числа больше количества цифр целой части числа, то пустые поля заполняются прочерком.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48072/" data-role="phrase-anchor" data-phrase-id="48072" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48072"></a><a data-anchor="/document/90/20882/dfasplfqn9/"></a>Например, если &#171;Доля участия&#187; налогоплательщика в иностранном юридическом лице или контролируемой иностранной компании составляет 53,87423 процента, то целая часть числа, состоящая из 3 клеток, дробная часть числа из 15 клеток заполняются в виде &#171;53-.87423----------&#187; с проставлением черты в свободные клетки.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48073/" data-role="phrase-anchor" data-phrase-id="48073" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48073"></a><a data-anchor="/document/90/20882/dfas50xv1y/"></a>11. При направлении уведомления, заполненного при помощи программного обеспечения и распечатанного на принтере, полей и черт для свободных мест может не быть. Расположение и размеры полей не должны изменяться.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48074/" data-role="phrase-anchor" data-phrase-id="48074" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48074"></a><a data-anchor="/document/90/20882/dfasrqihyh/"></a>12. Уведомления могут быть направлены налогоплательщиком в налоговый орган по месту налогового учета в бумажной форме или в электронной форме посредством телекоммуникационных каналов либо через персональный кабинет налогоплательщика.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit909/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48075/" data-role="phrase-anchor" data-phrase-id="48075" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48075"></a><a data-anchor="/document/90/20882/dfas897o88/"></a>ГЛАВА 4. </span><span class="doc__chapter-name">ПОРЯДОК ЗАПОЛНЕНИЯ&#160;ТИТУЛЬНОГО ЛИСТА УВЕДОМЛЕНИЯ</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48076/" data-role="phrase-anchor" data-phrase-id="48076" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48076"></a><a data-anchor="/document/90/20882/dfasp4droz/"></a>13. Поле &#171;ИНН&#187; в форме уведомления повторяется в верхней части каждой страницы и в нем указывается идентификационный номер налогоплательщика, представляющего уведомление.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48077/" data-role="phrase-anchor" data-phrase-id="48077" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48077"></a><a data-anchor="/document/90/20882/dfasy140z2/"></a>14. В поле &#171;Вид документа&#187;:</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48078/" data-role="phrase-anchor" data-phrase-id="48078" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48078"></a><a data-anchor="/document/90/20882/dfasr0ufpv/"></a>цифра &#171;1&#187; означает, что уведомление представляется первый раз за соответствующий отчетный период;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48079/" data-role="phrase-anchor" data-phrase-id="48079" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48079"></a><a data-anchor="/document/90/20882/dfas4fpd2o/"></a>цифра &#171;2&#187; и последующие цифры обозначают порядковые номера уточненных уведомлений за соответствующий отчетный период.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48080/" data-role="phrase-anchor" data-phrase-id="48080" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48080"></a><a data-anchor="/document/90/20882/dfasgbt1r1/"></a>15. В поле &#171;Отчетный период&#187; указывается порядковый номер месяца, за который представляется уведомление, а в поле &#171;Налоговый период&#187; указывается календарный год.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48081/" data-role="phrase-anchor" data-phrase-id="48081" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48081"></a><a data-anchor="/document/90/20882/dfasu0v9wm/"></a>16. В поле &#171;Сведения о налогоплательщике&#187; налогоплательщик указывает:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48082/" data-role="phrase-anchor" data-phrase-id="48082" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48082"></a><a data-anchor="/document/90/20882/dfas59847h/"></a>полное наименование юридического лица в соответствии с учредительными документами по юридическим лицам;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasnezxgg/"></a>по физическим лицам на основании документов, удостоверяющих личность, полностью записываются имя, фамилия и отчество (при наличии) физического лица. При этом сведения о физическом лице указываются на листе 2.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48083/" data-role="phrase-anchor" data-phrase-id="48083" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48083"></a><a data-anchor="/document/90/20882/dfas27upmx/"></a>17. В поле &#171;Местонахождение юридического лица&#187; указывается местонахождение юридического лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48084/" data-role="phrase-anchor" data-phrase-id="48084" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48084"></a><a data-anchor="/document/90/20882/dfas65yugg/"></a>18. В поле &#171;Почтовый адрес&#187; записывается почтовый адрес по месту нахождения юридического лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48085/" data-role="phrase-anchor" data-phrase-id="48085" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48085"></a><a data-anchor="/document/90/20882/dfas1g5hsi/"></a>19. В поле &#171;Адрес электронной почты&#187; указывается зарегистрированный в сети Интернет активный адрес электронной почты юридического лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48086/" data-role="phrase-anchor" data-phrase-id="48086" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48086"></a><a data-anchor="/document/90/20882/dfaspuhlik/"></a>20. В поле &#171;Телефон&#187; указываются контактные телефонные номера налогоплательщика или его представителя с кодом оператора.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48087/" data-role="phrase-anchor" data-phrase-id="48087" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48087"></a><a data-anchor="/document/90/20882/dfas0milxx/"></a>21. В поле &#171;Срок представления уведомления (день/месяц/год)&#187; заполняется дата представления уведомления в форме день, месяц, год.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48088/" data-role="phrase-anchor" data-phrase-id="48088" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48088"></a><a data-anchor="/document/90/20882/dfaswag1gm/"></a>22. В поле &#171;Представляется в __________________&#187; записывается полное наименование органа государственной налоговой службы, в который представляется уведомление.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48089/" data-role="phrase-anchor" data-phrase-id="48089" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48089"></a><a data-anchor="/document/90/20882/dfasfupxeb/"></a>23. В поле &#171;Настоящее уведомление составлено с ________ экземплярами документов на __ листах&#187; указываются формы заполненного уведомления, в поле &#171;Приложение на _____ листах&#187; указывается количество прилагаемых к уведомлению и подтверждающих документов.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48090/" data-role="phrase-anchor" data-phrase-id="48090" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48090"></a><a data-anchor="/document/90/20882/dfastrlh14/"></a>24. В свободном поле раздела &#171;Достоверность и полноту сведений, указанных в настоящем уведомлении, подтверждаю&#187; титульного листа указывается одна из цифр, соответствующая тому, кто представляет уведомление - &#171;1 - физическое лицо&#187;, &#171;2 - представитель физического лица&#187;, &#171;3 - руководитель предприятия&#187; и &#171;4 - представитель предприятия&#187;:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48091/" data-role="phrase-anchor" data-phrase-id="48091" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48091"></a><a data-anchor="/document/90/20882/dfasnebzml/"></a>если уведомление представляется юридическим лицом, указывается полностью фамилия, имя, отчество руководителя или представителя предприятия на основании документов, удостоверяющих личность, идентификационный номер налогоплательщика, номер телефона с кодом оператора, адрес электронной почты и заверяется личной подписью с указанием даты подписания;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas7hos9d/"></a>если уведомление представляется налогоплательщиком - физическим лицом, в том числе индивидуальным предпринимателем, адвокатом, нотариусом и другими лицами, которые в соответствии с актами законодательства Республики Узбекистан занимаются частной практикой, указывается полностью фамилия, имя, отчество на основании документов, удостоверяющих их личность, идентификационный номер налогоплательщика, номер телефона с кодом оператора, адрес электронной почты и заверяется личной подписью с указанием даты подписания. При представлении уведомления физическим лицом или представителем предприятия в поле &#171;Наименование и реквизиты документа, подтверждающего представительство налогоплательщика&#187; должны быть полностью указаны наименование и реквизиты документа, подтверждающего представительство, с приложением документа.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48092/" data-role="phrase-anchor" data-phrase-id="48092" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48092"></a><a data-anchor="/document/90/20882/dfas8v2ipu/"></a>Фамилия, имя, отчество руководителя или представителя предприятия либо физического лица или его представителя, представляющего уведомление, повторяется также на других листах и на них указывается фамилия, имя, отчество данного лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48093/" data-role="phrase-anchor" data-phrase-id="48093" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48093"></a><a data-anchor="/document/90/20882/dfasydwkmh/"></a>25. В поле &#171;Заполняется работником органа государственной налоговой службы&#187; способ представления уведомления, листы уведомления, количество прилагаемых и подтверждающих документов, дата сдачи и регистрационный номер заверяются именем, фамилией и отчеством (при наличии) и подписью работника налоговой службы, принявшего уведомление.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit910/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48094/" data-role="phrase-anchor" data-phrase-id="48094" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48094"></a><a data-anchor="/document/90/20882/dfasxgi2w5/"></a>ГЛАВА 5. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;СВЕДЕНИЯ О ФИЗИЧЕСКОМ ЛИЦЕ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48095/" data-role="phrase-anchor" data-phrase-id="48095" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48095"></a><a data-anchor="/document/90/20882/dfast3rpqg/"></a>26. Лист уведомления &#171;Сведения о физическом листе&#187; заполняется физическим лицом, не являющимся индивидуальным предпринимателем.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48096/" data-role="phrase-anchor" data-phrase-id="48096" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48096"></a><a data-anchor="/document/90/20882/dfasxnkipy/"></a>27. На основании документов, удостоверяющих личность физического лица, указываются сведения:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48097/" data-role="phrase-anchor" data-phrase-id="48097" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48097"></a><a data-anchor="/document/90/20882/dfascl53gr/"></a>в полях &#171;Фамилия&#187;, &#171;Имя&#187;, &#171;Отчество&#187; - фамилия, имя, отчество (при наличии) лица, представившего уведомление;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasgyw5ld/"></a>в поле &#171;Дата рождения&#187; - дата рождения (день, месяц, год);</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasyci2w3/"></a>в поле &#171;Место рождения&#187; - место рождения физического лица;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas2tbzb3/"></a>в поле &#171;Гражданство&#187; - цифра, соответствующая гражданству физического лица, - &#171;1 - гражданин Республики Узбекистан&#187;, &#171;2 - иностранный гражданин&#187; и &#171;3 - лицо без гражданства&#187;;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas1igg4y/"></a>в поле &#171;Код страны&#187; - страна гражданства физического лица;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas647b4f/"></a>в поле &#171;Сведения о документах, удостоверяющих личность&#187; указываются:</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasenrgnv/"></a>в поле &#171;Вид документа&#187; - цифра, соответствующая указанному виду документа;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasy8x5lp/"></a>в поле &#171;Серия&#187; - серия документа;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasfu7h2x/"></a>в поле &#171;Номер&#187; - номер документа;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasymmtpb/"></a>в поле &#171;Дата выдачи&#187; - дата выдачи;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasyid7ft/"></a>в поле &#171;Кем выдан&#187; - наименование органа, выдавшего документ, удостоверяющий личность.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48098/" data-role="phrase-anchor" data-phrase-id="48098" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48098"></a><a data-anchor="/document/90/20882/dfas72adhg/"></a>28. В поле &#171;Адрес места жительства&#187; должен указываться точный адрес места регистрации в качестве налогового резидента Республики Узбекистан по месту постоянной прописки.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48099/" data-role="phrase-anchor" data-phrase-id="48099" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48099"></a><a data-anchor="/document/90/20882/dfasrynp0e/"></a>29. В поле &#171;Телефон&#187; указывается номер контактного телефона с кодом оператора.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48100/" data-role="phrase-anchor" data-phrase-id="48100" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48100"></a><a data-anchor="/document/90/20882/dfasa6e2q4/"></a>30. В разделе &#171;Достоверность и полноту сведений, указанных в настоящем уведомлении, подтверждаю:&#187; указывается ИНН, имя, фамилия, отчество (при наличии) физического лица и заверяется личной подписью с указанием даты подписания.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48101/" data-role="phrase-anchor" data-phrase-id="48101" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48101"></a><a data-anchor="/document/90/20882/dfas4fsb3g/"></a>31. В поле &#171;Заполняется работником органа государственной налоговой службы&#187; способ представления уведомления, листы уведомления, количество прилагаемых и подтверждающих документов, дата сдачи и регистрационный номер заверяются именем, фамилией и отчеством (при наличии) и подписью работника налоговой службы, принявшего уведомление.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit911/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48102/" data-role="phrase-anchor" data-phrase-id="48102" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48102"></a><a data-anchor="/document/90/20882/dfas98c3b5/"></a>ГЛАВА 6. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА&#160;УВЕДОМЛЕНИЯ &#171;СВЕДЕНИЯ О КОНТРОЛИРУЕМЫХ&#160;ИНОСТРАННЫХ КОМПАНИЯХ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48103/" data-role="phrase-anchor" data-phrase-id="48103" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48103"></a><a data-anchor="/document/90/20882/dfas5uv1n0/"></a>32. Лист уведомления &#171;Сведения о контролируемых иностранных компаниях&#187; заполняется в случае когда налогоплательщик признается контролирующим лицом в отношении иностранного предприятия, являющегося контролируемой иностранной компанией.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48104/" data-role="phrase-anchor" data-phrase-id="48104" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48104"></a><a data-anchor="/document/90/20882/dfas09ulkf/"></a>Если налогоплательщик признается контролирующим лицом нескольких иностранных компаний, листы заполняются отдельно по каждой иностранной компании.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48105/" data-role="phrase-anchor" data-phrase-id="48105" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48105"></a><a data-anchor="/document/90/20882/dfascs5h68/"></a>33. В поле уведомления &#171;Порядковый номер контролируемой иностранной компании&#187; проставляется порядковый номер, самостоятельно присвоенный налогоплательщиком иностранной компании.</p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td style="width: 30%; word-wrap: break-word"><p><a data-anchor="/document/90/20882/bssPhr48106/" data-role="phrase-anchor" data-phrase-id="48106" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48106"></a><a data-anchor="/document/90/20882/dfaseuyrer/"></a>Например:</p></td><td class="bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48107/" data-role="phrase-anchor" data-phrase-id="48107" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48107"></a><a data-anchor="/document/90/20882/dfasid67td/"></a>&#160;</td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48108/" data-role="phrase-anchor" data-phrase-id="48108" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48108"></a><a data-anchor="/document/90/20882/dfas81we5g/"></a>И</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48109/" data-role="phrase-anchor" data-phrase-id="48109" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48109"></a><a data-anchor="/document/90/20882/dfasqyagp7/"></a>К</p></td><td class="bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48110/" data-role="phrase-anchor" data-phrase-id="48110" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48110"></a><a data-anchor="/document/90/20882/dfasglid8u/"></a>-</p></td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48111/" data-role="phrase-anchor" data-phrase-id="48111" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48111"></a><a data-anchor="/document/90/20882/dfasbhe1ay/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48112/" data-role="phrase-anchor" data-phrase-id="48112" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48112"></a><a data-anchor="/document/90/20882/dfas7sgd2u/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48113/" data-role="phrase-anchor" data-phrase-id="48113" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48113"></a><a data-anchor="/document/90/20882/dfast4p8ix/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48114/" data-role="phrase-anchor" data-phrase-id="48114" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48114"></a><a data-anchor="/document/90/20882/dfasg6lew1/"></a>0</p></td><td class="bdTop bdBottom" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48115/" data-role="phrase-anchor" data-phrase-id="48115" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48115"></a><a data-anchor="/document/90/20882/dfasz5ufzf/"></a>1</p></td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48116/" data-role="phrase-anchor" data-phrase-id="48116" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48116"></a><a data-anchor="/document/90/20882/dfasn0gi6v/"></a>.</p></td><td class="bdLeft" style="width: 16%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48117/" data-role="phrase-anchor" data-phrase-id="48117" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48117"></a><a data-anchor="/document/90/20882/dfasm99ept/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48118/" data-role="phrase-anchor" data-phrase-id="48118" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48118"></a><a data-anchor="/document/90/20882/dfas4mk796/"></a>При этом &#171;ИК&#187; по смыслу означает иностранную компанию.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48119/" data-role="phrase-anchor" data-phrase-id="48119" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48119"></a><a data-anchor="/document/90/20882/dfas14tgv7/"></a>Если налогоплательщик участвует в иностранной компании контролируемого иностранного предприятия и сведения о нем указаны в уведомлении об участии в иностранных юридических лицах (об учреждении иностранных структур без образования юридического лица) в соответствии с абзацем вторым части первой статьи 209 Налогового кодекса, каждой контролируемой иностранной компании присваивается соответствующий иностранному предприятию порядковый номер.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48120/" data-role="phrase-anchor" data-phrase-id="48120" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48120"></a><a data-anchor="/document/90/20882/dfasdn65fy/"></a>При смене контролируемой иностранной компанией статуса налогового резидента номер контролируемой иностранной компании сохраняется и повторно не присваивается.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48121/" data-role="phrase-anchor" data-phrase-id="48121" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48121"></a><a data-anchor="/document/90/20882/dfas6xnhat/"></a>При окончании (завершении) налогоплательщиком статуса контролирующего лица контролируемой иностранной компании данный номер другому предприятию повторно не присваивается.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48122/" data-role="phrase-anchor" data-phrase-id="48122" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48122"></a><a data-anchor="/document/90/20882/dfasdq7f6o/"></a>34. В поле уведомления &#171;Наименование иностранного предприятия&#187; в соответствии с правилами транслитерации латинским шрифтом записывается полное наименование иностранного предприятия.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48123/" data-role="phrase-anchor" data-phrase-id="48123" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48123"></a><a data-anchor="/document/90/20882/dfasw5prmu/"></a>35. В поле &#171;Код страны (территории) регистрации&#187; указывается трехзначный код страны (территории) регистрации данного иностранного предприятия в соответствии с международными стандартами ИСО 3166 &#171;Классификатор стран мира&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48124/" data-role="phrase-anchor" data-phrase-id="48124" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48124"></a><a data-anchor="/document/90/20882/dfas6cxnsr/"></a>36. В поле &#171;Дата регистрации иностранного предприятия&#187; записывается дата регистрации иностранного предприятия в его стране.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48125/" data-role="phrase-anchor" data-phrase-id="48125" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48125"></a><a data-anchor="/document/90/20882/dfas1shl3u/"></a>37. В поле &#171;Регистрационный(-ые) номер (номера) (при наличии) в стране регистрации (инкорпорации)&#187; указывается регистрационный(-ые) номер (номера) (при наличии) данного иностранного предприятия в стране (территории) регистрации (инкорпорации) или его аналог (аналоги).</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48126/" data-role="phrase-anchor" data-phrase-id="48126" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48126"></a><a data-anchor="/document/90/20882/dfasdihmg3/"></a>38. В поле &#171;Код налогоплательщика или его аналог (при наличии) в стране регистрации (инкорпорации)&#187; указывается код налогоплательщика в качестве налогоплательщика или его аналоги (при наличии) в стране (территории) регистрации (инкорпорации) данного иностранного предприятия.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48127/" data-role="phrase-anchor" data-phrase-id="48127" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48127"></a><a data-anchor="/document/90/20882/dfaskakdqw/"></a>39. В поле &#171;Код налогоплательщика или его аналог (при наличии) в стране (территории), где он является налоговым резидентом&#187; указывается код налогоплательщика в качестве налогоплательщика или его аналоги (при наличии) в стране (территории), где данное иностранное предприятие является налоговым резидентом.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48128/" data-role="phrase-anchor" data-phrase-id="48128" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48128"></a><a data-anchor="/document/90/20882/dfasba61hw/"></a>40. В поле &#171;Адрес в стране (территории) регистрации (инкорпорации) (при наличии)&#187; указывается адрес в стране (территории) регистрации (инкорпорации) иностранного предприятия (при наличии) латинским шрифтом.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit912/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48129/" data-role="phrase-anchor" data-phrase-id="48129" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48129"></a><a data-anchor="/document/90/20882/dfas71f4d3/"></a>ГЛАВА 7. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;ОСНОВАНИЯ ДЛЯ ПРИЗНАНИЯ НАЛОГОПЛАТЕЛЬЩИКА&#160;КОНТРОЛИРУЮЩИМ ЛИЦОМ КОНТРОЛИРУЕМОЙ&#160;ИНОСТРАННОЙ КОМПАНИИ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48130/" data-role="phrase-anchor" data-phrase-id="48130" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48130"></a><a data-anchor="/document/90/20882/dfasdc6qg4/"></a>41. Настоящий лист заполняется в случае указания налогоплательщиком на листе 3 уведомления сведений о контролируемой иностранной компании.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48131/" data-role="phrase-anchor" data-phrase-id="48131" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48131"></a><a data-anchor="/document/90/20882/dfas8wzpnz/"></a>42. В разделе &#171;Общие сведения&#187;:</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48132/" data-role="phrase-anchor" data-phrase-id="48132" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48132"></a><a data-anchor="/document/90/20882/dfaskwgyab/"></a>1) в поле &#171;Порядковый номер контролируемой иностранной компании&#187; указывается порядковый номер иностранной компании, указанный на листе 3 уведомления;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48133/" data-role="phrase-anchor" data-phrase-id="48133" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48133"></a><a data-anchor="/document/90/20882/dfaspbpg9i/"></a>2) в поле &#171;Основания для признания налогоплательщика контролирующим лицом контролируемой иностранной компании&#187; указывается соответствующий код оснований признания налогоплательщика контролирующим лицом иностранной компании в соответствии с приложением № 2 к настоящему Положению.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48134/" data-role="phrase-anchor" data-phrase-id="48134" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48134"></a><a data-anchor="/document/90/20882/dfasgtlren/"></a>При указании налогоплательщиком напротив соответствующего кода цифры &#171;1&#187; налогоплательщик имеет полномочия напротив кода соответствующего основания, не учитывая выполнение и/или невыполнение в отношениях, указать цифру &#171;0&#187; или &#171;2&#187;;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48135/" data-role="phrase-anchor" data-phrase-id="48135" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48135"></a><a data-anchor="/document/90/20882/dfas336dgb/"></a>3) в поле &#171;Самостоятельное признание контролирующим лицом иностранной компании&#187; указываются соответственно цифры &#171;0&#187; или &#171;1&#187;, цифра &#171;1&#187; - в случае самостоятельного признания налоговым резидентом Республики Узбекистан себя контролирующим лицом иностранной компании по основаниям, указанным в части первой или части пятой статьи 40 Налогового кодекса.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48136/" data-role="phrase-anchor" data-phrase-id="48136" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48136"></a><a data-anchor="/document/90/20882/dfasu5oatz/"></a>При самостоятельном признании контролирующим лицом иностранной компании поле &#171;Основания для признания налогоплательщика контролирующим лицом иностранной компании&#187; заполняется в соответствии с подпунктом 2 настоящего пункта.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48137/" data-role="phrase-anchor" data-phrase-id="48137" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48137"></a><a data-anchor="/document/90/20882/dfas80gmca/"></a>43. Раздел &#171;Сведения об участии в иностранном предприятии&#187; заполняется в случае участия в иностранном предприятии налогоплательщика, признанного контролирующим лицом иностранной компании:</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48138/" data-role="phrase-anchor" data-phrase-id="48138" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48138"></a><a data-anchor="/document/90/20882/dfas2qlehb/"></a>1) в поле &#171;Вид участия&#187; проставляется цифра &#171;0&#187; или &#171;1&#187;, соответствующая кодам видов участия в иностранном предприятии в соответствии с приложением № 3 к настоящему Положению, а в случае соответствия налогоплательщика нескольким основаниям - цифра &#171;1&#187; напротив соответствующего кода;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48139/" data-role="phrase-anchor" data-phrase-id="48139" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48139"></a><a data-anchor="/document/90/20882/dfaszkvx1t/"></a>2) код 205 в поле &#171;Вид участия&#187; заполняется только в случае указания в &#171;Основаниях для признания налогоплательщика контролирующим лицом контролируемой иностранной компании&#187; кода 102;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48140/" data-role="phrase-anchor" data-phrase-id="48140" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48140"></a><a data-anchor="/document/90/20882/dfasl5atw5/"></a>3) в поле &#171;Доля прямого участия, %&#187; указывается доля налогоплательщика в случаях, когда он является единственным прямым участником в иностранном предприятии, в том числе когда его единственное участие осуществляется смешанно (прямо и косвенно). Если налогоплательщик не является единственным прямым участником, проставляется &#171;0&#187;;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48141/" data-role="phrase-anchor" data-phrase-id="48141" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48141"></a><a data-anchor="/document/90/20882/dfasv7ad6d/"></a>4) в поле &#171;Доля косвенного участия, %&#187; указывается доля налогоплательщика в случаях, когда он является единственным косвенным участником в иностранном предприятии, в том числе когда его единственное участие осуществляется смешанно (прямо и косвенно). Если налогоплательщик не является единственным косвенным участником в иностранном предприятии, проставляется &#171;0&#187;;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48142/" data-role="phrase-anchor" data-phrase-id="48142" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48142"></a><a data-anchor="/document/90/20882/dfas4x3k3r/"></a>5) в поле &#171;Доля смешанного участия, %&#187; указывается размер общей доли единственного смешанного прямого и косвенного участия налогоплательщика в иностранном предприятии;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48143/" data-role="phrase-anchor" data-phrase-id="48143" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48143"></a><a data-anchor="/document/90/20882/dfasg4hgva/"></a>6) в поле &#171;Доля совместного участия вместе с супругом (супругой), родителями (усыновителями), родителями супруга (супруги), детьми (усыновленными детьми), братьями и сестрами с полным и неполным родством, а также опекунами (попечителями) и опекаемыми (подопечными), %&#187; указывается доля совместного участия налогоплательщика вместе с супругом (супругой), родителями (усыновителями), родителями супруга (супруги), детьми (усыновленными детьми), братьями и сестрами с полным и неполным родством, а также опекунами (попечителями) и опекаемыми (подопечными).</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48144/" data-role="phrase-anchor" data-phrase-id="48144" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48144"></a><a data-anchor="/document/90/20882/dfaseei7c2/"></a>Настоящее поле заполняется в случае выбора в поле &#171;Вид участия&#187; кода 204;</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48145/" data-role="phrase-anchor" data-phrase-id="48145" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48145"></a><a data-anchor="/document/90/20882/dfas6xvdg6/"></a>7) в поле &#171;Доля совместного участия с налоговым резидентом Республики Узбекистан, %&#187; указывается доля совместного участия в иностранном предприятии с резидентом Республики Узбекистан, не являющимся супругом (супругой), родителями (усыновителями), родителями супруга (супруги), детьми (усыновленными детьми), братьями и сестрами с полным и неполным родством, а также опекунами (попечителями) и опекаемыми (подопечными), данное поле заполняется при выборе в поле &#171;Вид участия&#187; кода 205.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48146/" data-role="phrase-anchor" data-phrase-id="48146" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48146"></a><a data-anchor="/document/90/20882/dfas8q1n05/"></a>44. Раздел &#171;Сведения о контроле иностранного предприятия&#187; заполняется в случае признания контролирующим лицом иностранной компании по основаниям, указанным в части пятой статьи 40 Налогового кодекса.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48147/" data-role="phrase-anchor" data-phrase-id="48147" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48147"></a><a data-anchor="/document/90/20882/dfasls6yg7/"></a>В поле &#171;Основания (наименование и реквизиты документов)&#187; указываются наименование, а также номер и дата документа признания налогоплательщика контролирующим лицом иностранной компании.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit913/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48148/" data-role="phrase-anchor" data-phrase-id="48148" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48148"></a><a data-anchor="/document/90/20882/dfas24x17w/"></a>ГЛАВА 8. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТОВ УВЕДОМЛЕНИЯ&#160;&#171;СВЕДЕНИЯ О КОНТРОЛИРУЕМЫХ ИНОСТРАННЫХ&#160;КОМПАНИЯХ, ЯВЛЯЮЩИХСЯ ИНОСТРАННОЙ&#160;СТРУКТУРОЙ БЕЗ ОБРАЗОВАНИЯ&#160;ЮРИДИЧЕСКОГО ЛИЦА&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48149/" data-role="phrase-anchor" data-phrase-id="48149" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48149"></a><a data-anchor="/document/90/20882/dfaskbpqp1/"></a>45. Лист уведомления &#171;Сведения о контролируемых иностранных компаниях, являющихся иностранной структурой без образования юридического лица&#187; заполняется в отношении контролируемой иностранной компании, являющейся иностранной структурой без образования юридического лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48150/" data-role="phrase-anchor" data-phrase-id="48150" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48150"></a><a data-anchor="/document/90/20882/dfaswgnelc/"></a>Если налогоплательщик признается контролирующим лицом нескольких контролируемых иностранных компаний, являющихся иностранной структурой без образования юридического лица, настоящий лист заполняется отдельно по каждой иностранной структуре.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48151/" data-role="phrase-anchor" data-phrase-id="48151" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48151"></a><a data-anchor="/document/90/20882/dfas8r8n5i/"></a>46. В поле &#171;Порядковый номер контролируемой иностранной компании&#187; проставляется порядковый номер, самостоятельно присвоенный налогоплательщиком иностранной структуре.</p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td style="width: 30%; word-wrap: break-word"><p><a data-anchor="/document/90/20882/bssPhr48152/" data-role="phrase-anchor" data-phrase-id="48152" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48152"></a><a data-anchor="/document/90/20882/dfas8qnaru/"></a>Например:</p></td><td class="bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48153/" data-role="phrase-anchor" data-phrase-id="48153" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48153"></a><a data-anchor="/document/90/20882/dfas11mdcr/"></a>&#160;</td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48154/" data-role="phrase-anchor" data-phrase-id="48154" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48154"></a><a data-anchor="/document/90/20882/dfas3tooy4/"></a>И</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48155/" data-role="phrase-anchor" data-phrase-id="48155" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48155"></a><a data-anchor="/document/90/20882/dfaslhp96p/"></a>С</p></td><td class="bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48156/" data-role="phrase-anchor" data-phrase-id="48156" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48156"></a><a data-anchor="/document/90/20882/dfasbark1q/"></a>-</p></td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48157/" data-role="phrase-anchor" data-phrase-id="48157" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48157"></a><a data-anchor="/document/90/20882/dfasi7vvrf/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48158/" data-role="phrase-anchor" data-phrase-id="48158" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48158"></a><a data-anchor="/document/90/20882/dfaseskl74/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48159/" data-role="phrase-anchor" data-phrase-id="48159" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48159"></a><a data-anchor="/document/90/20882/dfasz8h4eh/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48160/" data-role="phrase-anchor" data-phrase-id="48160" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48160"></a><a data-anchor="/document/90/20882/dfas4qnwv0/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/bssPhr48161/" data-role="phrase-anchor" data-phrase-id="48161" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48161"></a><a data-anchor="/document/90/20882/dfasuh0s57/"></a>1</p></td><td class="bdLeft" style="width: 21%; word-wrap: break-word"><a data-anchor="/document/90/20882/bssPhr48162/" data-role="phrase-anchor" data-phrase-id="48162" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48162"></a><a data-anchor="/document/90/20882/dfasg8hzsp/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48163/" data-role="phrase-anchor" data-phrase-id="48163" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48163"></a><a data-anchor="/document/90/20882/dfask4f9z6/"></a>При этом &#171;ИС&#187; по смыслу означает иностранную структуру.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48164/" data-role="phrase-anchor" data-phrase-id="48164" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48164"></a><a data-anchor="/document/90/20882/dfasgh501i/"></a>Если налогоплательщик участвует в контролируемой иностранной компании иностранного предприятия и сведения о нем указаны в уведомлении об участии в иностранных юридических лицах (об учреждении иностранных структур без образования юридического лица) в соответствии с абзацем вторым части первой статьи 209 Налогового кодекса, каждой контролируемой иностранной компании присваивается соответствующий иностранному предприятию порядковый номер.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48165/" data-role="phrase-anchor" data-phrase-id="48165" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48165"></a><a data-anchor="/document/90/20882/dfasleqhdv/"></a>При окончании (завершении) налогоплательщиком статуса контролирующего лица контролируемой иностранной компании данный номер другому предприятию повторно не присваивается.</p><p style="text-align:left"><a data-anchor="/document/90/20882/bssPhr48166/" data-role="phrase-anchor" data-phrase-id="48166" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48166"></a><a data-anchor="/document/90/20882/dfasgr56qh/"></a>47. В поле &#171;Форма (код) организационной структуры&#187; проставляется одна из нижеприведенных соответствующих цифр:</p><ul><li style="text-align: left;"><a data-anchor="/document/90/20882/bssPhr48167/" data-role="phrase-anchor" data-phrase-id="48167" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr48167"></a><a data-anchor="/document/90/20882/dfas3dn7s7/"></a>&#171;1&#187; - фонд;</li><li style="text-align: left;"><a data-anchor="/document/90/20882/dfask6u18w/"></a>&#171;2&#187; - партнерство;</li><li style="text-align: left;"><a data-anchor="/document/90/20882/dfasgn2ti9/"></a>&#171;3&#187; - товарищество;</li><li style="text-align: left;"><a data-anchor="/document/90/20882/dfas1u6wgt/"></a>&#171;4&#187; - траст;</li><li style="text-align: left;"><a data-anchor="/document/90/20882/dfasb8ooqq/"></a>&#171;5&#187; - коллективные инвестиции и (или) другие формы доверительного управления.</li></ul><span><span contenteditable="false" style="border-top:1px dashed #ff0000; color:#ffffff; display:block; font-size:0px; height:0px; left:0px; line-height:0px; margin:0px; padding:0px; position:absolute; right:0px; top:9946px; user-select:none; z-index:9999999"><span style="border-color:transparent; border-right-color:#ff0000; border-style:solid; border-width:8px 8px 8px 0; color:#ffffff; display:block; font-size:0px; height:0px; line-height:0px; margin:0px; padding:0px; position:absolute; right:0px; top:-8px; width:0px; z-index:9999999">&#160;</span><span style="border-color:transparent; border-left-color:#ff0000; border-style:solid; border-width:8px 0 8px 8px; color:#ffffff; display:block; font-size:0px; height:0px; left:0px; line-height:0px; margin:0px; padding:0px; position:absolute; top:-8px; width:0px; z-index:9999999">&#160;</span><span contenteditable="false" style="background:url(https://cdn.action-mcfr.ru/webarm/editor/plugins/magicline/images/icon.png?t=Q7V8) center no-repeat #ff0000; border-radius:2px; color:#ffffff; cursor:pointer; display:block; font-size:0px; height:17px; line-height:0px; margin:0px; padding:0px; position:absolute; right:17px; top:-8px; width:17px; z-index:9999999" title="Вставить здесь параграф"></span></span></span><partidstart>9</partidstart><p style="text-align:left"><a data-anchor="/document/90/20882/dfasbp3cz9/"></a>48. В поле &#171;Наименование иностранной структуры без образования юридического лица&#187; указывается наименование иностранной структуры без образования юридического лица латинским шрифтом. При отсутствии наименования приводится информация, позволяющая идентифицировать организационную форму иностранной структуры без образования юридического лица, в соответствии с законодательством иностранных государств и (или) учредительными документами.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasuy9eiu/"></a>49. В поле &#171;Наименование и реквизиты документа о создании иностранной структуры без образования юридического лица&#187; указываются наименование документа о создании иностранной структуры без образования юридического лица и его реквизиты (при наличии) на узбекском языке латинским шрифтом.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas8d9odb/"></a>50. В поле &#171;Дата создания (регистрации)&#187; указывается дата создания (регистрации) (в случае регистрации) иностранной структуры без образования юридического лица в зарубежном государстве.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasomy9g0/"></a>51. В поле &#171;Код страны создания (регистрации)&#187; указывается трехзначный код страны создания иностранной структуры в соответствии с международными стандартами ИСО 3166 &#171;Классификатор стран мира&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasdteor0/"></a>52. В поле &#171;Регистрационный (или другой идентификационный) номер в стране создания (регистрации) (при наличии)&#187; указывается номер, за которым создана (зарегистрирована) ) (в случае регистрации) иностранная структура в стране создания или другой идентификационный номер (при наличии).</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfaswggf45/"></a>53. Поле &#171;Другие сведения, идентифицирующие иностранную структуру без образования юридического лица&#187; заполняется при наличии других сведений, идентифицирующих иностранную структуру.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1357/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfasp6029e/"></a>ГЛАВА 9. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;ОСНОВАНИЯ ДЛЯ ПРИЗНАНИЯ НАЛОГОПЛАТЕЛЬЩИКА&#160;КОНТРОЛИРУЮЩИМ ЛИЦОМ КОНТРОЛИРУЕМОЙ&#160;ИНОСТРАННОЙ КОМПАНИИ, ЯВЛЯЮЩЕЙСЯ&#160;ИНОСТРАННОЙ СТРУКТУРОЙ БЕЗ ОБРАЗОВАНИЯ&#160;ЮРИДИЧЕСКОГО ЛИЦА&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfas31bcyg/"></a>54. Лист уведомления &#171;Основания для признания налогоплательщика контролирующим лицом контролируемой иностранной компании, являющейся иностранной структурой без образования юридического лица&#187; заполняется, если налогоплательщик на листе 5 данного уведомления указал себя контролирующим лицом контролируемой иностранной компании, являющейся иностранной структурой без образования юридического лица.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasibndge/"></a>55. В поле &#171;Порядковый номер контролируемой иностранной компании&#187; указывается порядковый номер контролируемой иностранной компании, указанный на листе 5 настоящего уведомления.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas4mtdzq/"></a>56. В поле &#171;Основания для признания налогоплательщика контролирующим лицом контролируемой иностранной компании&#187; указывается соответствующий код оснований признания налогоплательщика контролирующим лицом иностранной компании в соответствии с приложением № 2 к настоящему Положению.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasvv0e3t/"></a>При указании налогоплательщиком напротив соответствующего кода цифры &#171;1&#187; налогоплательщик имеет полномочия напротив кода соответствующего основания, не учитывая выполнение и/или невыполнение в отношениях, указать цифру &#171;0&#187; или &#171;2&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfaseh27nf/"></a>57. В поле &#171;Самостоятельное признание контролирующим лицом иностранной структуры без образования юридического лица&#187; указываются цифры &#171;0&#187; или &#171;1&#187;, цифра &#171;1&#187; - в случае самостоятельного признания налоговым резидентом Республики Узбекистан себя контролирующим лицом иностранной структуры без образования юридического лица в соответствии с частью тринадцатой статьи 40 Налогового кодекса.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasqg6ekv/"></a>При самостоятельном признании налогоплательщиком себя контролирующим лицом иностранного предприятия поле &#171;Основания для признания налогоплательщика контролирующим лицом контролируемой иностранной компании&#187; заполняется в порядке, указанном в пункте 71 настоящего Положения.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasykenad/"></a>58. В поле &#171;Наименование и реквизиты документов, подтверждающих выполнение оснований признания контролирующим лицом иностранной структуры без образования юридического лица&#187; указываются наименование, а также номер и дата документа (документов), подтверждающего выполнение оснований для признания налогоплательщика контролирующим лицом иностранной структуры без образования юридического лица.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1358/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfasd8o7e0/"></a>ГЛАВА 10. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;СВЕДЕНИЯ О ФИНАНСОВОЙ ОТЧЕТНОСТИ&#160;КОНТРОЛИРУЕМОЙ ИНОСТРАННОЙ КОМПАНИИ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfasln4t9g/"></a>59. Лист уведомления &#171;Сведения о финансовой отчетности контролируемой иностранной компании&#187; заполняется в отношении финансовой отчетности контролируемых иностранных компаний, указанных на листах 3 и 5 данного уведомления.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasu6roh4/"></a>60. В поле &#171;Порядковый номер контролируемой иностранной компании&#187; указываются порядковые номера контролируемых иностранных компаний, указанных на листах 3 и 5 данного уведомления.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas7ntxuf/"></a>61. В поле &#171;Определение прибыли контролируемой иностранной компании&#187; указывается:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/dfasywvoa9/"></a>цифра &#171;1&#187; при определении прибыли контролируемой иностранной компании на основании пункта 1 части первой статьи 331 Налогового кодекса;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfaselb8ry/"></a>цифра &#171;2&#187; при определении на основании пункта 2 части первой статьи 331 Налогового кодекса.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/dfasq0hu4b/"></a>62. В поле &#171;Последний день периода составления финансовой отчетности&#187; указывается дата окончания периода составления налоговой отчетности контролируемой иностранной компании за финансовый год.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasn4hvga/"></a>63. В поле &#171;Дата составления финансовой отчетности за финансовый год&#187; указывается дата составления контролируемой иностранной компанией финансовой отчетности.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasp7hvm9/"></a>64. В поле &#171;Последняя дата периода определения прибыли контролируемой иностранной компании&#187; указывается последняя дата определения прибыли контролируемой иностранной компании в соответствии с пунктом 2 части первой статьи 331 Налогового кодекса.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasq6aoy8/"></a>65. В поле &#171;Дата составления аудиторского заключения&#187; указывается дата составления аудиторского заключения по финансовой отчетности, если во внутренних правилах или учредительных (корпоративных) документах контролируемой иностранной компании установлено проведение в обязательном порядке в финансовом году аудиторской проверки по финансовой отчетности или если аудиторская проверка проведена в добровольном порядке.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas676b3m/"></a>66. В поле &#171;Основания для освобождения прибыли контролируемой иностранной компании от налогообложения&#187; в соответствующие коды оснований для освобождения прибыли контролируемой иностранной компании от налогообложения, указанные в приложении № 4 к настоящему Положению, проставляется цифра &#171;0&#187; или &#171;1&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfastqs3fi/"></a>Если несколько оснований соответствуют освобождению прибыли контролируемой иностранной компании от налогообложения, напротив них проставляется цифра &#171;1&#187;.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1359/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfasvl8z4v/"></a>ГЛАВА 11. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;ПОРЯДОК КОСВЕННОГО УЧАСТИЯ НАЛОГОПЛАТЕЛЬЩИКА&#160;В КОНТРОЛИРУЕМОЙ ИНОСТРАННОЙ КОМПАНИИ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfasagzqwe/"></a>67. Лист уведомления &#171;Порядок косвенного участия налогоплательщика в контролируемой иностранной компании&#187; заполняется при участии в иностранном предприятии самого налогоплательщика (без участия являющихся налоговыми резидентами супруга (супруги), родителей (усыновителей), родителей супруга (супруги), детей (усыновленных детей), братьев и сестер с полным и неполным родством, а также опекунов (попечителей) и опекаемых (подопечных)).</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasph0ooe/"></a>Если налогоплательщик косвенно участвует в нескольких контролируемых компаниях, по каждому иностранному предприятию и контролируемой компании данные листы заполняются отдельно.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasiykvpz/"></a>68. В разделе &#171;Сведения о косвенном участии налогоплательщика в контролируемой иностранной компании&#187; указывается следующее:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/dfaso0hf7u/"></a>в поле &#171;Порядковый номер контролируемой иностранной компании&#187; указывается порядковый номер, самостоятельно присвоенный налогоплательщиком контролируемой иностранной компании;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas2a52ra/"></a>в поле &#171;Наименование контролируемой иностранной компании&#187; латинским шрифтом указывается полное наименование контролируемой иностранной компании на узбекском языке;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfaszaqbxm/"></a>в поле &#171;Доля косвенного участия - всего, %&#187; указывается приведенная в разделе &#171;Сведения о косвенном участии налогоплательщика в контролируемой иностранной компании&#187;, выраженная в процентах сумма доли участия налогоплательщика в данной контролируемой иностранной компании по всей последовательности.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/dfasw16pex/"></a>69. В разделе &#171;Порядок косвенного участия&#187; указываются следующие сведения о последовательности участия налогоплательщика в контролируемой иностранной компании:</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasthdlcs/"></a>1) в поле &#171;Последовательность участия&#187; указывается порядковый номер последовательности косвенного участия налогоплательщика в указанной в разделе уведомления &#171;Сведения о косвенном участии налогоплательщика в контролируемой иностранной компании&#187; контролируемой иностранной компании и в иностранном (Республики Узбекистан) предприятии. Указанный номер присваивается налогоплательщиком самостоятельно;</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasz5zytu/"></a>2) в поле &#171;Доля последовательного косвенного участия - всего, %&#187; указывается процент доли косвенного участия налогоплательщика в контролируемой иностранной компании, указанной в разделе &#171;Сведения о косвенном участии налогоплательщика в контролируемой иностранной компании&#187; по данной последовательности относительно последнего участника.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas9yhiar/"></a>70. В поле &#171;Сведения о последовательных участниках&#187; указывается последовательность всех участников, приведенных в поле &#171;Последовательность участия&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasrce7b0/"></a>В первую очередь указывается иностранное предприятие (Узбекистан) или контролируемая иностранная компания, в которых налогоплательщик имеет прямую долю, в том числе указывается иностранная структура без образования юридического лица, использованная при участии в контролируемой налогоплательщиком иностранной компании.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas8fsxse/"></a>Последней указывается контролируемая иностранная компания, в которой налогоплательщик косвенно участвует, указанная в разделе &#171;Сведения о косвенном участии в контролируемой иностранной компании&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasr16doe/"></a>В поле &#171;Порядковый номер участника&#187; указываются порядковые номера контролируемой иностранной компании на основании листа 3 уведомления, контролируемой иностранной компании, являющейся иностранной структурой без образования юридического лица, на основании листа 5, предприятия Узбекистана, косвенно участвующего в контролируемой иностранной компании, на основании листа 9 и иностранного предприятия, в контролируемой иностранной компании которого косвенно участвует налогоплательщик, на основании листа 10.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasy5e2xx/"></a>В поле &#171;Доля прямого участия, %&#187;:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/dfasz6u9e2/"></a>указывается процент доли прямого участия налогоплательщика в последующем иностранном предприятии (Узбекистан) и (или) иностранной структуре без образования юридического лица или контролируемой иностранной компании относительно первого участника последовательности;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfas3wywyb/"></a>указывается процент доли прямого участия предыдущего участника в иностранном предприятии (Узбекистан) и (или) иностранной структуре без образования юридического лица или контролируемой иностранной компании относительно каждого очередного последующего участника последовательности.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/dfasscygi6/"></a>В поле &#171;Доля косвенного участия, %&#187;:</p><ul><li style="text-align:left"><a data-anchor="/document/90/20882/dfasywrze3/"></a>на первого участника поле не заполняется;</li><li style="text-align:left"><a data-anchor="/document/90/20882/dfasusywrh/"></a>указывается процент доли косвенного участия налогоплательщика в иностранном предприятии (Узбекистан), и (или) иностранной структуре без образования юридического лица, и контролируемой иностранной компании относительно каждого очередного последующего участника последовательности.</li></ul><p style="text-align:left"><a data-anchor="/document/90/20882/dfas6zhwaz/"></a>71. Если налогоплательщик косвенно участвует в контролируемой иностранной компании по нескольким последовательностям, данный лист заполняется отдельно для каждой последовательности.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1360/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfasilfvik/"></a>ГЛАВА 12. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;СВЕДЕНИЯ О ПРЕДПРИЯТИЯХ УЗБЕКИСТАНА,&#160;КОСВЕННО УЧАСТВУЮЩИХ В КОНТРОЛИРУЕМОЙ&#160;ИНОСТРАННОЙ КОМПАНИИ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfass8hhmh/"></a>72. Лист уведомления &#171;Сведения о предприятиях Узбекистана, косвенно участвующих в контролируемой иностранной компании&#187; заполняется при осуществлении налогоплательщиком косвенного участия в контролируемой иностранной компании через предприятия Республики Узбекистан.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas9ftifd/"></a>Если налогоплательщик косвенно участвует в контролируемой иностранной компании через несколько предприятий Республики Узбекистан, данный лист заполняется отдельно по каждому предприятию Республики Узбекистан.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasbxwyas/"></a>73. В поле &#171;Порядковый номер предприятия Республики Узбекистан&#187; проставляется порядковый номер, самостоятельно присвоенный налогоплательщиком предприятию Узбекистана.</p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdRight" style="width: 28%; word-wrap: break-word"><p><a data-anchor="/document/90/20882/dfasxgd3xu/"></a>Например:</p></td><td class="bdAll" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas4mg74g/"></a>U</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas8nd2sa/"></a>Z</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasqemopb/"></a>B</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfashqdm3u/"></a>-</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasl8h2c5/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasqufiqq/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasupbygp/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasy9bt9a/"></a>0</p></td><td class="bdTop bdBottom" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasivvt45/"></a>1</p></td><td class="bdAll" style="width: 6%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasgu6hds/"></a>.</p></td><td class="bdLeft" style="width: 12%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasxougth/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfas1ok0l6/"></a>Если налогоплательщик участвует в контролируемой иностранной компании через несколько предприятий Узбекистана, указанных в уведомлении об участии в иностранных юридических лицах (об учреждении иностранных структур без образования юридического лица) в соответствии с абзацем вторым части первой статьи 209 Налогового кодекса, каждому из них соответственно присваивается отдельный порядковый номер. Присвоенный порядковый номер в период участия не изменяется.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfast7yaux/"></a>При завершении участия этот номер другому предприятию Узбекистана повторно не присваивается.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas2f1i71/"></a>74. В поле &#171;Основной номер государственной регистрации предприятия&#187; указывается номер государственной регистрации предприятия Узбекистана.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas4a2zxg/"></a>75. В поле &#171;ИНН&#187; соответственно проставляется идентификационный номер налогоплательщика в органе государственной налоговой службы, где зарегистрирован налогоплательщик.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas8ylpuy/"></a>76. В поле &#171;Полное наименование&#187; записывается полное наименование предприятия Узбекистана в соответствии с учредительными документами.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1361/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfashurr8i/"></a>ГЛАВА 13. </span><span class="doc__chapter-name">ЗАПОЛНЕНИЕ ЛИСТА УВЕДОМЛЕНИЯ&#160;&#171;СВЕДЕНИЯ ОБ ИНОСТРАННОМ ПРЕДПРИЯТИИ,&#160;ЧЕРЕЗ КОТОРОЕ НАЛОГОПЛАТЕЛЬЩИК&#160;КОСВЕННО УЧАСТВУЕТ В КОНТРОЛИРУЕМОЙ&#160;ИНОСТРАННОЙ КОМПАНИИ&#187;</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfaswgm196/"></a>77. Лист уведомления &#171;Сведения об иностранном предприятии, через которое налогоплательщик косвенно участвует в контролируемой иностранной компании&#187; налогоплательщик заполняет в отношении иностранного предприятия, через которое осуществляет косвенное участие в контролируемой иностранной компании. При этом налогоплательщик не рассматривается в качестве прямого контролирующего лица в контролируемой иностранной компании.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasn5i5uq/"></a>Если налогоплательщик осуществляет свое участие через несколько иностранных предприятий, данный лист заполняется отдельно по каждому иностранному предприятию.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfas43aebp/"></a>78. В поле уведомления &#171;Порядковый номер иностранного предприятия&#187; проставляется порядковый номер, самостоятельно присвоенный налогоплательщиком иностранному предприятию.</p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td style="width: 30%; word-wrap: break-word"><p><a data-anchor="/document/90/20882/dfasa3gdno/"></a>Например:</p></td><td class="bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasehn4vz/"></a>&#160;</td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfaserika0/"></a>И</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasw8hq07/"></a>П</p></td><td class="bdRight bdLeft" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas8ivczt/"></a>-</p></td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas311v87/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas6197un/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas24lum7/"></a>0</p></td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasxn3mw4/"></a>0</p></td><td class="bdTop bdBottom" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfas8r3wqc/"></a>1</p></td><td class="bdAll" style="width: 5%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasy43nhi/"></a>.</p></td><td class="bdLeft" style="width: 16%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasgcc1hr/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfassu53up/"></a>При этом &#171;ИП&#187; по смыслу означает иностранная компания.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasgwavif/"></a>Если налогоплательщик участвует в контролируемой иностранной компании через иностранные предприятия, указанные в уведомлении об участии в иностранных юридических лицах (об учреждении иностранных структур без образования юридического лица), представленном в соответствии с абзацем вторым части первой статьи 209 Налогового кодекса, каждому из них соответственно присваивается отдельный порядковый номер.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfaswhk5pg/"></a>При завершении участия налогоплательщика в иностранном предприятии этот номер другому предприятию повторно не присваивается.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasah157x/"></a>79. В поле &#171;Наименование иностранного предприятия&#187; в соответствии с правилами транслитерации латинским шрифтом записывается полное наименование иностранного предприятия.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfaseqderi/"></a>80. В поле &#171;Код страны регистрации (инкорпорации)&#187; указывается трехзначный код страны регистрации (инкорпорации) иностранного предприятия в соответствии с международными стандартами ИСО 3166 &#171;Классификатор стран мира&#187;.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasa7sqf1/"></a>81. В поле &#171;Регистрационный номер в стране регистрации (инкорпорации) (при наличии)&#187; указывается номер регистрации (инкорпорации) (при наличии) в стране (территории) регистрации (инкорпорации) иностранного предприятия.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasvbdd4f/"></a>82. В поле &#171;Код налогоплательщика (при наличии) в стране регистрации (инкорпорации)&#187; указываются код регистрации в качестве налогоплательщика или его аналоги (при наличии) в стране (территории) регистрации (инкорпорации) иностранного предприятия.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasgs18eo/"></a>83. В поле &#171;Адрес в стране регистрации (инкорпорации) (при наличии)&#187; указывается полный юридический адрес (при наличии) в стране (территории) регистрации (инкорпорации) иностранного предприятия латинским шрифтом.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/20882/tit1362/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/20882/dfasoz7urd/"></a>ГЛАВА 14. </span><span class="doc__chapter-name">ЗАКЛЮЧИТЕЛЬНЫЕ ПОЛОЖЕНИЯ</span></div><p style="text-align:left"><a data-anchor="/document/90/20882/dfas3do6fl/"></a>84. Лица, виновные в нарушении требований настоящего Положения, несут ответственность в порядке, предусмотренном актами законодательства.</p><p style="text-align:left"><a data-anchor="/document/90/20882/dfasn2svqb/"></a>85. Контроль за соблюдением требований настоящего Положения осуществляется органами государственной налоговой службы.</p><p style="text-align:right"><a data-role="toc" data-anchor="/document/90/20882/tit82/"></a><a data-anchor="/document/90/20882/dfasqfomls/"></a>ПРИЛОЖЕНИЕ № 1&#160;<br>к Положению</p><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdRight" style="width: 18%; word-wrap: break-word"><p style="text-align:left"><a data-anchor="/document/90/20882/dfassg36e6/"></a>ИНН</p></td><td class="bdAll" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasmdpup3/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfas5gxsaf/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasmkx5xp/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfastfb4n7/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfas6n7lle/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfas9fbk88/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfas117zyl/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 5%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasxm181a/"></a>&#160;</td><td class="bdTop bdBottom bdRight" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasrsusog/"></a>&#160;</td><td class="bdLeft" style="width: 41%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfaslckld8/"></a>&#160;</td></tr></tbody></table></div></div></div></div><div align="center"><div class="table-wide"><div><div><table style="width: 100%" width="100%"><tbody><tr><td class="bdRight" style="width: 17%; word-wrap: break-word"><p style="text-align:left"><a data-anchor="/document/90/20882/dfasld77p0/"></a>Вид документа</p></td><td class="bdAll" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasgvrg9u/"></a>&#160;</td><td class="bdRight bdLeft" style="width: 4%; word-wrap: break-word"><p style="text-align:center"><a data-anchor="/document/90/20882/dfasz0qqkr/"></a>/</p></td><td class="bdAll" style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasopprui/"></a>&#160;</td><td class="bdLeft" style="width: 20%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasy9n8mz/"></a>&#160;</td><td style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfas28v0dr/"></a>&#160;</td><td style="width: 4%; word-wrap: break-word"><a data-anchor="/document/90/20882/dfasa8shkk/"></a>&#160;</td><td style="w