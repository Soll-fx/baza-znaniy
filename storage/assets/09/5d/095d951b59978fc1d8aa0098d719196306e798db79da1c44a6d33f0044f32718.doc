sPhr94/"></a><a data-anchor="/document/16/203029/dfasuwmp91/" data-dfa="dfasuwmp91"></a><a data-anchor="/document/16/203029/dfaszi1o3x/" data-dfa="dfaszi1o3x"></a><a data-anchor="/document/16/203029/dfasbzc6uz/" data-dfa="dfasbzc6uz"></a><a data-anchor="/document/16/203029/dfas7p4bn7/" data-dfa="dfas7p4bn7"></a><a data-anchor="/document/16/203029/dfasxzcfr4/" data-dfa="dfasxzcfr4"></a><a data-anchor="/document/16/203029/dfas337l6c/" data-dfa="dfas337l6c"></a><a data-anchor="/document/16/203029/dfas5aizyx/" data-dfa="dfas5aizyx"></a><a data-anchor="/document/16/203029/dfasqsndwa/" data-dfa="dfasqsndwa"></a><a data-anchor="/document/16/203029/dfasxerhvc/" data-dfa="dfasxerhvc"></a>&nbsp;</p></td><td colspan="2" align="center" class="bdTopbdLeft"><p align="center"><a data-anchor="/document/16/203029/bssPhr95/"></a><a data-anchor="/document/16/203029/dfas5yg06p/" data-dfa="dfas5yg06p"></a>&nbsp;</p></td><td class="bdBottom"><p><a data-anchor="/document/16/203029/bssPhr96/"></a><a data-anchor="/document/16/203029/dfasirobk5/" data-dfa="dfasirobk5"></a><a data-anchor="/document/16/203029/dfas6y0w34/" data-dfa="dfas6y0w34"></a>&nbsp;</p></td><td align="center" class="bdRightbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr97/"></a><a data-anchor="/document/16/203029/dfasb4w3q6/" data-dfa="dfasb4w3q6"></a>&nbsp;</p></td><td align="center" class="bdLeftbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr98/"></a><a data-anchor="/document/16/203029/dfasoang51/" data-dfa="dfasoang51"></a>&nbsp;</p></td><td colspan="2" align="center" class="bdRight"><p align="center"><a data-anchor="/document/16/203029/bssPhr99/"></a><a data-anchor="/document/16/203029/dfas4s7xhx/" data-dfa="dfas4s7xhx"></a>&nbsp;</p></td><td colspan="2" align="center" class="bdLeft"><p align="center"><a data-anchor="/document/16/203029/bssPhr100/"></a><a data-anchor="/document/16/203029/dfasygpqda/" data-dfa="dfasygpqda"></a>&nbsp;</p></td><td colspan="3" align="center" class="bdRightbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr101/"></a><a data-anchor="/document/16/203029/dfas1bqxeq/" data-dfa="dfas1bqxeq"></a>&nbsp;</p></td><td colspan="2" align="center" class="bdLeft"><p align="center"><a data-anchor="/document/16/203029/bssPhr102/"></a><a data-anchor="/document/16/203029/dfasro81hf/" data-dfa="dfasro81hf"></a>&nbsp;</p></td><td colspan="2" align="center" class="bdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr103/"></a><a data-anchor="/document/16/203029/dfas6ts3bs/" data-dfa="dfas6ts3bs"></a>&nbsp;</p></td><td colspan="3" align="center" class="bdTopbdRightbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr104/"></a><a data-anchor="/document/16/203029/dfas63degz/" data-dfa="dfas63degz"></a>&nbsp;</p></td><td align="center" class="bdLeftbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr105/"></a><a data-anchor="/document/16/203029/dfasgqd02x/" data-dfa="dfasgqd02x"></a>&nbsp;</p></td><td><p><a data-anchor="/document/16/203029/bssPhr106/"></a><a data-anchor="/document/16/203029/dfas7hlw27/" data-dfa="dfas7hlw27"></a>&nbsp;</p></td></tr><tr align="center"><td colspan="2" class="bdAll"><p align="center"><a data-anchor="/document/16/203029/bssPhr107/"></a><a data-anchor="/document/16/203029/dfas08cc17/" data-dfa="dfas08cc17"></a><a data-anchor="/document/16/203029/dfasnfeqlu/" data-dfa="dfasnfeqlu"></a><a data-anchor="/document/16/203029/dfasip5qdp/" data-dfa="dfasip5qdp"></a><a data-anchor="/document/16/203029/dfaspm4tgz/" data-dfa="dfaspm4tgz"></a><a data-anchor="/document/16/203029/dfaszrgmg8/" data-dfa="dfaszrgmg8"></a><a data-anchor="/document/16/203029/dfasxexs8z/" data-dfa="dfasxexs8z"></a><a data-anchor="/document/16/203029/dfasg11yfc/" data-dfa="dfasg11yfc"></a><a data-anchor="/document/16/203029/dfas5t8gcg/" data-dfa="dfas5t8gcg"></a><a data-anchor="/document/16/203029/dfasv4b9zn/" data-dfa="dfasv4b9zn"></a><a data-anchor="/document/16/203029/dfas6g64tg/" data-dfa="dfas6g64tg"></a>Материальные расходы</p><p align="center"><a data-anchor="/document/16/203029/bssPhr108/"></a><a data-anchor="/document/16/203029/dfas2bmik2/" data-dfa="dfas2bmik2"></a>(<a data-anchor="/document/16/203029/backlinkanchor25/" type="backlink-anchor"></a><a href="#/document/90/20918/dfaszgkgp3/" class="link npd" title="К материальным расходам относятся..." moduleId="90" documentId="20918" anchor="dfaszgkgp3">ст. 142</a> НК)</p></td><td valign="top" class="bdLeftbdRight"><p align="center"><a data-anchor="/document/16/203029/bssPhr109/"></a><a data-anchor="/document/16/203029/dfasdnuoul/" data-dfa="dfasdnuoul"></a>&nbsp;</p></td><td colspan="3" class="bdLeftbdRightbdBottom"><p align="center"><a data-anchor="/document/16/203029/bssPhr110/"></a><a data-anchor="/document/16/203029/dfasful3p6/" data-dfa="dfasful3p6"></a><a data-anchor="/document/16/203029/dfasmvw0d5/" data-dfa="dfasmvw0d5"></a>Расходы на оплату труда (<a data-anchor="/document/16/203029/backlinkanchor27/" type="backlink-anchor"></a><a href="#/document/90/20918/dfasyqopio/" class="link npd" title="К расходам на оплату труда относятся..." moduleId="90" documentId="20918" anchor="dfasyqopio">ст. 143</a> НК)</p></td><td valign="top" class="bdLeftbdRight"><p align="center"><a data-anchor="/document/16/203029/bssPhr111/"></a><a data-anchor="/document/16/203029/dfas0ek4mo/" data-dfa="dfas0ek4mo"></a>&nbsp;</p></td><td colspan="2" class="bdAll"><p align="center"><a data-anchor="/document/16/203029/bssPhr112/"></a><a data-anchor="/document/16/203029/dfas1zr6yt/" data-dfa="dfas1zr6yt"></a><a data-anchor="/document/16/203029/dfasnugkuh/" data-dfa="dfasnugkuh"></a>Расходы на амортизацию</p><p align="center"><a data-anchor="/document/16/203029/bssPhr113/"></a><a data-anchor="/document/16/203029/dfas8hng0m/" data-dfa="dfas8hng0m"></a>(<a data-anchor="/document/16/203029/backlinkanchor29/" type="backlink-anchor"></a><a href="#/document/90/20918/dfas1ltmff/" class="link npd" title="Амортизируемым имуществом в целях применения настоящей статьи признаются основные средства и нематериальные активы, учитываемые налогоплательщиком в соответствии с законодательством..." moduleId="90" documentId="20918" anchor="dfas1ltmff">ст. 144</a> НК)</p></td><td valign="top" class="bdLeftbdRight"><p align="center"><a data-anchor="/document/16/203029/bssPhr114/"></a><a data-anchor="/document/16/203029/dfas0vkuim/" data-dfa="dfas0vkuim"></a>&nbsp;</p></td><td colspan="4" class="bdAll"><p align="center"><a data-anchor="/document/16/203029/bssPhr115/"></a><a data-anchor="/document/16/203029/dfasivwdsy/" data-dfa="dfasivwdsy"></a><a data-anchor="/document/16/203029/dfasu19qp1/" data-dfa="dfasu19qp1"></a>Прочие доходы</p><p align="center"><a data-anchor="/document/16/203029/bssPhr116/"></a><a data-anchor="/document/16/203029/dfasrq03n1/" data-dfa="dfasrq03n1"></a>(<a data-anchor="/document/16/203029/backlinkanchor31/" type="backlink-anchor"></a><a href="#/document/90/20918/dfaspcldrs/" class="link npd" title="К прочим расходам относятся..." moduleId="90" documentId="20918" anchor="dfaspcldrs">ст. 145</a> НК)</p></td><td valign="top" class="bdLeftbdRight"><p align="center"><a data-anchor="/document/16/203029/bssPhr117/"></a><a data-anchor="/document/16/203029/dfas8c1zw1/" data-dfa="dfas8c1zw1"></a>&nbsp;</p></td><td colspan="6" class="bdAll"><p align="center"><a data-anchor="/document/16/203029/bssPhr118/"></a><a data-anchor="/document/16/203029/dfasavperp/" data-dfa="dfasavperp"></a><a data-anchor="/document/16/203029/dfastkm94r/" data-dfa="dfastkm94r"></a>Расходы, вычитаемые из прибыли в будущем</p><p align="center"><a data-anchor="/document/16/203029/bssPhr119/"></a><a data-anchor="/document/16/203029/dfas93f44b/" data-dfa="dfas93f44b"></a>(<a data-anchor="/document/16/203029/backlinkanchor33/" type="backlink-anchor"></a><a href="#/document/90/20918/dfasf6xqud/" class="link npd" title="Расходы, приведенные в настоящей статье если иное не предусмотрено частью второй настоящей статьи, не вычитаются при исчислении налогооблагаемой прибыли в момент их возникновения..." moduleId="90" documentId="20918" anchor="dfasf6xqud">ст. 146</a> НК)</p></td><td align="left"><p><a data-anchor="/document/16/203029/bssPhr120/"></a><a data-anchor="/document/16/203029/dfas52xrkw/" data-dfa="dfas52xrkw"></a>&nbsp;</p></td></tr></table></div><div class="scroller__track  scroller__track_h"><div class="scroller__bar scroller__bar_h"></div></div></div></div><div data-role="phrase-incut" class="incut-v4  incut-v4-attention "><h3 class="incut-v4__tag" data-incut-toggle="">Внимание</h3><p class="incut-v4__title" data-incut-toggle=""><a data-anchor="/document/16/203029/bssPhr121/"></a><a data-anchor="/document/16/203029/dfasxv124w/" data-dfa="dfasxv124w"></a>с 1 января 2019 года действует простое правило для разграничения вычитаемых и невычитаемых расходов. Если вид расхода не указан в <a data-anchor="/document/16/203029/backlinkanchor35/" type="backlink-anchor"></a><a href="#/document/90/20918/dfas6a8bzr/" class="link npd" title="К расходам, не подлежащим вычету при определении налогооблагаемой прибыли, относятся..." moduleId="90" documentId="20918" anchor="dfas6a8bzr">статье 147</a> НК, то его можно вычесть из совокупного дохода при расчете налогооблагаемой базы. И наоборот, когда расход указан в <a data-anchor="/document/16/203029/backlinkanchor37/" type="backlink-anchor"></a><a href="#/document/90/20918/dfas6a8bzr/" class="link npd" title="К расходам, не подлежащим вычету при определении налогооблагаемой прибыли, относятся..." moduleId="90" documentId="20918" anchor="dfas6a8bzr">статье 147</a> НК, вычет запрещен. Это правило следует использовать с осторожностью. Нельзя забывать, что не все затраты признаются расходами. Поэтому вычитаемые расходы должны отвечать сразу двум требованиям: <br>– быть обоснованными и документально подтвержденными <span class="xx-small">(<a data-anchor="/document/16/203029/backlinkanchor39/" type="backlink-anchor"></a><a href="#/document/90/20918/dfaslqgwio/" class="link npd" title="Расходами налогоплательщика являются обоснованные и документально подтвержденные расходы, а в случаях, предусмотренных настоящим Кодексом, и убытки, оформленные в соответствии с законодательством..." moduleId="90" documentId="20918" anchor="dfaslqgwio">ч. 2</a> ст. 141 НК)</span>; <br>– не содержаться в <a data-anchor="/document/16/203029/backlinkanchor41/" type="backlink-anchor"></a><a href="#/document/90/20918/dfas6a8bzr/" class="link npd" title="К расходам, не подлежащим вычету при определении налогооблагаемой прибыли, относятся..." moduleId="90" documentId="20918" anchor="dfas6a8bzr">статье 147</a> НК.</p><div class="incut-v4__icon"></div></div></div></div><div xmlns="" class="footer">© Материал из ЭС "ACTION: Главбух"<br />https://1gb.uz<br />Дата копирования: 29.09.2026</div></body></html>