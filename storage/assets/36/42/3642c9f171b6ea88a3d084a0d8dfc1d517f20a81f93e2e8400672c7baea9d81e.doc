098/bssPhr439/" data-role="phrase-anchor" data-phrase-id="439" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr439"></a><a data-anchor="/document/90/4098/dfaswrpgc9/"></a>&#160;</td><td><a data-anchor="/document/90/4098/bssPhr440/" data-role="phrase-anchor" data-phrase-id="440" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr440"></a><a data-anchor="/document/90/4098/dfash3bla4/"></a>&#160;</td><td valign="middle" class="bdBottom"><a data-anchor="/document/90/4098/bssPhr441/" data-role="phrase-anchor" data-phrase-id="441" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr441"></a><a data-anchor="/document/90/4098/dfas8a4g8n/"></a>&#160;</td></tr><tr valign="top" align="center"><td rowspan="12" class="bdLeft bdRight bdBottom"><p class="align-center"><a data-anchor="/document/90/4098/bssPhr442/" data-role="phrase-anchor" data-phrase-id="442" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr442"></a><a data-anchor="/document/90/4098/dfasymfm1i/"></a>4-й этап</p></td><td align="left" class="bdRight"><a data-anchor="/document/90/4098/bssPhr443/" data-role="phrase-anchor" data-phrase-id="443" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr443"></a><a data-anchor="/document/90/4098/dfas41bunn/"></a>&#160;</td><td rowspan="4" valign="middle" class="bdRight bdBottom"><p class="align-center"><a data-anchor="/document/90/4098/bssPhr444/" data-role="phrase-anchor" data-phrase-id="444" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr444"></a><a data-anchor="/document/90/4098/dfaslcqo53/"></a>Орган, уполномоченный выдавать лицензии на право пользования участками недр</p></td><td align="left" class="bdRight bdBottom"><a data-anchor="/document/90/4098/bssPhr445/" data-role="phrase-anchor" data-phrase-id="445" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr445"></a><a data-anchor="/document/90/4098/dfasggw3da/"></a>&#160;</td><td rowspan="7" align="left" class="bdRight bdBottom"><p><a data-anchor="/document/90/4098/bssPhr446/" data-role="phrase-anchor" data-phrase-id="446" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr446"></a><a data-anchor="/document/90/4098/dfaszuqz7w/"></a>Согласованный проект условий пользования участком недр представляется соискателю для ознакомления.</p><p><a data-anchor="/document/90/4098/bssPhr447/" data-role="phrase-anchor" data-phrase-id="447" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr447"></a><a data-anchor="/document/90/4098/dfasgn3qyc/"></a>При согласии соискателя с предлагаемыми условиями пользования недрами ему предоставляется в установленном порядке геологическая и иная информация по испрашиваемому участку недр и с ним подписывается Соглашение о конфиденциальности</p></td><td align="left" class="bdRight bdBottom"><a data-anchor="/document/90/4098/bssPhr448/" data-role="phrase-anchor" data-phrase-id="448" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr448"></a><a data-anchor="/document/90/4098/dfasuik5pk/"></a>&#160;</td><td rowspan="2" valign="middle" class="bdRight bdBottom"><p class="align-center"><a data-anchor="/document/90/4098/bssPhr449/" data-role="phrase-anchor" data-phrase-id="449" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr449"></a><a data-anchor="/document/90/4098/dfas1mqir5/"></a>10 дней</p></td></tr><tr valign="top"><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr450/" data-role="phrase-anchor" data-phrase-id="450" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr450"></a><a data-anchor="/document/90/4098/dfasen9lir/"></a>&#160;</td><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr451/" data-role="phrase-anchor" data-phrase-id="451" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr451"></a><a data-anchor="/document/90/4098/dfas0fshus/"></a>&#160;</td><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr452/" data-role="phrase-anchor" data-phrase-id="452" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr452"></a><a data-anchor="/document/90/4098/dfasgtl597/"></a>&#160;</td></tr><tr valign="top"><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr453/" data-role="phrase-anchor" data-phrase-id="453" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr453"></a><a data-anchor="/document/90/4098/dfas6c56hy/"></a>&#160;</td><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr454/" data-role="phrase-anchor" data-phrase-id="454" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr454"></a><a data-anchor="/document/90/4098/dfas6tfgui/"></a>&#160;</td><td><a data-anchor="/document/90/4098/bssPhr455/" data-role="phrase-anchor" data-phrase-id="455" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr455"></a><a data-anchor="/document/90/4098/dfasaugu7n/"></a>&#160;</td><td valign="middle" class="bdBottom"><a data-anchor="/document/90/4098/bssPhr456/" data-role="phrase-anchor" data-phrase-id="456" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr456"></a><a data-anchor="/document/90/4098/dfasd0e44v/"></a>&#160;</td></tr><tr valign="top"><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr457/" data-role="phrase-anchor" data-phrase-id="457" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr457"></a><a data-anchor="/document/90/4098/dfas6ya7o0/"></a>&#160;</td><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr458/" data-role="phrase-anchor" data-phrase-id="458" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr458"></a><a data-anchor="/document/90/4098/dfas3vl3hb/"></a>&#160;</td><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr459/" data-role="phrase-anchor" data-phrase-id="459" data-dwh-source-type-favorites="butto