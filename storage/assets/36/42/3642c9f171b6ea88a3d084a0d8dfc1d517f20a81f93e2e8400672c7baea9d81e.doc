 data-anchor="/document/90/4098/dfasrgczf0/"></a>&#160;</td><td><a data-anchor="/document/90/4098/bssPhr625/" data-role="phrase-anchor" data-phrase-id="625" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr625"></a><a data-anchor="/document/90/4098/dfasala4c0/"></a>&#160;</td><td class="bdBottom"><a data-anchor="/document/90/4098/bssPhr626/" data-role="phrase-anchor" data-phrase-id="626" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr626"></a><a data-anchor="/document/90/4098/dfasp56gwe/"></a>&#160;</td><td><a data-anchor="/document/90/4098/bssPhr627/" data-role="phrase-anchor" data-phrase-id="627" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr627"></a><a data-anchor="/document/90/4098/dfasna4qsx/"></a>&#160;</td><td valign="middle" class="bdBottom"><a data-anchor="/document/90/4098/bssPhr628/" data-role="phrase-anchor" data-phrase-id="628" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr628"></a><a data-anchor="/document/90/4098/dfaswtnshz/"></a>&#160;</td></tr><tr valign="top"><td class="bdRight"><a data-anchor="/document/90/4098/bssPhr629/" data-role="phrase-anchor" data-phrase-id="629" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr629"></a><a data-anchor="/document/90/4098/dfastmapp2/"></a>&#160;</td><td rowspan="3" valign="middle" align="center" class="bdRight bdBottom"><p class="align-center"><a data-anchor="/document/90/4098/bssPhr630/" data-role="phrase-anchor" data-phrase-id="630" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr630"></a><a data-anchor="/document/90/4098/dfasgw8rir/"></a>Госкомэкологии</p></td><td class="bdRight bdBottom"><a data-anchor="/document/90/4098/bssPhr631/" data-role="phrase-anchor" data-phrase-id="631" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr631"></a><a data-anchor="/document/90/4098/dfasgsl0a7/"></a>&#160;</td><td rowspan="6" class="bdRight bdBot