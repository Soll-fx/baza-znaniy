cument/90/19736/bssPhr1057/" data-role="phrase-anchor" data-phrase-id="1057" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1057"></a><a data-anchor="/document/90/19736/dfasrkugy7/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 23.2%;"><a data-anchor="/document/90/19736/bssPhr1058/" data-role="phrase-anchor" data-phrase-id="1058" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1058"></a><a data-anchor="/document/90/19736/dfas8idiuo/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 17.1%;"><a data-anchor="/document/90/19736/bssPhr1059/" data-role="phrase-anchor" data-phrase-id="1059" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1059"></a><a data-anchor="/document/90/19736/dfasfqv8uw/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 16.8%;"><a data-anchor="/document/90/19736/bssPhr1060/" data-role="phrase-anchor" data-phrase-id="1060" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1060"></a><a data-anchor="/document/90/19736/dfas4tycry/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" style="width: 5.1%;"><p><a data-anchor="/document/90/19736/bssPhr1061/" data-role="phrase-anchor" data-phrase-id="1061" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1061"></a><a data-anchor="/document/90/19736/dfas9v7ff8/"></a>&#8230;</p></td><td class="bdBottom bdRight" style="width: 24.2%;"><a data-anchor="/document/90/19736/bssPhr1062/" data-role="phrase-anchor" data-phrase-id="1062" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1062"></a><a data-anchor="/document/90/19736/dfash5551q/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 23.2%;"><a data-anchor="/document/90/19736/bssPhr1063/" data-role="phrase-anchor" data-phrase-id="1063" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1063"></a><a data-anchor="/document/90/19736/dfasgq4gd1/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 17.1%;"><a data-anchor="/document/90/19736/bssPhr1064/" data-role="phrase-anchor" data-phrase-id="1064" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1064"></a><a data-anchor="/document/90/19736/dfas63ykw5/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 16.8%;"><a data-anchor="/document/90/19736/bssPhr1065/" data-role="phrase-anchor" data-phrase-id="1065" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1065"></a><a data-anchor="/document/90/19736/dfasqo4y5v/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" colspan="2" style="width: 29.3%;"><p><a data-anchor="/document/90/19736/bssPhr1066/" data-role="phrase-anchor" data-phrase-id="1066" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1066"></a><a data-anchor="/document/90/19736/dfasd90gve/"></a>Жами</p></td><td class="bdBottom bdRight" style="width: 23.2%;"><a data-anchor="/document/90/19736/bssPhr1067/" data-role="phrase-anchor" data-phrase-id="1067" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1067"></a><a data-anchor="/document/90/19736/dfasyzu9xq/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 17.1%;"><a data-anchor="/document/90/19736/bssPhr1068/" data-role="phrase-anchor" data-phrase-id="1068" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1068"></a><a data-anchor="/document/90/19736/dfas2gqg2s/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 16.8%;"><a data-anchor="/document/90/19736/bssPhr1069/" data-role="phrase-anchor" data-phrase-id="1069" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1069"></a><a data-anchor="/document/90/19736/dfas0epx5s/"></a>&#160;</td></tr><tr><td class="bdBottom bdRight bdLeft" colspan="2" style="width: 29.3%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1070/" data-role="phrase-anchor" data-phrase-id="1070" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1070"></a><a data-anchor="/document/90/19736/dfashzge1a/"></a>Всего по служебной командировке</p></td><td class="bdBottom bdRight" style="width: 23.2%;"><a data-anchor="/document/90/19736/bssPhr1071/" data-role="phrase-anchor" data-phrase-id="1071" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1071"></a><a data-anchor="/document/90/19736/dfasg1gu7n/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 17.1%;"><a data-anchor="/document/90/19736/bssPhr1072/" data-role="phrase-anchor" data-phrase-id="1072" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1072"></a><a data-anchor="/document/90/19736/dfascvl82i/"></a>&#160;</td><td class="bdBottom bdRight" style="width: 16.8%;"><a data-anchor="/document/90/19736/bssPhr1073/" data-role="phrase-anchor" data-phrase-id="1073" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1073"></a><a data-anchor="/document/90/19736/dfasxet8kx/"></a>&#160;</td></tr></tbody></table></div></div></div></div><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1074/" data-role="phrase-anchor" data-phrase-id="1074" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1074"></a><a data-anchor="/document/90/19736/dfasu9pt04/"></a>Приложение № 2<br>к постановлению Кабинета Министров<br>от &#171;11&#187; июня 2026 года № 303</p><div class="doc__untyped" data-type="untyped" data-level="2"><a data-role="toc" data-anchor="/document/90/19736/tit21/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/19736/bssPhr1075/" data-role="phrase-anchor" data-phrase-id="1075" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1075"></a><a data-anchor="/document/90/19736/dfas3q32mk/"></a>ПОЛОЖЕНИЕ&#160;<br>о порядке использования средств Государственного бюджета Республики Узбекистан при приёме в Республике Узбекистан руководителей иностранных государств, прибывающих с официальными, рабочими и иными визитами, руководителей делегаций, членов их семей и других лиц</span></div><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/19736/tit15/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/19736/bssPhr1076/" data-role="phrase-anchor" data-phrase-id="1076" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1076"></a><a data-anchor="/document/90/19736/dfaso14w3x/"></a>Глава 1. </span><span class="doc__chapter-name">Общие положения</span></div><p><a data-anchor="/document/90/19736/bssPhr1077/" data-role="phrase-anchor" data-phrase-id="1077" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1077"></a><a data-anchor="/document/90/19736/dfastgkg7n/"></a>1. Настоящее Положение определяет порядок приёма в Республике Узбекистан руководителей иностранных государств, прибывающих с официальными, рабочими и иными визитами (далее &#8212; визиты), а также лиц, указанных в приложении 1 к настоящему Положению (далее &#8212; делегации иностранных государств).</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/19736/tit16/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/19736/bssPhr1078/" data-role="phrase-anchor" data-phrase-id="1078" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1078"></a><a data-anchor="/document/90/19736/dfasqxa1wa/"></a>Глава 2. </span><span class="doc__chapter-name">Порядок приёма делегаций иностранных государств</span></div><p><a data-anchor="/document/90/19736/bssPhr1079/" data-role="phrase-anchor" data-phrase-id="1079" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1079"></a><a data-anchor="/document/90/19736/dfas255z6k/"></a>2. Министерства, ведомства и другие организации, ответственные за организацию визитов, вносят в Администрацию Президента Республики Узбекистан или Кабинет Министров Республики Узбекистан соответствующие предложения о сроках, видах и форме визитов делегаций иностранных государств.</p><p><a data-anchor="/document/90/19736/bssPhr1080/" data-role="phrase-anchor" data-phrase-id="1080" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1080"></a><a data-anchor="/document/90/19736/dfas785o2i/"></a>3. Приём в Республике Узбекистан руководителей иностранных государств и делегаций иностранных государств, прибывающих с официальными, рабочими и неофициальными визитами, членов их семей и иных сопровождающих лиц осуществляется на основе взаимности в соответствии с двумя двусторонними документами, предусмотренными Положением о Государственном дипломатическом протоколе.</p><p><a data-anchor="/document/90/19736/bssPhr1081/" data-role="phrase-anchor" data-phrase-id="1081" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1081"></a><a data-anchor="/document/90/19736/dfasfi7co1/"></a>При визитах глав иностранных государств, глав правительств и руководителей международных организаций в Республику Узбекистан мероприятия по встрече и проводам организуются на основе принципа взаимности, сложившегося в международной практике.</p><p><a data-anchor="/document/90/19736/bssPhr1082/" data-role="phrase-anchor" data-phrase-id="1082" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1082"></a><a data-anchor="/document/90/19736/dfasm2qvuz/"></a>Государственные резиденции принимают делегации иностранных государств в качестве гостей Президента Республики Узбекистан либо Правительства Республики Узбекистан. Размер штата государственных резиденций соответствует уровню официальных визитов министров иностранных дел.</p><p><a data-anchor="/document/90/19736/bssPhr1083/" data-role="phrase-anchor" data-phrase-id="1083" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1083"></a><a data-anchor="/document/90/19736/dfasn8bzh6/"></a>4. Приём делегаций иностранных государств в Республике Узбекистан организуется ответственными организациями на надлежащем уровне.</p><p><a data-anchor="/document/90/19736/bssPhr1084/" data-role="phrase-anchor" data-phrase-id="1084" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1084"></a><a data-anchor="/document/90/19736/dfasxrag8w/"></a>Подготовка протокольных мероприятий по визитам, их проведение и ответственность за их организацию возлагаются на Министерство иностранных дел Республики Узбекистан.</p><p><a data-anchor="/document/90/19736/bssPhr1085/" data-role="phrase-anchor" data-phrase-id="1085" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1085"></a><a data-anchor="/document/90/19736/dfashsnk4g/"></a>5. Церемонии встречи и проводов глав иностранных государств, руководителей делегаций и членов их семей, прибывающих по официальным визитам, считаются мероприятиями высшего уровня.</p><p><a data-anchor="/document/90/19736/bssPhr1086/" data-role="phrase-anchor" data-phrase-id="1086" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1086"></a><a data-anchor="/document/90/19736/dfas7lf6nz/"></a>6. Если финансирование мероприятий, связанных с пребыванием делегаций иностранных государств в Республике Узбекистан, осуществляется за счёт бюджетных и внебюджетных средств соответствующих министерств и ведомств, программа визита после согласования с Министерством иностранных дел Республики Узбекистан, а также другими заинтересованными министерствами и ведомствами представляется в Кабинет Министров Республики Узбекистан для утверждения.</p><p><a data-anchor="/document/90/19736/bssPhr1087/" data-role="phrase-anchor" data-phrase-id="1087" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1087"></a><a data-anchor="/document/90/19736/dfashkifi3/"></a>7. Основные протокольные мероприятия в зависимости от уровня принимаемой делегации утверждаются Руководителем службы протокола Президента Республики Узбекистан по представлению Министерства иностранных дел Республики Узбекистан с указанием порядка, времени и места проведения приёма.</p><p><a data-anchor="/document/90/19736/bssPhr1088/" data-role="phrase-anchor" data-phrase-id="1088" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1088"></a><a data-anchor="/document/90/19736/dfasb24gxq/"></a>К организации приёма могут привлекаться все министерства и ведомства Республики Узбекистан, включая Жокаргы Кенес Республики Каракалпакстан, а также хокимияты областей и города Ташкента.</p><p><a data-anchor="/document/90/19736/bssPhr1089/" data-role="phrase-anchor" data-phrase-id="1089" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1089"></a><a data-anchor="/document/90/19736/dfashiqt1k/"></a>8. Во время пребывания в Узбекистане глав иностранных государств и делегаций благоустройство города Ташкента возлагается на хокима города Ташкента.</p><p><a data-anchor="/document/90/19736/bssPhr1090/" data-role="phrase-anchor" data-phrase-id="1090" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1090"></a><a data-anchor="/document/90/19736/dfasrz5tvk/"></a>Если в программу визита иностранных гостей включено пребывание в других городах, благоустройство этих городов и мероприятия по приёму делегаций осуществляются соответствующими хокимиятами за счёт средств местных бюджетов.</p><p><a data-anchor="/document/90/19736/bssPhr1091/" data-role="phrase-anchor" data-phrase-id="1091" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1091"></a><a data-anchor="/document/90/19736/dfasho99gx/"></a>Глава 3. Порядок использования средств Государственного бюджета Республики Узбекистан при приёме делегаций иностранных государств</p><p><a data-anchor="/document/90/19736/bssPhr1092/" data-role="phrase-anchor" data-phrase-id="1092" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1092"></a><a data-anchor="/document/90/19736/dfas5pofw1/"></a>9. Расходы, связанные с приёмом делегаций иностранных государств, осуществляются за счёт следующих источников:</p><p><a data-anchor="/document/90/19736/bssPhr1093/" data-role="phrase-anchor" data-phrase-id="1093" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1093"></a><a data-anchor="/document/90/19736/dfas8i17od/"></a>средств, выделенных из Государственного бюджета Республики Узбекистан министерствам, ведомствам и другим организациям, ответственным за организацию визитов, а также их внебюджетных фондов;</p><p><a data-anchor="/document/90/19736/bssPhr1094/" data-role="phrase-anchor" data-phrase-id="1094" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1094"></a><a data-anchor="/document/90/19736/dfasl1n2ky/"></a>средств резервного фонда Кабинета Министров;</p><p><a data-anchor="/document/90/19736/bssPhr1095/" data-role="phrase-anchor" data-phrase-id="1095" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1095"></a><a data-anchor="/document/90/19736/dfasa76lhz/"></a>средств, выделяемых за счёт дополнительных источников местного бюджета;</p><p><a data-anchor="/document/90/19736/bssPhr1096/" data-role="phrase-anchor" data-phrase-id="1096" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1096"></a><a data-anchor="/document/90/19736/dfascxaxrv/"></a>иных средств, не запрещённых законодательством.</p><p><a data-anchor="/document/90/19736/bssPhr1097/" data-role="phrase-anchor" data-phrase-id="1097" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1097"></a><a data-anchor="/document/90/19736/dfasgmzxps/"></a>10. Расходы, связанные с приёмом делегаций иностранных государств, осуществляются в пределах бюджетных средств министерств, ведомств и других организаций согласно утверждённым сметам расходов и программам мероприятий.</p><p><a data-anchor="/document/90/19736/bssPhr1098/" data-role="phrase-anchor" data-phrase-id="1098" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1098"></a><a data-anchor="/document/90/19736/dfaseqo6k3/"></a>При отсутствии у государственных органов и организаций бюджетных и внебюджетных средств указанные расходы осуществляются на основании соответствующих расчётов и документов за счёт средств резервного фонда Кабинета Министров в порядке, установленном Кабинетом Министров.</p><p><a data-anchor="/document/90/19736/bssPhr1099/" data-role="phrase-anchor" data-phrase-id="1099" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1099"></a><a data-anchor="/document/90/19736/dfaswnvlvp/"></a>Если программой пребывания делегаций иностранных государств предусмотрено посещение областей, расходы, связанные с приёмом делегаций в соответствующих регионах, осуществляются за счёт средств соответствующих местных бюджетов.</p><p><a data-anchor="/document/90/19736/bssPhr1100/" data-role="phrase-anchor" data-phrase-id="1100" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1100"></a><a data-anchor="/document/90/19736/dfas6d2wm3/"></a>11. Расходы, связанные с приёмом делегаций иностранных государств, официальных зарубежных делегаций, должностных лиц и гостей, принимаемых на официальном уровне, осуществляются в соответствии с нормами, установленными приложением 2 к настоящему Положению.</p><p><a data-anchor="/document/90/19736/bssPhr1101/" data-role="phrase-anchor" data-phrase-id="1101" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1101"></a><a data-anchor="/document/90/19736/dfaswf6ido/"></a>12. В случаях, когда для проведения мероприятий, связанных с приёмом делегаций иностранных государств, требуется выделение средств из резервного фонда Кабинета Министров, принимается соответствующее распоряжение или решение Кабинета Министров.</p><p><a data-anchor="/document/90/19736/bssPhr1102/" data-role="phrase-anchor" data-phrase-id="1102" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1102"></a><a data-anchor="/document/90/19736/dfashy9h1m/"></a>13. В проекте распоряжения или решения Кабинета Министров должны быть указаны сроки приёма и проводов делегаций иностранных государств, программа мероприятий, а также смета расходов.</p><p><a data-anchor="/document/90/19736/bssPhr1103/" data-role="phrase-anchor" data-phrase-id="1103" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1103"></a><a data-anchor="/document/90/19736/dfasv1cahm/"></a>14. Проект распоряжения или решения Кабинета Министров о выделении средств из резервного фонда Кабинета Министров для покрытия расходов, связанных с приёмом делегаций иностранных государств, подготавливается министерством или ведомством, ответственным за проведение соответствующего мероприятия.</p><p><a data-anchor="/document/90/19736/bssPhr1104/" data-role="phrase-anchor" data-phrase-id="1104" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1104"></a><a data-anchor="/document/90/19736/dfasnx1x8f/"></a>15. При наличии обосновывающих документов проект распоряжения или решения Кабинета Министров подготавливается ответственными за приём делегации министерствами и ведомствами и вносится на согласование заинтересованным министерствам и ведомствам.</p><p><a data-anchor="/document/90/19736/bssPhr1105/" data-role="phrase-anchor" data-phrase-id="1105" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1105"></a><a data-anchor="/document/90/19736/dfas29wghc/"></a>Проект распоряжения или решения Кабинета Министров должен быть согласован заинтересованными министерствами и ведомствами в течение двух дней.</p><p><a data-anchor="/document/90/19736/bssPhr1106/" data-role="phrase-anchor" data-phrase-id="1106" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1106"></a><a data-anchor="/document/90/19736/dfast84wsq/"></a>16. Смета расходов, прилагаемая к проекту распоряжения или решения Кабинета Министров, подлежит рассмотрению Министерством экономики и финансов.</p><p><a data-anchor="/document/90/19736/bssPhr1107/" data-role="phrase-anchor" data-phrase-id="1107" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1107"></a><a data-anchor="/document/90/19736/dfaswcxoa0/"></a>При отсутствии документов, подтверждающих обоснованность расходов, предусмотренных в смете, приложенной к проекту распоряжения или решения, Министерство экономики и финансов вправе запросить дополнительные обосновывающие документы у ответственного министерства.</p><p><a data-anchor="/document/90/19736/bssPhr1108/" data-role="phrase-anchor" data-phrase-id="1108" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1108"></a><a data-anchor="/document/90/19736/dfasvm6d23/"></a>Если обосновывающие документы не представлены в установленном порядке, Министерство экономики и финансов обязано вернуть смету расходов либо проект распоряжения (решения) на доработку.</p><p><a data-anchor="/document/90/19736/bssPhr1109/" data-role="phrase-anchor" data-phrase-id="1109" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1109"></a><a data-anchor="/document/90/19736/dfasy04n3k/"></a>После согласования Министерством экономики и финансов в установленном порядке проект вносится министерствами и ведомствами в Кабинет Министров Республики Узбекистан.</p><p><a data-anchor="/document/90/19736/bssPhr1110/" data-role="phrase-anchor" data-phrase-id="1110" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1110"></a><a data-anchor="/document/90/19736/dfasptv7xn/"></a>17. Ответственность за целевое расходование средств, выделенных на проведение мероприятий, несёт руководитель соответствующей организации.</p><div class="doc__chapter" data-type="chapter" data-level="4"><a data-role="toc" data-anchor="/document/90/19736/tit17/"></a><span class="doc__chapter-number" style="text-align:left"><a data-anchor="/document/90/19736/bssPhr1111/" data-role="phrase-anchor" data-phrase-id="1111" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1111"></a><a data-anchor="/document/90/19736/dfas65ksmg/"></a>Глава 4. </span><span class="doc__chapter-name">Заключительное положение</span></div><p><a data-anchor="/document/90/19736/bssPhr1112/" data-role="phrase-anchor" data-phrase-id="1112" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1112"></a><a data-anchor="/document/90/19736/dfas8g9l11/"></a>18. Лица, виновные в нарушении требований настоящего Положения, несут ответственность в соответствии с законодательством.</p><div><div class="table-wide"><div><div><table width="100.00%"><tbody><tr><td style="width: 111.95%;"><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1113/" data-role="phrase-anchor" data-phrase-id="1113" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1113"></a><a data-anchor="/document/90/19736/dfasdkq0xg/"></a>Приложение №1</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1114/" data-role="phrase-anchor" data-phrase-id="1114" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1114"></a><a data-anchor="/document/90/19736/dfasnx8fb7/"></a>к Положению о порядке использования</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1115/" data-role="phrase-anchor" data-phrase-id="1115" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1115"></a><a data-anchor="/document/90/19736/dfasxo2ur5/"></a>средств Государственного бюджета</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1116/" data-role="phrase-anchor" data-phrase-id="1116" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1116"></a><a data-anchor="/document/90/19736/dfasgu1ehy/"></a>Республики Узбекистан при приёме в Республике Узбекистан</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1117/" data-role="phrase-anchor" data-phrase-id="1117" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1117"></a><a data-anchor="/document/90/19736/dfasgq02s2/"></a>руководителей иностранных государств, прибывающих с</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1118/" data-role="phrase-anchor" data-phrase-id="1118" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1118"></a><a data-anchor="/document/90/19736/dfasqk1zlo/"></a>официальными, рабочими и иными визитами,</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1119/" data-role="phrase-anchor" data-phrase-id="1119" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1119"></a><a data-anchor="/document/90/19736/dfas2aht0t/"></a>руководителей делегаций, членов их семей и других лиц</p></td></tr></tbody></table></div></div></div></div><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1120/" data-role="phrase-anchor" data-phrase-id="1120" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1120"></a><a data-anchor="/document/90/19736/dfasqtptr8/"></a>Уровни официального приёма членов делегаций иностранных государств, должностных лиц и гостей</p><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1121/" data-role="phrase-anchor" data-phrase-id="1121" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1121"></a><a data-anchor="/document/90/19736/dfasu2foyl/"></a>Высший уровень</p><ol start="1"><li><a data-anchor="/document/90/19736/bssPhr1122/" data-role="phrase-anchor" data-phrase-id="1122" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1122"></a><a data-anchor="/document/90/19736/dfasto028l/"></a>Главы иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1123/" data-role="phrase-anchor" data-phrase-id="1123" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1123"></a><a data-anchor="/document/90/19736/dfas2l68fo/"></a>Руководители парламентов иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1124/" data-role="phrase-anchor" data-phrase-id="1124" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1124"></a><a data-anchor="/document/90/19736/dfassga826/"></a>Премьер-министры, канцлеры, государственные секретари, вице-президенты иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1125/" data-role="phrase-anchor" data-phrase-id="1125" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1125"></a><a data-anchor="/document/90/19736/dfas1h8f8k/"></a>Руководители международных организаций.</li></ol><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1126/" data-role="phrase-anchor" data-phrase-id="1126" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1126"></a><a data-anchor="/document/90/19736/dfashtme9m/"></a>1 уровень</p><ol start="1"><li><a data-anchor="/document/90/19736/bssPhr1127/" data-role="phrase-anchor" data-phrase-id="1127" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1127"></a><a data-anchor="/document/90/19736/dfasgqsgm7/"></a>Министры иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1128/" data-role="phrase-anchor" data-phrase-id="1128" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1128"></a><a data-anchor="/document/90/19736/dfasgic1pg/"></a>Послы иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1129/" data-role="phrase-anchor" data-phrase-id="1129" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1129"></a><a data-anchor="/document/90/19736/dfas0hnc5k/"></a>Члены парламентов иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1130/" data-role="phrase-anchor" data-phrase-id="1130" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1130"></a><a data-anchor="/document/90/19736/dfasruzoua/"></a>Личные представители глав иностранных государств.</li></ol><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1131/" data-role="phrase-anchor" data-phrase-id="1131" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1131"></a><a data-anchor="/document/90/19736/dfasipf9nf/"></a>2 уровень</p><ol start="1"><li><a data-anchor="/document/90/19736/bssPhr1132/" data-role="phrase-anchor" data-phrase-id="1132" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1132"></a><a data-anchor="/document/90/19736/dfaso05mwu/"></a>Известные международные общественные деятели.</li><li><a data-anchor="/document/90/19736/bssPhr1133/" data-role="phrase-anchor" data-phrase-id="1133" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1133"></a><a data-anchor="/document/90/19736/dfas3gppbv/"></a>Общественные и политические деятели иностранных государств.</li><li><a data-anchor="/document/90/19736/bssPhr1134/" data-role="phrase-anchor" data-phrase-id="1134" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1134"></a><a data-anchor="/document/90/19736/dfas61ddur/"></a>Бизнесмены и предприниматели.</li><li><a data-anchor="/document/90/19736/bssPhr1135/" data-role="phrase-anchor" data-phrase-id="1135" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1135"></a><a data-anchor="/document/90/19736/dfasl39fz4/"></a>Представители средств массовой информации.</li></ol><p><a data-anchor="/document/90/19736/bssPhr1136/" data-role="phrase-anchor" data-phrase-id="1136" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1136"></a><a data-anchor="/document/90/19736/dfas8t74wo/"></a>Примечание:<br>Приём любого из вышеуказанных гостей Президентом Республики Узбекистан считается приёмом высшего уровня.</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1137/" data-role="phrase-anchor" data-phrase-id="1137" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1137"></a><a data-anchor="/document/90/19736/dfas1aovnn/"></a>Приложение №2 к Положению о порядке использования</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1138/" data-role="phrase-anchor" data-phrase-id="1138" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1138"></a><a data-anchor="/document/90/19736/dfasalkbg0/"></a>средств Государственного бюджета Республики</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1139/" data-role="phrase-anchor" data-phrase-id="1139" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1139"></a><a data-anchor="/document/90/19736/dfas4rn90u/"></a>Узбекистан при приёме в Республике Узбекистан</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1140/" data-role="phrase-anchor" data-phrase-id="1140" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1140"></a><a data-anchor="/document/90/19736/dfasytsxl3/"></a>руководителей иностранных государств, прибывающих</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1141/" data-role="phrase-anchor" data-phrase-id="1141" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1141"></a><a data-anchor="/document/90/19736/dfaskgsrn9/"></a>.с официальными, рабочими и иными визитами,</p><p style="text-align:right"><a data-anchor="/document/90/19736/bssPhr1142/" data-role="phrase-anchor" data-phrase-id="1142" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1142"></a><a data-anchor="/document/90/19736/dfasv7lbq9/"></a>руководителей делегаций, членов их семей и других лиц</p><div class="doc__untyped" data-type="untyped" data-level="2"><a data-role="toc" data-anchor="/document/90/19736/tit22/"></a><span level="" style="text-align:left" h_size="" class="doc__untyped-name"><a data-anchor="/document/90/19736/bssPhr1143/" data-role="phrase-anchor" data-phrase-id="1143" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1143"></a><a data-anchor="/document/90/19736/dfaseqsnaz/"></a>НОРМЫ&#160;<br>Расходов, связанных с приёмом членов делегаций иностранных государств</span></div><div><div class="table-wide"><div><div><table width="100.00%"><thead><tr><th class="bdTop bdRight bdLeft" data-col-number="1" style="width: 6%;"><p style="text-align:center"><a tr="yes" data-anchor="/document/90/19736/bssPhr1144/" data-role="phrase-anchor" data-phrase-id="1144" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1144"></a><a data-anchor="/document/90/19736/dfasv3ubge/"></a>№ п/п</p></th><th class="bdTop bdRight bdLeft" data-col-number="2" style="width: 27.4%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1145/" data-role="phrase-anchor" data-phrase-id="1145" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1145"></a><a data-anchor="/document/90/19736/dfasgeayp5/"></a>Вид расходов</p></th><th class="bdTop bdRight bdLeft" data-col-number="3" style="width: 14.9%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1146/" data-role="phrase-anchor" data-phrase-id="1146" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1146"></a><a data-anchor="/document/90/19736/dfas2f8o8u/"></a>Единица измерения</p></th><th class="bdAll" colspan="3" data-col-number="4" style="width: 36.8%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1147/" data-role="phrase-anchor" data-phrase-id="1147" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1147"></a><a data-anchor="/document/90/19736/dfasuv21ng/"></a>Предельные размеры расходов по отношению к базовой расчётной величине (БРВ)</p></th></tr><tr><th class="bdBottom bdRight bdLeft" data-col-number="1" style="width: 6%;"><a tr="yes" data-anchor="/document/90/19736/bssPhr1148/" data-role="phrase-anchor" data-phrase-id="1148" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1148"></a><a data-anchor="/document/90/19736/dfasr284an/"></a>&#160;</th><th class="bdBottom bdRight bdLeft" data-col-number="2" style="width: 27.4%;">&#160;</th><th class="bdBottom bdRight bdLeft" data-col-number="3" style="width: 14.9%;">&#160;</th><th class="bdAll" data-col-number="4" style="width: 12.5%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1149/" data-role="phrase-anchor" data-phrase-id="1149" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1149"></a><a data-anchor="/document/90/19736/dfasxmvh32/"></a>Высший уровень</p></th><th class="bdAll" data-col-number="5" style="width: 11.4%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1150/" data-role="phrase-anchor" data-phrase-id="1150" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1150"></a><a data-anchor="/document/90/19736/dfas1mfhab/"></a>1 уровень</p></th><th class="bdAll" data-col-number="6" style="width: 64.68%;"><p style="text-align:center"><a data-anchor="/document/90/19736/bssPhr1151/" data-role="phrase-anchor" data-phrase-id="1151" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1151"></a><a data-anchor="/document/90/19736/dfas3gk482/"></a>2 уровень</p></th></tr></thead><tbody><tr><td class="bdAll" style="width: 6%;"><p><a data-anchor="/document/90/19736/bssPhr1152/" data-role="phrase-anchor" data-phrase-id="1152" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1152"></a><a data-anchor="/document/90/19736/dfaszb87de/"></a>1</p></td><td class="bdAll" style="width: 27.4%;"><p><a data-anchor="/document/90/19736/bssPhr1153/" data-role="phrase-anchor" data-phrase-id="1153" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1153"></a><a data-anchor="/document/90/19736/dfasmphnug/"></a>Официальный приём (обед) от имени Правительства Республики Узбекистан</p></td><td class="bdAll" style="width: 14.9%;"><p><a data-anchor="/document/90/19736/bssPhr1154/" data-role="phrase-anchor" data-phrase-id="1154" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1154"></a><a data-anchor="/document/90/19736/dfasg4f2dr/"></a>1 человек</p></td><td class="bdAll" style="width: 12.5%;"><p><a data-anchor="/document/90/19736/bssPhr1155/" data-role="phrase-anchor" data-phrase-id="1155" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1155"></a><a data-anchor="/document/90/19736/dfasmlwiyr/"></a>до 6,0 БРВ</p></td><td class="bdAll" style="width: 11.4%;"><p><a data-anchor="/document/90/19736/bssPhr1156/" data-role="phrase-anchor" data-phrase-id="1156" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1156"></a><a data-anchor="/document/90/19736/dfasc1fqec/"></a>до 3,0 БРВ</p></td><td class="bdAll" style="width: 64.68%;"><p><a data-anchor="/document/90/19736/bssPhr1157/" data-role="phrase-anchor" data-phrase-id="1157" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1157"></a><a data-anchor="/document/90/19736/dfasomdgv8/"></a>до 2,0 БРВ</p></td></tr><tr><td class="bdAll" style="width: 6%;"><p><a data-anchor="/document/90/19736/bssPhr1158/" data-role="phrase-anchor" data-phrase-id="1158" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1158"></a><a data-anchor="/document/90/19736/dfascsccop/"></a>2</p></td><td class="bdAll" style="width: 27.4%;"><p><a data-anchor="/document/90/19736/bssPhr1159/" data-role="phrase-anchor" data-phrase-id="1159" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1159"></a><a data-anchor="/document/90/19736/dfasvp3ra5/"></a>Официальный приём (ужин) от имени Правительства Республики Узбекистан</p></td><td class="bdAll" style="width: 14.9%;"><p><a data-anchor="/document/90/19736/bssPhr1160/" data-role="phrase-anchor" data-phrase-id="1160" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1160"></a><a data-anchor="/document/90/19736/dfasvqkfiz/"></a>1 человек</p></td><td class="bdAll" style="width: 12.5%;"><p><a data-anchor="/document/90/19736/bssPhr1161/" data-role="phrase-anchor" data-phrase-id="1161" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1161"></a><a data-anchor="/document/90/19736/dfasgsmqgt/"></a>до 11,0 БРВ</p></td><td class="bdAll" style="width: 11.4%;"><p><a data-anchor="/document/90/19736/bssPhr1162/" data-role="phrase-anchor" data-phrase-id="1162" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1162"></a><a data-anchor="/document/90/19736/dfasn4uxut/"></a>до 4,0 БРВ</p></td><td class="bdAll" style="width: 64.68%;"><p><a data-anchor="/document/90/19736/bssPhr1163/" data-role="phrase-anchor" data-phrase-id="1163" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1163"></a><a data-anchor="/document/90/19736/dfas4etb7s/"></a>до 3,0 БРВ</p></td></tr><tr><td class="bdAll" style="width: 6%;"><p><a data-anchor="/document/90/19736/bssPhr1164/" data-role="phrase-anchor" data-phrase-id="1164" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1164"></a><a data-anchor="/document/90/19736/dfashgf9ik/"></a>3</p></td><td class="bdAll" style="width: 27.4%;"><p><a data-anchor="/document/90/19736/bssPhr1165/" data-role="phrase-anchor" data-phrase-id="1165" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1165"></a><a data-anchor="/document/90/19736/dfasheq8gi/"></a>Суточное питание (обычный обед и два ужина)</p></td><td class="bdAll" style="width: 14.9%;"><p><a data-anchor="/document/90/19736/bssPhr1166/" data-role="phrase-anchor" data-phrase-id="1166" data-dwh-source-type-favorites="button_anchor" data-phrase-anchor="bssPhr1166"></a><a data-anchor="/document/90/19736/dfasrfpf0v/"></a>1 человек</p></td><td class="bdAll" style="