<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"></meta><!--[if gte mso 9]>
					<xml>
						<w:WordDocument>
							<w:View>Print</w:View>
							<w:Zoom>90</w:Zoom>
							<w:DoNotOptimizeForBrowser/>
						</w:WordDocument>
					</xml>
				<![endif]--><style xmlns="" type="text/css" media="all">
                body {
                    font-size: 100%;
                }
                h1.normal {
                    color: #000 !important;
                    width: 75%;
                }
                .content_block {
                    margin-right: 3%;
                    width: 74%;
                }
                div#documentBody {
                    margin-top: 31px;
                    padding-bottom: 30px;
                }
                div.docChainList {
                    font-family: Arial;
                    font-size: 13px;
                    margin: 7px 0 0;
                    padding: 10px;
                }
                table.author-tbl {
                    width: 40%;
                }
                div.page-box {
                    width: 100%;
                }
                div.page-wrapper .doc-page .content {
                    font-size: 14px;
                }
                pre {
                    font-family: sans-serif;
                    word-wrap: break-word;
                }
                .references {
                    display: none;
                }
                span.doc__references {
                    display: none;
                }
                .footer {
                    font-family: Arial;
                    font-size: 13px;
                    margin: 50px 0 0;
                }

            </style></head><body><style xmlns="" type="text/css" media="all">
            .attach-pretty-auth-red {
                color: #b40010;
                padding-left: 16px;
            }
        </style><div xmlns="" class="attach-pretty-auth-content"><h3></h3><p class="attach-pretty-auth-red"><img src="/i/attach-locked.png"> Приложение в платном доступе</p><p class="attach-pretty-auth-p"><a href="/#/customer/demo/">Оформите демодоступ</a> или <a href="/products/my-products?codeactivation=1" target="_blank">активируйте код доступа</a></p></div></body></html>