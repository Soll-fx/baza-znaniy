DATABASE_URL=postgres://baza:baza@localhost:5432/baza
PORT=4000
NODE_ENV=development

# Каталог хранения загруженных файлов (относительно корня проекта)
STORAGE_DIR=storage

# Директория-источник для импорта из Markdown
CONTENT_DIR=content

# Язык полнотекстового индекса: russian | uzbek | simple
FTS_LANGUAGE=russian
