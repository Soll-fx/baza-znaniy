# Локальный кластер Postgres (677 МБ) — восстанавливается через initdb,
# в репозитории ему не место
.pgdata
*.pgdata

node_modules/
dist/
coverage/

# Секреты: DATABASE_URL с паролемexternal-базы задаётся только в панели хостинга
.env
.env.local
.env.*
!.env.example

# Исходный корпус в Markdown (232 МБ) в git не входит: сервер читает его
# только при импорте, в рантайме не нужен, а рабочие данные лежат в БД.
# Хранится локально и бэкапится отдельно от репозитория.
content/

# Загруженные пользователем файлы — это эфемерно на бесплатных хостингах,
# поэтому в образ попадает только проверенный корпус из storage/assets
storage/exports/
storage/tmp/
storage/*.zip
uploads/

# Файлы вложений из storage/assets ВКЛЮЧЕНЫ в репозиторий намеренно:
# Dockerfile копирует их в образ, и без них статьи останутся без вложений.
# Всё, что рядом с assets, — нет.
storage/*
!storage/assets/

*.log
.DS_Store
.idea/
.vscode/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Профиль браузера, в котором шёл обход 1gb.uz: кэш, wasm, модели (161 МБ).
# Нужен только локально для продолжения краула.
tools/export-mcfr/session-profile/

# Рабочие данные краула: вложения, найденные обходом, но не вошедшие в
# восстановленный корпус (46 МБ). Для деплоя не нужны — статьи ссылаются
# на файлы из storage/assets.
tools/export-mcfr/data/
